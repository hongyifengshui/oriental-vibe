---
import BaseLayout from '../layouts/BaseLayout.astro';

// —— 图片资产（全部走 Seedream proxy，不引入任何外部版权素材）
const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';

const heroBg = `${imgBase}minimalist%20zen%20meditation%20space%20bamboo%20natural%20light%20japanese%20aesthetic%20peaceful&image_size=landscape_16_9`;
const brandImg = `${imgBase}minimalist%20scandinavian%20living%20room%20with%20chinese%20decor%20crystals%20natural%20wood%20neutral%20tones&image_size=portrait_4_3`;

const masterPortrait = `${imgBase}professional%20portrait%20middle%20aged%20chinese%20master%20xu%20wei%20shoulder%20length%20hair%20ponytail%20goatee%20burgundy%20polo%20shirt%20wooden%20prayer%20beads%20bracelet%20black%20studio%20background%20warm%20soft%20light%20wise%20authentic%20lineage%20teacher%20photorealistic&image_size=square_hd`;
const caseHero = `${imgBase}a%20well%20balanced%20classical%20chinese%20tea%20ceremony%20wooden%20table%20scrolls%20soft%20window%20light%20zen%20meditation%20room%20feng%20shui%20inspired&image_size=portrait_4_3`;
const teachingCover = `${imgBase}oriental%20ink%20painting%20showing%20teacher%20writing%20calligraphy%20with%20disciples%20watching%20soft%20sepia%20warm%20tones&image_size=portrait_4_3`;

// —— 导入 D-1 创建的三个 SVG 组件
import SealBadges from '../components/about/SealBadges.astro';
import LineageTree from '../components/about/LineageTree.astro';
import TimelineStory from '../components/about/TimelineStory.astro';

// —— 旧定义保留，确保 Astro 编译无警告（后面不用它们也没关系）
const teamMembers = [
  {
    nameKey: 'about.team1_name',
    roleKey: 'about.team1_role',
    titlesKey: 'about.team1_titles',
    bioKey: 'about.team1_bio',
    expertiseKey: 'about.team1_expertise',
    initial: 'X',
    img: masterPortrait,
  },
];
const timelineEvents = [
  { year: '2018', titleKey: 'about.timeline1_title', descKey: 'about.timeline1_desc' },
  { year: '2019', titleKey: 'about.timeline2_title', descKey: 'about.timeline2_desc' },
  { year: '2020', titleKey: 'about.timeline3_title', descKey: 'about.timeline3_desc' },
  { year: '2022', titleKey: 'about.timeline4_title', descKey: 'about.timeline4_desc' },
  { year: '2024', titleKey: 'about.timeline5_title', descKey: 'about.timeline5_desc' },
];
const stats = [
  { number: '10,000+', labelKey: 'about.stat1_label' },
  { number: '50+', labelKey: 'about.stat2_label' },
  { number: '98%', labelKey: 'about.stat3_label' },
  { number: '12', labelKey: 'about.stat4_label' },
];
const values = [
  { icon: 'sun',  titleKey: 'about.value1_title', descKey: 'about.value1_desc' },
  { icon: 'heart',titleKey: 'about.value2_title', descKey: 'about.value2_desc' },
  { icon: 'leaf', titleKey: 'about.value3_title', descKey: 'about.value3_desc' },
];

// —— 本页当前语言（用于给子组件传 lang prop）
const lang = Astro.url.searchParams.get('lang') || 'en';
const LANG_KEY = (lang === 'zh') ? 'zh' : (lang === 'es' ? 'es' : lang === 'fr' ? 'fr' : lang === 'de' ? 'de' : 'en');
---

<BaseLayout title="About Master Xu Wei | Oriental Vibe" description="40-year direct-lineage practice — Guiguzi 80th-gen, Sun Bin 79th-gen. Distinguished Visiting Professor at Hebei Academy of Fine Arts & PKU Institute of Seal Cutting Studies.">
<style is:global>
/* ==========================================================
   About 2.0 — 10-section redesign
   设计语言：米白宣纸 + 朱砂印章 + 墨色标题 + 藤黄/石青点缀
   ========================================================== */
.ab2 { width: 100%; }
.ab2-wrap { width: min(1140px, 92%); margin-inline: auto; }
.ab2 section { padding: clamp(56px, 10vw, 104px) 0; position: relative; }
.ab2 section:nth-child(even) { background: linear-gradient(180deg, #FDFBF6 0%, #FAF7F1 100%); }

.ab2 h2 {
  font-family: 'Cinzel', 'STKaiti', 'KaiTi', Georgia, serif;
  font-size: clamp(26px, 3.2vw, 36px);
  font-weight: 700;
  color: #3A403D;
  letter-spacing: 0.01em;
  margin: 0;
}
.ab2 .section-subtitle {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.24em;
  color: #A6977C;
  font-weight: 500;
  margin-bottom: 14px;
}
.ab2 .section-lead {
  margin-top: 14px;
  max-width: 720px;
  color: #6B726F;
  line-height: 1.75;
  font-size: 15px;
}
.ab2 .hr-ink {
  display: block;
  width: 56px;
  height: 2px;
  background: linear-gradient(90deg, #BFAF96, transparent);
  margin: 18px 0 24px;
}

/* ----------------------- SECTION 1 : HERO ----------------------- */
.ab2-hero {
  min-height: 86vh;
  padding-top: calc(var(--navbar-height, 80px) + 24px);
  background:
    radial-gradient(80% 50% at 80% 20%, rgba(191,175,150,0.22), transparent 60%),
    linear-gradient(180deg, rgba(245,241,235,0.9) 0%, rgba(250,247,241,0.95) 100%),
    url('${heroBg}');
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.ab2-hero-inner {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 48px;
  align-items: center;
}
@media (max-width: 900px) { .ab2-hero-inner { grid-template-columns: 1fr; gap: 28px; } }

.ab2-eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 6px 14px;
  border: 1px solid #D9CDB6;
  border-radius: 999px;
  background: rgba(255,253,248,0.7);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #8a7a5a;
  margin-bottom: 18px;
}
.ab2-eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: #A8322C; }

.ab2-hero h1 {
  font-family: 'Cinzel', 'STKaiti', Georgia, serif;
  font-size: clamp(34px, 5.2vw, 60px);
  line-height: 1.1;
  color: #2C2F2E;
  margin: 10px 0 18px;
  letter-spacing: -0.01em;
}
.ab2-hero h1 .zh {
  display: inline-block;
  font-family: 'STKaiti','KaiTi',serif;
  font-size: 0.8em;
  color: #A8322C;
  margin-right: 12px;
}
.ab2-hero-desc {
  font-size: clamp(15px, 1.7vw, 18px);
  color: #575D5A;
  line-height: 1.85;
  max-width: 560px;
  margin-bottom: 28px;
}
.ab2-hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
.ab2-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 22px;
  border-radius: 999px;
  font-size: 14px; font-weight: 600; text-decoration: none;
  transition: all .2s ease;
  cursor: pointer;
}
.ab2-btn.primary { background: #2C2F2E; color: #FDFBF6; }
.ab2-btn.primary:hover { background: #1A1C1B; transform: translateY(-2px); box-shadow: 0 10px 24px rgba(44,47,46,.18); }
.ab2-btn.ghost { background: transparent; color: #2C2F2E; border: 1px solid #D9CDB6; }
.ab2-btn.ghost:hover { background: #F5F0E8; }

.ab2-hero-stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 42px;
  padding: 22px 20px;
  background: rgba(255,253,248,0.85);
  border: 1px solid #E8E0D4;
  border-radius: 18px;
  backdrop-filter: blur(4px);
}
.ab2-stat-num {
  font-family: 'Cinzel', Georgia, serif;
  font-size: clamp(20px, 2.6vw, 26px);
  font-weight: 700;
  color: #A8322C;
}
.ab2-stat-lbl {
  font-size: 11px;
  color: #8A948C;
  margin-top: 4px;
  letter-spacing: 0.04em;
}

/* portrait */
.ab2-portrait {
  position: relative;
  width: min(440px, 100%);
  margin-inline: auto;
}
.ab2-portrait .frame {
  position: relative;
  aspect-ratio: 4 / 5;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 30px 60px -20px rgba(58,64,61,0.35), inset 0 0 0 1px rgba(255,255,255,0.4);
}
.ab2-portrait .frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ab2-portrait::before {
  content: '';
  position: absolute; inset: -14px;
  border: 1px solid #D9CDB6;
  border-radius: 32px;
  z-index: -1;
}
.ab2-seal-stamp {
  position: absolute; left: -22px; bottom: -28px;
  width: 88px; height: 88px;
  background: #A8322C;
  border-radius: 12px;
  display: grid; place-items: center;
  color: #F5F1EB;
  font-family: 'STKaiti', KaiTi, serif;
  font-weight: 700;
  transform: rotate(-6deg);
  box-shadow: 0 12px 22px rgba(168,50,44,.3);
  text-align: center;
  line-height: 1.05;
  padding: 10px 8px;
  font-size: 13px;
  letter-spacing: 1px;
}
.ab2-ribbon {
  position: absolute; right: -18px; top: -14px;
  background: linear-gradient(135deg, #BFAF96, #A6977C);
  color: #fff;
  padding: 8px 14px;
  border-radius: 10px;
  font-size: 11px;
  letter-spacing: 0.08em;
  font-weight: 600;
  transform: rotate(4deg);
  box-shadow: 0 6px 14px rgba(191,175,150,.35);
}

/* ----------------------- SECTION 2 : SEALS ----------------------- */
.ab2-seals-head { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 40px; }
.ab2-seals-head .hr-ink { margin-inline: auto; }
.ab2-seals-head .section-lead { text-align: center; }

/* ----------------------- SECTION 3 : TIMELINE ----------------------- */
.ab2-tl-head { margin-bottom: 10px; }

/* ----------------------- SECTION 4 : LINEAGE ----------------------- */
.ab2-lineage-head { margin-bottom: 30px; }

/* ----------------------- SECTION 5 : AFFILIATIONS ----------------------- */
.ab2-affil-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 28px;
}
@media (max-width: 760px) { .ab2-affil-grid { grid-template-columns: 1fr; } }
.ab2-card {
  background: #FFFDF9;
  border: 1px solid #E8E0D4;
  border-radius: 18px;
  padding: 26px 24px;
  transition: all .2s ease;
  position: relative;
  overflow: hidden;
}
.ab2-card:hover { box-shadow: 0 20px 36px -16px rgba(58,64,61,0.18); border-color: #D9CDB6; transform: translateY(-3px); }
.ab2-card-logo {
  width: 58px; height: 58px; border-radius: 14px;
  display: grid; place-items: center;
  background: linear-gradient(135deg, #F5F0E8, #E8E0D4);
  font-family: 'Cinzel','STKaiti',serif;
  font-weight: 700;
  color: #8a7a5a;
  font-size: 20px;
  margin-bottom: 14px;
}
.ab2-card h4 { margin: 0 0 6px; font-size: 16px; color: #2C2F2E; font-weight: 700; }
.ab2-card p { margin: 0; color: #6B726F; font-size: 13.5px; line-height: 1.7; }
.ab2-card .pill {
  display: inline-block;
  margin-top: 12px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 10.5px;
  background: #F5F0E8;
  color: #8a7a5a;
  letter-spacing: 0.08em;
}
.ab2-compliance-fine {
  margin-top: 34px;
  padding: 16px 18px;
  background: #FFF8F3;
  border: 1px solid #F0DFC7;
  border-radius: 14px;
  font-size: 12px;
  color: #8A5A10;
  line-height: 1.75;
}

/* ----------------------- SECTION 6 : EXPERTISE ----------------------- */
.ab2-exp-grid {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px; margin-top: 28px;
}
@media (max-width: 980px) { .ab2-exp-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 620px) { .ab2-exp-grid { grid-template-columns: 1fr; } }

.ab2-exp {
  background: #FFFDF9;
  border: 1px solid #E8E0D4;
  border-radius: 18px;
  padding: 24px 22px 22px;
  display: flex; flex-direction: column;
  transition: all .2s ease;
}
.ab2-exp:hover { box-shadow: 0 20px 36px -20px rgba(58,64,61,.2); transform: translateY(-3px); border-color: #D9CDB6; }
.ab2-exp .num {
  font-family: 'Cinzel', Georgia, serif;
  font-size: 28px; font-weight: 700;
  color: #BFAF96;
  opacity: .55;
}
.ab2-exp h5 { margin: 2px 0 8px; font-size: 16px; color: #2C2F2E; font-weight: 700; }
.ab2-exp p { margin: 0 0 16px; color: #6B726F; font-size: 13px; line-height: 1.7; flex: 1; }
.ab2-exp-foot {
  display: flex; justify-content: space-between; align-items: center;
  border-top: 1px dashed #E8E0D4; padding-top: 14px; margin-top: auto;
}
.ab2-price { color: #A8322C; font-weight: 700; font-family: 'Cinzel', Georgia, serif; font-size: 15px; }
.ab2-cta-link {
  font-size: 12px; font-weight: 600; text-decoration: none;
  color: #3A403D;
  padding: 7px 12px;
  border-radius: 999px;
  border: 1px solid #D9CDB6;
  background: #FFF9F2;
  transition: all .2s ease;
}
.ab2-cta-link:hover { background: #2C2F2E; color: #FDFBF6; border-color: #2C2F2E; }

/* ----------------------- SECTION 7 : CASE STUDIES ----------------------- */
.ab2-case-split {
  display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: center;
  margin-top: 24px;
}
@media (max-width: 900px) { .ab2-case-split { grid-template-columns: 1fr; gap: 24px; } }
.ab2-case-art {
  position: relative;
  aspect-ratio: 4 / 5;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 30px 60px -20px rgba(58,64,61,0.3);
}
.ab2-case-art img { width: 100%; height: 100%; object-fit: cover; }
.ab2-case-art::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(20,20,20,0.45));
}
.ab2-case-art .label {
  position: absolute; left: 20px; bottom: 22px; z-index: 2;
  color: #fff; font-family: 'Cinzel','STKaiti',serif; font-weight: 700; font-size: 18px;
}
.ab2-case-art .label small { display: block; font-family: inherit; font-size: 11px; opacity: .85; margin-top: 4px; letter-spacing: 0.18em; font-weight: 500; text-transform: uppercase; }

.ab2-case-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
}
@media (max-width: 620px) { .ab2-case-grid { grid-template-columns: 1fr; } }
.ab2-case {
  background: #FFFDF9;
  border: 1px solid #E8E0D4;
  border-radius: 16px;
  padding: 18px 16px;
  transition: all .2s ease;
}
.ab2-case:hover { border-color: #D9CDB6; box-shadow: 0 16px 30px -20px rgba(58,64,61,.25); transform: translateY(-2px); }
.ab2-case .c-client { font-weight: 700; color: #2C2F2E; font-size: 13.5px; margin-bottom: 10px; line-height: 1.3; }
.ab2-case .row { margin-top: 8px; font-size: 12px; line-height: 1.6; }
.ab2-case .row .tag { display: inline-block; font-size: 10px; padding: 2px 8px; border-radius: 999px; margin-right: 6px; font-weight: 600; letter-spacing: 0.05em; }
.ab2-case .before .tag { background: #FDEAE9; color: #A8322C; }
.ab2-case .after  .tag { background: #E8F5E8; color: #2A5A38; }
.ab2-case .row span { color: #575D5A; }

/* ----------------------- SECTION 8 : METHOD + GUARANTEE ----------------------- */
.ab2-mg-wrap {
  display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px;
  margin-top: 28px;
}
@media (max-width: 900px) { .ab2-mg-wrap { grid-template-columns: 1fr; gap: 28px; } }
.ab2-method {
  background: #2C2F2E;
  border-radius: 20px;
  color: #FDFBF6;
  padding: 32px 28px;
}
.ab2-method h3 {
  font-family: 'Cinzel','STKaiti',serif; font-size: 22px; color: #F5F0E8; margin: 0 0 24px;
  font-weight: 700;
}
.ab2-method ol { list-style: none; padding: 0; margin: 0; counter-reset: mg; display: grid; gap: 16px; }
.ab2-method li {
  counter-increment: mg;
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 14px;
  align-items: start;
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.ab2-method li:last-child { border-bottom: none; }
.ab2-method li::before {
  content: counter(mg,decimal-leading-zero);
  font-family: 'Cinzel', Georgia, serif;
  font-weight: 700; font-size: 24px;
  color: #BFAF96;
  text-align: center;
  line-height: 1;
  padding-top: 2px;
}
.ab2-method li strong { display: block; font-size: 14px; margin-bottom: 4px; color: #FDFBF6; }
.ab2-method li p { margin: 0; font-size: 13px; color: #C9CECC; line-height: 1.7; }

.ab2-guarantee h3 {
  font-family: 'Cinzel','STKaiti',serif; font-size: 22px; margin: 0 0 24px; color: #3A403D; font-weight: 700;
}
.ab2-guarantee ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
.ab2-guarantee li {
  background: #FFFDF9;
  border: 1px solid #E8E0D4;
  border-radius: 14px;
  padding: 16px 16px 16px 52px;
  position: relative;
  font-size: 13.5px;
  line-height: 1.7;
  color: #575D5A;
}
.ab2-guarantee li::before {
  content: '✓'; position: absolute; left: 16px; top: 18px;
  width: 26px; height: 26px; border-radius: 50%;
  background: #6B9B7A; color: #fff;
  display: grid; place-items: center;
  font-weight: 700;
}

/* ----------------------- SECTION 9 : TEACHING / COURSES ----------------------- */
.ab2-teach-head {
  display: grid; grid-template-columns: 1fr 1.2fr; gap: 32px; align-items: center;
}
@media (max-width: 900px) { .ab2-teach-head { grid-template-columns: 1fr; } }
.ab2-teach-art {
  aspect-ratio: 4/5;
  border-radius: 22px;
  overflow: hidden;
  position: relative;
}
.ab2-teach-art img { width: 100%; height: 100%; object-fit: cover; }
.ab2-teach-art::after {
  content: ''; position: absolute; inset: -10px; border: 1px solid #D9CDB6; border-radius: 30px; z-index: -1;
}
.ab2-teach-head .section-subtitle, .ab2-teach-head h2, .ab2-teach-head .section-lead { }

.ab2-course-grid {
  margin-top: 40px;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}
@media (max-width: 980px) { .ab2-course-grid { grid-template-columns: 1fr; } }
.ab2-course {
  background: #FFFDF9;
  border: 1px solid #E8E0D4;
  border-radius: 20px;
  padding: 26px 24px 24px;
  display: flex; flex-direction: column;
  position: relative;
  transition: all .2s ease;
}
.ab2-course:hover { transform: translateY(-4px); box-shadow: 0 24px 40px -22px rgba(58,64,61,0.25); border-color: #D9CDB6; }
.ab2-course.flagship {
  background: linear-gradient(180deg, #2C2F2E 0%, #3A403D 100%);
  color: #FDFBF6;
  border-color: transparent;
  transform: translateY(-4px);
}
.ab2-course.flagship:hover { transform: translateY(-8px); }
.ab2-course.flagship .tag-f {
  position: absolute; top: -10px; right: 20px;
  background: linear-gradient(135deg, #C9A24C, #F7E7B4);
  color: #4A3810;
  font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
  padding: 6px 12px; border-radius: 999px;
  box-shadow: 0 10px 20px -8px rgba(201,162,76,.5);
}
.ab2-course h5 {
  margin: 0 0 12px;
  font-family: 'Cinzel','STKaiti',serif;
  font-size: 18px; font-weight: 700;
}
.ab2-course .price {
  font-family: 'Cinzel', Georgia, serif;
  font-size: 24px; font-weight: 700;
  color: #A8322C;
  margin-bottom: 18px;
}
.ab2-course.flagship .price { color: #F7E7B4; }
.ab2-course ul { margin: 0 0 22px; padding: 0 0 0 18px; font-size: 13px; line-height: 1.85; flex: 1; }
.ab2-course.flagship ul li { color: #DAD8D2; }
.ab2-course ul li { color: #575D5A; }
.ab2-course .enroll-btn {
  display: block;
  text-align: center;
  padding: 13px 16px;
  border-radius: 999px;
  background: #2C2F2E;
  color: #FDFBF6;
  font-weight: 600;
  font-size: 13px;
  text-decoration: none;
  transition: all .2s ease;
}
.ab2-course.flagship .enroll-btn {
  background: linear-gradient(135deg, #C9A24C, #F7E7B4);
  color: #3A2F10;
}
.ab2-course .enroll-btn:hover { opacity: .9; transform: translateY(-1px); }

/* ----------------------- SECTION 10 : FINAL CTA ----------------------- */
.ab2-final {
  background:
    radial-gradient(60% 80% at 10% 10%, rgba(191,175,150,0.18), transparent 60%),
    radial-gradient(60% 80% at 90% 90%, rgba(168,50,44,0.08), transparent 60%),
    linear-gradient(180deg, #FAF7F1, #FDFBF6);
  border-top: 1px solid #E8E0D4;
}
.ab2-final-inner {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  gap: 30px;
  align-items: center;
  padding: 56px 50px;
  background: #FFFDF9;
  border: 1px solid #E8E0D4;
  border-radius: 28px;
