---
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts } from '../data/blog.js';
---
<BaseLayout title="Blog & Articles | Oriental Vibe" description="Explore space energy principles, wellness tips, and client stories from Oriental Vibe.">
  <!-- Hero -->
  <section class="hero fade-in">
    <div class="hero-content">
      <p class="hero-subtitle" data-i18n="blog.hero_subtitle">Insights & Wisdom</p>
      <h1 class="hero-title" data-i18n="blog.hero_title">Blog & Articles</h1>
      <p class="hero-description" data-i18n="blog.hero_desc">Explore space energy principles, wellness tips, and client stories</p>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="section fade-in">
    <div class="container">
      <div class="grid grid-2">
        {posts.map((post) => (
          <article class="card fade-in" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
            <div style="aspect-ratio: 16/9; overflow: hidden;">
              <img src={post.image} alt="" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" data-i18n-alt={post.titleKey} />
            </div>
            <div style="padding: 2rem; display: flex; flex-direction: column; flex: 1;">
              <span class="badge badge-popular" style="align-self: flex-start; margin-bottom: 1rem;" data-i18n={post.categoryKey}>{post.categoryEn}</span>
              <h3 style="margin-bottom: 1rem;" data-i18n={post.titleKey}>{post.titleEn}</h3>
              <p style="margin-bottom: 1rem; flex: 1;" data-i18n={post.excerptKey}>{post.excerptEn}</p>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border-light);">
                <small>{post.date}</small>
                <a href={`/blog/${post.id}`} class="btn btn-secondary" data-i18n="common.read_more">Read More</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
