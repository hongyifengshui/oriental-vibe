---
import BaseLayout from '../layouts/BaseLayout.astro';

const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';
const heroBg = `${imgBase}minimalist%20zen%20garden%20japanese%20style%20peaceful%20natural%20light%20neutral%20tones&image_size=landscape_16_9`;

const faqItems = [
  {
    number: '01',
    questionKey: 'faq.popular_q1',
    answerKey: 'faq.popular_a1',
  },
  {
    number: '02',
    questionKey: 'faq.popular_q2',
    answerKey: 'faq.popular_a2',
  },
  {
    number: '03',
    questionKey: 'faq.popular_q3',
    answerKey: 'faq.popular_a3',
  },
  {
    number: '04',
    questionKey: 'faq.popular_q4',
    answerKey: 'faq.popular_a4',
  },
  {
    number: '05',
    questionKey: 'faq.popular_q5',
    answerKey: 'faq.popular_a5',
  },
];

const trustBadges = [
  { icon: 'shield', labelKey: 'faq.trust_authentic' },
  { icon: 'box', labelKey: 'faq.trust_packaging' },
  { icon: 'globe', labelKey: 'faq.trust_shipping' },
  { icon: 'heart', labelKey: 'faq.trust_satisfaction' },
];
---

<BaseLayout title="FAQ | Oriental Vibe" description="Find answers to the most popular questions about our crystals, Five Elements Test, shipping, and more.">
  <style is:global>
    /* ===== Hero ===== */
    .faq-hero {
      min-height: 45vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: calc(var(--navbar-height) + 4rem) 2rem 3rem;
      background: linear-gradient(180deg, rgba(245,241,235,0.92) 0%, rgba(248,246,242,0.97) 100%), url('${heroBg}');
      background-size: cover;
      background-position: center;
      position: relative;
    }

    .faq-hero-content {
      max-width: 640px;
      position: relative;
      z-index: 1;
    }

    .faq-hero-badge {
      display: inline-block;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--color-accent-dark);
      border: 1px solid var(--color-accent);
      border-radius: 999px;
      padding: 0.4rem 1.25rem;
      margin-bottom: 1.75rem;
      font-weight: 400;
    }

    .faq-hero-title {
      font-size: 2.75rem;
      font-weight: 400;
      letter-spacing: -0.02em;
      color: var(--color-text-primary);
      margin-bottom: 1.25rem;
      line-height: 1.2;
    }

    .faq-hero-description {
      font-size: 1.05rem;
      color: var(--color-text-secondary);
      line-height: 1.75;
      margin-bottom: 0;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ===== Search ===== */
    .faq-search-section {
      background-color: var(--color-bg-primary);
      padding: 0 0 2rem;
    }

    .faq-search-wrapper {
      max-width: 560px;
      margin: 0 auto;
      position: relative;
    }

    .faq-search-input {
      width: 100%;
      padding: 0.95rem 1.25rem 0.95rem 3rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background-color: var(--color-bg-tertiary);
      color: var(--color-text-primary);
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 300;
      transition: all 0.25s ease;
      box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }

    .faq-search-input:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px rgba(191, 175, 150, 0.12), 0 4px 12px rgba(0,0,0,0.05);
    }

    .faq-search-input::placeholder {
      color: var(--color-text-tertiary);
    }

    .faq-search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--color-text-tertiary);
      pointer-events: none;
    }

    .faq-search-icon svg {
      width: 18px;
      height: 18px;
    }

    /* ===== FAQ List ===== */
    .faq-list-section {
      background-color: var(--color-bg-primary);
      padding: 0 0 5rem;
    }

    .faq-list-wrapper {
      max-width: 720px;
      margin: 0 auto;
    }

    .faq-item {
      border-bottom: 1px solid var(--color-border-light);
      transition: all 0.2s ease;
    }

    .faq-item:first-child {
      border-top: 1px solid var(--color-border-light);
    }

    .faq-question {
      width: 100%;
      display: flex;
      align-items: flex-start;
      padding: 1.5rem 0;
      background: none;
      border: none;
      cursor: pointer;
      text-align: left;
      font-family: var(--font-sans);
      gap: 1.25rem;
      transition: all 0.2s ease;
    }

    .faq-question:hover .faq-q-text {
      color: var(--color-accent-dark);
    }

    .faq-q-number {
      flex-shrink: 0;
      width: 2.25rem;
      height: 2.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: var(--color-bg-secondary);
      color: var(--color-text-tertiary);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      transition: all 0.3s ease;
    }

    .faq-item.open .faq-q-number {
      background-color: var(--color-accent);
      color: #fff;
    }

    .faq-q-content {
      flex: 1;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      padding-top: 0.35rem;
    }

    .faq-q-text {
      font-size: 1.05rem;
      font-weight: 400;
      color: var(--color-text-primary);
      line-height: 1.5;
      transition: color 0.2s ease;
    }

    .faq-item.open .faq-q-text {
      font-weight: 500;
    }

    .faq-icon {
      flex-shrink: 0;
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      color: var(--color-text-tertiary);
      margin-top: 0.15rem;
    }

    .faq-item.open .faq-icon {
      transform: rotate(180deg);
      color: var(--color-accent-dark);
    }

    .faq-icon svg {
      width: 18px;
      height: 18px;
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), padding 0.4s ease;
    }

    .faq-item.open .faq-answer {
      max-height: 600px;
    }

    .faq-answer-inner {
      padding: 0 0 1.75rem 3.5rem;
    }

    .faq-answer p {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.8;
      margin: 0;
    }

    .faq-answer .faq-answer-link {
      display: inline-block;
      margin-top: 0.75rem;
      color: var(--color-accent-dark);
      font-size: 0.9rem;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s ease;
    }

    .faq-answer .faq-answer-link:hover {
      border-bottom-color: var(--color-accent-dark);
    }

    /* ===== Trust Bar ===== */
    .faq-trust-section {
      background-color: var(--color-bg-secondary);
      padding: 3.5rem 0;
      border-top: 1px solid var(--color-border-light);
    }

    .faq-trust-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .faq-trust-item {
      text-align: center;
    }

    .faq-trust-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: var(--color-bg-tertiary);
      color: var(--color-accent-dark);
    }

    .faq-trust-icon svg {
      width: 22px;
      height: 22px;
    }

    .faq-trust-label {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
      font-weight: 400;
      line-height: 1.4;
    }

    /* ===== No Results ===== */
    .faq-no-results {
      text-align: center;
      padding: 4rem 2rem;
      display: none;
    }

    .faq-no-results.show {
      display: block;
    }

    .faq-no-results-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: var(--color-bg-secondary);
      color: var(--color-text-tertiary);
    }

    .faq-no-results-icon svg {
      width: 28px;
      height: 28px;
    }

    .faq-no-results h3 {
      margin-bottom: 0.5rem;
      font-size: 1.1rem;
    }

    .faq-no-results p {
      color: var(--color-text-secondary);
      margin-bottom: 1.25rem;
      font-size: 0.9rem;
    }

    /* ===== CTA ===== */
    .faq-cta-section {
      background-color: var(--color-text-primary);
      color: #FFFFFF;
      padding: 4.5rem 0;
      text-align: center;
    }

    .faq-cta-section h2 {
      color: #FFFFFF;
      margin-bottom: 0.75rem;
      font-size: 1.75rem;
      font-weight: 400;
    }

    .faq-cta-section p {
      color: rgba(255, 255, 255, 0.65);
      margin-bottom: 2rem;
      max-width: 440px;
      margin-left: auto;
      margin-right: auto;
      font-size: 0.95rem;
      line-height: 1.65;
    }

    .faq-cta-section .btn-accent {
      background-color: var(--color-accent);
      color: var(--color-text-primary);
      border-color: var(--color-accent);
      font-weight: 500;
    }

    .faq-cta-section .btn-accent:hover {
      background-color: var(--color-accent-light);
      border-color: var(--color-accent-light);
    }

    /* ===== Responsive ===== */
    @media (max-width: 768px) {
      .faq-hero {
        min-height: auto;
        padding-top: calc(var(--navbar-height) + 2.5rem);
        padding-bottom: 2.5rem;
      }

      .faq-hero-title {
        font-size: 2rem;
      }

      .faq-hero-description {
        font-size: 0.95rem;
      }

      .faq-trust-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }

      .faq-question {
        padding: 1.25rem 0;
      }

      .faq-q-number {
        width: 2rem;
        height: 2rem;
        font-size: 0.7rem;
      }

      .faq-q-text {
        font-size: 0.95rem;
      }

      .faq-answer-inner {
        padding-left: 3.25rem;
      }

      .faq-answer p {
        font-size: 0.9rem;
      }
    }

    @media (max-width: 480px) {
      .faq-hero-title {
        font-size: 1.65rem;
      }

      .faq-trust-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .faq-search-input {
        font-size: 0.9rem;
        padding-left: 2.5rem;
      }
    }
  </style>

  {/* ===== Hero ===== */}
  <section class="faq-hero fade-in">
    <div class="faq-hero-content">
      <span class="faq-hero-badge" data-i18n="faq.hero_badge">Help Center</span>
      <h1 class="faq-hero-title" data-i18n="faq.hero_title">Frequently Asked Questions</h1>
      <p class="faq-hero-description" data-i18n="faq.hero_description">Find answers to the most common questions our customers ask. Can't find what you're looking for? Our team is here to help.</p>
    </div>
  </section>

  {/* ===== Search ===== */}
  <section class="faq-search-section fade-in">
    <div class="container">
      <div class="faq-search-wrapper">
        <div class="faq-search-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input type="text" class="faq-search-input" id="faqSearch" oninput="filterFAQs()" data-i18n-placeholder="faq.search_placeholder" placeholder="Search for answers..." />
      </div>
    </div>
  </section>

  {/* ===== FAQ List ===== */}
  <section class="faq-list-section fade-in">
    <div class="container">
      <div class="faq-list-wrapper" id="faqList">
        {faqItems.map((item) => (
          <div class="faq-item" data-index={item.number}>
            <button class="faq-question" onclick="toggleFAQ(this)" aria-expanded="false">
              <span class="faq-q-number">{item.number}</span>
              <span class="faq-q-content">
                <span class="faq-q-text" data-i18n={item.questionKey}>Question {item.number}</span>
                <span class="faq-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </span>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-inner">
                <p data-i18n={item.answerKey}>Answer {item.number}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="faq-no-results" id="noResults">
        <div class="faq-no-results-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h3 data-i18n="faq.no_results_title">No results found</h3>
        <p data-i18n="faq.no_results_text">Try adjusting your search terms.</p>
        <button class="btn btn-secondary" onclick="clearSearch()" data-i18n="faq.clear_search">Clear Search</button>
      </div>
    </div>
  </section>

  {/* ===== Trust Bar ===== */}
  <section class="faq-trust-section fade-in">
    <div class="container">
      <div class="faq-trust-grid">
        <div class="faq-trust-item">
          <div class="faq-trust-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <p class="faq-trust-label" data-i18n="faq.trust_authentic">100% Authentic Crystals</p>
        </div>
        <div class="faq-trust-item">
          <div class="faq-trust-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <p class="faq-trust-label" data-i18n="faq.trust_packaging">Sacred Ceremonial Packaging</p>
        </div>
        <div class="faq-trust-item">
          <div class="faq-trust-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <p class="faq-trust-label" data-i18n="faq.trust_shipping">Worldwide Shipping</p>
        </div>
        <div class="faq-trust-item">
          <div class="faq-trust-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <p class="faq-trust-label" data-i18n="faq.trust_satisfaction">30-Day Satisfaction Guarantee</p>
        </div>
      </div>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="faq-cta-section fade-in">
    <div class="container">
      <h2 data-i18n="faq.cta_title">Still have questions?</h2>
      <p data-i18n="faq.cta_description">Our team is here to help. Reach out and we'll get back to you within 24 hours.</p>
      <a href="/contact" class="btn btn-accent btn-lg" data-i18n="faq.cta_button">Contact Us</a>
    </div>
  </section>

  <script is:inline>
    let currentSearch = '';

    function toggleFAQ(button) {
      const item = button.parentElement;
      const isOpen = item.classList.contains('open');

      // Close all others
      document.querySelectorAll('.faq-item.open').forEach(i => {
        if (i !== item) {
          i.classList.remove('open');
          i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
        }
      });

      if (isOpen) {
        item.classList.remove('open');
        button.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    }

    function filterFAQs() {
      currentSearch = document.getElementById('faqSearch').value.toLowerCase().trim();
      const items = document.querySelectorAll('.faq-item');
      let visibleCount = 0;

      items.forEach(item => {
        const question = item.querySelector('.faq-q-text').textContent.toLowerCase();
        const answer = item.querySelector('.faq-answer p').textContent.toLowerCase();
        const searchMatch = !currentSearch || question.includes(currentSearch) || answer.includes(currentSearch);

        item.style.display = searchMatch ? 'block' : 'none';
        if (searchMatch) visibleCount++;
      });

      document.getElementById('noResults').classList.toggle('show', visibleCount === 0);
    }

    function clearSearch() {
      document.getElementById('faqSearch').value = '';
      currentSearch = '';
      document.querySelectorAll('.faq-item').forEach(item => {
        item.style.display = 'block';
      });
      document.getElementById('noResults').classList.remove('show');
    }
  </script>
<script is:inline>
  (function() {
    var PREFIX = 'ov-admin-';
    var PAGE_ID = 'page-faq';
    var PAGE_PREFIX = 'faq';
    function applyPage() {
      try {
        var raw = localStorage.getItem(PREFIX + PAGE_ID);
        var data = raw ? JSON.parse(raw) : null;
        if (!data) return;
        Object.keys(data).forEach(function(key) {
          var val = data[key];
          if (val === undefined || val === null || val === '') return;
          var sel = '[data-i18n="' + PAGE_PREFIX + '.' + key + '"]';
          document.querySelectorAll(sel).forEach(function(el) { el.textContent = val; });
          var selPh = '[data-i18n-placeholder="' + PAGE_PREFIX + '.' + key + '"]';
          document.querySelectorAll(selPh).forEach(function(el) { el.setAttribute('placeholder', val); });
        });
      } catch(e) {}
    }
    function runWhenReady(fn) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, { once: true }); else fn(); }
    runWhenReady(applyPage);
    window.addEventListener('ov-admin-saved', function(e) { var k = e && e.detail && e.detail.key; if (k == null || k === PAGE_ID) applyPage(); });
    window.addEventListener('storage', function(e) { if (e.key === PREFIX + PAGE_ID) applyPage(); });
  })();
</script>
</BaseLayout>