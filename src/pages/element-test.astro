    { image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=terra%20cotta%20ceramic%20vase%20minimalist%20luxury&image_size=square', nameKey: 'test.rec_earth_name', priceUsd: 42 },
