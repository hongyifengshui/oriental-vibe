      function buildHealth(dist) {
        var tips = document.getElementById('etHealthTips');
        tips.innerHTML = '';

        var sorted = ELEMENTS.slice().sort(function(a,b){ return dist[a] - dist[b]; });
        var weakest = sorted[0];
        var strongest = sorted[4];

        if (dist[weakest] < 12) {
          var item1 = document.createElement('div');
          item1.className = 'et-analysis-item';
          item1.innerHTML =
            '<div class="et-analysis-bullet" style="background:' + EL_COLORS[weakest] + '">!</div>' +
            '<span><strong data-i18n="test.element_' + weakest.toLowerCase() + '">' + t('test.element_' + weakest.toLowerCase(), weakest) + '</strong> <span data-i18n="test.health_' + weakest.toLowerCase() + '">' + t('test.health_' + weakest.toLowerCase(), '') + '</span> <span data-i18n="test.health_tip_weak">' + t('test.health_tip_weak', '') + '</span></span>';
          tips.appendChild(item1);
        }

        if (dist[strongest] > 30) {
          var item2 = document.createElement('div');
          item2.className = 'et-analysis-item';
          item2.innerHTML =
            '<div class="et-analysis-bullet" style="background:' + EL_COLORS[strongest] + '">~</div>' +
            '<span><strong data-i18n="test.element_' + strongest.toLowerCase() + '">' + t('test.element_' + strongest.toLowerCase(), strongest) + '</strong> <span data-i18n="test.health_' + strongest.toLowerCase() + '">' + t('test.health_' + strongest.toLowerCase(), '') + '</span> <span data-i18n="test.health_tip_strong">' + t('test.health_tip_strong', '') + '</span></span>';
          tips.appendChild(item2);
        }

        /* Add general tip for each outlier */
        ELEMENTS.forEach(function(el) {
          if (el !== weakest && el !== strongest && dist[el] < 15) {
            var item = document.createElement('div');
            item.className = 'et-analysis-item';
            item.innerHTML =
              '<div class="et-analysis-bullet" style="background:' + EL_COLORS[el] + '">+</div>' +
              '<span><span data-i18n="test.element_' + el.toLowerCase() + '">' + t('test.element_' + el.toLowerCase(), el) + '</span>: <span data-i18n="test.health_' + el.toLowerCase() + '">' + t('test.health_' + el.toLowerCase(), '') + '</span></span>';
            tips.appendChild(item);
          }
        });
      }

