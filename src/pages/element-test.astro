      /* ---------- Builders ---------- */
      function buildDonut(dist) {
        var parts = [];
        var angle = 0;
        ELEMENTS.forEach(function(el) {
          var pct = dist[el];
          if (pct <= 0) return;
          var deg = (pct / 100) * 360;
          parts.push(EL_COLORS[el] + ' ' + angle + 'deg ' + (angle + deg) + 'deg');
          angle += deg;
        });
        donutEl.style.background = 'conic-gradient(' + parts.join(', ') + ')';
      }
      function buildLegend(dist) {
        legendEl.innerHTML = '';
        ELEMENTS.forEach(function(el) {
          var pct = dist[el];
          var item = document.createElement('div');
          item.className = 'et-legend-item';
          item.innerHTML =
            '<div class="et-legend-dot" style="background:' + EL_COLORS[el] + '"></div>' +
            '<span class="et-legend-name" data-i18n="test.element_' + el.toLowerCase() + '">' + t('test.element_' + el.toLowerCase(), el) + '</span>' +
            '<span class="et-legend-pct">' + pct + '%</span>' +
            '<div class="et-legend-bar-wrap"><div class="et-legend-bar" style="width:' + pct + '%;background:' + EL_COLORS[el] + '"></div></div>';
          legendEl.appendChild(item);
        });
      }

      function buildBirthInfo(year, month, day, hourKey, gender) {
        var dateStr = year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
        document.getElementById('etBirthDateValue').textContent = dateStr;

        var hourText = hourKey ? t('test.hour_' + hourKey, hourKey) : t('test.form_birthtime_unknown', 'Unknown');
        document.getElementById('etBirthTimeValue').textContent = hourText;

        var genderText = gender === 'female'
          ? t('test.form_gender_female', 'Female')
          : t('test.form_gender_male', 'Male');
        document.getElementById('etGenderValue').textContent = genderText;
      }

      function buildDayMaster(dmStem, dmEl, dmYy) {
        document.getElementById('etDayMasterStem').textContent = TIANGAN_CN[dmStem] || dmStem;
        document.getElementById('etDayMasterStem').style.color = EL_COLORS[dmEl];
        document.getElementById('etDayMasterEl').textContent = t('test.element_' + dmEl.toLowerCase(), dmEl);
        document.getElementById('etDayMasterYy').textContent = dmYy === 'yang' ? t('test.day_master_yang','Yang') : t('test.day_master_yin','Yin');
