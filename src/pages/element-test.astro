        document.getElementById('etDayMasterDesc').setAttribute('data-i18n', descKey);
        document.getElementById('etDayMasterDesc').textContent = t(descKey, '');
      }

      function buildBaZi(year, month, day, hourKey, dmStem) {
        var yearP = getYearPillar(year);
        var monthP = getMonthPillar(year, month);
        var dayP = getDayPillar(year, month, day);
        var hourP = hourKey ? getHourPillar(hourKey, dayP.stemIdx) : null;

        var pillars = [
          { labelKey: 'test.bazi_year_pillar', labelFb: 'Year', stem: yearP.stem, branch: yearP.branch },
          { labelKey: 'test.bazi_month_pillar', labelFb: 'Month', stem: monthP.stem, branch: monthP.branch },
          { labelKey: 'test.bazi_day_pillar', labelFb: 'Day', stem: dayP.stem, branch: dayP.branch },
          { labelKey: 'test.bazi_hour_pillar', labelFb: 'Hour', stem: hourP ? hourP.stem : null, branch: hourP ? hourP.branch : null }
        ];

        baziGrid.innerHTML = '';
        pillars.forEach(function(p) {
          var stemCn = p.stem ? TIANGAN_CN[p.stem] : '\u2014';
          var branchCn = p.branch ? DIZHI_CN[p.branch] : '\u2014';
          var stemEl = p.stem ? TIANGAN_ELEMENT[p.stem] : '';
          var branchEl = p.branch ? DIZHI_ELEMENT[p.branch] : '';
          var hidden = p.branch ? (DIZHI_HIDDEN[p.branch] || []).map(function(s){ return TIANGAN_CN[s]; }).join(' ') : '';
          var pillar = document.createElement('div');
          pillar.className = 'et-bazi-pillar';
          pillar.innerHTML =
            '<div class="et-bazi-pillar-label">' + t(p.labelKey, p.labelFb) + '</div>' +
            '<div class="et-bazi-pillar-stem">' + stemCn + '</div>' +
            '<div class="et-bazi-pillar-branch">' + branchCn + '</div>' +
            '<div class="et-bazi-pillar-el">' +
              (stemEl ? t('test.element_' + stemEl.toLowerCase(), stemEl) : '') + ' / ' +
              (branchEl ? t('test.element_' + branchEl.toLowerCase(), branchEl) : '') +
            '</div>' +
            (hidden ? '<div class="et-bazi-pillar-el" style="margin-top:0.4rem;font-size:0.6rem;">' + t('test.hidden_stems','Hidden') + ': ' + hidden + '</div>' : '');
          baziGrid.appendChild(pillar);
        });

        var zodiacIdx = ((year - 4) % 12 + 12) % 12;
        var zodiacKey = ZODIAC_KEYS[zodiacIdx];

        baziInfo.innerHTML =
          '<div class="et-bazi-info-item"><div class="et-bazi-info-label" data-i18n="test.zodiac">Zodiac</div><div class="et-bazi-info-value" data-i18n="test.zodiac_' + zodiacKey + '">' + t('test.zodiac_' + zodiacKey, ZODIAC[zodiacIdx]) + '</div></div>' +
          '<div class="et-bazi-info-item"><div class="et-bazi-info-label" data-i18n="test.day_master">Day Master</div><div class="et-bazi-info-value" data-i18n="test.element_' + TIANGAN_ELEMENT[dmStem].toLowerCase() + '">' + TIANGAN_CN[dmStem] + ' ' + t('test.element_' + TIANGAN_ELEMENT[dmStem].toLowerCase(), TIANGAN_ELEMENT[dmStem]) + '</div></div>' +
          '<div class="et-bazi-info-item"><div class="et-bazi-info-label" data-i18n="test.hidden_stems">Hidden</div><div class="et-bazi-info-value" style="font-size:0.85rem;">12 地支藏干</div></div>';
      }

