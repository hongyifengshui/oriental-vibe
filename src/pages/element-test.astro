    { image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=green%20aventurine%20crystal%20tower%20minimalist%20decor&image_size=square', nameKey: 'test.rec_wood_name', priceUsd: 59 },
    { image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=moss%20agate%20stone%20healing%20crystal%20luxury&image_size=square', nameKey: 'test.rec_wood_name', priceUsd: 39 }
