        var dayun = getDaYun(year, month, day, gender, yearP, monthP);
        var header = document.getElementById('etDayunHeader');
        header.innerHTML =
          '<div class="et-dayun-meta"><div class="et-dayun-meta-label" data-i18n="test.dayun_direction">Direction</div><div class="et-dayun-meta-value" data-i18n="' + (dayun.forward ? 'test.dayun_forward' : 'test.dayun_backward') + '">' + (dayun.forward ? t('test.dayun_forward','Forward') : t('test.dayun_backward','Backward')) + '</div></div>' +
          '<div class="et-dayun-meta"><div class="et-dayun-meta-label" data-i18n="test.dayun_start_age">Start Age</div><div class="et-dayun-meta-value">' + dayun.startAge + ' <span data-i18n="test.dayun_age">' + t('test.dayun_age','yrs') + '</span></div></div>';

        var timeline = document.getElementById('etDayunTimeline');
        timeline.innerHTML = '';
        var currentYear = new Date().getFullYear();
        var currentAge = currentYear - year;
        dayun.pillars.forEach(function(p) {
          var isCurrent = currentAge >= p.startAge && currentAge < p.startAge + 10;
          var pill = document.createElement('div');
          pill.className = 'et-dayun-pillar' + (isCurrent ? ' current' : '');
          pill.innerHTML =
            '<div class="et-dayun-pillar-age">' + p.startAge + '<span data-i18n="test.dayun_age">' + t('test.dayun_age','') + '</span></div>' +
            '<div class="et-dayun-pillar-stem">' + TIANGAN_CN[p.stem] + '</div>' +
            '<div class="et-dayun-pillar-branch">' + DIZHI_CN[p.branch] + '</div>' +
            '<div class="et-dayun-pillar-label" data-i18n="test.dayun_current">' + (isCurrent ? t('test.dayun_current','Now') : '') + '</div>';
          timeline.appendChild(pill);
        });
      }

      function buildDetails(dist) {
        detailsEl.innerHTML = '';
        var descKeys = {
          Wood: 'test.element_wood_desc', Fire: 'test.element_fire_desc',
          Earth: 'test.element_earth_desc', Metal: 'test.element_metal_desc',
          Water: 'test.element_water_desc'
        };
        ELEMENTS.forEach(function(el) {
          var pct = dist[el];
          var card = document.createElement('div');
          card.className = 'et-detail-card';
          card.innerHTML =
            '<div class="et-detail-icon" style="background:' + EL_COLORS[el] + '">' + EL_ICONS[el] + '</div>' +
            '<div class="et-detail-body">' +
              '<div class="et-detail-name" data-i18n="test.element_' + el.toLowerCase() + '">' + t('test.element_' + el.toLowerCase(), el) + '</div>' +
              '<div class="et-detail-pct">' + pct + '%</div>' +
              '<div class="et-detail-desc" data-i18n="' + descKeys[el] + '">' + t(descKeys[el], '') + '</div>' +
            '</div>';
          detailsEl.appendChild(card);
        });
      }

      function buildMissing(missingElements) {
        if (missingElements.length === 0) { missingSec.style.display = 'none'; return; }
        missingSec.style.display = 'block';
        missingList.innerHTML = '';
        var suggestions = {
          Wood: 'Spend time in nature, add green plants, wear green tones, practice creative hobbies.',
          Fire: 'Light candles, engage in passionate activities, add warm lighting, wear red accents.',
          Earth: 'Use ceramic decor, eat grounding foods, create cozy spaces, wear earthy tones.',
          Metal: 'Declutter your space, use white and metallic accents, practice breathing exercises.',
          Water: 'Add a small fountain, take baths, wear dark blue or black, practice meditation.'
        };
        missingElements.forEach(function(el) {
          var item = document.createElement('div');
          item.className = 'et-missing-item';
          item.innerHTML =
            '<div class="et-missing-bullet" style="background:' + EL_COLORS[el] + '">' + EL_ICONS[el] + '</div>' +
            '<div style="font-size:0.9rem;color:var(--color-text-secondary);line-height:1.65;">' +
              '<strong style="color:var(--color-text-primary)" data-i18n="test.element_' + el.toLowerCase() + '">' + t('test.element_' + el.toLowerCase(), el) + '</strong>: ' + suggestions[el] +
            '</div>';
          missingList.appendChild(item);
        });
      }

      function buildRecommendations(missingElements, usefulGodEl) {
        var recData = {};
        try { recData = JSON.parse(document.getElementById('etRecData').textContent); } catch(e) {}
        recGrid.innerHTML = '';

        var recKey = missingElements.length > 0 ? missingElements[0] : (usefulGodEl || 'Wood');
        var items = recData[recKey] ? recData[recKey] : recData.Wood;

        items.forEach(function(item, idx) {
          var card = document.createElement('article');
          card.className = 'et-rec-card';
          card.innerHTML =
            '<img src="' + item.image + '" alt="' + item.nameKey + '" loading="lazy" />' +
            '<div class="et-rec-card-body">' +
              '<h4 data-i18n="' + item.nameKey + '">' + t(item.nameKey, item.nameKey) + '</h4>' +
              '<span class="et-rec-price" data-price-usd="' + item.priceUsd + '">$' + item.priceUsd + '</span>' +
              '<button class="btn btn-secondary et-add-cart-btn" style="margin-top:0.5rem;" data-i18n="common.add_cart">Add to Cart</button>' +
            '</div>';
          recGrid.appendChild(card);

          var btn = card.querySelector('.et-add-cart-btn');
          if (btn) {
            btn.addEventListener('click', function() {
              if (window.__cart) {
                var productName = t(item.nameKey, item.nameKey);
                window.__cart.addToCart({
                  id: 'rec-' + recKey + '-' + idx,
                  name: productName,
                  price: item.priceUsd,
                  image: item.image
                });
              }
            });
          }
        });

        window.dispatchEvent(new CustomEvent('currency-change', { detail: localStorage.getItem('ov-currency') || 'USD' }));
      }

      /* ---------- Loading animation ---------- */
      function animateLoadingSteps(callback) {
        var step = 0;
        loadingSteps.forEach(function(s){ s.classList.remove('active'); });
        var interval = setInterval(function() {
          if (step > 0) loadingSteps[step-1].classList.remove('active');
          if (step < loadingSteps.length) {
            loadingSteps[step].classList.add('active');
            step++;
          } else {
            clearInterval(interval);
            callback();
          }
        }, 500);
      }

      function applyI18nToResult() {
        var lang = getLang();
        var tl = {};
        var enFallback = {};
        if (window.ovI18n && window.ovI18n.translations) {
          tl = window.ovI18n.translations[lang] || {};
          if (lang !== 'en') {
            enFallback = window.ovI18n.translations['en'] || {};
          }
        }

        document.querySelectorAll('[data-i18n]').forEach(function(el) {
          var key = el.getAttribute('data-i18n');
          var val = tl;
          var parts = key.split('.');
          for (var i = 0; i < parts.length; i++) val = val?.[parts[i]];
          // If not found in current lang, try English fallback
          if ((val === undefined || val === null || val === '') && lang !== 'en') {
            val = enFallback;
            for (var i = 0; i < parts.length; i++) val = val?.[parts[i]];
          }
          if (val !== undefined && val !== null && val !== '') el.textContent = val;
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
          var key = el.getAttribute('data-i18n-placeholder');
          var val = tl;
          var parts = key.split('.');
          for (var i = 0; i < parts.length; i++) val = val?.[parts[i]];
          if ((val === undefined || val === null || val === '') && lang !== 'en') {
            val = enFallback;
            for (var i = 0; i < parts.length; i++) val = val?.[parts[i]];
          }
          if (val !== undefined && val !== null && val !== '') el.setAttribute('placeholder', val);
        });
      }

      /* ---------- Form Submit ---------- */
      function isValidEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();

          if (!emailInput.value.trim() || !isValidEmail(emailInput.value.trim())) {
            emailInput.focus();
            emailInput.style.borderColor = 'var(--color-error)';
            setTimeout(function() { emailInput.style.borderColor = ''; }, 1500);
            return;
          }

          var year  = parseInt(birthYearSelect.value, 10);
          var month = parseInt(birthMonthSelect.value, 10);
          var day   = parseInt(birthDaySelect.value, 10);
          if (!year || !month || !day) return;

          var hourKey = birthtimeSelect.value;
          var gender = document.querySelector('input[name="gender"]:checked')?.value || 'male';

          loadingEl.classList.add('show');

          setTimeout(function () {
            animateLoadingSteps(function() {
              loadingEl.classList.remove('show');

              var yearP = getYearPillar(year);
              var monthP = getMonthPillar(year, month);
              var dayP = getDayPillar(year, month, day);
              var result = computeDistributionAndGods(year, month, day, hourKey);
              var dist = result.dist;
              var godsCount = result.godsCount;
              var dmStem = result.dmStem;
              var dmEl = result.dmEl;
              var dmYy = result.dmYy;

              var maxPct = -1, dominant = 'Wood';
              var missingElements = [];
              ELEMENTS.forEach(function(el) {
                if (dist[el] > maxPct) { maxPct = dist[el]; dominant = el; }
                if (dist[el] === 0) missingElements.push(el);
              });
              ELEMENTS.forEach(function(el) {
                if (dist[el] > 0 && dist[el] <= 5 && missingElements.indexOf(el) === -1) {
                  missingElements.push(el);
                }
              });

              var usefulGods = findUsefulGods(dist, dmEl);

              /* Build all sections */
              buildBirthInfo(year, month, day, hourKey, gender);
              buildDayMaster(dmStem, dmEl, dmYy);
              buildBaZi(year, month, day, hourKey, dmStem);
              buildDonut(dist);
              buildLegend(dist);
              buildStrength(dist, dmEl);
              buildUsefulGods(usefulGods);
              buildTenGods(godsCount);
              buildWealth(dmEl, dist, godsCount);
              buildCareer(dmEl, dist, godsCount);
              buildRelationship(gender, dmEl, dist, godsCount);
              buildHealth(dist);
              buildLuck(dominant, dmEl);
              buildDaYun(year, month, day, gender, yearP, monthP);
              buildDetails(dist);
              buildMissing(missingElements);
              buildRecommendations(missingElements, usefulGods.useful);

              /* Donut center label */
              donutCenter.innerHTML = '<span data-i18n="test.element_' + dominant.toLowerCase() + '">' + t('test.element_' + dominant.toLowerCase(), dominant) + '</span>';

              resultSec.classList.add('show');
              resultSec.style.display = 'block';

              setTimeout(function() {
                resultSec.querySelectorAll('.fade-in').forEach(function(el) {
                  el.classList.add('visible');
                });
                applyI18nToResult();
              }, 50);

              /* Check if user is logged in - registered users get free report */
              var isLoggedIn = !!(window.ovAuth && window.ovAuth.isLoggedIn());
              var isMember = window.ovAuth && window.ovAuth.isMember();
              var hasPaid = localStorage.getItem('ov-test-paid') === 'true';

              if (isLoggedIn || hasPaid) {
                /* Full report - logged in users get free, members get premium */
                showFullReport();
                var consultUpgrade = document.getElementById('etConsultUpgrade');
                if (consultUpgrade) consultUpgrade.style.display = 'block';
                setTimeout(showModal, 1000);
              } else {
                /* Guest - show preview + paywall */
                showPaywall();
              }

              resultSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }, 2000);
        });
      }

      /* ---------- Download / Share / Save / Retake ---------- */
      var downloadBtn = document.getElementById('etDownloadBtn');
      var shareBtn = document.getElementById('etShareBtn');

      function generateReportText() {
        var name = document.getElementById('formName').value || 'User';
        var year = document.getElementById('formBirthYear').value;
        var month = document.getElementById('formBirthMonth').value;
        var day = document.getElementById('formBirthDay').value;
        var hourKey = document.getElementById('formBirthtime').value;
        var gender = document.querySelector('input[name="gender"]:checked')?.value || 'male';
        var dmStem = document.getElementById('etDayMasterStem').textContent;
        var dmEl = document.getElementById('etDayMasterEl').textContent;
        var dmYy = document.getElementById('etDayMasterYy').textContent;
        var dominant = document.getElementById('etDonutCenter')?.textContent || '';

        var lines = [];
        lines.push('========================================');
        lines.push('  FIVE ELEMENTS PERSONAL REPORT');
        lines.push('  Based on BaZi Astrology');
        lines.push('========================================');
        lines.push('');
        lines.push('Personal Information');
        lines.push('  Name: ' + name);
        lines.push('  Gender: ' + (gender === 'female' ? 'Female' : 'Male'));
        lines.push('  Birth Date: ' + year + '-' + String(month).padStart(2,'0') + '-' + String(day).padStart(2,'0'));
        if (hourKey) {
          var hourText = t('test.hour_' + hourKey, hourKey);
          lines.push('  Birth Time: ' + hourText);
        }
        lines.push('  Generated: ' + new Date().toLocaleString());
        lines.push('');
        lines.push('----------------------------------------');
        lines.push('Day Master');
        lines.push('----------------------------------------');
        lines.push('  ' + dmStem + '  (' + dmEl + ' / ' + dmYy + ')');
        var desc = document.getElementById('etDayMasterDesc')?.textContent || '';
        if (desc) lines.push('  ' + desc);
        lines.push('');
        lines.push('----------------------------------------');
        lines.push('Dominant Element: ' + dominant);
        lines.push('----------------------------------------');
        lines.push('');
        lines.push('Five Elements Distribution:');
        var legendItems = document.querySelectorAll('.et-legend-item');
        legendItems.forEach(function(item) {
          var name = item.querySelector('.et-legend-name')?.textContent || '';
          var pct = item.querySelector('.et-legend-pct')?.textContent || '';
          if (name && pct) lines.push('  ' + name + ': ' + pct);
        });
        lines.push('');
        lines.push('----------------------------------------');
        lines.push('Report from Oriental Vibe');
        lines.push('========================================');
        return lines.join('\n');
      }

      if (downloadBtn) {
        downloadBtn.addEventListener('click', function() {
          try {
            var reportText = generateReportText();
            var name = document.getElementById('formName').value || 'report';
            var blob = new Blob([reportText], { type: 'text/plain;charset=utf-8' });
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.href = url;
            link.download = 'five-elements-report-' + name.toLowerCase().replace(/\s+/g, '-') + '.txt';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
            showToast(t('test.report_downloaded', 'Report downloaded successfully'));
          } catch(e) {
            showToast(t('test.download_failed', 'Download failed, please try again'));
          }
        });
      }

      if (shareBtn) {
        shareBtn.addEventListener('click', function() {
          var name = document.getElementById('formName').value || 'My';
          var dmEl = document.getElementById('etDayMasterEl')?.textContent || '';
          var dominant = document.getElementById('etDonutCenter')?.textContent || '';
          var shareText = name + '\'s Five Elements Report: Day Master is ' + dmEl + ', Dominant element is ' + dominant + '. Check yours at ' + window.location.href;

          if (navigator.share) {
            navigator.share({
              title: 'My Five Elements Report',
              text: shareText,
              url: window.location.href
            }).catch(function() {});
          } else {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(shareText).then(function() {
                showToast(t('test.link_copied', 'Link copied to clipboard!'));
              }).catch(function() {
                prompt(t('test.share_prompt', 'Copy this link to share:'));
              });
            } else {
              prompt(t('test.share_prompt', 'Copy this link to share:'), window.location.href);
            }
          }
        });
      }

      if (saveBtn) {
        saveBtn.addEventListener('click', function() {
          try {
            localStorage.setItem('ov-elements-result', resultSec.innerHTML);
            localStorage.setItem('ov-elements-result-date', new Date().toISOString());
            showToast(t('test.result_saved', 'Result saved locally'));
          } catch(e) {}
        });
      }
      if (retakeBtn) {
        retakeBtn.addEventListener('click', function() {
          resultSec.classList.remove('show');
          resultSec.style.display = 'none';
          form.reset();
          updateDayOptions();
          goToStep(1);
          document.querySelector('.et-hero').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      /* ---------- Toast ---------- */
      function showToast(msg) {
        var existing = document.querySelector('.et-toast');
        if (existing) existing.remove();
        var toast = document.createElement('div');
        toast.className = 'et-toast';
        toast.style.cssText = 'position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);background:var(--color-accent-dark);color:#fff;padding:0.875rem 1.5rem;border-radius:var(--radius-sm);box-shadow:var(--shadow-md);z-index:9999;font-size:0.9rem;opacity:0;transition:opacity 0.3s ease;';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function(){ toast.style.opacity = '1'; }, 10);
        setTimeout(function(){ toast.style.opacity = '0'; setTimeout(function(){ toast.remove(); }, 300); }, 2500);
      }

      /* ---------- Paywall / Payment ---------- */
      var paywallEl = document.getElementById('etPaywall');
      var payBtn = document.getElementById('etPayBtn');
      var payModal = document.getElementById('etPayModal');
      var payModalClose = document.getElementById('etPayModalClose');
      var payConfirm = document.getElementById('etPayConfirm');
      var consultUpgradeEl = document.getElementById('etConsultUpgrade');

      // Sections to blur behind paywall (everything after Day Master)
      var paywallSections = [
        'etWealth', 'etCareer', 'etRelationship', 'etHealth',
        'etLuck', 'etDaYun', 'etDetails', 'etMissing', 'etRecGrid',
        'etReportActions'
      ];

      function showPaywall() {
        // Blur all detailed sections
        paywallSections.forEach(function(id) {
          var el = document.getElementById(id);
          if (el) el.classList.add('et-paywall-blur');
        });
        // Show paywall lock
        if (paywallEl) paywallEl.style.display = 'block';
        // Hide consultation upgrade
        if (consultUpgradeEl) consultUpgradeEl.style.display = 'none';
      }

      function showFullReport() {
        // Remove blur from all sections
        paywallSections.forEach(function(id) {
          var el = document.getElementById(id);
          if (el) el.classList.remove('et-paywall-blur');
        });
        // Hide paywall lock
        if (paywallEl) paywallEl.style.display = 'none';
        // Show consultation upgrade
        if (consultUpgradeEl) consultUpgradeEl.style.display = 'block';
        // Show email sent toast
        var emailToast = document.getElementById('etEmailToast');
        if (emailToast) {
          setTimeout(function() { emailToast.classList.add('show'); }, 800);
          setTimeout(function() { emailToast.classList.remove('show'); }, 7000);
        }
      }

      // Email toast close button
      var emailToastClose = document.getElementById('etEmailToastClose');
      if (emailToastClose) {
        emailToastClose.addEventListener('click', function() {
          var et = document.getElementById('etEmailToast');
          if (et) et.classList.remove('show');
        });
      }

      // Pay button - open payment modal
      if (payBtn) {
        payBtn.addEventListener('click', function() {
          if (payModal) { payModal.classList.add('active'); }
        });
      }

      // Member unlock - inline form toggle
      const memberToggle = document.getElementById('etMemberToggle');
      const memberForm = document.getElementById('etMemberForm');
      const memberUnlockBtn = document.getElementById('etMemberUnlockBtn');
      if (memberToggle && memberForm) {
        memberToggle.addEventListener('click', function() {
          memberForm.classList.toggle('show');
        });
      }
      if (memberUnlockBtn) {
        memberUnlockBtn.addEventListener('click', function() {
          const memEmail = document.getElementById('etMemberEmail')?.value.trim();
          const memCode = document.getElementById('etMemberCode')?.value.trim();
          if (!memEmail || !memCode) {
            alert('Please enter your membership email and code.');
            return;
          }
          if (!memEmail.includes('@')) {
            alert('Please enter a valid email address.');
            return;
          }
          // Use auth system to set user with membership tier
          if (window.ovAuth) {
            window.ovAuth.setUser({
              name: memEmail.split('@')[0],
              email: memEmail,
              tier: 'starter',
              registeredAt: new Date().toISOString(),
            });
          } else {
            localStorage.setItem('ov-is-member', 'true');
            localStorage.setItem('ov-test-paid', 'true');
          }
          showFullReport();
          memberForm.classList.remove('show');
        });
      }

      // Payment modal close
      if (payModalClose && payModal) {
        payModalClose.addEventListener('click', function() {
          payModal.classList.remove('active');
        });
        payModal.addEventListener('click', function(e) {
          if (e.target === payModal) payModal.classList.remove('active');
        });
      }

      // Payment confirm
      if (payConfirm) {
        payConfirm.addEventListener('click', function() {
          var cardNumber = (document.getElementById('payCardNumber') || {}).value || '';
          var expiry = (document.getElementById('payExpiry') || {}).value || '';
          var cvc = (document.getElementById('payCvc') || {}).value || '';

          if (!cardNumber || cardNumber.length < 13) {
            alert('Please enter a valid card number.');
            return;
          }
          if (!expiry || expiry.length < 4) {
            alert('Please enter a valid expiry date.');
            return;
          }
          if (!cvc || cvc.length < 3) {
            alert('Please enter a valid CVC.');
            return;
          }

          // Simulate payment processing
          payConfirm.textContent = 'Processing...';
          payConfirm.disabled = true;

          setTimeout(function() {
            localStorage.setItem('ov-test-paid', 'true');
            payModal.classList.remove('active');
            showFullReport();
            payConfirm.textContent = 'Pay $9.99';
            payConfirm.disabled = false;
          }, 1500);
        });
      }

      // Card number formatting
      var cardInput = document.getElementById('payCardNumber');
      if (cardInput) {
        cardInput.addEventListener('input', function(e) {
          var val = e.target.value.replace(/\s/g, '').replace(/[^\d]/g, '');
          var formatted = val.replace(/(\d{4})(?=\d)/g, '$1 ');
          e.target.value = formatted.substring(0, 19);
        });
      }

      // Expiry formatting
      var expiryInput = document.getElementById('payExpiry');
      if (expiryInput) {
        expiryInput.addEventListener('input', function(e) {
          var val = e.target.value.replace(/[^\d]/g, '');
          if (val.length >= 2) {
            val = val.substring(0, 2) + '/' + val.substring(2, 4);
          }
          e.target.value = val.substring(0, 5);
        });
      }

      /* ---------- Modal ---------- */
      function showModal() {
        modal.style.display = 'flex';
        modal.setAttribute('aria-hidden', 'false');
      }
      function hideModal() {
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
      }
      if (modalClose) modalClose.addEventListener('click', hideModal);
      if (modal) {
        modal.addEventListener('click', function (e) { if (e.target === modal) hideModal(); });
      }
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hideModal(); });

      /* ---------- Language change ---------- */
      function onLangChange() {
        var lang = getLang();
        // Use BaseLayout's translations if already loaded
        if (window.ovI18n && window.ovI18n.translations && window.ovI18n.translations[lang]) {
          _cache[lang] = window.ovI18n.translations[lang];
          applyI18nToResult();
        } else {
          // Fetch translations directly as fallback
          fetch('/i18n/' + lang + '.json')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              _cache[lang] = data;
              applyI18nToResult();
            })
            .catch(function() {});
        }
        if (stepNameEl) {
          var labelKey = stepNameKeys[currentStep - 1] || '';
          stepNameEl.setAttribute('data-i18n', labelKey);
          stepNameEl.textContent = t(labelKey, labelKey);
        }
      }
      // Only listen for ov-i18n-ready (BaseLayout dispatches this after translations are loaded)
      document.addEventListener('ov-i18n-ready', onLangChange);

      // Initial load: if BaseLayout already initialized, apply now
      if (window.ovI18n && window.ovI18n.translations) {
        onLangChange();
      } else {
        // Wait for BaseLayout to finish initializing
        document.addEventListener('ov-i18n-ready', function initOnce() {
          document.removeEventListener('ov-i18n-ready', initOnce);
          onLangChange();
        });
      }
    })();
  </script>
