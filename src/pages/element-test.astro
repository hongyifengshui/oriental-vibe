  <script is:inline>
    (function () {
      /* ---------- Constants ---------- */
      var ELEMENTS = ['Wood','Fire','Earth','Metal','Water'];
      var EL_COLORS = { Wood:'#6B9B6B', Fire:'#C45A5A', Earth:'#C4A75A', Metal:'#8A948C', Water:'#5A7A8A' };
      var EL_ICONS  = { Wood:'\u6728', Fire:'\u706B', Earth:'\u571F', Metal:'\u91D1', Water:'\u6C34' };

      /* Tiangan (Heavenly Stems) */
      var TIANGAN = ['Jia','Yi','Bing','Ding','Wu','Ji','Geng','Xin','Ren','Gui'];
      var TIANGAN_CN = { Jia:'\u7532',Yi:'\u4E59',Bing:'\u4E19',Ding:'\u4E01',Wu:'\u620A',Ji:'\u5DF1',Geng:'\u5E9A',Xin:'\u8F9B',Ren:'\u58EC',Gui:'\u7678' };
      var TIANGAN_ELEMENT = { Jia:'Wood',Yi:'Wood',Bing:'Fire',Ding:'Fire',Wu:'Earth',Ji:'Earth',Geng:'Metal',Xin:'Metal',Ren:'Water',Gui:'Water' };
      var TIANGAN_YINYANG = { Jia:'yang',Yi:'yin',Bing:'yang',Ding:'yin',Wu:'yang',Ji:'yin',Geng:'yang',Xin:'yin',Ren:'yang',Gui:'yin' };

      /* Dizhi (Earthly Branches) */
      var DIZHI = ['Zi','Chou','Yin','Mao','Chen','Si','Wu','Wei','Shen','You','Xu','Hai'];
      var DIZHI_CN = { Zi:'\u5B50',Chou:'\u4E11',Yin:'\u5BC5',Mao:'\u536F',Chen:'\u8FB0',Si:'\u5DF3',Wu:'\u5348',Wei:'\u672A',Shen:'\u7533',You:'\u9149',Xu:'\u620C',Hai:'\u4EA5' };
      var DIZHI_ELEMENT = { Zi:'Water',Chou:'Earth',Yin:'Wood',Mao:'Wood',Chen:'Earth',Si:'Fire',Wu:'Fire',Wei:'Earth',Shen:'Metal',You:'Metal',Xu:'Earth',Hai:'Water' };
      var DIZHI_HIDDEN = {
        Zi: ['Gui'],
        Chou: ['Ji','Gui','Xin'],
        Yin: ['Jia','Bing','Wu'],
        Mao: ['Yi'],
        Chen: ['Wu','Yi','Gui'],
        Si: ['Bing','Wu','Geng'],
        Wu: ['Ding','Ji'],
        Wei: ['Ji','Ding','Yi'],
        Shen: ['Geng','Ren','Wu'],
        You: ['Xin'],
        Xu: ['Wu','Xin','Ding'],
        Hai: ['Ren','Jia']
      };

      /* Zodiac */
      var ZODIAC = ['Rat','Ox','Tiger','Rabbit','Dragon','Snake','Horse','Goat','Monkey','Rooster','Dog','Pig'];
      var ZODIAC_KEYS = ['rat','ox','tiger','rabbit','dragon','snake','horse','goat','monkey','rooster','dog','pig'];

      /* Hour branch */
      var HOUR_BRANCH = { zi:'Zi',chou:'Chou',yin:'Yin',mao:'Mao',chen:'Chen',si:'Si',wu:'Wu',wei:'Wei',shen:'Shen',you:'You',xu:'Xu',hai:'Hai' };

      /* Ten Gods: mapping from element relation + yinyang to god name
         Key: relation = 'self'|'same'|'output'|'wealth'|'power'|'resource' + yinyang match (same/diff) */
      var TEN_GODS = {
        same_same: 'god_bi_jian',     /* 比肩 Bi Jian: same element, same yin/yang */
        same_diff: 'god_jie_cai',     /* 劫财 Jie Cai: same element, diff yin/yang */
        output_same: 'god_shi_shen',  /* 食神 Shi Shen: element produces you, same yy = Eating God */
        output_diff: 'god_shang_guan', /* 伤官 Shang Guan: element produces you, diff yy = Hurting Officer */
        wealth_same: 'god_pian_cai',  /* 偏财 Pian Cai: you produce element, same yy = Indirect Wealth */
        wealth_diff: 'god_zheng_cai', /* 正财 Zheng Cai: you produce element, diff yy = Direct Wealth */
        power_same: 'god_qi_sha',     /* 七杀 Qi Sha: element controls you, same yy = Seven Killings */
        power_diff: 'god_zheng_guan', /* 正官 Zheng Guan: element controls you, diff yy = Direct Officer */
        resource_same: 'god_pian_yin', /* 偏印 Pian Yin: element produces you, same yy = Indirect Resource */
        resource_diff: 'god_zheng_yin' /* 正印 Zheng Yin: element produces you, diff yy = Direct Resource */
      };

      var GOD_CATEGORIES = [
        { key: 'god_friend', gods: ['god_bi_jian','god_jie_cai'], rel: 'same' },
        { key: 'god_output', gods: ['god_shi_shen','god_shang_guan'], rel: 'output' },
        { key: 'god_wealth', gods: ['god_pian_cai','god_zheng_cai'], rel: 'wealth' },
        { key: 'god_power', gods: ['god_qi_sha','god_zheng_guan'], rel: 'power' },
        { key: 'god_resource', gods: ['god_pian_yin','god_zheng_yin'], rel: 'resource' }
      ];

      /* Element relationship: what is el relative to dayMasterEl?
         Returns: 'self', 'same' (sibling), 'output' (you produce it = wealth/your output),
         'wealth' (you produce it), 'power' (it controls you), 'resource' (it produces you) */
      function getElementRelation(dayMasterEl, el) {
        if (dayMasterEl === el) return 'same';
        var genOrder = ['Wood','Fire','Earth','Metal','Water'];
        var dmIdx = genOrder.indexOf(dayMasterEl);
        var elIdx = genOrder.indexOf(el);
        var diff = (elIdx - dmIdx + 5) % 5;
        if (diff === 1) return 'output';
        if (diff === 2) return 'wealth';
        if (diff === 3) return 'power';
        if (diff === 4) return 'resource';
        return 'same';
      }

      /* ---------- i18n helpers ---------- */
      var _cache = {};
      function getLang() { return localStorage.getItem('ov-lang') || 'en'; }
      function loadT(cb) {
        if (window.ovI18n) {
          _cache[getLang()] = window.ovI18n.translations[getLang()] || {};
          if (cb) cb(_cache[getLang()]);
          return;
        }
        var lang = getLang();
        if (_cache[lang]) { cb(_cache[lang]); return; }
        fetch('/i18n/' + lang + '.json').then(function(r){return r.json();}).then(function(tr){ _cache[lang]=tr; cb(tr); }).catch(function(){ cb({}); });
      }
      function t(key, fb) {
        if (window.ovI18n) return window.ovI18n.t(key, fb);
        var parts = key.split('.');
        var v = _cache[getLang()];
        if (!v) return fb || key;
        for (var i=0;i<parts.length;i++) v = v?.[parts[i]];
        return v || fb || key;
      }

      /* ---------- Pillar Calculation ---------- */
      function getYearPillar(year) {
        var stemIdx  = ((year - 4) % 10 + 10) % 10;
        var branchIdx = ((year - 4) % 12 + 12) % 12;
        return { stem: TIANGAN[stemIdx], branch: DIZHI[branchIdx], stemIdx: stemIdx, branchIdx: branchIdx };
      }
      function getMonthPillar(year, month) {
        var yearPillar = getYearPillar(year);
        var branchIdx = (month + 1) % 12;
        var yearStemIdx = yearPillar.stemIdx;
        var monthStemStartIdx = (yearStemIdx % 5) * 2;
        var stemIdx = (monthStemStartIdx + month - 1) % 10;
        return { stem: TIANGAN[stemIdx], branch: DIZHI[branchIdx] };
      }
      function getDayPillar(year, month, day) {
        var date = new Date(year, month - 1, day);
        var jd = Math.floor(date.getTime() / 86400000);
        var stemIdx = ((jd - 1) % 10 + 10) % 10;
        var branchIdx = ((jd - 1) % 12 + 12) % 12;
        return { stem: TIANGAN[stemIdx], branch: DIZHI[branchIdx], stemIdx: stemIdx, branchIdx: branchIdx };
      }
      function getHourPillar(hourKey, dayStemIdx) {
        if (!hourKey || !HOUR_BRANCH[hourKey]) return null;
        var branchName = HOUR_BRANCH[hourKey];
        var branchIdx = DIZHI.indexOf(branchName);
        var hourStemStartIdx = (dayStemIdx % 5) * 2;
        var stemIdx = (hourStemStartIdx + branchIdx) % 10;
        return { stem: TIANGAN[stemIdx], branch: branchName };
      }

      /* Ten God for a stem relative to day master */
      function getTenGod(dayMasterStem, targetStem) {
        var dmEl = TIANGAN_ELEMENT[dayMasterStem];
        var dmYy = TIANGAN_YINYANG[dayMasterStem];
        var tgEl = TIANGAN_ELEMENT[targetStem];
        var tgYy = TIANGAN_YINYANG[targetStem];
        if (dmEl === tgEl) {
          return dmYy === tgYy ? TEN_GODS['same_same'] : TEN_GODS['same_diff'];
        }
        var rel = getElementRelation(dmEl, tgEl);
        var yyKey = dmYy === tgYy ? 'same' : 'diff';
        return TEN_GODS[rel + '_' + yyKey] || 'god_bi_jian';
      }

      /* ---------- Distribution + Ten Gods ---------- */
      function computeDistributionAndGods(year, month, day, hourKey) {
        var yearP = getYearPillar(year);
        var monthP = getMonthPillar(year, month);
        var dayP = getDayPillar(year, month, day);
        var hourP = hourKey ? getHourPillar(hourKey, dayP.stemIdx) : null;

        var dmStem = dayP.stem;
        var dmEl = TIANGAN_ELEMENT[dmStem];
        var dmYy = TIANGAN_YINYANG[dmStem];

        var dist = { Wood:0, Fire:0, Earth:0, Metal:0, Water:0 };
        var godsCount = {};
        GOD_CATEGORIES.forEach(function(c) { c.gods.forEach(function(g){ godsCount[g]=0; }); });

        function addStem(stem, weight) {
          var el = TIANGAN_ELEMENT[stem];
          dist[el] += weight;
          if (stem !== dmStem) {
            var god = getTenGod(dmStem, stem);
            godsCount[god] = (godsCount[god] || 0) + weight;
          }
        }
        function addBranch(branch, weight) {
          var el = DIZHI_ELEMENT[branch];
          dist[el] += weight;
          /* hidden stems contribute partially */
          var hidden = DIZHI_HIDDEN[branch] || [];
          hidden.forEach(function(hs, i) {
            var hw = weight * (i === 0 ? 0.5 : 0.15);
            var hel = TIANGAN_ELEMENT[hs];
            dist[hel] += hw;
            if (hs !== dmStem) {
              var god = getTenGod(dmStem, hs);
              godsCount[god] = (godsCount[god] || 0) + hw;
            }
          });
        }

        addStem(yearP.stem, 20);
        addBranch(yearP.branch, 8);
        addStem(monthP.stem, 15);
        addBranch(monthP.branch, 18);
        addStem(dayP.stem, 25);
        addBranch(dayP.branch, 8);
        if (hourP) {
          addStem(hourP.stem, 8);
          addBranch(hourP.branch, 6);
        }

        var total = 0;
        ELEMENTS.forEach(function(e){ total += dist[e]; });
        if (total > 0) {
          ELEMENTS.forEach(function(e){ dist[e] = Math.round(dist[e] / total * 100); });
        }
        var sum = 0;
        ELEMENTS.forEach(function(e){ sum += dist[e]; });
        if (sum !== 100) {
          var maxEl = ELEMENTS[0];
          ELEMENTS.forEach(function(e){ if (dist[e] > dist[maxEl]) maxEl = e; });
          dist[maxEl] += (100 - sum);
        }

        return { dist: dist, godsCount: godsCount, dmStem: dmStem, dmEl: dmEl, dmYy: dmYy };
      }

      /* ---------- Useful Gods ---------- */
      function findUsefulGods(dist, dmEl) {
        var dmPct = dist[dmEl];
        var sorted = ELEMENTS.slice().sort(function(a,b){ return dist[b] - dist[a]; });
        var genOrder = ['Wood','Fire','Earth','Metal','Water'];
        var dmIdx = genOrder.indexOf(dmEl);
        var resourceEl = genOrder[(dmIdx + 4) % 5];
        var outputEl = genOrder[(dmIdx + 1) % 5];

        var useful, happy, avoid;
        if (dmPct >= 35) {
          /* Strong Day Master: favor output (self-expression) and wealth */
          useful = outputEl;
          happy = genOrder[(dmIdx + 2) % 5];
          avoid = resourceEl;
        } else if (dmPct <= 20) {
          /* Weak Day Master: favor resource and same element */
          useful = resourceEl;
          happy = dmEl;
          avoid = genOrder[(dmIdx + 3) % 5]; /* power/control is worst */
        } else {
          /* Balanced: favor output for wealth and growth */
          useful = outputEl;
          happy = resourceEl;
          avoid = sorted[4];
        }
        return { useful: useful, happy: happy, avoid: avoid };
      }

      /* ---------- Da Yun ---------- */
      function getDaYun(year, month, day, gender, yearPillar, monthPillar) {
        var yearStemIdx = yearPillar.stemIdx;
        var isYangYear = yearStemIdx % 2 === 0;
        var isMale = gender === 'male';
        var forward = (isYangYear && isMale) || (!isYangYear && !isMale);

        /* Simple start age: based on day to nearest qi node (approximate) */
        var date = new Date(year, month - 1, day);
        var doy = Math.floor((date - new Date(year, 0, 0)) / 86400000);
        var startAge = (doy % 9) + 1;

        var monthStemIdx = TIANGAN.indexOf(monthPillar.stem);
        var monthBranchIdx = DIZHI.indexOf(monthPillar.branch);
        var pillars = [];
        for (var i = 1; i <= 8; i++) {
          var si, bi;
          if (forward) {
            si = (monthStemIdx + i) % 10;
            bi = (monthBranchIdx + i) % 12;
          } else {
            si = (monthStemIdx - i + 100) % 10;
            bi = (monthBranchIdx - i + 120) % 12;
          }
          pillars.push({
            index: i,
            stem: TIANGAN[si],
            branch: DIZHI[bi],
            startAge: startAge + (i - 1) * 10
          });
        }
        return { forward: forward, startAge: startAge, pillars: pillars };
      }

      /* ---------- DOM refs ---------- */
      var form        = document.getElementById('elementForm');
      var resultSec   = document.getElementById('resultSection');
      var loadingEl   = document.getElementById('etLoading');
      var modal       = document.getElementById('discountModal');
      var modalClose  = document.getElementById('discountClose');
      var donutEl     = document.getElementById('etDonut');
      var donutCenter = document.getElementById('etDonutCenter');
      var legendEl    = document.getElementById('etLegend');
      var detailsEl   = document.getElementById('etDetails');
      var missingSec  = document.getElementById('etMissingSection');
      var missingList = document.getElementById('etMissingList');
      var recGrid     = document.getElementById('etRecGrid');
      var baziGrid    = document.getElementById('etBaziGrid');
      var baziInfo    = document.getElementById('etBaziInfo');
      var saveBtn     = document.getElementById('etSaveBtn');
      var retakeBtn   = document.getElementById('etRetakeBtn');
      var loadingSteps = document.querySelectorAll('.et-loading-step');

      var nameInput     = document.getElementById('formName');
      var birthYearSelect  = document.getElementById('formBirthYear');
      var birthMonthSelect = document.getElementById('formBirthMonth');
      var birthDaySelect   = document.getElementById('formBirthDay');
      var birthtimeSelect = document.getElementById('formBirthtime');
      var emailInput    = document.getElementById('formEmail');
      var step1 = document.getElementById('etStep1');
      var step2 = document.getElementById('etStep2');
      var step3 = document.getElementById('etStep3');
      var progressDots  = document.querySelectorAll('.et-progress-dot');
      var stepNumEl = document.getElementById('etStepNum');
      var stepNameEl = document.getElementById('etStepName');

      var currentStep = 1;
      var stepNameKeys = ['test.step_personal', 'test.step_birth', 'test.step_email'];

      function goToStep(stepNum) {
        if (stepNum < 1 || stepNum > 3) return;
        currentStep = stepNum;

        step1.classList.toggle('active', stepNum === 1);
        step2.classList.toggle('active', stepNum === 2);
        step3.classList.toggle('active', stepNum === 3);

        progressDots.forEach(function(d, i) {
          d.classList.toggle('filled', i < stepNum);
        });

        if (stepNumEl) stepNumEl.textContent = stepNum;
        if (stepNameEl) {
          var labelKey = stepNameKeys[stepNum - 1] || '';
          stepNameEl.setAttribute('data-i18n', labelKey);
          stepNameEl.textContent = t(labelKey, labelKey);
        }

        var firstInput = stepNum === 1 ? nameInput : (stepNum === 2 ? birthYearSelect : emailInput);
        if (firstInput) {
          setTimeout(function() { firstInput.focus(); }, 300);
        }
      }

      function isLeapYear(year) {
        return (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
      }

      function getDaysInMonth(year, month) {
        var days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
        if (month === 2 && isLeapYear(year)) return 29;
        return days[month - 1];
      }

      function populateYearOptions() {
        var currentYear = new Date().getFullYear();
        var startYear = 1920;
        var endYear = currentYear + 1;
        for (var y = endYear; y >= startYear; y--) {
          var opt = document.createElement('option');
          opt.value = y;
          opt.textContent = y;
          birthYearSelect.appendChild(opt);
        }
      }

      function updateDayOptions() {
        var year = parseInt(birthYearSelect.value, 10);
        var month = parseInt(birthMonthSelect.value, 10);
        var currentDay = birthDaySelect.value;

        birthDaySelect.innerHTML = '';
        var defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.setAttribute('data-i18n', 'test.form_day');
        defaultOpt.textContent = t('test.form_day', 'Day');
        birthDaySelect.appendChild(defaultOpt);

        if (year && month) {
          var daysInMonth = getDaysInMonth(year, month);
          for (var d = 1; d <= daysInMonth; d++) {
            var opt = document.createElement('option');
            opt.value = d;
            opt.textContent = d;
            birthDaySelect.appendChild(opt);
          }
          if (currentDay && parseInt(currentDay, 10) <= daysInMonth) {
            birthDaySelect.value = currentDay;
          }
        }
      }

      function isBirthdateComplete() {
        return birthYearSelect.value && birthMonthSelect.value && birthDaySelect.value;
      }

