      function buildTenGods(godsCount) {
        var catsWrap = document.getElementById('etTenGodsCats');
        var detailTitle = document.getElementById('etGodDetailTitle');
        var detailDesc = document.getElementById('etGodDetailDesc');

        catsWrap.innerHTML = '';
        var firstCat = null;
        GOD_CATEGORIES.forEach(function(cat) {
          var total = 0;
          cat.gods.forEach(function(g){ total += godsCount[g] || 0; });
          if (!firstCat && total > 0) firstCat = cat;
          var catEl = document.createElement('div');
          catEl.className = 'et-god-cat';
          catEl.innerHTML =
            '<div class="et-god-cat-name" data-i18n="' + cat.key + '">' + t(cat.key, cat.key) + '</div>' +
            '<div class="et-god-cat-sub">' + total.toFixed(0) + ' pts</div>';
          catEl.addEventListener('click', function() {
            document.querySelectorAll('.et-god-cat').forEach(function(c){ c.classList.remove('active'); });
            catEl.classList.add('active');
            var mainGod = cat.gods[0];
            detailTitle.textContent = t(cat.key, cat.key);
            detailDesc.textContent = t(mainGod + '_desc', '');
          });
          catsWrap.appendChild(catEl);
        });

        if (firstCat) {
          var firstCard = catsWrap.querySelector('.et-god-cat');
          if (firstCard) firstCard.classList.add('active');
          detailTitle.textContent = t(firstCat.key, firstCat.key);
          detailDesc.textContent = t(firstCat.gods[0] + '_desc', '');
        }
      }

      function buildWealth(dmEl, dist, godsCount) {
        var zhengCai = godsCount['god_zheng_cai'] || 0;
        var pianCai = godsCount['god_pian_cai'] || 0;
        var totalWealth = zhengCai + pianCai;
        var shiShen = godsCount['god_shi_shen'] || 0;
        var shangGuan = godsCount['god_shang_guan'] || 0;

        var type, typeKey;
        if (zhengCai > pianCai * 1.5) { type = 'stable'; typeKey = 'test.wealth_stable'; }
        else if (pianCai > zhengCai * 1.5) { type = 'side'; typeKey = 'test.wealth_side'; }
        else if (totalWealth > 10) { type = 'mixed'; typeKey = 'test.wealth_mixed'; }
        else { type = 'weak'; typeKey = 'test.wealth_weak'; }

        var dmPct = dist[dmEl];
        var score = Math.min(100, Math.round(totalWealth * 2 + 30));

        var grid = document.getElementById('etWealthGrid');
        grid.innerHTML =
          '<div class="et-grid-card"><div class="et-grid-card-label" data-i18n="test.wealth_strength">Wealth Index</div><div class="et-grid-card-value">' + score + '/100</div></div>' +
          '<div class="et-grid-card"><div class="et-grid-card-label" data-i18n="test.wealth_type">Wealth Pattern</div><div class="et-grid-card-value" data-i18n="' + typeKey + '">' + t(typeKey, '') + '</div></div>' +
          '<div class="et-grid-card"><div class="et-grid-card-label"><span data-i18n="test.god_zheng_cai">Zheng Cai</span> / <span data-i18n="test.god_pian_cai">Pian Cai</span></div><div class="et-grid-card-value">' + zhengCai.toFixed(0) + ' / ' + pianCai.toFixed(0) + '</div></div>';

        var tips = document.getElementById('etWealthTips');
        tips.innerHTML = '';
        var tipItems = [];
        if (zhengCai > pianCai) tipItems.push('wealth_tip_1');
        if (pianCai > zhengCai) tipItems.push('wealth_tip_2');
        if (shiShen + shangGuan > totalWealth && totalWealth < 15) tipItems.push('wealth_tip_3');
        if (dmPct < 22 && totalWealth > 15) tipItems.push('wealth_tip_4');
        if (tipItems.length === 0) tipItems.push('wealth_tip_1');

        tipItems.forEach(function(tk) {
          var item = document.createElement('div');
          item.className = 'et-analysis-item';
          item.innerHTML =
            '<div class="et-analysis-bullet" style="background:' + EL_COLORS['Earth'] + '">$</div>' +
            '<span data-i18n="test.' + tk + '">' + t('test.' + tk, '') + '</span>';
          tips.appendChild(item);
        });
      }

      function buildCareer(dmEl, dist, godsCount) {
        var official = (godsCount['god_zheng_guan'] || 0) + (godsCount['god_qi_sha'] || 0);
        var output = (godsCount['god_shi_shen'] || 0) + (godsCount['god_shang_guan'] || 0);
        var wealth = (godsCount['god_zheng_cai'] || 0) + (godsCount['god_pian_cai'] || 0);
        var resource = (godsCount['god_zheng_yin'] || 0) + (godsCount['god_pian_yin'] || 0);
        var friend = (godsCount['god_bi_jian'] || 0) + (godsCount['god_jie_cai'] || 0);

        var maxVal = Math.max(official, output, wealth, resource, friend);
        var styleKey;
        if (official === maxVal) styleKey = 'test.career_style_official';
        else if (output === maxVal) styleKey = 'test.career_style_output';
        else if (wealth === maxVal) styleKey = 'test.career_style_wealth';
        else if (resource === maxVal) styleKey = 'test.career_style_resource';
        else styleKey = 'test.career_style_friend';

        var careerDirKey = 'test.element_' + dmEl.toLowerCase() + '_career';
        var grid = document.getElementById('etCareerGrid');
        grid.innerHTML =
          '<div class="et-grid-card"><div class="et-grid-card-label" data-i18n="test.career_style">Work Style</div><div class="et-grid-card-value" data-i18n="' + styleKey + '">' + t(styleKey, '') + '</div></div>' +
          '<div class="et-grid-card"><div class="et-grid-card-label" data-i18n="test.career_direction">Career Direction</div><div class="et-grid-card-value" data-i18n="' + careerDirKey + '">' + t(careerDirKey, '') + '</div></div>' +
          '<div class="et-grid-card"><div class="et-grid-card-label" data-i18n="test.ten_gods_title">Ten Gods</div><div class="et-grid-card-value" data-i18n="test.' + (official===maxVal?'god_zheng_guan':output===maxVal?'god_shi_shen':wealth===maxVal?'god_zheng_cai':resource===maxVal?'god_zheng_yin':'god_bi_jian') + '">' + t(official===maxVal?'god_zheng_guan':output===maxVal?'god_shi_shen':wealth===maxVal?'god_zheng_cai':resource===maxVal?'god_zheng_yin':'god_bi_jian','') + '</div></div>';
      }

