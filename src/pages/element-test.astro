    { image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=selenite%20tower%20lamp%20nordic%20glow%20luxury&image_size=square', nameKey: 'test.rec_metal_name', priceUsd: 89 },
    { image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=silver%20singing%20bowl%20meditation%20minimalist&image_size=square', nameKey: 'test.rec_metal_name', priceUsd: 56 }
  ],
  Water: [
    { image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=lapis%20lazuli%20sphere%20deep%20blue%20luxury%20decor&image_size=square', nameKey: 'test.rec_water_name', priceUsd: 72 },
    { image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=black%20obsidian%20mirror%20feng%20shui%20nordic&image_size=square', nameKey: 'test.rec_water_name', priceUsd: 48 },
    { image: 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=aquamarine%20crystal%20point%20calm%20energy&image_size=square', nameKey: 'test.rec_water_name', priceUsd: 65 }
  ]
};
---
<BaseLayout title="Five Elements Test | Oriental Vibe">
  <style is:global>
    /* ===== Element Test Page Styles ===== */
    .et-hero { min-height:100vh; display:flex; align-items:center; justify-content:center; text-align:center; padding:calc(var(--navbar-height) + 4rem) 2rem 4rem; background:linear-gradient(180deg,var(--color-bg-primary) 0%,var(--color-bg-secondary) 100%); position:relative; overflow:hidden; }
    .et-hero::before { content:''; position:absolute; top:20%; left:50%; transform:translateX(-50%); width:600px; height:600px; background:radial-gradient(circle,rgba(191,175,150,0.08) 0%,transparent 70%); border-radius:50%; pointer-events:none; }
    .et-hero-inner { max-width:680px; position:relative; z-index:1; }
    .et-hero-sub { font-size:0.85rem; text-transform:uppercase; letter-spacing:0.15em; color:var(--color-text-tertiary); margin-bottom:1.5rem; font-weight:400; }
    .et-hero-title { margin-bottom:1.5rem; }
    .et-hero-desc { font-size:1.1rem; color:var(--color-text-secondary); margin-bottom:2.5rem; max-width:580px; margin-left:auto; margin-right:auto; line-height:1.8; }

    /* Step form */
    .et-form { display:flex; flex-direction:column; gap:1.5rem; text-align:left; margin-top:2rem; }
    .et-step { opacity:0; transform:translateY(16px); transition:opacity 0.5s ease,transform 0.5s ease; max-height:0; overflow:hidden; }
    .et-step.active { opacity:1; transform:translateY(0); max-height:700px; }
    .et-field-group { text-align:left; }
    .et-field-row { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    .et-birthdate-row { display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.75rem; }
    .et-birthdate-col { position:relative; }
    .et-label { display:block; font-size:0.9rem; margin-bottom:0.5rem; color:var(--color-text-primary); font-weight:400; }
    .et-input, .et-select { width:100%; padding:0.875rem 1.25rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); background:#FFF; font-family:inherit; font-size:0.95rem; color:var(--color-text-primary); transition:var(--transition-base); }
    .et-input:focus, .et-select:focus { outline:none; border-color:var(--color-accent); box-shadow:0 0 0 3px rgba(191,175,150,0.15); }
    .et-progress { display:flex; align-items:center; justify-content:center; margin-bottom:1rem; gap:0; }
    .et-progress-dot { width:12px; height:12px; border-radius:50%; background:var(--color-border); transition:var(--transition-base); flex-shrink:0; position:relative; z-index:1; }
    .et-progress-dot.filled { background:var(--color-accent-dark); box-shadow:0 0 0 4px rgba(191,175,150,0.2); }
    .et-progress-line { flex:0 0 40px; height:2px; background:var(--color-border); margin:0 4px; }
    .et-progress-label { font-size:0.8rem; color:var(--color-text-tertiary); text-align:center; margin-top:0.25rem; margin-bottom:2rem; font-weight:500; }

    /* Hero highlights */
    .et-hero-highlights { display:grid; grid-template-columns:repeat(2,1fr); gap:0.75rem; margin-bottom:2rem; max-width:500px; margin-left:auto; margin-right:auto; }
    .et-hero-highlight-item { display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:var(--color-text-secondary); }
    .et-hero-highlight-icon { color:var(--color-accent-dark); font-size:1rem; }

    /* Step titles */
    .et-step-title { font-family:var(--font-serif); font-size:1.35rem; font-weight:500; color:var(--color-text-primary); margin-bottom:0.25rem; }
    .et-step-desc { font-size:0.9rem; color:var(--color-text-secondary); margin-bottom:1.25rem; }
    .et-step-actions { display:flex; gap:0.75rem; justify-content:center; margin-top:1.5rem; flex-wrap:wrap; }
    .et-step-actions .btn { min-width:140px; }

    .et-optional { font-size:0.75rem; color:var(--color-text-tertiary); font-weight:400; margin-left:0.25rem; }
    .et-field-hint { font-size:0.75rem; color:var(--color-text-tertiary); margin-top:0.5rem; line-height:1.5; }

    /* Crystal showcase */
    .et-crystal-showcase { margin:2.5rem 0 1.5rem; text-align:center; }
    .et-crystal-showcase-title { font-family:var(--font-serif); font-size:1.5rem; color:var(--color-text-primary); margin-bottom:0.5rem; }
    .et-crystal-showcase-sub { font-size:0.9rem; color:var(--color-text-secondary); margin-bottom:1.5rem; }
    .et-crystal-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:0.75rem; }
    .et-crystal-card { background:var(--color-bg-card); border:1px solid var(--color-border-light); border-radius:var(--radius-md); padding:1rem 0.75rem; cursor:pointer; transition:var(--transition-base); position:relative; overflow:hidden; }
    .et-crystal-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-sm); border-color:var(--color-accent); }
    .et-crystal-card-img { width:80px; height:80px; margin:0 auto 0.75rem; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--font-serif); font-size:1.8rem; color:#fff; }
    .et-crystal-card-name { font-family:var(--font-serif); font-size:1rem; color:var(--color-text-primary); margin-bottom:0.25rem; }
    .et-crystal-card-el { font-size:0.75rem; color:var(--color-text-tertiary); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.5rem; }
    .et-crystal-card-desc { font-size:0.78rem; color:var(--color-text-secondary); line-height:1.5; }
    .et-crystal-card-btn { margin-top:0.75rem; font-size:0.75rem; padding:0.4rem 0.8rem; border-radius:999px; background:var(--color-accent); color:#fff; border:none; cursor:pointer; transition:var(--transition-base); }
    .et-crystal-card-btn:hover { background:var(--color-accent-dark); }

    /* Trust badges */
    .et-trust-badges { display:flex; gap:2rem; justify-content:center; margin-top:2rem; flex-wrap:wrap; }
    .et-trust-badge { display:flex; align-items:center; gap:0.5rem; font-size:0.8rem; color:var(--color-text-tertiary); }
    .et-trust-badge span:first-child { font-size:1.1rem; }

    /* Gender radio */
    .et-gender-group { display:flex; gap:0.75rem; }
    .et-gender-option { flex:1; position:relative; }
    .et-gender-option input { position:absolute; opacity:0; }
    .et-gender-option label { display:block; padding:0.875rem 1.25rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); background:#FFF; text-align:center; cursor:pointer; transition:var(--transition-base); font-size:0.95rem; }
    .et-gender-option input:checked + label { border-color:var(--color-accent); background:rgba(191,175,150,0.08); color:var(--color-accent-dark); font-weight:500; }

    /* Loading overlay */
    .et-loading { display:none; position:fixed; inset:0; z-index:var(--z-overlay); background:rgba(245,241,235,0.92); backdrop-filter:blur(8px); align-items:center; justify-content:center; flex-direction:column; gap:2rem; }
    .et-loading.show { display:flex; }
    .et-spinner { width:48px; height:48px; border:2px solid var(--color-border); border-top-color:var(--color-accent-dark); border-radius:50%; animation:et-spin 0.9s linear infinite; }
    @keyframes et-spin { to { transform:rotate(360deg); } }
    .et-loading-text { font-family:var(--font-serif); font-size:1.2rem; color:var(--color-text-secondary); }
    .et-loading-steps { display:flex; flex-direction:column; gap:0.5rem; text-align:center; }
    .et-loading-step { font-size:0.85rem; color:var(--color-text-tertiary); opacity:0.4; transition:opacity 0.3s ease; }
    .et-loading-step.active { opacity:1; color:var(--color-accent-dark); }

    /* Result section */
    .et-result { display:none; padding:var(--section-padding) 0; }
    .et-result.show { display:block; }
    .et-result-inner { max-width:1080px; margin:0 auto; padding:0 1.5rem; }
    .et-result-header { text-align:center; margin-bottom:3rem; }
    .et-result-header h2 { margin-bottom:0.5rem; }
    .et-result-header p { color:var(--color-text-secondary); }

    .et-birth-info { display:flex; justify-content:center; gap:2rem; margin-top:1.5rem; flex-wrap:wrap; }
    .et-birth-info-item { display:flex; flex-direction:column; gap:0.25rem; align-items:center; }
    .et-birth-info-label { font-size:0.8rem; color:var(--color-text-tertiary); text-transform:uppercase; letter-spacing:0.08em; }
    .et-birth-info-value { font-size:1rem; font-weight:600; color:var(--color-text-primary); font-family:var(--font-serif); }

    /* Section title */
    .et-section-title { font-family:var(--font-serif); font-size:1.4rem; color:var(--color-text-primary); text-align:center; margin-bottom:1.5rem; }
    .et-section-subtitle { text-align:center; color:var(--color-text-tertiary); font-size:0.85rem; margin-bottom:2rem; letter-spacing:0.05em; }

    /* BaZi Chart */
    .et-bazi { background:var(--color-bg-card); border-radius:var(--radius-lg); padding:2rem; margin-bottom:2rem; border:1px solid var(--color-border-light); box-shadow:var(--shadow-sm); }
    .et-bazi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; }
    .et-bazi-pillar { text-align:center; padding:1rem 0.5rem; background:var(--color-bg-secondary); border-radius:var(--radius-sm); border:1px solid var(--color-border-light); }
    .et-bazi-pillar-label { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--color-text-tertiary); margin-bottom:0.5rem; }
    .et-bazi-pillar-stem { font-family:var(--font-serif); font-size:1.5rem; color:var(--color-text-primary); line-height:1.2; }
    .et-bazi-pillar-branch { font-family:var(--font-serif); font-size:1.5rem; color:var(--color-accent-dark); line-height:1.2; margin-top:0.25rem; }
    .et-bazi-pillar-el { font-size:0.65rem; color:var(--color-text-tertiary); margin-top:0.4rem; line-height:1.4; }
    .et-bazi-info { display:flex; justify-content:center; gap:1.5rem; margin-top:1.5rem; flex-wrap:wrap; }
    .et-bazi-info-item { text-align:center; padding:0.75rem 1.25rem; background:var(--color-bg-secondary); border-radius:var(--radius-sm); }
    .et-bazi-info-label { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--color-text-tertiary); margin-bottom:0.2rem; }
    .et-bazi-info-value { font-family:var(--font-serif); font-size:1rem; color:var(--color-text-primary); }

    /* Day Master Card */
    .et-daymaster { background:linear-gradient(135deg,var(--color-bg-card) 0%,var(--color-bg-secondary) 100%); border-radius:var(--radius-lg); padding:2rem; margin-bottom:2rem; border:1px solid var(--color-border-light); box-shadow:var(--shadow-sm); text-align:center; }
    .et-daymaster-badge { display:inline-block; padding:0.4rem 1rem; border-radius:999px; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--color-accent-dark); background:rgba(191,175,150,0.15); margin-bottom:1rem; }
    .et-daymaster-stem { font-family:var(--font-serif); font-size:2.5rem; margin-bottom:0.5rem; line-height:1; }
    .et-daymaster-meta { display:flex; justify-content:center; gap:1.5rem; margin-bottom:1rem; font-size:0.85rem; color:var(--color-text-tertiary); }
    .et-daymaster-desc { font-size:0.95rem; color:var(--color-text-secondary); max-width:600px; margin:0 auto; line-height:1.75; }

    /* Distribution */
    .et-distribution { text-align:center; margin-bottom:2rem; }
    .et-chart-row { display:flex; align-items:center; gap:3rem; justify-content:center; flex-wrap:wrap; }
    .et-donut-wrap { position:relative; width:220px; height:220px; flex-shrink:0; }
    .et-donut { width:220px; height:220px; border-radius:50%; position:relative; }
    .et-donut::after { content:''; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:110px; height:110px; border-radius:50%; background:var(--color-bg-primary); }
    .et-donut-label { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; z-index:1; }
    .et-donut-label small { display:block; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--color-text-tertiary); }
    .et-donut-label span { font-family:var(--font-serif); font-size:1.1rem; color:var(--color-text-primary); }

    /* Legend */
    .et-legend { display:flex; flex-direction:column; gap:0.75rem; }
    .et-legend-item { display:flex; align-items:center; gap:0.75rem; }
    .et-legend-dot { width:12px; height:12px; border-radius:50%; flex-shrink:0; }
    .et-legend-name { font-size:0.9rem; color:var(--color-text-primary); min-width:60px; }
    .et-legend-pct { font-family:var(--font-serif); font-size:1.1rem; color:var(--color-text-primary); min-width:48px; }
    .et-legend-bar-wrap { width:120px; height:6px; background:var(--color-border-light); border-radius:3px; overflow:hidden; }
    .et-legend-bar { height:100%; border-radius:3px; transition:width 1s ease; }

    /* Strength */
    .et-strength { background:var(--color-bg-card); border-radius:var(--radius-lg); padding:1.75rem; margin-bottom:2rem; text-align:center; border:1px solid var(--color-border-light); box-shadow:var(--shadow-sm); }
    .et-strength-badge { display:inline-block; padding:0.5rem 1.5rem; border-radius:999px; font-family:var(--font-serif); font-size:1.1rem; margin-bottom:0.75rem; }
    .et-strength-badge.strong { background:rgba(196,90,90,0.12); color:#C45A5A; }
    .et-strength-badge.weak { background:rgba(90,122,138,0.12); color:#5A7A8A; }
    .et-strength-badge.balanced { background:rgba(107,155,107,0.12); color:#6B9B6B; }
    .et-strength-desc { font-size:0.9rem; color:var(--color-text-secondary); max-width:600px; margin:0 auto; line-height:1.7; }

    /* Useful Gods */
    .et-useful-gods { background:var(--color-bg-card); border-radius:var(--radius-lg); padding:1.75rem; margin-bottom:2rem; border:1px solid var(--color-border-light); box-shadow:var(--shadow-sm); }
    .et-gods-row { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }
    .et-god-card { text-align:center; padding:1.25rem 0.75rem; background:var(--color-bg-secondary); border-radius:var(--radius-sm); border:1px solid var(--color-border-light); }
    .et-god-card-label { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--color-text-tertiary); margin-bottom:0.5rem; }
    .et-god-card-value { font-family:var(--font-serif); font-size:1.3rem; margin-bottom:0.4rem; }
    .et-god-card-desc { font-size:0.8rem; color:var(--color-text-secondary); line-height:1.5; }

    /* Ten Gods */
    .et-ten-gods { background:var(--color-bg-card); border-radius:var(--radius-lg); padding:1.75rem; margin-bottom:2rem; border:1px solid var(--color-border-light); box-shadow:var(--shadow-sm); }
    .et-ten-gods-cats { display:grid; grid-template-columns:repeat(5,1fr); gap:0.75rem; margin-bottom:1.5rem; }
    .et-god-cat { text-align:center; padding:0.875rem 0.5rem; background:var(--color-bg-secondary); border-radius:var(--radius-sm); border:1px solid var(--color-border-light); transition:var(--transition-base); cursor:pointer; }
    .et-god-cat:hover { transform:translateY(-2px); box-shadow:var(--shadow-xs); }
    .et-god-cat.active { border-color:var(--color-accent); background:rgba(191,175,150,0.08); }
    .et-god-cat-name { font-size:0.8rem; color:var(--color-text-primary); font-weight:500; margin-bottom:0.25rem; }
    .et-god-cat-sub { font-size:0.65rem; color:var(--color-text-tertiary); line-height:1.3; }
    .et-god-detail { padding:1rem; background:var(--color-bg-secondary); border-radius:var(--radius-sm); min-height:80px; }
    .et-god-detail-title { font-size:0.95rem; margin-bottom:0.4rem; color:var(--color-accent-dark); }
    .et-god-detail-desc { font-size:0.85rem; color:var(--color-text-secondary); line-height:1.6; }

    /* Two-col highlight */
    .et-highlight-row { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:2rem; }
    .et-highlight-card { background:var(--color-bg-card); border-radius:var(--radius-lg); padding:2rem; text-align:center; border:1px solid var(--color-border-light); box-shadow:var(--shadow-sm); }
    .et-highlight-card h4 { font-size:0.8rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--color-text-tertiary); margin-bottom:0.75rem; }
    .et-highlight-value { font-family:var(--font-serif); font-size:2.2rem; margin-bottom:0.5rem; line-height:1.2; }
    .et-highlight-desc { font-size:0.88rem; color:var(--color-text-secondary); line-height:1.7; }

    /* Grid sections */
    .et-grid-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:2rem; }
    .et-grid-card { background:var(--color-bg-card); border-radius:var(--radius-sm); padding:1.25rem; text-align:center; border:1px solid var(--color-border-light); }
    .et-grid-card-label { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--color-text-tertiary); margin-bottom:0.5rem; }
    .et-grid-card-value { font-family:var(--font-serif); font-size:0.95rem; color:var(--color-text-primary); line-height:1.45; }

    /* Luck */
    .et-luck-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }
    .et-luck-card { background:var(--color-bg-card); border-radius:var(--radius-sm); padding:1.1rem; text-align:center; border:1px solid var(--color-border-light); }
    .et-luck-card-label { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--color-text-tertiary); margin-bottom:0.4rem; }
    .et-luck-card-value { font-family:var(--font-serif); font-size:0.9rem; color:var(--color-text-primary); line-height:1.4; }
    .et-luck-card-wide { grid-column:span 3; }

    /* Analysis cards */
    .et-analysis-section { background:var(--color-bg-card); border-radius:var(--radius-lg); padding:1.75rem; margin-bottom:2rem; border:1px solid var(--color-border-light); box-shadow:var(--shadow-sm); }
    .et-analysis-title { font-family:var(--font-serif); font-size:1.2rem; margin-bottom:1rem; text-align:center; }
    .et-analysis-list { display:flex; flex-direction:column; gap:0.75rem; }
