      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">会员等级</label><div><span class="badge badge-accent">${u.level}</span></div></div>
        <div class="form-group"><label class="form-label">账户状态</label><div><span class="badge ${statusBadge(u.status)}">${u.status==='active'?'正常':'已禁用'}</span></div></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">注册时间</label><div>${u.registered}</div></div>
        <div class="form-group"><label class="form-label">最后登录</label><div>${u.lastLogin}</div></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">累计消费</label><div style="color:#BFAF96;font-weight:600;">${formatMoney(u.totalSpent)}</div></div>
        <div class="form-group"><label class="form-label">订单数量</label><div>${u.orderCount} 单</div></div>
      </div>
      <div class="form-group"><label class="form-label">联系电话</label><div>${u.phone}</div></div>
      <div style="margin-top:18px;"><div class="card-title" style="margin-bottom:14px;">最近订单</div>
        ${userOrders.length === 0 ? '<p style="color:#8A948C;font-size:13px;">暂无订单</p>' :
          `<table class="data-table"><thead><tr><th>订单号</th><th>金额</th><th>状态</th><th>时间</th></tr></thead><tbody>${userOrders.slice(0,5).map(o => `<tr><td>${o.id}</td><td>${formatMoney(o.paidAmount)}</td><td><span class="badge ${statusBadge(o.status)}">${statusName(o.status)}</span></td><td>${o.createdAt}</td></tr>`).join('')}</tbody></table>`}
      </div>
    `, '', true);
  }
  function toggleUserStatus(id) {
    const users = lsGet('users') || [];
    const u = users.find(x => x.id === id);
    if (!u) return;
    u.status = u.status === 'active' ? 'disabled' : 'active';
    lsSet('users', users);
    renderUsers();
    showToast('状态已更新', 'success');
  }
  function exportUsersCSV() {
    const users = lsGet('users') || [];
    const csv = 'ID,姓名,邮箱,电话,等级,注册时间,最后登录,状态,累计消费,订单数\n' + users.map(u => `${u.id},${u.name},${u.email},${u.phone},${u.level},${u.registered},${u.lastLogin},${u.status},${u.totalSpent},${u.orderCount}`).join('\n');
    const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'users.csv';
    link.click();
    showToast('用户数据已导出', 'success');
  }

  // ========== ORDERS ==========
  let orderStatus = '', orderSortKey = 'createdAt', orderSortDir = -1, orderPage = 1;
  const ORDER_PAGE_SIZE = 10;
  function setOrderTab(btn) {
    const status = typeof btn === 'string' ? btn : (btn?.dataset?.status || '');
    orderStatus = status; orderPage = 1;
    const tabs = document.querySelectorAll('#order-tabs .tab-item');
    tabs.forEach(t => t.classList.toggle('active', t.dataset.status === status));
    renderOrders();
  }
  function renderOrders() {
    const orders = lsGet('orders') || [];
    const search = (document.getElementById('order-search')?.value || '').toLowerCase();
    const payFilter = document.getElementById('order-payment-filter')?.value || '';
    let filtered = orders.filter(o => {
      if (orderStatus && o.status !== orderStatus) return false;
      if (search && !o.id.toLowerCase().includes(search) && !o.userName.toLowerCase().includes(search)) return false;
      if (payFilter && o.paymentMethod !== payFilter) return false;
      return true;
    });
    filtered.sort((a, b) => {
      const va = a[orderSortKey], vb = b[orderSortKey];
      if (typeof va === 'string') return va.localeCompare(vb) * orderSortDir;
      return (va - vb) * orderSortDir;
    });
    const totalPages = Math.ceil(filtered.length / ORDER_PAGE_SIZE);
    if (orderPage > totalPages) orderPage = Math.max(1, totalPages);
    const pageData = filtered.slice((orderPage-1)*ORDER_PAGE_SIZE, orderPage*ORDER_PAGE_SIZE);
    document.getElementById('orders-body').innerHTML = pageData.map(o => `
      <tr>
        <td style="font-weight:600;color:#BFAF96;">${o.id}</td>
        <td>${o.userName}</td>
        <td><div class="product-name">${o.products[0]?.productName || ''}${o.products.length>1?` 等${o.products.length}件`:''}</div></td>
        <td style="text-decoration:line-through;color:#8A948C;">${formatMoney(o.totalAmount)}</td>
        <td style="font-weight:600;color:#C47B6B;">${formatMoney(o.paidAmount)}</td>
        <td>${o.paymentMethod}</td>
        <td><span class="badge ${statusBadge(o.status)}">${statusName(o.status)}</span></td>
        <td><span class="badge ${SHIPPING_STATUS_BADGES[o.shippingStatus]||'badge-secondary'}">${SHIPPING_STATUS_NAMES[o.shippingStatus]||'未发货'}</span>${o.tracking?.number?`<div style="font-size:10px;color:#8A948C;margin-top:2px;">${o.tracking.company} ${o.tracking.number}</div>`:''}</td>
        <td>${o.createdAt}</td>
        <td><div class="table-actions"><button class="btn btn-outline btn-sm" onclick="viewOrder('${o.id}')">详情</button>${o.status==='paid'?`<button class="btn btn-success btn-sm" onclick="shipOrder('${o.id}')">发货</button>`:''}${o.status==='shipped'?`<button class="btn btn-outline btn-sm" onclick="updateShipping('${o.id}')">更新快递</button>`:''}${o.status==='completed'?`<button class="btn btn-warning btn-sm" onclick="refundOrder('${o.id}')">退款</button>`:''}</div></td>
      </tr>
    `).join('');
    renderPagination('orders-pagination', orderPage, totalPages, 'gotoOrderPage');
  }
  function gotoOrderPage(p) { orderPage = p; renderOrders(); }
  function sortOrders(key) {
    if (orderSortKey === key) orderSortDir *= -1;
    else { orderSortKey = key; orderSortDir = 1; }
    renderOrders();
  }
