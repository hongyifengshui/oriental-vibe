      <div class="form-group"><label class="form-label">副标题</label><input class="form-input" id="edit-banner-subtitle" value="${(b.subtitle||'').replace(/"/g,'&quot;')}" oninput="updateBannerPreview()" /></div>
      <div class="form-row">
