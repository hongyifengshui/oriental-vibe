            <button class="rt-btn" type="button" onclick="rtExec('italic')" title="斜体"><em>I</em></button>
            <button class="rt-btn" type="button" onclick="rtExec('underline')" title="下划线"><u>U</u></button>
            <button class="rt-btn" type="button" onclick="rtExec('insertUnorderedList')" title="无序列表">&#8226;</button>
            <button class="rt-btn" type="button" onclick="rtExec('insertOrderedList')" title="有序列表">1.</button>
            <button class="rt-btn" type="button" onclick="rtInsertLink()" title="插入链接">&#128279;</button>
          </div>
          <div class="rich-text-editor" id="sec-content" contenteditable="true">${s.content || ''}</div>
        </div>
      `;
    } else if (s.type === 'image-text') {
      bodyHTML += `
        <div class="form-group"><label class="form-label">图片URL</label>
          <div class="image-url-field">
            <input class="form-input" id="sec-image" value="${(s.image||'').replace(/"/g,'&quot;')}" />
            <button class="btn btn-outline btn-sm" onclick="pickFromMedia('image','sec-image')">&#128248; 从媒体库选择</button>
          </div>
        </div>
        <div class="form-group"><label class="form-label">内容描述</label>
          <div class="rich-text-toolbar">
            <button class="rt-btn" type="button" onclick="rtExec('bold')"><strong>B</strong></button>
            <button class="rt-btn" type="button" onclick="rtExec('italic')"><em>I</em></button>
            <button class="rt-btn" type="button" onclick="rtExec('insertUnorderedList')">&#8226;</button>
            <button class="rt-btn" type="button" onclick="rtInsertLink()">&#128279;</button>
          </div>
          <div class="rich-text-editor" id="sec-content" contenteditable="true">${s.content || ''}</div>
        </div>
        <div class="form-group"><label class="form-label">图片位置</label><select class="form-select" id="sec-img-pos"><option value="left" ${s.imagePosition==='left'?'selected':''}>左侧</option><option value="right" ${s.imagePosition==='right'?'selected':''}>右侧</option></select></div>
      `;
    } else if (s.type === 'carousel') {
      bodyHTML += `<div style="margin-bottom:14px;font-size:13px;color:#6B726F;">轮播图片：</div>`;
      (s.images || ['','','']).forEach((img, i) => {
        bodyHTML += `<div class="form-group"><label class="form-label">图片 ${i+1}</label>
          <div class="image-url-field">
            <input class="form-input" id="sec-img-${i}" value="${(img||'').replace(/"/g,'&quot;')}" placeholder="图片URL" />
            <button class="btn btn-outline btn-sm" onclick="pickFromMedia('image','sec-img-${i}')">&#128248; 选择</button>
          </div>
        </div>`;
      });
      bodyHTML += `<button class="btn btn-outline btn-sm" onclick="addCarouselImage()">+ 添加图片</button>`;
      window._carouselCount = (s.images || []).length;
    } else if (s.type === 'video') {
      bodyHTML += `
        <div class="form-group"><label class="form-label">视频URL (YouTube/Vimeo)</label>
          <div class="image-url-field">
            <input class="form-input" id="sec-video-url" value="${(s.videoUrl||'').replace(/"/g,'&quot;')}" placeholder="https://www.youtube.com/watch?v=..." />
            <button class="btn btn-outline btn-sm" onclick="pickFromMedia('video','sec-video-url')">&#127909; 从媒体库选择</button>
          </div>
        </div>
        <div class="form-group"><label class="form-label">视频描述</label><textarea class="form-textarea" id="sec-video-desc">${s.videoDesc || ''}</textarea></div>
      `;
    } else if (s.type === 'cta') {
      bodyHTML += `
        <div class="form-group"><label class="form-label">副标题</label><input class="form-input" id="sec-cta-subtitle" value="${(s.ctaSubtitle||'').replace(/"/g,'&quot;')}" /></div>
        <div class="form-row">
          <div class="form-group"><label class="form-label">按钮文案</label><input class="form-input" id="sec-cta-text" value="${(s.ctaText||'').replace(/"/g,'&quot;')}" /></div>
          <div class="form-group"><label class="form-label">按钮链接</label><input class="form-input" id="sec-cta-link" value="${(s.ctaLink||'').replace(/"/g,'&quot;')}" /></div>
        </div>
      `;
    } else if (s.type === 'faq') {
      bodyHTML += `<div id="faq-items-container" style="margin-bottom:14px;"></div><button class="btn btn-outline btn-sm" onclick="addFaqItem()">+ 添加问题</button>`;
      window._faqs = JSON.parse(JSON.stringify(s.faqs || []));
      setTimeout(renderFaqItems, 10);
    } else if (s.type === 'features') {
      bodyHTML += `<div id="features-items-container" style="margin-bottom:14px;"></div><button class="btn btn-outline btn-sm" onclick="addFeatureItem()">+ 添加特性</button>`;
      window._features = JSON.parse(JSON.stringify(s.features || []));
      setTimeout(renderFeatureItems, 10);
    } else if (s.type === 'pricing') {
      bodyHTML += `<div id="pricing-items-container" style="margin-bottom:14px;"></div><button class="btn btn-outline btn-sm" onclick="addPricingItem()">+ 添加方案</button>`;
      window._plans = JSON.parse(JSON.stringify(s.plans || []));
      setTimeout(renderPricingItems, 10);
    }
    bodyHTML += `
      <div style="margin-top:20px;padding-top:18px;border-top:1px solid #E8E4DE;">
        <div style="font-size:14px;font-weight:600;color:#3A403D;margin-bottom:14px;">样式设置</div>
        <div class="setting-grid-2">
          <div class="setting-item"><label>内边距</label><div class="padding-options">${['small','medium','large'].map(p => `<div class="padding-option ${(s.padding||'medium')===p?'active':''}" data-setting="padding" data-val="${p}" onclick="setSectionStyle('padding','${p}',this)">${p==='small'?'小':p==='medium'?'中':'大'}</div>`).join('')}</div></div>
          <div class="setting-item"><label>文字对齐</label><div class="align-options">${['left','center','right'].map(a => `<div class="align-option ${(s.textAlign||'center')===a?'active':''}" data-setting="textAlign" data-val="${a}" onclick="setSectionStyle('textAlign','${a}',this)">${a==='left'?'\u{2190}':a==='center'?'\u{2194}':'\u{2192}'}</div>`).join('')}</div></div>
        </div>
        <div class="setting-grid-2" style="margin-top:12px;">
          <div class="setting-item"><label>标题字体</label><div class="font-options">${['serif','sans-serif','cursive'].map(f => `<div class="font-option ${(s.titleFont||'sans-serif')===f?'active':''}" data-setting="titleFont" data-val="${f}" onclick="setSectionStyle('titleFont','${f}',this)">${f==='serif'?'衬线':f==='sans-serif'?'无衬线':'手写体'}</div>`).join('')}</div></div>
          <div class="setting-item"><label>背景色</label><div class="color-options">
            <div class="color-option ${s.bgColor===''?'active':''}" style="background:linear-gradient(135deg,#fff,#F5F1EB);" data-setting="bgColor" data-val="" onclick="setSectionStyle('bgColor','',this)" title="默认"></div>
            <div class="color-option ${s.bgColor==='#F5F1EB'?'active':''}" style="background:#F5F1EB;" data-setting="bgColor" data-val="#F5F1EB" onclick="setSectionStyle('bgColor','#F5F1EB',this)"></div>
            <div class="color-option ${s.bgColor==='#FAFAF8'?'active':''}" style="background:#FAFAF8;" data-setting="bgColor" data-val="#FAFAF8" onclick="setSectionStyle('bgColor','#FAFAF8',this)"></div>
            <div class="color-option ${s.bgColor==='#BFAF96'?'active':''}" style="background:#BFAF96;" data-setting="bgColor" data-val="#BFAF96" onclick="setSectionStyle('bgColor','#BFAF96',this)"></div>
            <div class="color-option ${s.bgColor==='#8A948C'?'active':''}" style="background:#8A948C;" data-setting="bgColor" data-val="#8A948C" onclick="setSectionStyle('bgColor','#8A948C',this)"></div>
          </div></div>
        </div>
        <div class="setting-item" style="margin-top:12px;"><label>背景图片URL</label>
          <div class="image-url-field">
            <input type="text" id="sec-bg-image" value="${(s.bgImage||'').replace(/"/g,'&quot;')}" placeholder="留空不使用背景图" />
            <button class="btn btn-outline btn-sm" onclick="pickFromMedia('image','sec-bg-image')">&#128248; 选择</button>
          </div>
        </div>
      </div>
    `;
    window._sectionType = s.type;
    openModal('编辑' + typeInfo.name, bodyHTML, `<button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="saveSection()">保存</button>`, true);
  }

  function setSectionStyle(setting, val, el) {
    const parent = el.parentElement;
    parent.querySelectorAll('[data-setting="' + setting + '"]').forEach(e => e.classList.remove('active'));
    el.classList.add('active');
    if (!window._sectionStyles) window._sectionStyles = {};
    window._sectionStyles[setting] = val;
  }

  function rtExec(cmd) {
    document.execCommand(cmd, false, null);
  }
  function rtInsertLink() {
    const url = prompt('请输入链接地址：', 'https://');
    if (url) document.execCommand('createLink', false, url);
  }

  function addCarouselImage() {
    const container = document.querySelector('#modal-body');
    const count = window._carouselCount || 3;
    const idx = count;
    const newGroup = document.createElement('div');
    newGroup.className = 'form-group';
    newGroup.innerHTML = `<label class="form-label">图片 ${idx+1}</label>
      <div class="image-url-field">
        <input class="form-input" id="sec-img-${idx}" value="" placeholder="图片URL" />
        <button class="btn btn-outline btn-sm" onclick="pickFromMedia('image','sec-img-${idx}')">&#128248; 选择</button>
      </div>`;
    const btn = container.querySelector('button[onclick="addCarouselImage()"]');
    btn.parentElement.insertBefore(newGroup, btn);
    window._carouselCount = idx + 1;
  }

  function renderFaqItems() {
    const container = document.getElementById('faq-items-container');
    if (!container) return;
    container.innerHTML = (window._faqs || []).map((f,i) => `
      <div style="background:#FAFAF8;border-radius:8px;padding:12px;margin-bottom:10px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <span style="font-size:12px;font-weight:600;color:#6B726F;">问题 ${i+1}</span>
          <button class="btn btn-danger btn-sm btn-icon" onclick="removeFaqItem(${i})" style="width:24px;height:24px;font-size:11px;">&#10006;</button>
        </div>
        <div class="form-group" style="margin-bottom:8px;"><input class="form-input" placeholder="问题" value="${(f.q||'').replace(/"/g,'&quot;')}" oninput="updateFaq(${i},'q',this.value)" /></div>
        <div class="form-group" style="margin-bottom:0;"><textarea class="form-textarea" style="min-height:60px;" placeholder="回答" oninput="updateFaq(${i},'a',this.value)">${f.a||''}</textarea></div>
      </div>
    `).join('');
  }
  function updateFaq(i, field, val) {
    if (!window._faqs) window._faqs = [];
    if (!window._faqs[i]) window._faqs[i] = { q:'', a:'' };
    window._faqs[i][field] = val;
  }
  function addFaqItem() {
    if (!window._faqs) window._faqs = [];
    window._faqs.push({ q:'', a:'' });
    renderFaqItems();
  }
  function removeFaqItem(i) {
    window._faqs.splice(i, 1);
    renderFaqItems();
  }

  function renderFeatureItems() {
    const container = document.getElementById('features-items-container');
    if (!container) return;
    container.innerHTML = (window._features || []).map((f,i) => `
      <div style="background:#FAFAF8;border-radius:8px;padding:12px;margin-bottom:10px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <span style="font-size:12px;font-weight:600;color:#6B726F;">特性 ${i+1}</span>
          <button class="btn btn-danger btn-sm btn-icon" onclick="removeFeatureItem(${i})" style="width:24px;height:24px;font-size:11px;">&#10006;</button>
        </div>
        <div class="form-row" style="margin-bottom:8px;">
          <div class="form-group" style="margin-bottom:0;"><input class="form-input" placeholder="图标emoji" value="${(f.icon||'').replace(/"/g,'&quot;')}" oninput="updateFeature(${i},'icon',this.value)" /></div>
          <div class="form-group" style="margin-bottom:0;"><input class="form-input" placeholder="标题" value="${(f.title||'').replace(/"/g,'&quot;')}" oninput="updateFeature(${i},'title',this.value)" /></div>
        </div>
        <div class="form-group" style="margin-bottom:0;"><input class="form-input" placeholder="描述" value="${(f.desc||'').replace(/"/g,'&quot;')}" oninput="updateFeature(${i},'desc',this.value)" /></div>
      </div>
    `).join('');
  }
  function updateFeature(i, field, val) {
    if (!window._features) window._features = [];
    if (!window._features[i]) window._features[i] = { icon:'', title:'', desc:'' };
    window._features[i][field] = val;
  }
  function addFeatureItem() {
    if (!window._features) window._features = [];
    window._features.push({ icon:'\u{2728}', title:'', desc:'' });
    renderFeatureItems();
  }
  function removeFeatureItem(i) {
    window._features.splice(i, 1);
    renderFeatureItems();
  }

  function renderPricingItems() {
    const container = document.getElementById('pricing-items-container');
    if (!container) return;
    container.innerHTML = (window._plans || []).map((p,i) => `
      <div style="background:#FAFAF8;border-radius:8px;padding:12px;margin-bottom:10px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <span style="font-size:12px;font-weight:600;color:#6B726F;">方案 ${i+1}</span>
          <div style="display:flex;gap:6px;align-items:center;">
            <label style="font-size:12px;color:#6B726F;display:flex;align-items:center;gap:4px;cursor:pointer;"><input type="checkbox" ${p.featured?'checked':''} onchange="updatePlan(${i},'featured',this.checked)" /> 推荐</label>
            <button class="btn btn-danger btn-sm btn-icon" onclick="removePricingItem(${i})" style="width:24px;height:24px;font-size:11px;">&#10006;</button>
          </div>
        </div>
        <div class="form-row" style="margin-bottom:8px;">
          <div class="form-group" style="margin-bottom:0;"><input class="form-input" placeholder="方案名称" value="${(p.name||'').replace(/"/g,'&quot;')}" oninput="updatePlan(${i},'name',this.value)" /></div>
          <div class="form-group" style="margin-bottom:0;"><input class="form-input" placeholder="价格" value="${(p.price||'').replace(/"/g,'&quot;')}" oninput="updatePlan(${i},'price',this.value)" /></div>
        </div>
        <div class="form-group" style="margin-bottom:0;"><textarea class="form-textarea" style="min-height:60px;" placeholder="特性列表（每行一个）" oninput="updatePlan(${i},'featuresText',this.value)">${(p.features||[]).join('\n')}</textarea></div>
      </div>
    `).join('');
  }
  function updatePlan(i, field, val) {
    if (!window._plans) window._plans = [];
    if (!window._plans[i]) window._plans[i] = { name:'', price:'', features:[], featured:false };
    if (field === 'featuresText') {
      window._plans[i].features = val.split('\n').filter(x => x.trim());
    } else {
      window._plans[i][field] = val;
    }
  }
  function addPricingItem() {
    if (!window._plans) window._plans = [];
    window._plans.push({ name:'', price:'', features:[], featured:false });
    renderPricingItems();
  }
  function removePricingItem(i) {
    window._plans.splice(i, 1);
    renderPricingItems();
  }

  function saveSection() {
    if (editingSectionIdx < 0) return;
    const content = getContentData();
    const s = content[currentContentPage].sections[editingSectionIdx];
    s.title = document.getElementById('sec-title').value;
    s.icon = document.getElementById('sec-icon').value;
    const type = s.type;
    if (type === 'text' || type === 'image-text') {
      const contentEl = document.getElementById('sec-content');
      s.content = contentEl ? contentEl.innerHTML : '';
    }
    if (type === 'image-text') {
      s.image = document.getElementById('sec-image').value;
      s.imagePosition = document.getElementById('sec-img-pos').value;
    }
    if (type === 'carousel') {
      const count = window._carouselCount || 3;
      const images = [];
      for (let i = 0; i < count; i++) {
        const el = document.getElementById('sec-img-' + i);
        if (el && el.value) images.push(el.value);
      }
      s.images = images;
    }
    if (type === 'video') {
      s.videoUrl = document.getElementById('sec-video-url').value;
      s.videoDesc = document.getElementById('sec-video-desc').value;
    }
    if (type === 'cta') {
      s.ctaText = document.getElementById('sec-cta-text').value;
      s.ctaLink = document.getElementById('sec-cta-link').value;
      s.ctaSubtitle = document.getElementById('sec-cta-subtitle').value;
    }
    if (type === 'faq') {
      s.faqs = (window._faqs || []).filter(f => f.q || f.a);
    }
    if (type === 'features') {
      s.features = (window._features || []).filter(f => f.title || f.desc);
    }
    if (type === 'pricing') {
      s.plans = (window._plans || []).filter(p => p.name || p.price);
    }
    if (window._sectionStyles) {
      Object.assign(s, window._sectionStyles);
    }
    const bgImageEl = document.getElementById('sec-bg-image');
    if (bgImageEl) s.bgImage = bgImageEl.value;
    content[currentContentPage].lastEdit = new Date().toISOString().slice(0, 10);
    saveContentData(content);
    const pages = getPagesData();
    const pIdx = pages.findIndex(p => p.id === currentContentPage);
    if (pIdx >= 0) { pages[pIdx].lastEdit = content[currentContentPage].lastEdit; savePagesData(pages); }
    window._sectionStyles = null;
    window._faqs = null;
    window._features = null;
    window._plans = null;
    closeModal();
    editingSectionIdx = -1;
    renderSectionsForEditor();
    showToast('区块已更新', 'success');
  }

  function deleteSection(idx) {
    if (!confirm('确定要删除这个区块吗？')) return;
    const content = getContentData();
    content[currentContentPage].sections.splice(idx, 1);
    content[currentContentPage].lastEdit = new Date().toISOString().slice(0, 10);
    saveContentData(content);
    renderSectionsForEditor();
    showToast('区块已删除', 'success');
  }

  function moveSection(idx, dir) {
    const content = getContentData();
    const sections = content[currentContentPage].sections;
    const newIdx = idx + dir;
    if (newIdx < 0 || newIdx >= sections.length) return;
    [sections[idx], sections[newIdx]] = [sections[newIdx], sections[idx]];
    content[currentContentPage].lastEdit = new Date().toISOString().slice(0, 10);
    saveContentData(content);
    renderSectionsForEditor();
  }

  // ===== MEDIA LIBRARY =====
  let currentMediaTab = 'images';

  // ========== FILE UPLOAD UTILS ==========
  const MAX_IMAGE_SIZE = 5 * 1024 * 1024;
  const MAX_VIDEO_SIZE = 20 * 1024 * 1024;
  const IMAGE_MAX_WIDTH = 1920;
  const IMAGE_MAX_HEIGHT = 1920;
  const IMAGE_QUALITY = 0.82;

  function compressImage(dataUrl, maxWidth, maxHeight, quality) {
    return new Promise(function(resolve, reject) {
      const img = new Image();
      img.onload = function() {
        let w = img.width;
        let h = img.height;
        if (w > maxWidth || h > maxHeight) {
          const ratio = Math.min(maxWidth / w, maxHeight / h);
          w = Math.round(w * ratio);
          h = Math.round(h * ratio);
        }
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        try {
          const result = canvas.toDataURL('image/jpeg', quality);
          resolve(result);
        } catch (e) {
          reject(e);
        }
      };
      img.onerror = function() {
        reject(new Error('图片加载失败'));
      };
      img.src = dataUrl;
    });
  }

  function readFileAsDataUrl(file) {
    return new Promise(function(resolve, reject) {
      const reader = new FileReader();
      reader.onload = function(ev) {
        resolve(ev.target.result);
      };
      reader.onerror = function() {
        reject(new Error('文件读取失败'));
      };
      reader.onabort = function() {
        reject(new Error('文件读取被中止'));
      };
      reader.readAsDataURL(file);
    });
  }

  function checkLocalStorageQuota(dataSize) {
    try {
      const testKey = '__quota_test__';
      let used = 0;
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key) used += localStorage.getItem(key).length + key.length;
      }
      const estimatedRemaining = 5 * 1024 * 1024 - used;
      return dataSize < estimatedRemaining;
    } catch (e) {
      return true;
    }
  }

  function uploadLocalFile(accept, callback, options) {
    const opts = options || {};
    const maxSize = opts.maxSize || 10 * 1024 * 1024;
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = accept;
    input.style.display = 'none';
    input.style.position = 'absolute';
    input.style.left = '-9999px';
    document.body.appendChild(input);
    let handled = false;

    function cleanup() {
      if (input.parentNode) {
        input.parentNode.removeChild(input);
      }
    }

    input.onchange = function(e) {
      if (handled) return;
      handled = true;
      const file = e.target.files && e.target.files[0];
      if (!file) { cleanup(); return; }
      if (file.size > maxSize) {
        const sizeMB = (maxSize / 1024 / 1024).toFixed(0);
        showToast('文件大小不能超过 ' + sizeMB + 'MB', 'error');
        cleanup();
        return;
      }
      readFileAsDataUrl(file)
        .then(function(dataUrl) {
          if (opts.compress && file.type && file.type.indexOf('image/') === 0 && file.type !== 'image/gif') {
            return compressImage(dataUrl, IMAGE_MAX_WIDTH, IMAGE_MAX_HEIGHT, IMAGE_QUALITY)
              .then(function(compressed) {
                return { dataUrl: compressed, fileName: file.name };
              })
              .catch(function() {
                return { dataUrl: dataUrl, fileName: file.name };
              });
          }
          return { dataUrl: dataUrl, fileName: file.name };
        })
        .then(function(result) {
          if (!checkLocalStorageQuota(result.dataUrl.length)) {
            showToast('存储空间不足，请删除一些旧文件后重试', 'error');
            cleanup();
            return;
          }
          callback(result.dataUrl, result.fileName);
          cleanup();
        })
        .catch(function(err) {
          console.error('Upload error:', err);
          showToast(err.message || '文件上传失败，请重试', 'error');
          cleanup();
        });
    };

    input.oncancel = function() {
      cleanup();
    };

    try {
      input.click();
    } catch (e) {
      console.error('Trigger file input error:', e);
      showToast('无法打开文件选择器，请重试', 'error');
      cleanup();
    }
  }

  function uploadImage(callback) {
    uploadLocalFile('image/jpeg,image/png,image/webp,image/gif', callback, { 
      maxSize: MAX_IMAGE_SIZE, 
      compress: true 
    });
  }

  function uploadVideo(callback) {
    uploadLocalFile('video/mp4,video/webm,video/ogg', callback, { 
      maxSize: MAX_VIDEO_SIZE 
    });
  }

  // ========== MEDIA LIBRARY ==========
  function getMediaData() {
    const content = getContentData();
    const pageKey = currentContentPage || '_global_';
    if (!content[pageKey]) content[pageKey] = { banner:{}, sections:[], seo:{}, advanced:{}, media:{images:[], videos:[]} };
    if (!content[pageKey].media) content[pageKey].media = { images: [], videos: [] };
    if (!content[pageKey].media.images) content[pageKey].media.images = [];
    if (!content[pageKey].media.videos) content[pageKey].media.videos = [];
    return content[pageKey].media;
  }

  function saveMediaData(media) {
    try {
      const content = getContentData();
      const pageKey = currentContentPage || '_global_';
      if (!content[pageKey]) content[pageKey] = { banner:{}, sections:[], seo:{}, advanced:{}, media };
      content[pageKey].media = media;
      saveContentData(content);
      return true;
    } catch (e) {
      console.error('Save media data error:', e);
      if (e.name === 'QuotaExceededError' || e.message && e.message.indexOf('quota') >= 0) {
        showToast('存储空间不足，请删除一些旧文件后重试', 'error');
      } else {
        showToast('保存失败，请重试', 'error');
      }
      return false;
    }
  }

  function renderMediaLibrary() {
    const media = getMediaData();
    renderMediaImages(media.images);
    renderMediaVideos(media.videos);
  }

  function renderMediaImages(images) {
    document.getElementById('media-img-count').textContent = `共 ${images.length} 张图片`;
    const grid = document.getElementById('media-images-grid');
    if (images.length === 0) {
      grid.innerHTML = '<div class="cm-empty-state" style="grid-column:1/-1;"><div class="cm-empty-icon">&#128247;</div><div>暂无图片，点击"添加图片"上传</div></div>';
      return;
    }
    grid.innerHTML = images.map((img, i) => `
      <div class="media-item">
        <div class="media-item-thumb">${img.url ? `<img src="${img.url}" alt="${img.name||''}" onerror="this.style.display='none';this.parentNode.innerHTML='&#128247;'">` : '&#128247;'}</div>
        <div class="media-item-overlay">
          <span class="media-item-name">${img.name || '图片 ' + (i+1)}</span>
          <div class="media-item-actions">
            <button class="media-item-btn" onclick="copyMediaUrl('image', ${i})" title="复制链接">&#128279;</button>
            <button class="media-item-btn danger" onclick="deleteMediaItem('image', ${i})" title="删除">&#128465;</button>
          </div>
        </div>
      </div>
    `).join('');
  }

  function renderMediaVideos(videos) {
    document.getElementById('media-video-count').textContent = `共 ${videos.length} 个视频`;
    const grid = document.getElementById('media-videos-grid');
    if (videos.length === 0) {
      grid.innerHTML = '<div class="cm-empty-state" style="grid-column:1/-1;"><div class="cm-empty-icon">&#127909;</div><div>暂无视频，点击"添加视频"添加</div></div>';
      return;
    }
    grid.innerHTML = videos.map((v, i) => `
      <div class="media-item">
        <div class="media-item-thumb">${v.cover ? `<img src="${v.cover}" alt="" onerror="this.style.display='none';this.parentNode.innerHTML='&#127909;'">` : '&#127909;'}</div>
        <div class="video-play-icon">&#9654;</div>
        <div class="media-item-overlay">
          <span class="media-item-name">${v.name || '视频 ' + (i+1)}</span>
          <div class="media-item-actions">
            <button class="media-item-btn" onclick="copyMediaUrl('video', ${i})" title="复制链接">&#128279;</button>
            <button class="media-item-btn danger" onclick="deleteMediaItem('video', ${i})" title="删除">&#128465;</button>
          </div>
        </div>
      </div>
    `).join('');
