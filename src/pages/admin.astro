        <div style="display:flex;justify-content:space-between;padding:7px 0;font-size:13px;"><span>优惠折扣</span><span style="color:#C47B6B;">-${formatMoney(o.discount)}</span></div>
        <div style="display:flex;justify-content:space-between;padding:12px 0;font-size:16px;font-weight:600;border-top:1px solid #E8E4DE;margin-top:8px;"><span>实付金额</span><span style="color:#C47B6B;">${formatMoney(o.paidAmount)}</span></div>
