  const statusBadge = s => ({ pending:'badge-warning', paid:'badge-info', shipped:'badge-info', completed:'badge-success', cancelled:'badge-danger', refund:'badge-danger', active:'badge-success', inactive:'badge-secondary', disabled:'badge-danger', expired:'badge-secondary' })[s] || 'badge-secondary';
