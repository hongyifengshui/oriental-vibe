    document.getElementById('source-donut').style.background = `conic-gradient(${stops})`;
    document.getElementById('source-legend').innerHTML = sources.map(s => `<div class="legend-item"><span class="legend-dot" style="background:${s.color}"></span><span class="legend-label">${s.label}</span><span class="legend-value">${s.value}</span></div>`).join('');
