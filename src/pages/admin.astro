      </div>
      ${o.tracking?.number ? `<div class="settings-section"><div class="settings-section-title">物流信息</div><p style="font-size:13px;margin-bottom:6px;">快递状态：<span class="badge ${SHIPPING_STATUS_BADGES[o.shippingStatus]||'badge-secondary'}">${SHIPPING_STATUS_NAMES[o.shippingStatus]||'未发货'}</span></p><p style="font-size:13px;">物流公司：${o.tracking.company}</p><p style="font-size:13px;">运单号：${o.tracking.number}</p></div>` : `<div class="settings-section"><div class="settings-section-title">物流信息</div><p style="font-size:13px;color:#8A948C;">快递状态：<span class="badge ${SHIPPING_STATUS_BADGES[o.shippingStatus]||'badge-secondary'}">${SHIPPING_STATUS_NAMES[o.shippingStatus]||'未发货'}</span></p></div>`}
      <div class="settings-section"><div class="settings-section-title">订单日志</div>${o.logs.map(l => `<div style="padding:9px 0;border-bottom:1px solid #F5F1EB;font-size:13px;"><span style="color:#8A948C;">${l.time}</span> - ${l.action}</div>`).join('')}</div>
    `, '', true);
  }
  function shipOrder(id) {
    openModal('订单发货', `
      <div class="form-group"><label class="form-label">物流公司</label><select class="form-select" id="ship-company"><option>顺丰速运</option><option>中通快递</option><option>圆通速递</option><option>韵达快递</option><option>京东物流</option></select></div>
      <div class="form-group"><label class="form-label">运单号</label><input class="form-input" id="ship-number" placeholder="请输入运单号" /></div>
      <div class="form-group"><label class="form-label">发货时间</label><input class="form-input" type="datetime-local" id="ship-time" value="${new Date().toISOString().slice(0,16)}" /></div>
    `, `<button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="confirmShip('${id}')">确认发货</button>`);
  }
  function confirmShip(id) {
    const orders = lsGet('orders') || [];
    const o = orders.find(x => x.id === id);
    if (!o) return;
    const shipNum = document.getElementById('ship-number').value.trim();
    if (!shipNum) { showToast('请输入运单号', 'error'); return; }
    o.status = 'shipped';
    o.shippingStatus = 'in_transit';
    o.tracking = { company: document.getElementById('ship-company').value, number: shipNum };
    o.logs.push({ time: new Date().toISOString().slice(0,16).replace('T',' '), action: '已发货 - ' + document.getElementById('ship-company').value });
    lsSet('orders', orders);
    closeModal(); renderOrders();
    showToast('发货成功', 'success');
  }
  function updateShipping(id) {
    const orders = lsGet('orders') || [];
    const o = orders.find(x => x.id === id);
    if (!o) return;
    openModal('更新快递状态', `
      <div class="form-group"><label class="form-label">快递状态</label><select class="form-select" id="upd-ship-status"><option value="in_transit" ${o.shippingStatus==='in_transit'?'selected':''}>运输中</option><option value="delivered" ${o.shippingStatus==='delivered'?'selected':''}>已送达</option><option value="signed" ${o.shippingStatus==='signed'?'selected':''}>已签收</option><option value="returned" ${o.shippingStatus==='returned'?'selected':''}>已退回</option></select></div>
      <div class="form-group"><label class="form-label">物流公司</label><select class="form-select" id="upd-ship-company"><option ${o.tracking?.company==='顺丰速运'?'selected':''}>顺丰速运</option><option ${o.tracking?.company==='中通快递'?'selected':''}>中通快递</option><option ${o.tracking?.company==='圆通速递'?'selected':''}>圆通速递</option><option ${o.tracking?.company==='韵达快递'?'selected':''}>韵达快递</option><option ${o.tracking?.company==='京东物流'?'selected':''}>京东物流</option></select></div>
      <div class="form-group"><label class="form-label">运单号</label><input class="form-input" id="upd-ship-number" value="${o.tracking?.number||''}" placeholder="请输入运单号" /></div>
    `, `<button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="confirmUpdateShipping('${id}')">确认更新</button>`);
  }
  function confirmUpdateShipping(id) {
    const orders = lsGet('orders') || [];
    const o = orders.find(x => x.id === id);
    if (!o) return;
    const newStatus = document.getElementById('upd-ship-status').value;
    o.shippingStatus = newStatus;
    o.tracking = { company: document.getElementById('upd-ship-company').value, number: document.getElementById('upd-ship-number').value.trim() };
    if (newStatus === 'signed') { o.status = 'completed'; }
    o.logs.push({ time: new Date().toISOString().slice(0,16).replace('T',' '), action: '快递状态更新 - ' + SHIPPING_STATUS_NAMES[newStatus] });
    lsSet('orders', orders);
    closeModal(); renderOrders();
    showToast('快递状态已更新', 'success');
  }
  function refundOrder(id) {
    if (!confirm('确定要为该订单办理退款吗？')) return;
    const orders = lsGet('orders') || [];
    const o = orders.find(x => x.id === id);
    if (!o) return;
    o.status = 'refund';
    o.logs.push({ time: new Date().toISOString().slice(0,16).replace('T',' '), action: '申请退款' });
    lsSet('orders', orders);
    renderOrders();
    showToast('退款申请已提交', 'success');
  }
  function exportOrdersCSV() {
    const orders = lsGet('orders') || [];
    const csv = '订单号,客户,邮箱,商品,商品总额,优惠,实付,支付方式,订单状态,快递状态,物流公司,运单号,下单时间\n' + orders.map(o => `${o.id},${o.userName},${o.userEmail},${o.products.map(p=>p.productName).join('|')},${o.totalAmount},${o.discount},${o.paidAmount},${o.paymentMethod},${statusName(o.status)},${SHIPPING_STATUS_NAMES[o.shippingStatus]||'未发货'},${o.tracking?.company||''},${o.tracking?.number||''},${o.createdAt}`).join('\n');
    const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'orders.csv';
    link.click();
    showToast('订单数据已导出', 'success');
  }

  // ========== MEMBERSHIP ==========
  let memberTab = 'levels', memberPage = 1;
  const MEMBER_PAGE_SIZE = 10;
  function setMemberTab(tab, btn) {
    memberTab = tab; memberPage = 1;
    const tabs = document.querySelectorAll('#page-membership .tab-bar .tab-item');
    const tabIndexMap = { levels: 0, list: 1, benefits: 2 };
    tabs.forEach((b, i) => b.classList.toggle('active', i === tabIndexMap[tab]));
    document.getElementById('member-levels-view').style.display = tab==='levels' ? '' : 'none';
    document.getElementById('member-list-view').style.display = tab==='list' ? '' : 'none';
    document.getElementById('member-benefits-view').style.display = tab==='benefits' ? '' : 'none';
    if (tab === 'levels') renderMembershipLevels();
    if (tab === 'list') renderMembers();
    if (tab === 'benefits') renderBenefits();
  }
  function renderMembershipLevels() {
    const levels = [
      { name: '初级会员', price: 99, icon: '\u{1F331}', color: '#D4C9B5', features: ['所有服务/产品/课程95折', '1次运势咨询服务', '积分奖励', '免费配送(满99)'], featured: false },
      { name: '中级会员', price: 299, icon: '\u{1F338}', color: '#BFAF96', features: ['所有服务/产品/课程8.8折', '1次个人运势咨询', '1次家居风水咨询', '双倍积分', '专属客服', '免费配送'], featured: true },
      { name: '高级会员', price: 699, icon: '\u{1F451}', color: '#8A948C', features: ['所有服务/产品/课程7.5折', '年度免费咨询6次', '赠送定制款水晶手串', '三倍积分', '1对1VIP客服', '免费配送', '每月优惠券', '新品抢先体验', '专属礼品', '线下活动优先'], featured: false }
    ];
    document.getElementById('membership-cards').innerHTML = levels.map(l => `
      <div class="member-card ${l.featured?'featured':''}">
        ${l.featured?'<div class="member-card-badge">最受欢迎</div>':''}
        <div class="member-card-icon" style="background:${l.color}20;color:${l.color};">${l.icon}</div>
        <h3>${l.name}</h3>
        <div class="price">${l.price}<span>/年</span></div>
        <ul>${l.features.map(f=>`<li>${f}</li>`).join('')}</ul>
        <button class="btn ${l.featured?'btn-primary':'btn-outline'}" onclick="editLevel('${l.name}')">编辑等级</button>
      </div>
    `).join('');
  }
  function editLevel(name) { showToast(`编辑${name}功能开发中...`, 'warning'); }
  function renderMembers() {
    const members = lsGet('members') || [];
    const search = (document.getElementById('member-search')?.value || '').toLowerCase();
    const levelFilter = document.getElementById('member-level-filter')?.value || '';
    const statusFilter = document.getElementById('member-status-filter')?.value || '';
    let filtered = members.filter(m => {
      if (search && !m.name.toLowerCase().includes(search)) return false;
      if (levelFilter && m.level !== levelFilter) return false;
      if (statusFilter && m.status !== statusFilter) return false;
      return true;
    });
    const totalPages = Math.ceil(filtered.length / MEMBER_PAGE_SIZE);
    if (memberPage > totalPages) memberPage = Math.max(1, totalPages);
    const pageData = filtered.slice((memberPage-1)*MEMBER_PAGE_SIZE, memberPage*MEMBER_PAGE_SIZE);
    document.getElementById('members-body').innerHTML = pageData.map(m => `
      <tr>
        <td>${m.id}</td>
        <td><div class="user-cell"><div class="avatar">${m.name.slice(0,1)}</div><div><div class="name">${m.name}</div></div></div></td>
        <td><span class="badge badge-accent">${m.level}</span></td>
        <td>${m.joined}</td>
        <td>${m.expires}</td>
        <td style="font-weight:600;color:#BFAF96;">${formatMoney(m.totalSpent)}</td>
        <td>${m.points}</td>
        <td><span class="badge ${statusBadge(m.status)}">${m.status==='active'?'有效':'已过期'}</span></td>
        <td><div class="table-actions"><button class="btn btn-outline btn-sm" onclick="memberAction(${m.id},'renew')">续费</button><button class="btn btn-warning btn-sm" onclick="memberAction(${m.id},'upgrade')">升级</button></div></td>
      </tr>
    `).join('');
    renderPagination('members-pagination', memberPage, totalPages, 'gotoMemberPage');
  }
  function gotoMemberPage(p) { memberPage = p; renderMembers(); }
  function memberAction(id, action) {
    const actions = { renew: '续费', upgrade: '升级', downgrade: '降级' };
    showToast(`${actions[action]}功能开发中...`, 'warning');
  }
  function renderBenefits() {
    const benefits = lsGet('benefits') || [];
    document.getElementById('benefits-list').innerHTML = benefits.length === 0 ?
      `<div class="empty-state"><div class="empty-state-icon">\u{1F381}</div><p>暂无权益</p></div>` :
      `<table class="data-table"><thead><tr><th>ID</th><th>图标</th><th>权益名称</th><th>描述</th><th>适用等级</th><th>操作</th></tr></thead><tbody>${benefits.map(b => `<tr><td>${b.id}</td><td><span style="font-size:22px;">${b.icon}</span></td><td style="font-weight:500;">${b.name}</td><td>${b.desc}</td><td><span class="badge badge-accent">${b.level}</span></td><td><button class="btn btn-outline btn-sm" onclick="editBenefit(${b.id})">编辑</button> <button class="btn btn-danger btn-sm" onclick="deleteBenefit(${b.id})">删除</button></td></tr>`).join('')}</tbody></table>`;
  }
  function openBenefitModal(benefitId) {
    const benefits = lsGet('benefits') || [];
    const b = benefitId ? benefits.find(x => x.id === benefitId) : null;
    const isEdit = !!b;
    openModal(isEdit ? '编辑权益' : '新增权益', `
      <div class="form-group"><label class="form-label">权益名称</label><input class="form-input" id="ben-name" value="${b?.name||''}" /></div>
      <div class="form-group"><label class="form-label">权益描述</label><textarea class="form-textarea" id="ben-desc">${b?.desc||''}</textarea></div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">图标</label><input class="form-input" id="ben-icon" value="${b?.icon||'\u{1F381}'}" /></div>
        <div class="form-group"><label class="form-label">适用等级</label><select class="form-select" id="ben-level"><option value="初级会员" ${b?.level==='初级会员'?'selected':''}>初级会员</option><option value="中级会员" ${b?.level==='中级会员'?'selected':''}>中级会员</option><option value="高级会员" ${b?.level==='高级会员'?'selected':''}>高级会员</option></select></div>
      </div>
    `, `<button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="saveBenefit(${isEdit?b.id:0})">${isEdit?'保存':'新增'}</button>`);
  }
  function editBenefit(id) { openBenefitModal(id); }
  function saveBenefit(id) {
    let benefits = lsGet('benefits') || [];
    const name = document.getElementById('ben-name').value.trim();
    if (!name) { showToast('请输入权益名称', 'error'); return; }
    const data = { name, desc: document.getElementById('ben-desc').value, icon: document.getElementById('ben-icon').value, level: document.getElementById('ben-level').value };
    if (id) { const b = benefits.find(x => x.id===id); if (b) Object.assign(b, data); showToast('权益已更新', 'success'); }
    else { const maxId = benefits.reduce((m,b)=>Math.max(m,b.id),0); benefits.push({ id: maxId+1, ...data }); showToast('权益已添加', 'success'); }
    lsSet('benefits', benefits); closeModal(); renderBenefits();
  }
  function deleteBenefit(id) {
    if (!confirm('确定删除该权益吗？')) return;
    let benefits = lsGet('benefits') || [];
    benefits = benefits.filter(b => b.id !== id);
    lsSet('benefits', benefits); renderBenefits();
    showToast('权益已删除', 'success');
  }

  // ========== ANALYTICS ==========
  let analyticsRange = '7d';
  function setAnalyticsRange(range, btn) {
    analyticsRange = range;
    const btns = document.querySelectorAll('#page-analytics .time-range-btn');
    btns.forEach(b => b.classList.toggle('active', b.textContent.includes(range.replace('d','天')) ||
      (range === 'today' && b.textContent.includes('今日')) ||
      (range === 'yesterday' && b.textContent.includes('昨日')) ||
      (range === 'month' && b.textContent.includes('本月')) ||
      (range === 'lastmonth' && b.textContent.includes('上月'))));
    renderAnalytics();
  }
  function renderAnalytics() {
    const users = lsGet('users') || [];
    const orders = lsGet('orders') || [];
    const products = lsGet('products') || [];
    const revenue = orders.filter(o => o.status !== 'cancelled').reduce((s,o) => s + parseFloat(o.paidAmount), 0);
    const avgOrder = orders.length > 0 ? revenue / orders.length : 0;
    const conversion = users.length > 0 ? ((orders.length / users.length) * 100).toFixed(1) : 0;

    document.getElementById('analytics-metrics').innerHTML = [
      { label:'访客数', value: randInt(5000,20000), change:'+15.3%', up:true },
      { label:'订单数', value: orders.length, change:'+8.7%', up:true },
      { label:'销售额', value: formatMoney(revenue).slice(0,8), change:'+12.1%', up:true },
      { label:'客单价', value: formatMoney(avgOrder), change:'+3.2%', up:true },
      { label:'转化率', value: conversion + '%', change:'+1.5%', up:true },
      { label:'新增用户', value: randInt(50,200), change:'-2.4%', up:false }
    ].map(m => `
      <div class="metric-card">
        <div class="m-label">${m.label}</div>
        <div class="m-value">${m.value}</div>
        <div class="m-change ${m.up?'up':'down'}">${m.up?'\u{25B2}':'\u{25BC}'} ${m.change}</div>
      </div>
    `).join('');

    const daysMap = { today:1, yesterday:1, '7d':7, '30d':30, month:30, lastmonth:30 };
    const days = daysMap[analyticsRange] || 7;
    renderAnalyticsChart('analytics-sales-chart', days, '#BFAF96', 2000, 15000);
    renderAnalyticsChart('analytics-user-chart', days, '#8A948C', 50, 300);
    renderAnalyticsTopProducts(products);
    renderAnalyticsRegion();
  }
  function renderAnalyticsChart(id, days, color, min, max) {
    const svg = document.getElementById(id);
    if (!svg) return;
    const data = []; let maxVal = 0;
    for (let i=days-1; i>=0; i--) {
      const val = randInt(min, max);
      data.push({ label: daysAgo(i).slice(5), val });
      if (val > maxVal) maxVal = val;
    }
    maxVal = Math.ceil(maxVal / 1000) * 1000;
    const w=500, h=240, pad={t:20,r:20,b:30,l:50}, cw=w-pad.l-pad.r, ch=h-pad.t-pad.b;
    const points = data.map((d,i) => [pad.l + (i/(data.length-1))*cw, pad.t + ch - (d.val/maxVal)*ch]);
    const areaPath = `M${points[0][0]},${pad.t+ch} ` + points.map(p=>`L${p[0]},${p[1]}`).join(' ') + ` L${points.at(-1)[0]},${pad.t+ch} Z`;
    const linePath = points.map((p,i)=>(i===0?'M':'L')+p[0]+','+p[1]).join(' ');
    let gridLines = '';
    for (let i=0; i<=4; i++) {
      const y = pad.t + (ch/4)*i; const val = Math.round(maxVal - (maxVal/4)*i);
      gridLines += `<line x1="${pad.l}" y1="${y}" x2="${w-pad.r}" y2="${y}" stroke="#F0EDE8" stroke-width="1"/>`;
      gridLines += `<text x="${pad.l-8}" y="${y+4}" text-anchor="end" fill="#8A948C" font-size="10">${val>=1000?(val/1000)+'k':val}</text>`;
    }
    let xLabels = ''; const step = Math.ceil(data.length / 7);
    data.forEach((d,i) => {
      if (i%step===0 || i===data.length-1) {
        const x = pad.l + (i/(data.length-1))*cw;
        xLabels += `<text x="${x}" y="${h-pad.b+18}" text-anchor="middle" fill="#8A948C" font-size="10">${d.label}</text>`;
      }
    });
    svg.innerHTML = `<defs><linearGradient id="${id}Grad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${color}" stop-opacity="0.3"/><stop offset="100%" stop-color="${color}" stop-opacity="0"/></linearGradient></defs>${gridLines}${xLabels}<path d="${areaPath}" fill="url(#${id}Grad)"/><path d="${linePath}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>${points.map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="3" fill="#fff" stroke="${color}" stroke-width="2"/>`).join('')}`;
  }
  function renderAnalyticsTopProducts(products) {
    const sorted = [...products].sort((a,b) => b.sales - a.sales).slice(0,10);
    const max = sorted[0]?.sales || 1;
    document.getElementById('analytics-top-products').innerHTML = sorted.map((p,i) => `
      <div class="h-bar-item">
        <div class="h-bar-label">${i+1}. ${p.name.length>6?p.name.slice(0,6)+'...':p.name}</div>
        <div class="h-bar-track"><div class="h-bar-fill" style="width:${(p.sales/max)*100}%"></div></div>
        <div class="h-bar-value">${p.sales}</div>
      </div>
    `).join('');
  }
  function renderAnalyticsRegion() {
    const regions = [
      { name:'广东', value: randInt(200,500) },
      { name:'北京', value: randInt(150,400) },
      { name:'上海', value: randInt(150,380) },
      { name:'浙江', value: randInt(100,300) },
      { name:'江苏', value: randInt(100,280) },
      { name:'四川', value: randInt(80,250) }
    ].sort((a,b) => b.value - a.value);
    const max = regions[0].value;
    document.getElementById('analytics-region').innerHTML = regions.map(r => `
      <div class="h-bar-item">
        <div class="h-bar-label">${r.name}</div>
        <div class="h-bar-track"><div class="h-bar-fill" style="width:${(r.value/max)*100}%"></div></div>
        <div class="h-bar-value">${r.value}</div>
      </div>
    `).join('');
  }

  // ========== SETTINGS ==========
  let settingTab = 'basic';
  function setSettingTab(tab, btn) {
    settingTab = tab;
    const tabs = document.querySelectorAll('#page-settings .tab-bar .tab-item');
    const tabIndexMap = { basic: 0, payment: 1, email: 2, service: 3 };
    tabs.forEach((b, i) => b.classList.toggle('active', i === tabIndexMap[tab]));
    ['basic','payment','email','service'].forEach(t => {
      const el = document.getElementById('setting-' + t);
      if (el) el.style.display = t === tab ? '' : 'none';
    });
  }
  function loadSettings() {
    const settings = lsGet('settings') || {};
    if (settings.siteName) document.getElementById('set-site-name').value = settings.siteName;
    if (settings.slogan) document.getElementById('set-site-slogan').value = settings.slogan;
    if (settings.description) document.getElementById('set-site-desc').value = settings.description;
    if (settings.keywords) document.getElementById('set-keywords').value = settings.keywords;
    if (settings.email) document.getElementById('set-email').value = settings.email;
    if (settings.gaId) document.getElementById('set-ga-id').value = settings.gaId;
    if (settings.paymentInfo) document.getElementById('set-payment-info').value = settings.paymentInfo;
    if (settings.paymentEnabled === false) document.getElementById('pay-enabled').classList.remove('active');
  }
  function saveSettings() {
    const settings = lsGet('settings') || {};
    settings.siteName = document.getElementById('set-site-name').value;
    settings.slogan = document.getElementById('set-site-slogan').value;
    settings.description = document.getElementById('set-site-desc').value;
    settings.keywords = document.getElementById('set-keywords').value;
    settings.email = document.getElementById('set-email').value;
    settings.gaId = document.getElementById('set-ga-id').value.trim();
    settings.paymentInfo = document.getElementById('set-payment-info').value;
    settings.paymentEnabled = document.getElementById('pay-enabled').classList.contains('active');
    lsSet('settings', settings);
    showToast('设置已保存', 'success');
  }
  function testEmail() { showToast('测试邮件已发送，请查收', 'success'); }

  // ========== INIT ==========
  document.addEventListener('DOMContentLoaded', function() {
    checkAuth();
  });
  if (document.readyState !== 'loading') checkAuth();
  </script>
</body>
</html>