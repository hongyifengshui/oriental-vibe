  // ========== PAGINATION ==========
  function renderPagination(containerId, current, total, onChangeName) {
    const el = document.getElementById(containerId);
    if (total <= 1) { el.innerHTML = ''; return; }
    let html = '';
    html += `<button class="page-btn" ${current<=1?'disabled style="opacity:0.4;cursor:not-allowed;"':''} onclick="${onChangeName}(${current-1})">&larr;</button>`;
    const start = Math.max(1, current - 2);
    const end = Math.min(total, current + 2);
    if (start > 1) { html += `<button class="page-btn" onclick="${onChangeName}(1)">1</button>`; if (start > 2) html += '<span style="padding:0 6px;color:#8A948C;">...</span>'; }
    for (let i=start; i<=end; i++) html += `<button class="page-btn ${i===current?'active':''}" onclick="${onChangeName}(${i})">${i}</button>`;
    if (end < total) { if (end < total-1) html += '<span style="padding:0 6px;color:#8A948C;">...</span>'; html += `<button class="page-btn" onclick="${onChangeName}(${total})">${total}</button>`; }
    html += `<button class="page-btn" ${current>=total?'disabled style="opacity:0.4;cursor:not-allowed;"':''} onclick="${onChangeName}(${current+1})">&rarr;</button>`;
    el.innerHTML = html;
  }

