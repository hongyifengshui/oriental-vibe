  function setEditorTab(tab, btn) {
    editorTab = tab;
    const tabs = document.querySelectorAll('.cm-editor-tabs .cm-editor-tab');
    tabs.forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
    document.getElementById('editor-tab-design').style.display = tab === 'design' ? 'block' : 'none';
    document.getElementById('editor-tab-media').style.display = tab === 'media' ? 'block' : 'none';
    document.getElementById('editor-tab-advanced').style.display = tab === 'advanced' ? 'block' : 'none';
    if (tab === 'media') {
      renderMediaLibrary();
    }
