  function setMediaTab(tab, btn) {
    currentMediaTab = tab;
    document.querySelectorAll('.cm-media-tab').forEach(b => b.classList.toggle('active', b === btn));
    document.getElementById('media-images-panel').style.display = tab === 'images' ? 'block' : 'none';
    document.getElementById('media-videos-panel').style.display = tab === 'videos' ? 'block' : 'none';
  }

  function addMediaImage() {
    uploadImage(function(dataUrl, fileName) {
      const media = getMediaData();
      media.images.push({ 
        url: dataUrl, 
        name: fileName || ('图片 ' + (media.images.length + 1)), 
        size: Math.round(dataUrl.length * 3 / 4 / 1024) + 'KB',
        createdAt: new Date().toISOString().slice(0, 10) 
      });
      if (saveMediaData(media)) {
        renderMediaLibrary();
        showToast('图片上传成功', 'success');
      }
    });
  }

  function addMediaImageByUrl() {
    const url = prompt('请输入图片URL：');
    if (!url) return;
    const name = prompt('图片名称（可选）：', '图片 ' + (getMediaData().images.length + 1)) || '';
    const media = getMediaData();
    media.images.push({ url, name, createdAt: new Date().toISOString().slice(0, 10) });
    if (saveMediaData(media)) {
      renderMediaLibrary();
      showToast('图片已添加', 'success');
    }
  }

  function addMediaVideo() {
    uploadVideo(function(dataUrl, fileName) {
      const media = getMediaData();
      media.videos.push({ 
        url: dataUrl, 
        name: fileName || ('视频 ' + (media.videos.length + 1)),
        cover: '',
        size: Math.round(dataUrl.length * 3 / 4 / 1024) + 'KB',
        createdAt: new Date().toISOString().slice(0, 10) 
      });
      if (saveMediaData(media)) {
        renderMediaLibrary();
        showToast('视频上传成功', 'success');
      }
    });
  }

  function addMediaVideoByUrl() {
    const url = prompt('请输入视频URL（YouTube/Vimeo 或 mp4）：');
    if (!url) return;
    const name = prompt('视频名称（可选）：', '视频 ' + (getMediaData().videos.length + 1)) || '';
    const cover = prompt('视频封面图URL（可选）：') || '';
    const media = getMediaData();
    media.videos.push({ url, name, cover, createdAt: new Date().toISOString().slice(0, 10) });
    if (saveMediaData(media)) {
      renderMediaLibrary();
      showToast('视频已添加', 'success');
    }
  }

  function deleteMediaItem(type, idx) {
    if (!confirm('确定要删除这个' + (type === 'image' ? '图片' : '视频') + '吗？')) return;
    const media = getMediaData();
    if (type === 'image') media.images.splice(idx, 1);
    else media.videos.splice(idx, 1);
    saveMediaData(media);
    renderMediaLibrary();
    showToast('已删除', 'success');
  }

  function copyMediaUrl(type, idx) {
    const media = getMediaData();
    const item = type === 'image' ? media.images[idx] : media.videos[idx];
    if (!item) return;
    navigator.clipboard?.writeText(item.url);
    showToast('链接已复制到剪贴板', 'success');
  }

  function pickFromMedia(type, targetInputId) {
    const media = getMediaData();
    const items = type === 'image' ? media.images : media.videos;
    if (items.length === 0) {
      if (confirm('媒体库为空，是否现在上传' + (type === 'image' ? '图片' : '视频') + '？')) {
        if (type === 'image') {
          addMediaImage();
        } else {
          addMediaVideo();
        }
      }
      return;
    }
    const uploadBtn = type === 'image' 
      ? '<button class="btn btn-primary btn-sm" onclick="uploadToMediaAndPick(\'image\', \'' + targetInputId + '\')">&#8683; 上传图片</button>'
      : '<button class="btn btn-primary btn-sm" onclick="uploadToMediaAndPick(\'video\', \'' + targetInputId + '\')">&#8683; 上传视频</button>';
    const html = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div style="font-size:14px;font-weight:500;">选择${type === 'image' ? '图片' : '视频'}</div>
        ${uploadBtn}
      </div>
      <div class="media-picker-grid">
        ${items.map((item, i) => `
          <div class="media-picker-item" onclick="selectMediaItem(${i}, '${type}', '${targetInputId}')">
            ${type === 'image'
              ? (item.url ? `<img src="${item.url}" alt="" onerror="this.style.display='none';this.parentNode.innerHTML='<div class=\\'media-picker-item-icon\\'>&#128247;</div>'">` : '<div class="media-picker-item-icon">&#128247;</div>')
              : `<div class="media-picker-item-icon">&#127909;</div>`
            }
          </div>
        `).join('')}
      </div>
    `;
    openModal('从媒体库选择', html, '<button class="btn btn-outline" onclick="closeModal()">取消</button>');
  }

  function uploadToMediaAndPick(type, targetInputId) {
    const uploadFunc = type === 'image' ? uploadImage : uploadVideo;
    uploadFunc(function(dataUrl, fileName) {
      const media = getMediaData();
      const newItem = { 
        url: dataUrl, 
        name: fileName || ((type === 'image' ? '图片 ' : '视频 ') + (type === 'image' ? media.images.length : media.videos.length) + 1), 
        createdAt: new Date().toISOString().slice(0, 10) 
      };
      if (type === 'image') {
        media.images.push(newItem);
      } else {
        newItem.cover = '';
        media.videos.push(newItem);
      }
      if (!saveMediaData(media)) return;
      const input = document.getElementById(targetInputId);
      if (input) {
        input.value = dataUrl;
        input.dispatchEvent(new Event('input'));
        input.dispatchEvent(new Event('change'));
      }
      closeModal();
      showToast('上传成功并已选择', 'success');
    });
  }

  function selectMediaItem(idx, type, targetInputId) {
    const media = getMediaData();
    const items = type === 'image' ? media.images : media.videos;
    const item = items[idx];
    if (!item) return;
    const input = document.getElementById(targetInputId);
    if (input) {
      input.value = item.url;
      input.dispatchEvent(new Event('input'));
      input.dispatchEvent(new Event('change'));
    }
    closeModal();
    showToast('已选择', 'success');
  }

  function deleteCurrentPage() {
    if (!confirm('确定要删除当前页面吗？此操作不可恢复。')) return;
    const pages = getPagesData();
    const idx = pages.findIndex(p => p.id === currentContentPage);
    if (idx < 0) return;
    const pageInfo = pages[idx];
    if (pageInfo.group === 'core') {
      if (!confirm('这是核心页面，删除后无法恢复。确认删除？')) return;
    }
    pages.splice(idx, 1);
    savePagesData(pages);
    const content = getContentData();
    delete content[currentContentPage];
    saveContentData(content);
    showToast('页面已删除', 'success');
    currentContentPage = null;
    backToPageList();
  }

  function savePageContent() {
    const content = getContentData();
    if (!content[currentContentPage]) content[currentContentPage] = { banner:{}, sections:[], seo:{}, advanced:{} };
    content[currentContentPage].seo = {
      title: document.getElementById('seo-title').value,
      description: document.getElementById('seo-description').value,
      keywords: document.getElementById('seo-keywords').value,
      ogImage: document.getElementById('seo-og-image').value
    };
    content[currentContentPage].advanced = {
      slug: document.getElementById('adv-slug').value,
      inNav: document.getElementById('adv-in-nav').classList.contains('active'),
      indexable: document.getElementById('adv-index').classList.contains('active'),
      sort: parseInt(document.getElementById('adv-sort').value) || 0
    };
    content[currentContentPage].lastEdit = new Date().toISOString().slice(0, 10);
    saveContentData(content);
    const pages = getPagesData();
    const pIdx = pages.findIndex(p => p.id === currentContentPage);
    if (pIdx >= 0) { pages[pIdx].lastEdit = content[currentContentPage].lastEdit; savePagesData(pages); }
    const subEl = document.getElementById('cm-editor-sub');
    if (subEl) subEl.textContent = '最后编辑：' + content[currentContentPage].lastEdit;
    showToast('页面内容已保存', 'success');
  }

  function previewPage(pageId) {
    showToast('预览功能：前台页面已在新窗口打开', 'info');
    window.open('#' + (pageId || currentContentPage), '_blank');
  }

  function updateSeoPreview() {
    const title = document.getElementById('seo-title').value || '页面标题';
    const desc = document.getElementById('seo-description').value || '页面描述内容...';
    document.getElementById('seo-preview-title').textContent = title;
    document.getElementById('seo-preview-desc').textContent = desc;
  }

  // ========== PRODUCTS ==========
  let productSortKey = 'id', productSortDir = -1, productPage = 1;
  const PRODUCT_PAGE_SIZE = 10;
  function renderProducts() {
    const products = lsGet('products') || [];
    const categories = lsGet('categories') || [];
    const catSel = document.getElementById('product-category-filter');
    if (catSel && catSel.options.length <= 1) {
      catSel.innerHTML = '<option value="">全部分类</option>' + categories.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
    }
    const search = (document.getElementById('product-search')?.value || '').toLowerCase();
    const catFilter = document.getElementById('product-category-filter')?.value || '';
    const statusFilter = document.getElementById('product-status-filter')?.value || '';
    let filtered = products.filter(p => {
      if (search && !p.name.toLowerCase().includes(search)) return false;
      if (catFilter && p.category !== catFilter) return false;
      if (statusFilter && p.status !== statusFilter) return false;
      return true;
    });
    filtered.sort((a, b) => {
      const va = a[productSortKey], vb = b[productSortKey];
      if (typeof va === 'string') return va.localeCompare(vb) * productSortDir;
      return (va - vb) * productSortDir;
    });
    const totalPages = Math.ceil(filtered.length / PRODUCT_PAGE_SIZE);
    if (productPage > totalPages) productPage = Math.max(1, totalPages);
    const pageData = filtered.slice((productPage-1)*PRODUCT_PAGE_SIZE, productPage*PRODUCT_PAGE_SIZE);
    document.getElementById('products-body').innerHTML = pageData.map(p => {
      const mainImg = p.images && p.images.length > 0 ? p.images[0] : p.image;
      return `
      <tr>
        <td>#${p.id}</td>
        <td>
          ${mainImg 
            ? `<div class="product-list-img"><img src="${mainImg}" alt="" /></div>`
            : `<div class="avatar" style="background:linear-gradient(135deg,#F5F1EB,#E8E0D4);color:#BFAF96;">${p.name.slice(0,1)}</div>`
          }
        </td>
        <td style="font-weight:500;">${p.name}</td>
        <td><span class="badge badge-secondary">${p.category}</span></td>
        <td style="color:#BFAF96;font-weight:600;">${formatMoney(p.price)}</td>
        <td>${p.stock}</td>
        <td>${p.sales}</td>
        <td><span class="badge ${statusBadge(p.status)}">${p.status==='active'?'上架中':'已下架'}</span></td>
        <td><div class="table-actions"><button class="btn btn-outline btn-sm" onclick="editProduct(${p.id})">编辑</button><button class="btn ${p.status==='active'?'btn-warning':'btn-success'} btn-sm" onclick="toggleProductStatus(${p.id})">${p.status==='active'?'下架':'上架'}</button></div></td>
      </tr>
    `}).join('');
    renderPagination('products-pagination', productPage, totalPages, 'gotoProductPage');
  }
  function gotoProductPage(p) { productPage = p; renderProducts(); }
  function sortProducts(key) {
    if (productSortKey === key) productSortDir *= -1;
    else { productSortKey = key; productSortDir = 1; }
    renderProducts();
  }
  function showProductTab(view) {
    document.getElementById('products-list-view').style.display = view==='list' ? '' : 'none';
    document.getElementById('products-category-view').style.display = view==='categories' ? '' : 'none';
    if (view === 'categories') renderCategories();
    else renderProducts();
  }
