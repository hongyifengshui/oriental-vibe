  function renderSectionsForEditor() {
    const content = getContentData();
    const page = content[currentContentPage] || { sections: [] };
    const sections = page.sections || [];
    const el = document.getElementById('sections-list');
    if (sections.length === 0) { el.innerHTML = `<div class="empty-state"><div class="empty-state-icon">\u{1F4C4}</div><p>暂无区块，点击下方新增区块</p></div>`; return; }
    el.innerHTML = sections.map((s,i) => {
      const typeInfo = SECTION_TYPES.find(t => t.id === s.type) || SECTION_TYPES[0];
      let thumbContent = s.icon || typeInfo.icon;
      if (s.type === 'image-text' && s.image) {
        thumbContent = `<img src="${s.image}" alt="" />`;
      }
      const descText = s.content ? s.content.replace(/<[^>]*>/g, '').slice(0, 60) + '...' : (s.desc || '');
      return `
      <div class="section-card">
        <div class="section-card-header">
          <div class="section-card-title">
            <span>${s.icon || typeInfo.icon}</span>
            <div>
              <div style="font-size:14px;">${s.title || '区块标题'}</div>
              <span class="section-card-type">${typeInfo.name}</span>
            </div>
          </div>
          <div class="section-card-actions">
            <button class="btn btn-outline btn-sm btn-icon" onclick="moveSection(${i},-1)" ${i===0?'disabled style="opacity:0.4;cursor:not-allowed;"':''} title="上移">\u{2191}</button>
            <button class="btn btn-outline btn-sm btn-icon" onclick="moveSection(${i},1)" ${i===sections.length-1?'disabled style="opacity:0.4;cursor:not-allowed;"':''} title="下移">\u{2193}</button>
            <button class="btn btn-outline btn-sm btn-icon" onclick="duplicateSection(${i})" title="复制">&#128203;</button>
            <button class="btn btn-outline btn-sm btn-icon" onclick="editSection(${i})" title="编辑">&#9998;</button>
            <button class="btn btn-danger btn-sm btn-icon" onclick="deleteSection(${i})" title="删除">&#128465;</button>
          </div>
        </div>
        <div class="section-card-body"><div class="section-card-thumb">${thumbContent}</div><div class="section-card-info"><h4>${s.title || '区块标题'}</h4><p>${descText || '点击编辑区块内容'}</p></div></div>
      </div>
    `;}).join('');
  }

