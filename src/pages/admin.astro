  <div class="modal-overlay" id="modal-overlay" onclick="if(event.target===this)closeModal()">
    <div class="modal" id="modal-box">
      <div class="modal-header"><h3 id="modal-title">标题</h3><span class="modal-close" onclick="closeModal()">&times;</span></div>
      <div class="modal-body" id="modal-body"></div>
      <div class="modal-footer" id="modal-footer"></div>
    </div>
  </div>
  <div class="toast-container" id="toast-container"></div>

  <script is:inline>
  // ========== DATA LAYER ==========
  const LS_PREFIX = 'ov-admin-';
  const lsGet = k => { try { return JSON.parse(localStorage.getItem(LS_PREFIX + k)); } catch { return null; } };
  const lsSet = (k, v) => {
    try {
      localStorage.setItem(LS_PREFIX + k, JSON.stringify(v));
      return true;
    } catch (e) {
      console.error('lsSet error:', e);
      if (e.name === 'QuotaExceededError' || (e.message && e.message.indexOf('quota') >= 0)) {
        showToast('存储空间不足，请清理数据后重试', 'error');
      } else {
        showToast('保存失败，请重试', 'error');
      }
      return false;
    }
  };
  const randInt = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;
  const randPick = arr => arr[Math.floor(Math.random() * arr.length)];
  const daysAgo = n => { const d = new Date(); d.setDate(d.getDate() - n); return d.toISOString().slice(0, 10); };
  const formatMoney = n => '¥' + Number(n).toFixed(2);

  const FIRST_NAMES = ['张','李','王','刘','陈','杨','赵','黄','周','吴','徐','孙','马','朱','胡','郭','何','高','林','罗'];
  const GIVEN_NAMES = ['伟','芳','娜','敏','静','丽','强','磊','军','洋','勇','艳','杰','娟','涛','明','超','秀英','霞','平'];
  const genChineseName = () => randPick(FIRST_NAMES) + randPick(GIVEN_NAMES) + (Math.random() > 0.5 ? randPick(GIVEN_NAMES) : '');

  const PRODUCT_NAMES = ['水晶能量套装','风水罗盘套装','冥想香薰礼盒','能量石精选组合','七脉轮晶石套装','藏香礼盒装','佛像摆件','风铃套装','盐晶灯','颂钵套装','能量手链','风水葫芦','水晶球','香炉套装','塔罗牌套装','能量蜡烛','瑜伽垫套装','精油礼盒','水晶簇','能量树摆件'];
  const CATEGORIES = ['水晶矿石','香道香薰','禅意摆件','能量饰品','瑜伽冥想','风水器物'];
  const ORDER_STATUSES = ['pending','paid','shipped','completed','cancelled','refund'];
  const ORDER_STATUS_NAMES = { pending:'待付款', paid:'待发货', shipped:'已发货', completed:'已完成', cancelled:'已取消', refund:'退款中' };
  const SHIPPING_STATUSES = ['unshipped','in_transit','delivered','signed','returned'];
  const SHIPPING_STATUS_NAMES = { unshipped:'未发货', in_transit:'运输中', delivered:'已送达', signed:'已签收', returned:'已退回' };
  const SHIPPING_STATUS_BADGES = { unshipped:'badge-secondary', in_transit:'badge-info', delivered:'badge-success', signed:'badge-success', returned:'badge-danger' };
  const PAYMENT_METHODS = ['支付宝','微信支付','PayPal','Stripe'];
  const MEMBER_LEVELS = ['初级会员','中级会员','高级会员'];

  const PAGE_TEMPLATES = [
    { id:'home', name:'首页模板', icon:'\u{1F3E0}' },
    { id:'product', name:'商品页模板', icon:'\u{1F6CD}' },
    { id:'article', name:'文章页模板', icon:'\u{1F4DD}' },
    { id:'custom', name:'自定义模板', icon:'\u{2699}' }
  ];

  const SECTION_TYPES = [
    { id:'text', name:'文本区块', icon:'\u{1F4DD}', desc:'标题与文本内容' },
    { id:'image-text', name:'图文区块', icon:'\u{1F5BC}', desc:'图片加文字布局' },
    { id:'carousel', name:'图片轮播', icon:'\u{1F3A0}', desc:'多图轮播展示' },
    { id:'video', name:'视频区块', icon:'\u{1F3AC}', desc:'嵌入视频内容' },
    { id:'cta', name:'CTA区块', icon:'\u{1F4E2}', desc:'行动召唤区块' },
    { id:'faq', name:'FAQ区块', icon:'\u{2753}', desc:'常见问题解答' },
    { id:'features', name:'特性列表', icon:'\u{2728}', desc:'特性/功能列表' },
    { id:'pricing', name:'价格表', icon:'\u{1F4B0}', desc:'价格方案展示' }
  ];

  const CONTENT_PAGES = [
    { id:'home', name:'首页', type:'首页', template:'home', icon:'\u{1F3E0}', status:'published', desc:'网站首页，展示品牌形象与核心服务', color:'#BFAF96', group:'core' },
    { id:'shop', name:'商城页', type:'列表页', template:'product', icon:'\u{1F6CD}', status:'published', desc:'商品展示与购买页面', color:'#8A948C', group:'core' },
    { id:'services', name:'服务页', type:'内容页', template:'custom', icon:'\u{1F4BC}', status:'published', desc:'专业咨询服务介绍与预约', color:'#D4A574', group:'core' },
    { id:'courses', name:'课程页', type:'列表页', template:'article', icon:'\u{1F4DA}', status:'published', desc:'在线课程展示与报名', color:'#6B9B7A', group:'core' },
    { id:'blog', name:'博客页', type:'博客页', template:'article', icon:'\u{1F4DD}', status:'published', desc:'文章资讯与知识分享', color:'#7B8DA0', group:'core' },
    { id:'test', name:'五行测试', type:'内容页', template:'custom', icon:'\u{2728}', status:'draft', desc:'五行元素性格测试工具', color:'#C49B6B', group:'core' },
    { id:'membership', name:'会员页', type:'功能页', template:'custom', icon:'\u{2B50}', status:'published', desc:'会员等级展示与注册', color:'#A6977C', group:'core' },
    { id:'privacy', name:'隐私政策', type:'政策页', template:'article', icon:'\u{1F512}', status:'published', desc:'隐私信息保护政策说明', color:'#8A948C', group:'policy' },
    { id:'terms', name:'服务条款', type:'政策页', template:'article', icon:'\u{1F4CB}', status:'published', desc:'网站服务使用条款', color:'#8A948C', group:'policy' },
    { id:'shipping', name:'配送政策', type:'说明页', template:'article', icon:'\u{1F4E6}', status:'draft', desc:'配送与退换货政策说明', color:'#8A948C', group:'policy' }
  ];

  // Seed generators
  function genUsers(n=50) {
    const users = [];
    for (let i=1; i<=n; i++) {
      const name = genChineseName();
      const hasMember = Math.random() > 0.4;
      users.push({
        id: i, name, email: `user${i}@example.com`, phone: `138${randInt(10000000,99999999)}`,
        level: hasMember ? randPick(MEMBER_LEVELS) : '普通用户',
        registered: daysAgo(randInt(1,365)),
        lastLogin: daysAgo(randInt(0,30)) + ' ' + String(randInt(0,23)).padStart(2,'0') + ':' + String(randInt(0,59)).padStart(2,'0'),
        status: Math.random() > 0.08 ? 'active' : 'disabled',
        totalSpent: randInt(0,9999), orderCount: randInt(0,20)
      });
    }
    return users;
  }
  function genProducts(n=20) {
    const products = [];
    for (let i=1; i<=n; i++) {
      products.push({
        id: i, name: PRODUCT_NAMES[i-1] || `商品${i}`, category: randPick(CATEGORIES),
        price: randInt(49,899) + 0.9, originalPrice: randInt(100,1299) + 0.9,
        stock: randInt(10,500), sales: randInt(5,800),
        description: '精选优质商品，品质保证。', specs: ['标准规格'],
        status: Math.random() > 0.15 ? 'active' : 'inactive', createdAt: daysAgo(randInt(1,200))
      });
    }
    return products;
  }
  function genOrders(n=80, users, products) {
    const orders = [];
    for (let i=1; i<=n; i++) {
      const u = randPick(users);
      const productCount = randInt(1,3);
      const orderProducts = [];
      let total = 0;
      for (let j=0; j<productCount; j++) {
        const p = randPick(products);
        const qty = randInt(1,3);
        orderProducts.push({ productId: p.id, productName: p.name, price: p.price, qty });
        total += p.price * qty;
      }
      const status = randPick(ORDER_STATUSES);
      const discount = Math.random() > 0.7 ? randInt(5,50) : 0;
      let shippingStatus = 'unshipped';
      if (status === 'shipped') shippingStatus = randPick(['in_transit','delivered','signed']);
      else if (status === 'completed') shippingStatus = 'signed';
      else if (status === 'cancelled' || status === 'refund') shippingStatus = Math.random() > 0.5 ? 'returned' : 'unshipped';
      orders.push({
        id: 'OV' + String(20240000 + i), userId: u.id, userName: u.name, userEmail: u.email,
        products: orderProducts, totalAmount: total.toFixed(2), discount: discount.toFixed(2),
        paidAmount: (total - discount).toFixed(2), paymentMethod: randPick(PAYMENT_METHODS), status, shippingStatus,
        createdAt: daysAgo(randInt(0,60)) + ' ' + String(randInt(0,23)).padStart(2,'0') + ':' + String(randInt(0,59)).padStart(2,'0'),
