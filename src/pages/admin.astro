      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Banner高度</label><div class="size-options" id="banner-size-opts">${['small','medium','large'].map(s => `<div class="size-option ${(b.size||'medium')===s?'active':''}" data-val="${s}" onclick="setBannerSize('${s}')">${s==='small'?'小':s==='medium'?'中':'大'}</div>`).join('')}</div></div>
        <div class="form-group"><label class="form-label">文字对齐</label><div class="align-options" id="banner-align-opts">${['left','center','right'].map(a => `<div class="align-option ${(b.align||'center')===a?'active':''}" data-val="${a}" onclick="setBannerAlign('${a}')">${a==='left'?'\u{2190}':a==='center'?'\u{2194}':'\u{2192}'}</div>`).join('')}</div></div>
      </div>
      <div class="form-group"><label class="form-label">标题字号</label><div class="size-options" id="banner-title-size-opts">${['small','medium','large','xlarge'].map(s => `<div class="size-option ${(b.titleSize||'large')===s?'active':''}" data-val="${s}" onclick="setBannerTitleSize('${s}')">${s==='small'?'小':s==='medium'?'中':s==='large'?'大':'超大'}</div>`).join('')}</div></div>
    `, `<button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="saveBanner()">保存</button>`, true);
    window._bannerSize = b.size || 'medium';
    window._bannerAlign = b.align || 'center';
    window._bannerTitleSize = b.titleSize || 'large';
  }

  function setBannerSize(val) {
    window._bannerSize = val;
    document.querySelectorAll('#banner-size-opts .size-option').forEach(e => e.classList.toggle('active', e.dataset.val === val));
    updateBannerPreview();
  }
  function setBannerAlign(val) {
    window._bannerAlign = val;
    document.querySelectorAll('#banner-align-opts .align-option').forEach(e => e.classList.toggle('active', e.dataset.val === val));
    updateBannerPreview();
  }
  function setBannerTitleSize(val) {
    window._bannerTitleSize = val;
    document.querySelectorAll('#banner-title-size-opts .size-option').forEach(e => e.classList.toggle('active', e.dataset.val === val));
    updateBannerPreview();
  }

  function updateBannerPreview() {
    const title = document.getElementById('edit-banner-title')?.value || '';
    const subtitle = document.getElementById('edit-banner-subtitle')?.value || '';
    const btnText = document.getElementById('edit-banner-btn')?.value || '';
    const image = document.getElementById('edit-banner-image')?.value || '';
    const bannerEl = document.getElementById('banner-preview');
    if (!bannerEl) return;
    bannerEl.className = 'banner-edit-card banner-size-' + (window._bannerSize || 'medium') + ' banner-align-' + (window._bannerAlign || 'center');
    if (image) bannerEl.style.backgroundImage = 'url(' + image + ')';
    else bannerEl.style.backgroundImage = '';
    document.getElementById('banner-title').textContent = title || '标题';
    document.getElementById('banner-subtitle').textContent = subtitle || '副标题';
    document.getElementById('banner-btn-text').textContent = btnText || '按钮';
    const titleEl = document.getElementById('banner-title');
    const sizeMap = { small: '20px', medium: '26px', large: '32px', xlarge: '40px' };
    titleEl.style.fontSize = sizeMap[window._bannerTitleSize] || '32px';
  }

  function saveBanner() {
    const content = getContentData();
    if (!content[currentContentPage]) content[currentContentPage] = { banner:{}, sections:[], seo:{}, advanced:{} };
    content[currentContentPage].banner = {
      title: document.getElementById('edit-banner-title').value,
      subtitle: document.getElementById('edit-banner-subtitle').value,
      buttonText: document.getElementById('edit-banner-btn').value,
      buttonLink: document.getElementById('edit-banner-btn-link').value,
      image: document.getElementById('edit-banner-image').value,
      size: window._bannerSize || 'medium',
      align: window._bannerAlign || 'center',
      titleSize: window._bannerTitleSize || 'large'
    };
    content[currentContentPage].lastEdit = new Date().toISOString().slice(0, 10);
    saveContentData(content);
    const pages = getPagesData();
    const pIdx = pages.findIndex(p => p.id === currentContentPage);
    if (pIdx >= 0) { pages[pIdx].lastEdit = content[currentContentPage].lastEdit; savePagesData(pages); }
    closeModal();
    loadPageEditorData();
    showToast('Banner已更新', 'success');
  }

  function addSection() {
    openModal('选择区块类型', `
      <div style="margin-bottom:12px;font-size:13px;color:#8A948C;">选择要添加的区块类型：</div>
      <div class="section-types-grid">
        ${SECTION_TYPES.map(t => `
          <div class="section-type-card" onclick="addSectionOfType('${t.id}')">
            <div class="st-icon">${t.icon}</div>
            <div class="st-name">${t.name}</div>
            <div class="st-desc">${t.desc}</div>
          </div>
        `).join('')}
      </div>
    `, `<button class="btn btn-outline" onclick="closeModal()">取消</button>`, true);
  }

  function createSectionData(type) {
    const base = {
      id: Date.now(), type, title: '新区块', icon: '\u{2728}',
      bgColor: '', bgImage: '',
      padding: 'medium', textAlign: 'center',
      titleFont: 'sans-serif'
    };
    switch(type) {
      case 'text':
        return { ...base, title: '文本区块', content: '<p>在这里输入您的文本内容...</p>' };
      case 'image-text':
        return { ...base, title: '图文区块', content: '<p>图文区块描述文字...</p>', image: '', imagePosition: 'left' };
      case 'carousel':
        return { ...base, title: '图片轮播', images: ['', '', ''] };
      case 'video':
        return { ...base, title: '视频区块', videoUrl: '', videoDesc: '' };
      case 'cta':
        return { ...base, title: '立即行动', ctaText: '点击了解', ctaLink: '#', ctaSubtitle: '加入我们，开启新旅程' };
      case 'faq':
        return { ...base, title: '常见问题', faqs: [{ q: '问题1？', a: '回答内容...' }, { q: '问题2？', a: '回答内容...' }] };
      case 'features':
        return { ...base, title: '核心特性', features: [{ icon: '\u{2728}', title: '特性1', desc: '描述文字' }, { icon: '\u{1F48E}', title: '特性2', desc: '描述文字' }, { icon: '\u{1F338}', title: '特性3', desc: '描述文字' }] };
      case 'pricing':
        return { ...base, title: '价格方案', plans: [{ name: '基础版', price: '99', features: ['功能1', '功能2'], featured: false }, { name: '专业版', price: '299', features: ['功能1', '功能2', '功能3'], featured: true }] };
      default:
        return { ...base, content: '<p>内容...</p>' };
    }
  }

  function addSectionOfType(type) {
    const content = getContentData();
    if (!content[currentContentPage]) content[currentContentPage] = { banner:{}, sections:[], seo:{}, advanced:{} };
    content[currentContentPage].sections.push(createSectionData(type));
    content[currentContentPage].lastEdit = new Date().toISOString().slice(0, 10);
    saveContentData(content);
    const pages = getPagesData();
    const pIdx = pages.findIndex(p => p.id === currentContentPage);
    if (pIdx >= 0) { pages[pIdx].lastEdit = content[currentContentPage].lastEdit; savePagesData(pages); }
    closeModal();
    renderSectionsForEditor();
    showToast('区块已添加', 'success');
  }

  function duplicateSection(idx) {
    const content = getContentData();
    const sections = content[currentContentPage].sections;
    const copy = JSON.parse(JSON.stringify(sections[idx]));
    copy.id = Date.now();
    sections.splice(idx + 1, 0, copy);
    content[currentContentPage].lastEdit = new Date().toISOString().slice(0, 10);
    saveContentData(content);
    renderSectionsForEditor();
    showToast('区块已复制', 'success');
  }

  function editSection(idx) {
    editingSectionIdx = idx;
    const content = getContentData();
    const s = content[currentContentPage]?.sections?.[idx];
    if (!s) return;
    const typeInfo = SECTION_TYPES.find(t => t.id === s.type) || SECTION_TYPES[0];
    let bodyHTML = `
      <div class="form-group"><label class="form-label">区块标题</label><input class="form-input" id="sec-title" value="${(s.title||'').replace(/"/g,'&quot;')}" /></div>
      <div class="form-group"><label class="form-label">图标 (emoji)</label><input class="form-input" id="sec-icon" value="${(s.icon||'').replace(/"/g,'&quot;')}" /></div>
    `;
    if (s.type === 'text') {
      bodyHTML += `
        <div class="form-group"><label class="form-label">内容</label>
