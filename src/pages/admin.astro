        <div class="gallery-upload-btns">
          <button class="btn btn-outline btn-sm" type="button" onclick="uploadDetailImage()">&#8683; 上传详情图</button>
          <button class="btn btn-outline btn-sm" type="button" onclick="addDetailImageByUrl()">&#128279; 输入URL</button>
        </div>
        <div class="form-hint">用于商品详情页展示，建议宽度 750px 以上</div>
      </div>
      <div class="form-group"><label class="form-label">商品描述</label><textarea class="form-textarea" id="p-desc" rows="5">${p?.description||''}</textarea></div>
    `, `<button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="saveProduct(${isEdit?p.id:0})">${isEdit?'保存':'新增'}</button>`, true);
  }

  function setMainImage(index) {
    if (index < 0 || index >= _galleryImages.length) return;
    _mainImageIndex = index;
    const mainPreview = document.getElementById('p-main-preview');
    if (mainPreview) {
      mainPreview.innerHTML = `<span class="main-tag">封面</span><img src="${_galleryImages[index]}" alt="" />`;
    }
    const thumbs = document.querySelectorAll('#p-gallery-thumbs .product-thumb-item');
    thumbs.forEach((thumb, i) => {
      thumb.classList.toggle('active', i === index);
      thumb.classList.toggle('is-main', i === index);
    });
  }

  function uploadGalleryImage() {
    uploadImage(function(dataUrl) {
      _galleryImages.push(dataUrl);
      renderGalleryThumbs();
      if (_galleryImages.length === 1) setMainImage(0);
    });
  }

  function addGalleryImageByUrl() {
    const url = prompt('请输入商品图片URL：');
    if (!url) return;
    _galleryImages.push(url);
    renderGalleryThumbs();
    if (_galleryImages.length === 1) setMainImage(0);
  }

  function removeGalleryImage(index) {
    _galleryImages.splice(index, 1);
    if (_mainImageIndex >= _galleryImages.length) {
      _mainImageIndex = Math.max(0, _galleryImages.length - 1);
    }
    renderGalleryThumbs();
    const mainPreview = document.getElementById('p-main-preview');
    if (mainPreview) {
      if (_galleryImages.length > 0) {
        mainPreview.innerHTML = `<span class="main-tag">封面</span><img src="${_galleryImages[_mainImageIndex]}" alt="" />`;
      } else {
        mainPreview.innerHTML = '<div class="product-image-placeholder" style="color:#8A948C;display:flex;flex-direction:column;align-items:center;gap:8px;">&#128247;<span style="font-size:13px;">暂无图片</span></div>';
      }
    }
  }

  function renderGalleryThumbs() {
    const container = document.getElementById('p-gallery-thumbs');
    if (!container) return;
    container.innerHTML = _galleryImages.map((img, i) => `
      <div class="product-thumb-item ${i===_mainImageIndex?'active':''} ${i===0?'is-main':''}" onclick="setMainImage(${i})">
        <img src="${img}" alt="" />
        <button class="product-thumb-del" onclick="event.stopPropagation();removeGalleryImage(${i})">&times;</button>
      </div>
    `).join('') + '<div class="product-thumb-add" onclick="uploadGalleryImage()" title="上传图片">+</div>';
  }

  function uploadDetailImage() {
    uploadImage(function(dataUrl) {
      _detailImages.push(dataUrl);
      renderDetailImages();
    });
  }

  function addDetailImageByUrl() {
    const url = prompt('请输入详情图片URL：');
    if (!url) return;
    _detailImages.push(url);
    renderDetailImages();
  }

  function removeDetailImage(idx) {
    _detailImages.splice(idx, 1);
    renderDetailImages();
  }

  function renderDetailImages() {
    const container = document.getElementById('p-detail-images');
    if (!container) return;
    container.innerHTML = _detailImages.map((img, i) => `
      <div class="product-detail-img-item">
        <img src="${img}" alt="" />
        <button class="product-detail-img-del" onclick="removeDetailImage(${i})">&times;</button>
      </div>
    `).join('') + `
      <div class="product-detail-img-add" onclick="uploadDetailImage()">
        <span class="add-icon">+</span>
        <span class="add-text">添加详情图</span>
      </div>`;
  }

  function saveProduct(id) {
    const products = lsGet('products') || [];
    const name = document.getElementById('p-name').value.trim();
    if (!name) { showToast('请输入商品名称', 'error'); return; }
    const mainImage = _galleryImages[_mainImageIndex] || _galleryImages[0] || '';
    const data = {
      name,
      category: document.getElementById('p-category').value,
      price: parseFloat(document.getElementById('p-price').value)||0,
      originalPrice: parseFloat(document.getElementById('p-original').value)||0,
      stock: parseInt(document.getElementById('p-stock').value)||0,
      description: document.getElementById('p-desc').value,
      status: document.getElementById('p-status').value,
      image: mainImage,
      images: [..._galleryImages],
      detailImages: [..._detailImages]
    };
    if (id) { const idx = products.findIndex(p => p.id===id); if (idx>=0) products[idx] = { ...products[idx], ...data }; }
    else { const maxId = products.reduce((m,p)=>Math.max(m,p.id),0); products.push({ id: maxId+1, sales: 0, createdAt: new Date().toISOString().slice(0,10), ...data }); }
    if (lsSet('products', products)) {
      showToast(id ? '商品已更新' : '商品已添加', 'success');
      closeModal();
      renderProducts();
    }
  }
  function toggleProductStatus(id) {
    const products = lsGet('products') || [];
    const p = products.find(x => x.id === id);
    if (!p) return;
    p.status = p.status === 'active' ? 'inactive' : 'active';
    lsSet('products', products); renderProducts();
    showToast('状态已更新', 'success');
  }
  function renderCategories() {
    const categories = lsGet('categories') || [];
    document.getElementById('categories-list').innerHTML = categories.length === 0 ?
      `<div class="empty-state"><div class="empty-state-icon">\u{1F4C2}</div><p>暂无分类</p></div>` :
      `<table class="data-table"><thead><tr><th>ID</th><th>分类名称</th><th>商品数量</th><th>排序</th><th>操作</th></tr></thead><tbody>${categories.map(c => `<tr><td>${c.id}</td><td style="font-weight:500;">${c.name}</td><td>${c.productCount}</td><td>${c.sort}</td><td><button class="btn btn-outline btn-sm" onclick="editCategory(${c.id})">编辑</button> <button class="btn btn-danger btn-sm" onclick="deleteCategory(${c.id})">删除</button></td></tr>`).join('')}</tbody></table>`;
  }
  function openCategoryModal(catId) {
    const categories = lsGet('categories') || [];
    const c = catId ? categories.find(x => x.id === catId) : null;
    const isEdit = !!c;
    openModal(isEdit ? '编辑分类' : '新增分类', `
      <div class="form-group"><label class="form-label">分类名称</label><input class="form-input" id="cat-name" value="${c?.name||''}" /></div>
      <div class="form-group"><label class="form-label">排序</label><input class="form-input" type="number" id="cat-sort" value="${c?.sort||0}" /></div>
    `, `<button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="saveCategory(${isEdit?c.id:0})">${isEdit?'保存':'新增'}</button>`);
  }
  function editCategory(id) { openCategoryModal(id); }
  function saveCategory(id) {
    const categories = lsGet('categories') || [];
    const name = document.getElementById('cat-name').value.trim();
    if (!name) { showToast('请输入分类名称', 'error'); return; }
    if (id) { const c = categories.find(x => x.id===id); if (c) { c.name = name; c.sort = parseInt(document.getElementById('cat-sort').value)||0; } showToast('分类已更新', 'success'); }
    else { const maxId = categories.reduce((m,c)=>Math.max(m,c.id),0); categories.push({ id: maxId+1, name, productCount: 0, sort: parseInt(document.getElementById('cat-sort').value)||0 }); showToast('分类已添加', 'success'); }
    lsSet('categories', categories); closeModal(); renderCategories();
  }
  function deleteCategory(id) {
    if (!confirm('确定删除该分类吗？')) return;
    let categories = lsGet('categories') || [];
    categories = categories.filter(c => c.id !== id);
    lsSet('categories', categories); renderCategories();
    showToast('分类已删除', 'success');
  }

  // ========== USERS ==========
  let userTab = 'all', userSortKey = 'id', userSortDir = -1, userPage = 1;
  const USER_PAGE_SIZE = 10;
  function setUserTab(tab, btn) {
    userTab = tab; userPage = 1;
    if (!btn) {
      const tabs = document.querySelectorAll('#page-users .tab-bar .tab-item');
      tabs.forEach(b => {
        const isActive = (tab === 'all' && b.textContent.includes('全部')) ||
                         (tab === 'member' && b.textContent.includes('会员')) ||
                         (tab === 'disabled' && b.textContent.includes('禁用'));
        b.classList.toggle('active', isActive);
      });
    } else {
      btn.parentElement.querySelectorAll('.tab-item').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }
    renderUsers();
  }
  function renderUsers() {
    const users = lsGet('users') || [];
    const search = (document.getElementById('user-search')?.value || '').toLowerCase();
    const levelFilter = document.getElementById('user-level-filter')?.value || '';
    const statusFilter = document.getElementById('user-status-filter')?.value || '';
    let filtered = users.filter(u => {
      if (userTab === 'member' && !MEMBER_LEVELS.includes(u.level)) return false;
      if (userTab === 'disabled' && u.status !== 'disabled') return false;
      if (search && !u.name.toLowerCase().includes(search) && !u.email.toLowerCase().includes(search)) return false;
      if (levelFilter && u.level !== levelFilter) return false;
      if (statusFilter && u.status !== statusFilter) return false;
      return true;
    });
    filtered.sort((a, b) => {
      const va = a[userSortKey], vb = b[userSortKey];
      if (typeof va === 'string') return va.localeCompare(vb) * userSortDir;
      return (va - vb) * userSortDir;
    });
    const totalPages = Math.ceil(filtered.length / USER_PAGE_SIZE);
    if (userPage > totalPages) userPage = Math.max(1, totalPages);
    const pageData = filtered.slice((userPage-1)*USER_PAGE_SIZE, userPage*USER_PAGE_SIZE);
    document.getElementById('users-body').innerHTML = pageData.map(u => `
      <tr>
        <td>${u.id}</td>
        <td><div class="user-cell"><div class="avatar">${u.name.slice(0,1)}</div><div><div class="name">${u.name}</div></div></div></td>
        <td>${u.email}</td>
        <td><span class="badge ${MEMBER_LEVELS.includes(u.level)?'badge-accent':'badge-secondary'}">${u.level}</span></td>
        <td>${u.registered}</td>
        <td>${u.lastLogin}</td>
        <td><span class="badge ${statusBadge(u.status)}">${u.status==='active'?'正常':'已禁用'}</span></td>
        <td><div class="table-actions"><button class="btn btn-outline btn-sm" onclick="viewUser(${u.id})">详情</button><button class="btn ${u.status==='active'?'btn-warning':'btn-success'} btn-sm" onclick="toggleUserStatus(${u.id})">${u.status==='active'?'禁用':'启用'}</button></div></td>
      </tr>
    `).join('');
    renderPagination('users-pagination', userPage, totalPages, 'gotoUserPage');
  }
  function gotoUserPage(p) { userPage = p; renderUsers(); }
  function sortUsers(key) {
    if (userSortKey === key) userSortDir *= -1;
    else { userSortKey = key; userSortDir = 1; }
    renderUsers();
  }
  function viewUser(id) {
    const users = lsGet('users') || [];
    const orders = lsGet('orders') || [];
    const u = users.find(x => x.id === id);
    if (!u) return;
    const userOrders = orders.filter(o => o.userId === id);
    openModal('用户详情', `
      <div style="display:flex;align-items:center;gap:18px;margin-bottom:22px;padding-bottom:18px;border-bottom:1px solid #E8E4DE;">
