                  </div>
                `).join('')}
                <div class="product-thumb-add" onclick="uploadGalleryImage()" title="上传图片">+</div>
              </div>
              <div class="gallery-upload-btns">
                <button class="btn btn-outline btn-sm" type="button" onclick="uploadGalleryImage()">&#8683; 本地上传</button>
