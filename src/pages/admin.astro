---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>东方能量空间 - 管理后台</title>
  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;background:#FAFAF8;color:#3A403D;min-height:100vh;font-size:14px;line-height:1.6}
    a{text-decoration:none;color:inherit}
    button{cursor:pointer;font-family:inherit;border:none;background:none;color:inherit}
    input,select,textarea{font-family:inherit}
    table{border-collapse:collapse;width:100%}

    /* LOGIN */
    .login-page{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#F5F1EB 0%,#E8E0D4 100%);padding:20px}
    .login-card{background:#fff;border-radius:16px;padding:48px 40px;box-shadow:0 20px 60px rgba(58,64,61,.12);width:100%;max-width:420px;animation:slideUp .5s ease}
    @keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    .login-logo{text-align:center;margin-bottom:32px}
    .login-logo-icon{width:64px;height:64px;margin:0 auto 16px;background:linear-gradient(135deg,#BFAF96,#8A948C);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:32px;color:#fff}
    .login-logo h1{font-size:22px;color:#3A403D;font-weight:600;margin-bottom:6px}
    .login-logo p{font-size:13px;color:#8A948C}
    .login-form .form-group{margin-bottom:20px}
    .login-form label{display:block;font-size:13px;font-weight:500;color:#3A403D;margin-bottom:8px}
    .login-form input{width:100%;padding:12px 16px;border:1px solid #E8E4DE;border-radius:10px;font-size:14px;transition:all .2s;background:#FAFAF8}
    .login-form input:focus{outline:none;border-color:#BFAF96;background:#fff;box-shadow:0 0 0 4px rgba(191,175,150,.15)}
    .login-error{background:#FCE8E8;color:#C47B6B;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:16px;display:none;animation:shake .3s ease}
    .login-error.show{display:block}
    @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
    .login-options{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;font-size:13px}
    .remember-me{display:flex;align-items:center;gap:6px;color:#6B726F;cursor:pointer}
    .remember-me input{width:auto;margin:0}
    .login-btn{width:100%;padding:14px;background:linear-gradient(135deg,#BFAF96,#A6977C);color:#fff;border-radius:10px;font-size:15px;font-weight:600;transition:all .2s}
    .login-btn:hover{background:linear-gradient(135deg,#A6977C,#8A7A60);transform:translateY(-1px);box-shadow:0 4px 12px rgba(191,175,150,.3)}
    .login-btn:active{transform:scale(.98)}
    .login-footer{text-align:center;margin-top:32px;font-size:12px;color:#8A948C}

    /* LAYOUT */
    .admin-layout{display:none;min-height:100vh}
    .admin-layout.show{display:flex}
    .sidebar{width:250px;min-height:100vh;background:#2D3130;color:#C8CCC9;display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100;transition:transform .3s ease}
    .sidebar-brand{padding:20px 20px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:12px;white-space:nowrap;overflow:hidden;flex-shrink:0}
    .sidebar-brand-icon{width:40px;height:40px;background:linear-gradient(135deg,#BFAF96,#8A948C);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;flex-shrink:0}
    .sidebar-brand-text h2{font-size:16px;color:#F5F1EB;font-weight:600}
    .sidebar-brand-text span{font-size:11px;color:#8A948C}
    .sidebar-nav{flex:1;padding:12px 0;overflow-y:auto;overflow-x:hidden}
    .nav-section{padding:12px 20px 6px;font-size:11px;color:#6B726F;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
    .nav-item{display:flex;align-items:center;gap:12px;padding:10px 16px;color:#A8B0A9;font-size:13px;cursor:pointer;transition:all .2s;white-space:nowrap;position:relative;margin:2px 12px;border-radius:12px}
    .nav-item:hover{background:rgba(255,255,255,.06);color:#F5F1EB}
    .nav-item.active{background:linear-gradient(135deg,#BFAF96,#A6977C);color:#fff;font-weight:500;box-shadow:0 2px 8px rgba(191,175,150,.3)}
    .nav-item .nav-icon{font-size:16px;flex-shrink:0;width:20px;text-align:center}
    .sidebar-footer{padding:12px;border-top:1px solid rgba(255,255,255,.08);flex-shrink:0}
    .admin-user{display:flex;align-items:center;gap:10px;padding:10px;border-radius:12px;cursor:pointer;transition:background .2s;white-space:nowrap;overflow:hidden}
    .admin-user:hover{background:rgba(255,255,255,.06)}
    .admin-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#BFAF96,#8A948C);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;flex-shrink:0}
    .admin-info .name{font-size:13px;color:#F5F1EB;font-weight:500}
    .admin-info .role{font-size:11px;color:#8A948C}

    .main-content{flex:1;margin-left:250px;min-height:100vh;background:#FAFAF8}
    .top-bar{background:#fff;border-bottom:1px solid #E8E4DE;padding:14px 28px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:50}
    .top-bar-left{display:flex;align-items:center;gap:16px}
    .menu-toggle{font-size:20px;color:#6B726F;cursor:pointer;display:none;padding:6px 10px;border-radius:8px;transition:all .2s}
    .menu-toggle:hover{background:#F5F1EB;color:#3A403D}
    .page-title{font-size:18px;font-weight:600;color:#3A403D}
    .top-bar-right{display:flex;align-items:center;gap:12px}
    .top-bar-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#6B726F;cursor:pointer;transition:all .2s;position:relative;font-size:18px}
    .top-bar-icon:hover{background:#F5F1EB;color:#3A403D}
    .top-bar-icon .badge-dot{position:absolute;top:8px;right:8px;width:8px;height:8px;background:#C47B6B;border-radius:50%;border:2px solid #fff}

    .page-content{padding:28px}
    .page-section{display:none;animation:fadeIn .3s ease}
    .page-section.active{display:block}
    @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
    .page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px}
    .page-header h1{font-size:24px;font-weight:700;color:#3A403D;letter-spacing:-.3px}
    .page-header-actions{display:flex;gap:10px}

    /* BUTTONS */
    .btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:500;transition:all .2s;white-space:nowrap;border:none;cursor:pointer}
    .btn:active{transform:scale(.97)}
    .btn-primary{background:linear-gradient(135deg,#BFAF96,#A6977C);color:#fff;box-shadow:0 2px 6px rgba(191,175,150,.25)}
    .btn-primary:hover{background:linear-gradient(135deg,#A6977C,#8A7A60);box-shadow:0 4px 12px rgba(191,175,150,.35);transform:translateY(-1px)}
    .btn-secondary{background:#3A403D;color:#fff}
    .btn-secondary:hover{background:#2d3230}
    .btn-outline{border:1px solid #E8E4DE;color:#3A403D;background:#fff}
    .btn-outline:hover{border-color:#BFAF96;color:#BFAF96;background:#FFFDF9}
    .btn-success{background:linear-gradient(135deg,#6B9B7A,#5A8A69);color:#fff}
    .btn-success:hover{background:linear-gradient(135deg,#5A8A69,#4A7A59)}
    .btn-warning{background:linear-gradient(135deg,#D4A574,#C49460);color:#fff}
    .btn-warning:hover{background:linear-gradient(135deg,#C49460,#B48450)}
    .btn-danger{background:linear-gradient(135deg,#C47B6B,#B06959);color:#fff}
    .btn-danger:hover{background:linear-gradient(135deg,#B06959,#A05949)}
    .btn-sm{padding:6px 12px;font-size:12px;border-radius:8px}
    .btn-icon{width:34px;height:34px;padding:0;justify-content:center;border-radius:8px;font-size:14px}

    /* CARDS */
    .card{background:#fff;border-radius:12px;padding:22px;box-shadow:0 1px 3px rgba(58,64,61,.04),0 1px 2px rgba(58,64,61,.03);border:1px solid #E8E4DE;transition:all .25s ease}
    .card:hover{box-shadow:0 6px 20px rgba(58,64,61,.06),0 2px 6px rgba(58,64,61,.04)}
    .card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
    .card-title{font-size:16px;font-weight:600;color:#3A403D}
    .card-subtitle{font-size:12px;color:#8A948C;margin-top:4px}

    /* STATS */
    .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:22px}
    .stat-card{background:#fff;border-radius:12px;padding:22px;border:1px solid #E8E4DE;transition:all .25s;position:relative;overflow:hidden}
    .stat-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(58,64,61,.08)}
    .stat-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
    .stat-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px}
    .stat-icon.blue{background:linear-gradient(135deg,#E8F0FA,#D4E4F5);color:#2a5d9a}
    .stat-icon.green{background:linear-gradient(135deg,#E8F5E8,#D4EBD4);color:#5a7a5a}
    .stat-icon.orange{background:linear-gradient(135deg,#FFF5E6,#FFE8CC);color:#9a6b00}
    .stat-icon.purple{background:linear-gradient(135deg,#F5E8F5,#EBD4EB);color:#7a2a9a}
    .stat-label{font-size:13px;color:#8A948C;margin-bottom:6px}
    .stat-value{font-size:30px;font-weight:700;color:#3A403D;letter-spacing:-.5px}
    .stat-change{font-size:12px;margin-top:10px;display:flex;align-items:center;gap:4px;font-weight:500}
    .stat-change.up{color:#6B9B7A}
    .stat-change.down{color:#C47B6B}

    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:22px}
    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:22px}

    /* TABLE */
    .table-wrapper{background:#fff;border-radius:12px;border:1px solid #E8E4DE;overflow:hidden;box-shadow:0 1px 3px rgba(58,64,61,.04)}
    .data-table th{background:#FAFAF8;padding:14px 18px;text-align:left;font-size:12px;font-weight:600;color:#6B726F;text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid #E8E4DE;cursor:pointer;user-select:none;white-space:nowrap}
    .data-table th:hover{color:#3A403D}
    .data-table th .sort-arrow{margin-left:4px;font-size:10px;opacity:.4}
    .data-table th.sorted .sort-arrow{opacity:1}
    .data-table td{padding:14px 18px;border-bottom:1px solid #F0EDE8;font-size:13px;color:#3A403D}
    .data-table tbody tr:hover{background:#F5F1EB}
    .data-table tbody tr:nth-child(even){background:#FAFAF8}
    .data-table tbody tr:nth-child(even):hover{background:#F5F1EB}
    .table-actions{display:flex;gap:6px}

    /* BADGES */
    .badge{display:inline-block;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600}
    .badge-success{background:#E8F5E8;color:#5a7a5a}
    .badge-warning{background:#FFF5E6;color:#9a6b00}
    .badge-info{background:#E8F0FA;color:#2a5d9a}
    .badge-danger{background:#FCE8E8;color:#A55040}
    .badge-secondary{background:#F0EFED;color:#6B726F}
    .badge-accent{background:#F5F0E8;color:#8a7a5a}

    /* TOOLBAR */
    .toolbar{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;align-items:center}
    .search-box{position:relative;flex:1;min-width:200px;max-width:320px}
    .search-box input{width:100%;padding:10px 14px 10px 38px;border:1px solid #E8E4DE;border-radius:10px;font-size:13px;background:#fff;transition:all .2s}
    .search-box input:focus{outline:none;border-color:#BFAF96;box-shadow:0 0 0 4px rgba(191,175,150,.1)}
    .search-box::before{content:'\1F50D';position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:13px;opacity:.5}
    .filter-select{padding:10px 14px;border:1px solid #E8E4DE;border-radius:10px;font-size:13px;background:#fff;color:#3A403D;cursor:pointer;transition:all .2s}
    .filter-select:focus{outline:none;border-color:#BFAF96;box-shadow:0 0 0 4px rgba(191,175,150,.1)}

    /* TABS */
    .tab-bar{display:flex;gap:0;border-bottom:2px solid #E8E4DE;margin-bottom:22px;overflow-x:auto}
    .tab-item{padding:12px 22px;font-size:13px;color:#6B726F;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .2s;white-space:nowrap;flex-shrink:0;font-weight:500}
    .tab-item:hover{color:#3A403D}
    .tab-item.active{color:#BFAF96;border-bottom-color:#BFAF96;font-weight:600}

    /* FORM */
    .form-group{margin-bottom:18px}
    .form-label{display:block;font-size:13px;font-weight:500;color:#3A403D;margin-bottom:8px}
    .form-label .required{color:#C47B6B;margin-left:2px}
    .form-input,.form-select,.form-textarea{width:100%;padding:10px 14px;border:1px solid #E8E4DE;border-radius:10px;font-size:13px;background:#fff;color:#3A403D;transition:all .2s}
    .form-input:focus,.form-select:focus,.form-textarea:focus{outline:none;border-color:#BFAF96;box-shadow:0 0 0 4px rgba(191,175,150,.1)}
    .form-textarea{resize:vertical;min-height:90px}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .form-hint{font-size:12px;color:#8A948C;margin-top:6px}

    /* MODAL */
    .modal-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(58,64,61,.5);backdrop-filter:blur(4px);z-index:1000;justify-content:center;align-items:center;padding:20px}
    .modal-overlay.active{display:flex;animation:fadeIn .2s ease}
    .modal{background:#fff;border-radius:14px;width:100%;max-width:600px;max-height:85vh;overflow-y:auto;box-shadow:0 24px 60px rgba(0,0,0,.18);animation:modalIn .25s ease}
    .modal.large{max-width:800px}
    @keyframes modalIn{from{opacity:0;transform:scale(.95) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}
    .modal-header{display:flex;justify-content:space-between;align-items:center;padding:20px 26px;border-bottom:1px solid #E8E4DE;position:sticky;top:0;background:#fff;border-radius:14px 14px 0 0}
    .modal-header h3{font-size:18px;font-weight:600;color:#3A403D}
    .modal-close{font-size:24px;color:#8A948C;cursor:pointer;line-height:1;padding:4px 8px;border-radius:8px;transition:all .2s}
    .modal-close:hover{color:#3A403D;background:#F5F1EB}
    .modal-body{padding:26px}
    .modal-footer{padding:18px 26px;border-top:1px solid #E8E4DE;display:flex;justify-content:flex-end;gap:10px;position:sticky;bottom:0;background:#fff;border-radius:0 0 14px 14px}

    /* CHARTS */
    .chart-wrap{display:flex;align-items:center;gap:28px}
    .donut-chart{width:160px;height:160px;border-radius:50%;position:relative;flex-shrink:0}
    .donut-chart::after{content:'';position:absolute;top:25%;left:25%;right:25%;bottom:25%;background:#fff;border-radius:50%}
    .donut-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;z-index:1}
    .donut-center .val{font-size:24px;font-weight:700;color:#3A403D}
    .donut-center .lbl{font-size:11px;color:#8A948C;margin-top:2px}
    .chart-legend{display:flex;flex-direction:column;gap:12px;flex:1}
    .legend-item{display:flex;align-items:center;gap:10px;font-size:13px}
    .legend-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
    .legend-label{color:#3A403D;flex:1}
    .legend-value{color:#8A948C;font-weight:600}

    .h-bar-list{display:flex;flex-direction:column;gap:14px}
    .h-bar-item{display:flex;align-items:center;gap:14px}
    .h-bar-label{width:100px;font-size:12px;color:#3A403D;flex-shrink:0;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500}
    .h-bar-track{flex:1;height:26px;background:#F5F1EB;border-radius:6px;overflow:hidden;position:relative}
    .h-bar-fill{height:100%;border-radius:6px;transition:width .6s ease;background:linear-gradient(90deg,#BFAF96,#A6977C)}
    .h-bar-value{width:55px;font-size:12px;color:#6B726F;text-align:right;flex-shrink:0;font-weight:500}

    /* ===== CONTENT MANAGEMENT - CLEAN DESIGN ===== */
    .cm-page-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px;}
    .cm-page-header h1{font-size:22px;font-weight:600;color:#3A403D;margin:0 0 6px 0;letter-spacing:-.2px;}
    .cm-page-header p{font-size:13px;color:#8A948C;margin:0;}

    .cm-page-group{margin-bottom:28px;}
    .cm-group-title{font-size:12px;font-weight:600;color:#8A948C;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;padding-left:2px;}

    .cm-page-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;}

    .cm-page-card{background:#fff;border:1px solid #E8E4DE;border-radius:10px;padding:18px;cursor:pointer;transition:all .2s ease;position:relative;display:block;}
    .cm-page-card:hover{border-color:#BFAF96;box-shadow:0 4px 12px rgba(58,64,61,.06);transform:translateY(-1px);}
    .cm-page-card-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;flex-direction:row;}
    .cm-page-card-icon{width:42px;height:42px;border-radius:10px;background:#F5F1EB;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
    .cm-page-card-status{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:500;white-space:nowrap;}
    .cm-page-card-status.published{background:#E8F5E8;color:#5a7a5a;}
    .cm-page-card-status.draft{background:#FFF5E6;color:#9a6b00;}
    .cm-page-card-name{font-size:15px;font-weight:600;color:#3A403D;margin-bottom:4px;display:block;}
    .cm-page-card-type{font-size:12px;color:#8A948C;margin-bottom:12px;display:block;}
    .cm-page-card-meta{display:flex;justify-content:space-between;align-items:center;padding-top:12px;border-top:1px solid #F0EDE8;flex-direction:row;}
    .cm-page-card-date{font-size:11px;color:#8A948C;}
    .cm-page-card-actions{display:flex;gap:6px;flex-direction:row;}
    .cm-page-card-btn{width:28px;height:28px;border-radius:6px;border:1px solid #E8E4DE;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;color:#6B726F;transition:all .15s;padding:0;line-height:1;}
    .cm-page-card-btn:hover{border-color:#BFAF96;color:#BFAF96;}
    .cm-page-card-btn.danger:hover{border-color:#C47B6B;color:#C47B6B;}

    /* Editor View */
    .cm-breadcrumb{display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:20px;color:#8A948C;}
    .cm-breadcrumb-link{color:#BFAF96;cursor:pointer;font-weight:500;transition:color .2s;}
    .cm-breadcrumb-link:hover{color:#A6977C;}
    .cm-breadcrumb-sep{opacity:.5;}
    .cm-breadcrumb-current{color:#3A403D;font-weight:500;}

    .cm-editor-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid #E8E4DE;}
    .cm-editor-title{display:flex;align-items:center;gap:14px;}
    .cm-editor-icon{width:48px;height:48px;border-radius:12px;background:#F5F1EB;display:flex;align-items:center;justify-content:center;font-size:22px;}
    .cm-editor-title h2{font-size:20px;font-weight:600;color:#3A403D;margin:0 0 4px 0;}
    .cm-editor-sub{font-size:12px;color:#8A948C;}
    .cm-editor-actions{display:flex;gap:10px;}

    .cm-editor-tabs{display:flex;gap:0;border-bottom:1px solid #E8E4DE;margin-bottom:24px;}
    .cm-editor-tab{display:flex;align-items:center;gap:8px;padding:12px 20px;font-size:13px;color:#6B726F;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s;font-weight:500;white-space:nowrap;}
    .cm-editor-tab:hover{color:#3A403D;}
    .cm-editor-tab.active{color:#BFAF96;border-bottom-color:#BFAF96;font-weight:600;}
    .cm-tab-icon{font-size:15px;}

    .cm-tab-panel{animation:fadeIn .2s ease;}
    .cm-panel-section{background:#fff;border:1px solid #E8E4DE;border-radius:10px;padding:22px;margin-bottom:18px;}
    .cm-panel-section:last-child{margin-bottom:0;}
    .cm-panel-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
    .cm-panel-title{font-size:15px;font-weight:600;color:#3A403D;}

    .cm-media-subtabs{display:flex;gap:4px;margin-bottom:18px;padding:4px;background:#F5F1EB;border-radius:8px;width:fit-content;}
    .cm-media-tab{padding:7px 16px;border-radius:6px;cursor:pointer;transition:all .2s;font-size:13px;font-weight:500;color:#6B726F;}
    .cm-media-tab:hover{color:#3A403D;}
    .cm-media-tab.active{background:#fff;color:#BFAF96;font-weight:600;box-shadow:0 1px 2px rgba(58,64,61,.04);}

    .media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:14px;}
    .media-item{position:relative;border-radius:10px;overflow:hidden;background:#FAFAF8;border:1px solid #E8E4DE;transition:all .2s;cursor:pointer;}
    .media-item:hover{border-color:#BFAF96;transform:translateY(-2px);box-shadow:0 4px 12px rgba(58,64,61,.08);}
    .media-item-thumb{width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:40px;background:#F5F1EB;overflow:hidden;}
    .media-item-thumb img{width:100%;height:100%;object-fit:cover;}
    .media-item-overlay{position:absolute;bottom:0;left:0;right:0;padding:10px;background:linear-gradient(transparent,rgba(0,0,0,.7));color:#fff;opacity:0;transition:opacity .2s;}
    .media-item:hover .media-item-overlay{opacity:1;}
    .media-item-name{font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:6px;}
    .media-item-actions{display:flex;gap:6px;}
    .media-item-btn{flex:1;padding:4px 8px;border:none;border-radius:4px;background:rgba(255,255,255,.2);color:#fff;font-size:12px;cursor:pointer;transition:background .2s;}
    .media-item-btn:hover{background:rgba(255,255,255,.35);}
    .media-item-btn.danger:hover{background:#C47B6B;}
    .video-grid .media-item-thumb{position:relative;}
    .video-play-icon{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:36px;color:#fff;text-shadow:0 2px 8px rgba(0,0,0,.5);pointer-events:none;}

    .cm-empty-state{padding:48px 24px;text-align:center;color:#8A948C;}
    .cm-empty-icon{font-size:48px;margin-bottom:12px;opacity:.6;}

    .media-picker-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px;max-height:400px;overflow-y:auto;}
    .media-picker-item{aspect-ratio:1;border-radius:8px;overflow:hidden;border:2px solid #E8E4DE;cursor:pointer;transition:all .2s;background:#F5F1EB;display:flex;align-items:center;justify-content:center;}
    .media-picker-item:hover{border-color:#BFAF96;transform:scale(1.03);}
    .media-picker-item img{width:100%;height:100%;object-fit:cover;}
    .media-picker-item-icon{font-size:32px;opacity:.6;}

    @media(max-width:768px){
      .cm-page-header{flex-direction:column;gap:14px;}
      .cm-page-grid{grid-template-columns:1fr;}
      .cm-editor-header{flex-direction:column;align-items:flex-start;gap:14px;}
      .cm-editor-tabs{overflow-x:auto;scrollbar-width:none;}
      .cm-editor-tabs::-webkit-scrollbar{display:none;}
      .cm-editor-tab{padding:10px 14px;font-size:12px;}
      .cm-panel-section{padding:16px;}
    }

    /* ===== PRODUCT IMAGE UPLOAD - E-COMMERCE STYLE ===== */
    .product-gallery { margin-top: 8px; }
    .product-gallery-main {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      margin-bottom: 16px;
    }
    .product-main-image {
      width: 280px;
      height: 280px;
      border: 2px solid #E8E4DE;
      border-radius: 12px;
      overflow: hidden;
      background: #FAFAF8;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      flex-shrink: 0;
    }
    .product-main-image img { width: 100%; height: 100%; object-fit: cover; }
    .product-main-image .main-tag {
      position: absolute;
      top: 10px;
      left: 10px;
      background: #BFAF96;
      color: #fff;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      z-index: 2;
    }
    .product-thumbs {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }
    .product-thumb-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .product-thumb-item {
      width: 72px;
      height: 72px;
      border: 2px solid #E8E4DE;
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      position: relative;
      background: #FAFAF8;
      transition: all .2s;
      flex-shrink: 0;
    }
    .product-thumb-item:hover { border-color: #BFAF96; transform: translateY(-2px); }
    .product-thumb-item.active { border-color: #BFAF96; box-shadow: 0 2px 8px rgba(191,175,150,.3); }
    .product-thumb-item img { width: 100%; height: 100%; object-fit: cover; }
    .product-thumb-item.is-main::after {
      content: '封面';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(191,175,150,.9);
      color: #fff;
      font-size: 10px;
      padding: 2px 0;
      text-align: center;
      font-weight: 600;
    }
    .product-thumb-add {
      width: 72px;
      height: 72px;
      border: 2px dashed #D4C9B5;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all .2s;
      background: #FFFEFC;
      color: #BFAF96;
      font-size: 22px;
      flex-shrink: 0;
    }
    .product-thumb-add:hover { border-color: #BFAF96; background: #FFF9F0; }
    .product-thumb-del {
      position: absolute;
      top: 2px;
      right: 2px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(196,123,107,.9);
      color: #fff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      line-height: 1;
      padding: 0;
      opacity: 0;
      transition: opacity .2s;
      z-index: 3;
    }
    .product-thumb-item:hover .product-thumb-del { opacity: 1; }
    .gallery-upload-btns {
      display: flex;
      gap: 8px;
      margin-top: 8px;
      flex-wrap: wrap;
    }
    .product-detail-section { margin-top: 20px; }
    .product-detail-images-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 8px;
    }
    .product-detail-img-item {
      position: relative;
      width: 140px;
      height: 140px;
      border-radius: 10px;
      overflow: hidden;
      border: 2px solid #E8E4DE;
      flex-shrink: 0;
      transition: all .2s;
    }
    .product-detail-img-item:hover { border-color: #BFAF96; transform: translateY(-2px); }
    .product-detail-img-item img { width: 100%; height: 100%; object-fit: cover; }
    .product-detail-img-del {
      position: absolute;
      top: 6px;
      right: 6px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(196,123,107,.9);
      color: #fff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      line-height: 1;
      padding: 0;
      transition: all .2s;
    }
    .product-detail-img-del:hover { background: #C47B6B; transform: scale(1.1); }
    .product-detail-img-add {
      width: 140px;
      height: 140px;
      border: 2px dashed #D4C9B5;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all .2s;
      background: #FFFEFC;
      color: #BFAF96;
      flex-shrink: 0;
      gap: 6px;
    }
    .product-detail-img-add:hover { border-color: #BFAF96; background: #FFF9F0; transform: translateY(-2px); }
    .product-detail-img-add .add-icon { font-size: 28px; font-weight: 300; }
    .product-detail-img-add .add-text { font-size: 12px; font-weight: 500; }
    .product-list-img {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      overflow: hidden;
      background: #F5F1EB;
    }
    .product-list-img img { width: 100%; height: 100%; object-fit: cover; }

    /* ADMIN DROPDOWN */
    .admin-user { position: relative; }
    .admin-dropdown {
      position: absolute;
      bottom: 100%;
      left: 0;
      right: 0;
      margin-bottom: 6px;
      background: #3A403D;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 10px;
      padding: 6px;
      display: none;
      min-width: 160px;
      box-shadow: 0 8px 24px rgba(0,0,0,.3);
      z-index: 200;
    }
    .admin-dropdown.show { display: block; animation: fadeIn .2s ease; }
    .admin-dropdown-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      color: #C8CCC9;
      font-size: 13px;
      border-radius: 8px;
      cursor: pointer;
      transition: all .15s;
    }
    .admin-dropdown-item:hover { background: rgba(255,255,255,.08); color: #F5F1EB; }
    .admin-dropdown-item.danger:hover { background: rgba(196,123,107,.2); color: #E8A898; }
    .admin-dropdown-item .dd-icon { font-size: 15px; width: 18px; text-align: center; }
    .admin-dropdown-divider {
      height: 1px;
      background: rgba(255,255,255,.08);
      margin: 4px 0;
    }

    /* SECTION TYPES GRID */
    .section-types-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
    .section-type-card{background:#FAFAF8;border:2px solid #E8E4DE;border-radius:10px;padding:16px;cursor:pointer;transition:all .2s;text-align:center}
    .section-type-card:hover{border-color:#BFAF96;background:#FFFDF9;transform:translateY(-2px)}
    .section-type-card .st-icon{font-size:28px;margin-bottom:8px}
    .section-type-card .st-name{font-size:13px;font-weight:600;color:#3A403D;margin-bottom:2px}
    .section-type-card .st-desc{font-size:11px;color:#8A948C;line-height:1.4}

    /* BANNER PREVIEW ENHANCED */
    .banner-preview-wrap{border-radius:12px;overflow:hidden;margin-bottom:22px;transition:height .3s ease}
    .banner-edit-card{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;transition:all .3s ease;background:linear-gradient(135deg,#BFAF96 0%,#8A948C 100%);background-size:cover;background-position:center}
    .banner-edit-card::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,rgba(0,0,0,0) 40%,rgba(0,0,0,.2))}
    .banner-edit-card h2{font-weight:700;margin-bottom:8px;position:relative;z-index:1;transition:all .2s}
    .banner-edit-card p{opacity:.9;margin-bottom:16px;position:relative;z-index:1;transition:all .2s}
    .banner-edit-card .banner-btn-preview{padding:10px 26px;background:rgba(255,255,255,.25);border:1px solid rgba(255,255,255,.5);border-radius:10px;font-size:14px;font-weight:500;position:relative;z-index:1;backdrop-filter:blur(4px);transition:all .2s}
    .banner-edit-btn{position:absolute;top:16px;right:16px;z-index:2}
    .banner-size-small{height:180px}
    .banner-size-small h2{font-size:24px}
    .banner-size-small p{font-size:14px}
    .banner-size-medium{height:260px}
    .banner-size-medium h2{font-size:32px}
    .banner-size-medium p{font-size:16px}
    .banner-size-large{height:360px}
    .banner-size-large h2{font-size:42px}
    .banner-size-large p{font-size:18px}
    .banner-align-left{align-items:flex-start !important;padding-left:60px}
    .banner-align-center{align-items:center !important}
    .banner-align-right{align-items:flex-end !important;padding-right:60px}

    /* RICH TEXT TOOLBAR */
    .rich-text-toolbar{display:flex;gap:4px;padding:8px;background:#FAFAF8;border:1px solid #E8E4DE;border-bottom:none;border-radius:10px 10px 0 0;flex-wrap:wrap}
    .rt-btn{width:32px;height:32px;border:1px solid #E8E4DE;background:#fff;border-radius:6px;cursor:pointer;font-size:13px;color:#6B726F;transition:all .15s;display:flex;align-items:center;justify-content:center}
    .rt-btn:hover{border-color:#BFAF96;color:#BFAF96;background:#FFFDF9}
    .rt-btn.active{background:#BFAF96;color:#fff;border-color:#BFAF96}
    .rich-text-editor{min-height:120px;padding:12px 14px;border:1px solid #E8E4DE;border-radius:0 0 10px 10px;font-size:13px;line-height:1.7;outline:none;background:#fff;transition:border-color .2s}
    .rich-text-editor:focus{border-color:#BFAF96;box-shadow:0 0 0 4px rgba(191,175,150,.1)}
    .rich-text-editor ul,.rich-text-editor ol{margin-left:20px;margin-bottom:8px}
    .rich-text-editor p{margin-bottom:8px}
    .rich-text-editor p:last-child{margin-bottom:0}
    .rich-text-editor a{color:#BFAF96;text-decoration:underline}

    /* SETTING ROWS */
    .setting-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .setting-item{display:flex;flex-direction:column;gap:6px}
    .setting-item label{font-size:12px;font-weight:500;color:#6B726F}
    .setting-item select,.setting-item input[type="text"]{padding:8px 12px;border:1px solid #E8E4DE;border-radius:8px;font-size:13px;background:#fff}
    .setting-item select:focus,.setting-item input[type="text"]:focus{outline:none;border-color:#BFAF96}

    /* COLOR PICKER SIMPLE */
    .color-options{display:flex;gap:8px;flex-wrap:wrap}
    .color-option{width:28px;height:28px;border-radius:8px;cursor:pointer;border:2px solid transparent;transition:all .15s;position:relative}
    .color-option:hover{transform:scale(1.1)}
    .color-option.active{border-color:#3A403D}
    .color-option.active::after{content:'\2713';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:12px;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.3)}

    /* FONT SIZE OPTIONS */
    .size-options{display:flex;gap:6px}
    .size-option{padding:6px 14px;border:1px solid #E8E4DE;border-radius:8px;cursor:pointer;font-size:12px;color:#6B726F;background:#fff;transition:all .15s}
    .size-option:hover{border-color:#BFAF96;color:#BFAF96}
    .size-option.active{background:#BFAF96;color:#fff;border-color:#BFAF96}

    /* ALIGN OPTIONS */
    .align-options{display:flex;gap:6px}
    .align-option{width:36px;height:32px;border:1px solid #E8E4DE;border-radius:8px;cursor:pointer;color:#6B726F;background:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;transition:all .15s}
    .align-option:hover{border-color:#BFAF96;color:#BFAF96}
    .align-option.active{background:#BFAF96;color:#fff;border-color:#BFAF96}

    /* PADDING OPTIONS */
    .padding-options{display:flex;gap:6px}
    .padding-option{padding:6px 14px;border:1px solid #E8E4DE;border-radius:8px;cursor:pointer;font-size:12px;color:#6B726F;background:#fff;transition:all .15s}
    .padding-option:hover{border-color:#BFAF96;color:#BFAF96}
    .padding-option.active{background:#BFAF96;color:#fff;border-color:#BFAF96}

    /* FONT STYLE OPTIONS */
    .font-options{display:flex;gap:6px;flex-wrap:wrap}
    .font-option{padding:6px 14px;border:1px solid #E8E4DE;border-radius:8px;cursor:pointer;font-size:12px;color:#6B726F;background:#fff;transition:all .15s}
    .font-option:nth-child(1){font-family:Georgia,'Times New Roman',serif}
    .font-option:nth-child(2){font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif}
    .font-option:nth-child(3){font-family:'Brush Script MT',cursive}
    .font-option:hover{border-color:#BFAF96;color:#BFAF96}
    .font-option.active{background:#BFAF96;color:#fff;border-color:#BFAF96}

    /* SECTION CARD ENHANCED */
    .section-card{background:#fff;border:1px solid #E8E4DE;border-radius:12px;padding:18px;margin-bottom:14px;transition:all .2s;position:relative}
    .section-card:hover{box-shadow:0 4px 14px rgba(58,64,61,.06)}
    .section-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
    .section-card-title{font-size:15px;font-weight:600;color:#3A403D;display:flex;align-items:center;gap:10px}
    .section-card-type{font-size:11px;color:#8A948C;background:#F5F1EB;padding:2px 8px;border-radius:6px;font-weight:500}
    .section-card-actions{display:flex;gap:4px}
    .section-card-body{display:grid;grid-template-columns:140px 1fr;gap:16px;align-items:center}
    .section-card-thumb{width:140px;height:90px;background:linear-gradient(135deg,#F5F1EB,#E8E0D4);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:32px;overflow:hidden;position:relative}
    .section-card-thumb img{width:100%;height:100%;object-fit:cover}
    .section-card-info h4{font-size:14px;font-weight:600;color:#3A403D;margin-bottom:6px}
    .section-card-info p{font-size:12px;color:#6B726F;line-height:1.6}
    .add-section-btn{width:100%;padding:18px;border:2px dashed #D4C9B5;border-radius:12px;color:#BFAF96;font-size:14px;font-weight:500;transition:all .2s;background:#FFFEFC}
    .add-section-btn:hover{border-color:#BFAF96;background:#FFF9F0;color:#A6977C}

    /* PAGE HEADER ENHANCED */
    .content-page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px}
    .content-page-header h1{font-size:22px;font-weight:700;color:#3A403D}

    @media (max-width:768px){
      .section-types-grid{grid-template-columns:repeat(2,1fr)}
      .section-card-body{grid-template-columns:100px 1fr}
      .section-card-thumb{width:100px;height:70px;font-size:24px}
      .setting-grid-2{grid-template-columns:1fr}
    }

    /* BREADCRUMB */
    .breadcrumb{display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:18px;color:#8A948C}
    .breadcrumb a{color:#BFAF96;cursor:pointer;font-weight:500;transition:color .2s}
    .breadcrumb a:hover{color:#A6977C}
    .breadcrumb .sep{opacity:.5}
    .breadcrumb .current{color:#3A403D;font-weight:500}

    /* PAGE EDITOR */
    .editor-tabs{margin-bottom:22px}
    .banner-edit-card{position:relative;border-radius:12px;overflow:hidden;margin-bottom:22px;height:220px;background:linear-gradient(135deg,#BFAF96 0%,#8A948C 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff}
    .banner-edit-card::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,rgba(0,0,0,0) 40%,rgba(0,0,0,.15))}
    .banner-edit-card h2{font-size:32px;font-weight:700;margin-bottom:8px;position:relative;z-index:1}
    .banner-edit-card p{font-size:16px;opacity:.9;margin-bottom:16px;position:relative;z-index:1}
    .banner-edit-card .banner-btn-preview{padding:10px 26px;background:rgba(255,255,255,.25);border:1px solid rgba(255,255,255,.5);border-radius:10px;font-size:14px;font-weight:500;position:relative;z-index:1;backdrop-filter:blur(4px)}
    .banner-edit-btn{position:absolute;top:16px;right:16px;z-index:2}

    .section-card{background:#fff;border:1px solid #E8E4DE;border-radius:12px;padding:18px;margin-bottom:14px;transition:all .2s;position:relative}
    .section-card:hover{box-shadow:0 4px 14px rgba(58,64,61,.06)}
    .section-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
    .section-card-title{font-size:15px;font-weight:600;color:#3A403D;display:flex;align-items:center;gap:10px}
    .section-card-actions{display:flex;gap:4px}
    .section-card-body{display:grid;grid-template-columns:120px 1fr;gap:16px;align-items:center}
    .section-card-thumb{width:120px;height:80px;background:linear-gradient(135deg,#F5F1EB,#E8E0D4);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:28px}
    .section-card-info h4{font-size:14px;font-weight:600;color:#3A403D;margin-bottom:6px}
    .section-card-info p{font-size:12px;color:#6B726F;line-height:1.6}
    .add-section-btn{width:100%;padding:18px;border:2px dashed #D4C9B5;border-radius:12px;color:#BFAF96;font-size:14px;font-weight:500;transition:all .2s;background:#FFFEFC}
    .add-section-btn:hover{border-color:#BFAF96;background:#FFF9F0;color:#A6977C}

    /* MEMBERSHIP */
    .membership-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:24px}
    .member-card{background:#fff;border:1px solid #E8E4DE;border-radius:14px;padding:26px;position:relative;transition:all .25s}
    .member-card:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(58,64,61,.08)}
    .member-card.featured{border-color:#BFAF96;background:linear-gradient(180deg,#FFFEFC 0%,#FFF9F0 100%);box-shadow:0 4px 16px rgba(191,175,150,.15)}
    .member-card-badge{position:absolute;top:-12px;right:24px;background:linear-gradient(135deg,#BFAF96,#A6977C);color:#fff;padding:5px 14px;border-radius:20px;font-size:11px;font-weight:600;box-shadow:0 2px 8px rgba(191,175,150,.3)}
    .member-card-icon{width:60px;height:60px;border-radius:14px;margin-bottom:18px;display:flex;align-items:center;justify-content:center;font-size:28px}
    .member-card h3{font-size:20px;font-weight:700;color:#3A403D;margin-bottom:4px}
    .member-card .price{font-size:34px;font-weight:700;color:#BFAF96;margin:18px 0;letter-spacing:-1px}
    .member-card .price span{font-size:14px;font-weight:400;color:#8A948C}
    .member-card ul{list-style:none;margin-bottom:22px}
    .member-card li{padding:7px 0;font-size:13px;color:#6B726F;display:flex;align-items:center;gap:10px}
    .member-card li::before{content:'\2713';color:#6B9B7A;font-weight:bold;font-size:14px}
    .member-card .btn{width:100%;justify-content:center}

    /* ANALYTICS */
    .metric-cards{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:22px}
    .metric-card{background:#fff;border:1px solid #E8E4DE;border-radius:10px;padding:16px;transition:all .2s}
    .metric-card:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(58,64,61,.06)}
    .metric-card .m-label{font-size:11px;color:#8A948C;margin-bottom:6px}
    .metric-card .m-value{font-size:22px;font-weight:700;color:#3A403D;letter-spacing:-.5px}
    .metric-card .m-change{font-size:11px;margin-top:6px;font-weight:500}
    .metric-card .m-change.up{color:#6B9B7A}
    .metric-card .m-change.down{color:#C47B6B}
    .time-range-bar{display:flex;gap:4px;margin-bottom:18px}
    .time-range-btn{padding:7px 16px;font-size:12px;color:#6B726F;background:#fff;border:1px solid #E8E4DE;border-radius:8px;cursor:pointer;transition:all .2s;font-weight:500}
    .time-range-btn:hover{border-color:#BFAF96;color:#BFAF96}
    .time-range-btn.active{background:linear-gradient(135deg,#BFAF96,#A6977C);color:#fff;border-color:#BFAF96}

    /* SETTINGS */
    .settings-section{margin-bottom:30px}
    .settings-section-title{font-size:16px;font-weight:600;color:#3A403D;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #E8E4DE}
    .toggle-switch{position:relative;width:46px;height:26px;background:#E8E4DE;border-radius:13px;cursor:pointer;transition:all .2s;flex-shrink:0}
    .toggle-switch.active{background:linear-gradient(135deg,#BFAF96,#A6977C)}
    .toggle-switch::after{content:'';position:absolute;top:3px;left:3px;width:20px;height:20px;background:#fff;border-radius:50%;transition:transform .25s;box-shadow:0 1px 4px rgba(0,0,0,.15)}
    .toggle-switch.active::after{transform:translateX(20px)}
    .setting-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid #F5F1EB}
    .setting-row:last-child{border-bottom:none}
    .setting-info h4{font-size:14px;font-weight:500;color:#3A403D;margin-bottom:3px}
    .setting-info p{font-size:12px;color:#8A948C}

    /* MISC */
    .avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#BFAF96,#8A948C);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:600;vertical-align:middle;margin-right:10px}
    .avatar-lg{width:52px;height:52px;font-size:18px}
    .pagination{display:flex;justify-content:center;gap:6px;margin-top:18px}
    .page-btn{min-width:34px;height:34px;padding:0 10px;border:1px solid #E8E4DE;border-radius:8px;font-size:13px;color:#6B726F;background:#fff;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:all .15s;font-weight:500}
    .page-btn:hover{border-color:#BFAF96;color:#BFAF96}
    .page-btn.active{background:linear-gradient(135deg,#BFAF96,#A6977C);color:#fff;border-color:#BFAF96}
    .empty-state{text-align:center;padding:50px 20px;color:#8A948C}
    .empty-state-icon{font-size:52px;margin-bottom:14px;opacity:.3}
    .empty-state p{font-size:14px}
    .toast-container{position:fixed;top:24px;right:24px;z-index:2000;display:flex;flex-direction:column;gap:10px}
    .toast{background:#fff;border-radius:10px;padding:14px 20px;box-shadow:0 6px 20px rgba(0,0,0,.12);display:flex;align-items:center;gap:12px;border-left:4px solid #6B9B7A;animation:toastIn .3s ease;min-width:260px}
    .toast.success{border-left-color:#6B9B7A}
    .toast.error{border-left-color:#C47B6B}
    .toast.warning{border-left-color:#D4A574}
    .toast-icon{font-size:20px}
    .toast-message{font-size:13px;color:#3A403D;font-weight:500}
    @keyframes toastIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:translateX(0)}}
    .user-cell{display:flex;align-items:center;gap:10px}
    .user-cell .name{font-weight:500;color:#3A403D}
    .user-cell .sub{font-size:12px;color:#8A948C}

    /* RESPONSIVE */
    @media (max-width:1024px){
      .stats-grid{grid-template-columns:repeat(2,1fr)}
      .grid-2,.grid-3{grid-template-columns:1fr}
      .metric-cards{grid-template-columns:repeat(3,1fr)}
      .membership-grid{grid-template-columns:1fr}
    }
    @media (max-width:768px){
      .sidebar{transform:translateX(-100%);width:250px;z-index:200}
      .sidebar.mobile-open{transform:translateX(0)}
      .main-content{margin-left:0 !important}
      .menu-toggle{display:block}
      .stats-grid{grid-template-columns:1fr 1fr}
      .metric-cards{grid-template-columns:repeat(2,1fr)}
      .form-row{grid-template-columns:1fr}
      .chart-wrap{flex-direction:column;align-items:flex-start}
      .page-content{padding:18px}
      .top-bar{padding:12px 18px}
      .page-title{font-size:16px}
      .mobile-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.4);z-index:150;backdrop-filter:blur(2px)}
      .mobile-overlay.show{display:block}
      .section-card-body{grid-template-columns:80px 1fr}
      .section-card-thumb{width:80px;height:60px;font-size:22px}
    }
    @media (max-width:480px){
      .stats-grid{grid-template-columns:1fr}
      .metric-cards{grid-template-columns:1fr}
      .login-card{padding:32px 24px}
    }
    ::-webkit-scrollbar{width:6px;height:6px}
    ::-webkit-scrollbar-track{background:transparent}
    ::-webkit-scrollbar-thumb{background:#D4C9B5;border-radius:3px}
    ::-webkit-scrollbar-thumb:hover{background:#BFAF96}
  </style>
</head>
<body>

  <!-- LOGIN -->
  <div class="login-page" id="login-page">
    <div class="login-card">
      <div class="login-logo">
        <div class="login-logo-icon">&#9784;</div>
        <h1>东方能量空间</h1>
        <p>Oriental Vibe 管理后台</p>
      </div>
      <div class="login-error" id="login-error">账号或密码错误，请重试</div>
      <form class="login-form" onsubmit="handleLogin(event)">
        <div class="form-group">
          <label>管理员账号</label>
          <input type="text" id="login-username" placeholder="请输入账号" autocomplete="username" />
        </div>
        <div class="form-group">
          <label>登录密码</label>
          <input type="password" id="login-password" placeholder="请输入密码" autocomplete="current-password" />
        </div>
        <div class="login-options">
          <label class="remember-me"><input type="checkbox" id="remember-me" /> 记住我</label>
          <a href="#" onclick="return false;" style="color:#BFAF96;">忘记密码？</a>
        </div>
        <button type="submit" class="login-btn">登 录</button>
      </form>
      <div class="login-footer">&copy; 2024 东方能量空间 Oriental Vibe. All rights reserved.</div>
    </div>
  </div>

  <!-- ADMIN LAYOUT -->
  <div class="admin-layout" id="admin-layout">
    <div class="mobile-overlay" id="mobile-overlay" onclick="toggleMobileSidebar()"></div>
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-icon">&#9784;</div>
        <div class="sidebar-brand-text"><h2>东方能量空间</h2><span>v3.0 管理后台</span></div>
      </div>
      <nav class="sidebar-nav">
        <div class="nav-section">主菜单</div>
        <div class="nav-item active" data-page="dashboard" onclick="switchPage('dashboard')"><span class="nav-icon">&#9632;</span><span class="nav-label">仪表盘</span></div>
        <div class="nav-item" data-page="content" onclick="switchPage('content')"><span class="nav-icon">&#9998;</span><span class="nav-label">内容管理</span></div>
        <div class="nav-item" data-page="products" onclick="switchPage('products')"><span class="nav-icon">&#128722;</span><span class="nav-label">商品管理</span></div>
        <div class="nav-item" data-page="users" onclick="switchPage('users')"><span class="nav-icon">&#9787;</span><span class="nav-label">用户管理</span></div>
        <div class="nav-item" data-page="orders" onclick="switchPage('orders')"><span class="nav-icon">&#9776;</span><span class="nav-label">订单管理</span></div>
        <div class="nav-item" data-page="analytics" onclick="switchPage('analytics')"><span class="nav-icon">&#128200;</span><span class="nav-label">数据分析</span></div>
        <div class="nav-section">系统</div>
        <div class="nav-item" data-page="settings" onclick="switchPage('settings')"><span class="nav-icon">&#9881;</span><span class="nav-label">系统设置</span></div>
      </nav>
      <div class="sidebar-footer">
        <div class="admin-user" onclick="toggleAdminDropdown(event)">
          <div class="admin-avatar">A</div>
          <div class="admin-info">
            <div class="name">管理员</div>
            <div class="role">超级管理员</div>
          </div>
          <div class="admin-dropdown" id="admin-dropdown">
            <div class="admin-dropdown-item" onclick="showAdminProfile()">
              <span class="dd-icon">&#128100;</span>
              <span>个人资料</span>
            </div>
            <div class="admin-dropdown-item" onclick="showChangePassword()">
              <span class="dd-icon">&#128274;</span>
              <span>修改密码</span>
            </div>
            <div class="admin-dropdown-divider"></div>
            <div class="admin-dropdown-item danger" onclick="logout()">
              <span class="dd-icon">&#10149;</span>
              <span>退出登录</span>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <div class="main-content">
      <div class="top-bar">
        <div class="top-bar-left">
          <span class="menu-toggle" onclick="toggleMobileSidebar()">&#9776;</span>
          <span class="page-title" id="page-title">仪表盘</span>
        </div>
        <div class="top-bar-right">
          <span class="top-bar-icon" title="通知">&#128276;<span class="badge-dot"></span></span>
          <span class="top-bar-icon" title="帮助">&#10068;</span>
        </div>
      </div>
      <div class="page-content">

        <!-- DASHBOARD -->
        <div id="page-dashboard" class="page-section active">
          <div class="page-header"><h1>仪表盘</h1><div class="page-header-actions"><button class="btn btn-outline" onclick="exportDashboard()">&#8681; 导出报表</button></div></div>
          <div class="stats-grid" id="dash-stats"></div>
          <div class="grid-2">
            <div class="card">
              <div class="card-header">
                <div><div class="card-title">销售趋势</div><div class="card-subtitle">近30天销售额走势</div></div>
                <div class="time-range-bar">
                  <button class="time-range-btn active" onclick="setDashRange(7, this)">7天</button>
                  <button class="time-range-btn" onclick="setDashRange(30, this)">30天</button>
                  <button class="time-range-btn" onclick="setDashRange(90, this)">90天</button>
                </div>
              </div>
              <div style="height:280px;"><svg id="sales-chart" width="100%" height="100%" viewBox="0 0 500 260" preserveAspectRatio="none"></svg></div>
            </div>
            <div class="grid-2" style="grid-template-columns:1fr;margin-bottom:0;">
              <div class="card">
                <div class="card-title" style="margin-bottom:18px;">用户来源</div>
                <div class="chart-wrap"><div class="donut-chart" id="source-donut"><div class="donut-center"><div class="val" id="source-total">0</div><div class="lbl">总用户</div></div></div><div class="chart-legend" id="source-legend"></div></div>
              </div>
              <div class="card">
                <div class="card-title" style="margin-bottom:18px;">会员等级分布</div>
                <div class="chart-wrap"><div class="donut-chart" id="member-donut"><div class="donut-center"><div class="val" id="member-total">0</div><div class="lbl">会员</div></div></div><div class="chart-legend" id="member-legend"></div></div>
              </div>
            </div>
          </div>
          <div class="grid-2">
            <div class="card">
              <div class="card-header"><div class="card-title">最近订单</div><a href="#" onclick="switchPage('orders');return false;" style="font-size:13px;color:#BFAF96;font-weight:500;">查看全部 &rarr;</a></div>
              <div style="overflow-x:auto;"><table class="data-table"><thead><tr><th>订单号</th><th>客户</th><th>金额</th><th>状态</th></tr></thead><tbody id="dash-orders-body"></tbody></table></div>
            </div>
            <div class="card">
              <div class="card-header"><div class="card-title">热门商品 TOP5</div><a href="#" onclick="switchPage('products');return false;" style="font-size:13px;color:#BFAF96;font-weight:500;">全部商品 &rarr;</a></div>
              <div class="h-bar-list" id="top-products"></div>
            </div>
          </div>
        </div>

        <!-- CONTENT MANAGEMENT -->
        <div id="page-content" class="page-section">

          <!-- 视图1：页面列表 -->
          <div id="cm-list-view">
            <div class="cm-page-header">
              <div>
                <h1 class="cm-page-title">内容管理</h1>
                <p class="cm-page-desc">管理网站所有页面的内容与设置</p>
              </div>
              <button class="btn btn-primary" onclick="openNewPageModal()">
                <span style="margin-right:6px;">&#10133;</span>新增页面
              </button>
            </div>

            <!-- 核心页面 -->
            <div class="cm-page-group">
              <div class="cm-group-title">核心页面</div>
              <div class="cm-page-grid" id="cm-core-pages"></div>
            </div>

            <!-- 政策页面 -->
            <div class="cm-page-group">
              <div class="cm-group-title">政策与说明</div>
              <div class="cm-page-grid" id="cm-policy-pages"></div>
            </div>

            <!-- 自定义页面 -->
            <div class="cm-page-group">
              <div class="cm-group-title">自定义页面</div>
              <div class="cm-page-grid" id="cm-custom-pages"></div>
            </div>
          </div>

          <!-- 视图2：页面编辑器 -->
          <div id="cm-editor-view" style="display:none;">
            <!-- 面包屑 -->
            <div class="cm-breadcrumb">
              <span class="cm-breadcrumb-link" onclick="backToPageList()">&#8592; 返回页面列表</span>
              <span class="cm-breadcrumb-sep">/</span>
              <span class="cm-breadcrumb-current" id="cm-editor-page-name">编辑页面</span>
            </div>

            <!-- 页面标题栏 -->
            <div class="cm-editor-header">
              <div class="cm-editor-title">
                <span class="cm-editor-icon" id="cm-editor-icon">&#128196;</span>
                <div>
                  <h2 id="cm-editor-title">页面编辑</h2>
                  <div class="cm-editor-sub" id="cm-editor-sub">最后编辑：--</div>
                </div>
              </div>
              <div class="cm-editor-actions">
                <button class="btn btn-outline" onclick="previewPage(currentContentPage)">&#128065; 预览</button>
                <button class="btn btn-primary" onclick="savePageContent()">&#10003; 保存</button>
              </div>
            </div>

            <!-- 编辑器Tab -->
            <div class="cm-editor-tabs">
              <div class="cm-editor-tab active" data-tab="design" onclick="setEditorTab('design', this)">
                <span class="cm-tab-icon">&#127912;</span>页面设计
              </div>
              <div class="cm-editor-tab" data-tab="media" onclick="setEditorTab('media', this)">
                <span class="cm-tab-icon">&#128248;</span>媒体库
              </div>
              <div class="cm-editor-tab" data-tab="advanced" onclick="setEditorTab('advanced', this)">
                <span class="cm-tab-icon">&#9881;</span>高级设置
              </div>
            </div>

            <!-- 页面设计 -->
            <div class="cm-tab-panel" id="editor-tab-design">
              <div class="cm-panel-section">
                <div class="cm-panel-title">Banner 横幅</div>
                <div class="banner-preview-wrap">
                  <div class="banner-edit-card banner-size-medium banner-align-center" id="banner-preview">
                    <h2 id="banner-title">东方能量空间</h2>
                    <p id="banner-subtitle">探索东方智慧，开启能量生活</p>
                    <span class="banner-btn-preview" id="banner-btn-text">立即探索</span>
                  </div>
                </div>
                <div style="margin-top:12px;text-align:right;">
                  <button class="btn btn-outline btn-sm" onclick="editBanner()">&#9998; 编辑Banner</button>
                </div>
              </div>

              <div class="cm-panel-section">
                <div class="cm-panel-header">
                  <div class="cm-panel-title">内容区块</div>
                  <button class="btn btn-primary btn-sm" onclick="addSection()">&#10133; 添加区块</button>
                </div>
                <div id="sections-list"></div>
              </div>
            </div>

            <!-- 媒体库 -->
            <div class="cm-tab-panel" id="editor-tab-media" style="display:none;">
              <div class="cm-media-subtabs">
                <div class="cm-media-tab active" onclick="setMediaTab('images', this)">&#128247; 图片库</div>
                <div class="cm-media-tab" onclick="setMediaTab('videos', this)">&#127909; 视频库</div>
              </div>

              <div id="media-images-panel">
                <div class="cm-panel-header">
                  <div class="cm-panel-title"><span id="media-img-count">共 0 张图片</span></div>
                  <div style="display:flex;gap:8px;">
                    <button class="btn btn-outline btn-sm" onclick="addMediaImageByUrl()">&#128279; 输入URL</button>
                    <button class="btn btn-primary btn-sm" onclick="addMediaImage()">&#8683; 本地上传</button>
                  </div>
                </div>
                <div class="media-grid" id="media-images-grid"></div>
              </div>

              <div id="media-videos-panel" style="display:none;">
                <div class="cm-panel-header">
                  <div class="cm-panel-title"><span id="media-video-count">共 0 个视频</span></div>
                  <div style="display:flex;gap:8px;">
                    <button class="btn btn-outline btn-sm" onclick="addMediaVideoByUrl()">&#128279; 输入URL</button>
                    <button class="btn btn-primary btn-sm" onclick="addMediaVideo()">&#8683; 本地上传</button>
                  </div>
                </div>
                <div class="media-grid video-grid" id="media-videos-grid"></div>
              </div>
            </div>

            <!-- 高级 -->
            <div class="cm-tab-panel" id="editor-tab-advanced" style="display:none;">
              <div class="cm-panel-section">
                <div class="cm-panel-title">SEO 自动优化</div>
                <div style="padding:16px;background:#F5F9F5;border-radius:10px;border:1px solid #E0EDE0;margin-bottom:14px;">
                  <div style="display:flex;align-items:flex-start;gap:10px;">
                    <span style="font-size:20px;">&#9989;</span>
                    <div>
                      <div style="font-size:14px;font-weight:600;color:#3A403D;margin-bottom:4px;">SEO 已自动优化</div>
                      <div style="font-size:13px;color:#6B726F;line-height:1.6;">
                        系统已根据页面内容自动生成符合 Google、Bing 等欧美搜索引擎最佳实践的 SEO 设置，包括：
                        <ul style="margin-top:8px;padding-left:20px;">
                          <li style="margin-bottom:4px;">Title 标签（基于页面名称 + 品牌名）</li>
                          <li style="margin-bottom:4px;">Meta Description（基于页面内容摘要）</li>
                          <li style="margin-bottom:4px;">Open Graph / Twitter Card 社交分享标签</li>
                          <li style="margin-bottom:4px;">语义化 HTML 结构与 H1-H6 层级</li>
                          <li style="margin-bottom:4px;">图片 Alt 属性自动生成</li>
                          <li>Canonical URL 与 Sitemap 自动生成</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="cm-panel-section">
                <div class="cm-panel-title">基本设置</div>
                <div class="form-group"><label class="form-label">页面路径 (URL Slug)</label><div style="display:flex;align-items:center;"><span style="color:#8A948C;margin-right:8px;">/</span><input class="form-input" id="adv-slug" placeholder="page-url" style="flex:1;" /></div><div class="form-hint">页面访问地址，只能包含小写字母、数字和横杠</div></div>
                <div class="setting-row"><div class="setting-info"><h4>显示在导航栏</h4><p>在网站顶部导航中显示此页面链接</p></div><div class="toggle-switch active" id="adv-in-nav" onclick="this.classList.toggle('active')"></div></div>
                <div class="setting-row"><div class="setting-info"><h4>允许搜索引擎索引</h4><p>允许Google等搜索引擎收录此页面</p></div><div class="toggle-switch active" id="adv-index" onclick="this.classList.toggle('active')"></div></div>
                <div class="form-group"><label class="form-label">排序权重</label><input class="form-input" type="number" id="adv-sort" value="0" style="max-width:200px;" /><div class="form-hint">数值越小越靠前，默认为0</div></div>
              </div>

              <div class="cm-panel-section">
                <div class="cm-panel-title">页面操作</div>
                <div class="page-actions-grid">
                  <button class="page-action-btn" onclick="previewPage(currentContentPage)"><span class="page-action-icon">&#128065;</span><span class="page-action-text">预览页面</span></button>
                  <button class="page-action-btn" onclick="duplicatePage(currentContentPage)"><span class="page-action-icon">&#128203;</span><span class="page-action-text">复制页面</span></button>
                  <button class="page-action-btn danger" onclick="deleteCurrentPage()"><span class="page-action-icon">&#128465;</span><span class="page-action-text">删除页面</span></button>
                </div>
              </div>
            </div>
          </div>
        </div>

