  function exportDashboard() {
    var users = lsGet('users') || [];
    var orders = lsGet('orders') || [];
    var members = lsGet('members') || [];
    var products = lsGet('products') || [];
    var d = new Date();
    var todayStr = d.toISOString().slice(0,10);

    function csvEscape(val) {
      var str = String(val == null ? '' : val);
      if (str.indexOf(',') >= 0 || str.indexOf('"') >= 0 || str.indexOf('\n') >= 0) {
        return '"' + str.replace(/"/g, '""') + '"';
      }
      return str;
    }

    function getRevenue(orderList) {
      var sum = 0;
      for (var i = 0; i < orderList.length; i++) {
        if (orderList[i].status !== 'cancelled') {
          sum += parseFloat(orderList[i].paidAmount) || 0;
        }
      }
      return sum;
    }

    var todayOrders = [];
    var todayStrFull = daysAgo(0);
    for (var i = 0; i < orders.length; i++) {
      if (orders[i].createdAt && orders[i].createdAt.startsWith(todayStrFull)) {
        todayOrders.push(orders[i]);
      }
    }

    var monthStr = d.toISOString().slice(0,7);
    var monthOrders = [];
    for (var j = 0; j < orders.length; j++) {
      if (orders[j].createdAt && orders[j].createdAt.startsWith(monthStr)) {
        monthOrders.push(orders[j]);
      }
    }
    var monthRevenue = getRevenue(monthOrders);
    var totalRevenue = getRevenue(orders);

    var activeCount = 0;
    for (var k = 0; k < members.length; k++) {
      if (members[k].status === 'active') activeCount++;
    }

    var lines = [];
    lines.push('Dashboard Report');
    lines.push('Generated,' + csvEscape(new Date().toLocaleString()));
    lines.push('');
    lines.push('Key Metrics');
    lines.push('Metric,Value');
    lines.push('Total Users,' + users.length);
    lines.push('Today Orders,' + todayOrders.length);
    lines.push('Monthly Revenue,' + monthRevenue.toFixed(2));
    lines.push('Total Revenue,' + totalRevenue.toFixed(2));
    lines.push('Active Members,' + activeCount);
    lines.push('Total Products,' + products.length);
    lines.push('Total Orders,' + orders.length);
    lines.push('');

    lines.push('Sales Trend (Last 30 Days)');
    lines.push('Date,Order Count,Revenue');
    for (var di = 29; di >= 0; di--) {
      var dateStr = daysAgo(di);
      var dayOrd = [];
      for (var oi = 0; oi < orders.length; oi++) {
        if (orders[oi].createdAt && orders[oi].createdAt.startsWith(dateStr)) {
          dayOrd.push(orders[oi]);
        }
      }
      var dayRev = getRevenue(dayOrd);
      lines.push(dateStr + ',' + dayOrd.length + ',' + dayRev.toFixed(2));
    }
    lines.push('');

    lines.push('Top 10 Products');
    lines.push('Rank,Product Name,Sales');
    var sortedProducts = products.slice().sort(function(a,b) {
      return (b.sales || 0) - (a.sales || 0);
    });
    var topCount = Math.min(10, sortedProducts.length);
    for (var pi = 0; pi < topCount; pi++) {
      var p = sortedProducts[pi];
      lines.push((pi+1) + ',' + csvEscape(p.name) + ',' + (p.sales || 0));
    }
    lines.push('');

    lines.push('Member Distribution');
    lines.push('Level,Count,Percentage');
    var levels = ['初级会员','中级会员','高级会员'];
    for (var li = 0; li < levels.length; li++) {
      var lvl = levels[li];
      var lvlCount = 0;
      for (var mi = 0; mi < members.length; mi++) {
        if (members[mi].level === lvl) lvlCount++;
      }
      var lvlPct = members.length > 0 ? ((lvlCount / members.length) * 100).toFixed(1) + '%' : '0%';
      lines.push(csvEscape(lvl) + ',' + lvlCount + ',' + lvlPct);
    }
    lines.push('');

    lines.push('Order Status Summary');
    lines.push('Status,Count,Amount');
    var orderStatuses = ['pending','paid','shipped','completed','cancelled','refunded'];
    var statusNames = { pending:'Pending', paid:'Paid', shipped:'Shipped', completed:'Completed', cancelled:'Cancelled', refunded:'Refunded' };
    for (var si = 0; si < orderStatuses.length; si++) {
      var st = orderStatuses[si];
      var statusOrders = [];
      for (var soi = 0; soi < orders.length; soi++) {
        if (orders[soi].status === st) statusOrders.push(orders[soi]);
      }
      var stAmount = 0;
      for (var sai = 0; sai < statusOrders.length; sai++) {
        stAmount += parseFloat(statusOrders[sai].paidAmount) || 0;
      }
      lines.push(statusNames[st] + ',' + statusOrders.length + ',' + stAmount.toFixed(2));
    }

    var csv = lines.join('\n');
    var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
    var link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'dashboard-report-' + todayStr + '.csv';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setTimeout(function() { URL.revokeObjectURL(link.href); }, 1000);
    showToast('Report exported successfully', 'success');
  }

  // ========== CONTENT MANAGEMENT (NEW) ==========
  let currentContentPage = null;
  let editorTab = 'content';
  let editingSectionIdx = -1;

  function slugify(text) {
    return text.toLowerCase().trim().replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-').replace(/^-+|-+$/g, '');
  }

  function getPagesData() {
    const pages = lsGet('pages') || null;
    if (pages && Array.isArray(pages)) return pages;
    return CONTENT_PAGES.map(p => ({ ...p, lastEdit: daysAgo(randInt(0,30)) }));
  }
  function savePagesData(pages) {
    lsSet('pages', pages);
  }
  function getContentData() {
    return lsGet('content') || {};
  }
  function saveContentData(content) {
    lsSet('content', content);
  }

  function renderContentList() {
    const pages = getPagesData();
    const content = getContentData();

    const corePages = pages.filter(p => (p.group || 'core') === 'core');
    const policyPages = pages.filter(p => p.group === 'policy');
    const customPages = pages.filter(p => p.group === 'custom' || (!p.group && !CONTENT_PAGES.find(cp => cp.id === p.id)));

    const renderPageCard = (p) => {
      const pageContent = content[p.id] || {};
      const lastEdit = p.lastEdit || pageContent.lastEdit || '--';
      const statusLabel = p.status === 'published' ? '已发布' : '草稿';
      const statusClass = p.status === 'published' ? 'published' : 'draft';
      const typeLabel = p.type || (p.group === 'policy' ? '政策页' : (p.group === 'core' ? '核心页' : '自定义页'));
      return `
        <div class="cm-page-card" onclick="openPageEditor('${p.id}')">
          <div class="cm-page-card-top">
            <div class="cm-page-card-icon">${p.icon || '&#128196;'}</div>
            <div class="cm-page-card-status ${statusClass}">${statusLabel}</div>
          </div>
          <div class="cm-page-card-name">${p.name}</div>
          <div class="cm-page-card-type">${typeLabel}</div>
          <div class="cm-page-card-meta">
            <div class="cm-page-card-date">${lastEdit}</div>
            <div class="cm-page-card-actions" onclick="event.stopPropagation()">
              <button class="cm-page-card-btn" title="编辑" onclick="openPageEditor('${p.id}')">&#9998;</button>
              <button class="cm-page-card-btn" title="复制" onclick="duplicatePage('${p.id}')">&#128203;</button>
              <button class="cm-page-card-btn danger" title="删除" onclick="deletePage('${p.id}')">&#128465;</button>
            </div>
          </div>
        </div>
      `;
    };

    document.getElementById('cm-core-pages').innerHTML = corePages.map(renderPageCard).join('');
    document.getElementById('cm-policy-pages').innerHTML = policyPages.map(renderPageCard).join('');
    document.getElementById('cm-custom-pages').innerHTML = customPages.length ? customPages.map(renderPageCard).join('') : `<div style="grid-column:1/-1;padding:32px;text-align:center;color:#8A948C;font-size:13px;">暂无自定义页面</div>`;
  }

  function openPageEditor(pageId) {
    currentContentPage = pageId;
    const pages = getPagesData();
    const pageInfo = pages.find(p => p.id === pageId);

    if (pageInfo) {
      document.getElementById('cm-editor-page-name').textContent = pageInfo.name;
      document.getElementById('cm-editor-title').textContent = pageInfo.name;
      document.getElementById('cm-editor-icon').textContent = pageInfo.icon || '&#128196;';
      const lastEdit = pageInfo.lastEdit || '--';
      document.getElementById('cm-editor-sub').textContent = '最后编辑：' + lastEdit;
    }

    setEditorTab('design', document.querySelector('.cm-editor-tab[data-tab="design"]'));
    document.getElementById('cm-list-view').style.display = 'none';
    document.getElementById('cm-editor-view').style.display = 'block';
    loadPageEditorData();
    renderSectionsForEditor();
  }

  function backToPageList() {
    document.getElementById('cm-editor-view').style.display = 'none';
    document.getElementById('cm-list-view').style.display = 'block';
    renderContentList();
  }

  function shadeColor(hex, percent) {
    const num = parseInt(hex.replace('#',''), 16);
    const r = Math.max(0, Math.min(255, (num >> 16) + percent));
    const g = Math.max(0, Math.min(255, ((num >> 8) & 0xFF) + percent));
    const b = Math.max(0, Math.min(255, (num & 0xFF) + percent));
    return '#' + ((r << 16) | (g << 8) | b).toString(16).padStart(6, '0');
  }

  function openNewPageModal() {
    openModal('新增页面', `
      <div class="form-group"><label class="form-label">页面名称 <span class="required">*</span></label><input class="form-input" id="new-page-name" placeholder="请输入页面名称" oninput="autoGenerateSlug()" /></div>
      <div class="form-group"><label class="form-label">页面路径 (Slug)</label><div style="display:flex;align-items:center;"><span style="color:#8A948C;margin-right:8px;">/</span><input class="form-input" id="new-page-slug" placeholder="page-url" style="flex:1;" /></div><div class="form-hint">页面访问地址，留空将自动生成</div></div>
      <div class="form-group"><label class="form-label">选择模板</label><div class="section-types-grid" style="grid-template-columns:repeat(2,1fr);">${PAGE_TEMPLATES.map(t => `
        <div class="section-type-card" data-template="${t.id}" onclick="selectTemplate('${t.id}', this)">
          <div class="st-icon">${t.icon}</div>
          <div class="st-name">${t.name}</div>
        </div>
      `).join('')}</div></div>
      <div class="form-group"><label class="form-label">页面状态</label><select class="form-select" id="new-page-status"><option value="published">发布</option><option value="draft">草稿</option></select></div>
    `, `<button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="createNewPage()">创建页面</button>`, false);
    setTimeout(() => selectTemplate('custom', document.querySelector('[data-template="custom"]')), 10);
  }

  function selectTemplate(id, el) {
    document.querySelectorAll('[data-template]').forEach(e => e.style.borderColor = '#E8E4DE');
    document.querySelectorAll('[data-template]').forEach(e => e.style.background = '#FAFAF8');
    el.style.borderColor = '#BFAF96';
    el.style.background = '#FFFDF9';
    window._selectedTemplate = id;
  }

  function autoGenerateSlug() {
    const name = document.getElementById('new-page-name').value;
    const slugEl = document.getElementById('new-page-slug');
    if (!slugEl.value || slugEl.dataset.auto === 'true') {
      slugEl.value = slugify(name);
      slugEl.dataset.auto = 'true';
    }
  }

  function createNewPage() {
    const name = document.getElementById('new-page-name').value.trim();
    if (!name) { showToast('请输入页面名称', 'error'); return; }
    let slug = document.getElementById('new-page-slug').value.trim();
    if (!slug) slug = slugify(name);
    const template = window._selectedTemplate || 'custom';
    const status = document.getElementById('new-page-status').value;
    const pages = getPagesData();
    const templateInfo = PAGE_TEMPLATES.find(t => t.id === template) || PAGE_TEMPLATES[3];
    const id = 'page-' + Date.now();
    const newPage = {
      id, name, type: '自定义页', template,
      icon: templateInfo.icon, status,
      desc: name + '页面',
      lastEdit: new Date().toISOString().slice(0, 10)
    };
    pages.unshift(newPage);
    savePagesData(pages);
    const content = getContentData();
    content[id] = {
      banner: { title: name, subtitle: '探索东方智慧，开启能量生活', buttonText: '立即了解', buttonLink: '#', image: '', size: 'medium', align: 'center', titleSize: 'large' },
      sections: [],
      seo: { title: name + ' - 东方能量空间', description: '', keywords: '', ogImage: '' },
      advanced: { slug, inNav: false, indexable: true, sort: pages.length },
      lastEdit: new Date().toISOString().slice(0, 10)
    };
    saveContentData(content);
    closeModal();
    showToast('页面创建成功', 'success');
    openPageEditor(id);
  }

  function duplicatePage(pageId) {
    if (!confirm('确定要复制这个页面吗？')) return;
    const pages = getPagesData();
    const page = pages.find(p => p.id === pageId);
    if (!page) return;
    const content = getContentData();
    const pageContent = content[pageId];
    const newId = 'page-' + Date.now();
    const newPage = { ...page, id: newId, name: page.name + ' - 副本', lastEdit: new Date().toISOString().slice(0, 10) };
    pages.unshift(newPage);
    savePagesData(pages);
    if (pageContent) {
      content[newId] = JSON.parse(JSON.stringify(pageContent));
      content[newId].lastEdit = new Date().toISOString().slice(0, 10);
      saveContentData(content);
    }
    showToast('页面已复制', 'success');
    openPageEditor(newId);
  }

  function deletePage(pageId) {
    if (!confirm('确定要删除这个页面吗？此操作不可撤销。')) return;
    let pages = getPagesData();
    pages = pages.filter(p => p.id !== pageId);
    savePagesData(pages);
    const content = getContentData();
    delete content[pageId];
    saveContentData(content);
    renderContentList();
    showToast('页面已删除', 'success');
  }
  function loadPageEditorData() {
    const content = getContentData();
    const page = content[currentContentPage] || { banner:{}, sections:[], seo:{}, advanced:{} };
    const banner = page.banner || {};
    const bannerEl = document.getElementById('banner-preview');
    bannerEl.className = 'banner-edit-card banner-size-' + (banner.size || 'medium') + ' banner-align-' + (banner.align || 'center');
    if (banner.image) {
      bannerEl.style.backgroundImage = 'url(' + banner.image + ')';
    } else {
      bannerEl.style.backgroundImage = '';
    }
    document.getElementById('banner-title').textContent = banner.title || '标题';
    document.getElementById('banner-subtitle').textContent = banner.subtitle || '副标题';
    document.getElementById('banner-btn-text').textContent = banner.buttonText || '按钮';
    document.getElementById('seo-title').value = page.seo?.title || '';
    document.getElementById('seo-description').value = page.seo?.description || '';
    document.getElementById('seo-keywords').value = page.seo?.keywords || '';
    document.getElementById('seo-og-image').value = page.seo?.ogImage || '';
    document.getElementById('seo-preview-title').textContent = page.seo?.title || '页面标题';
