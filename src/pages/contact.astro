---
import BaseLayout from '../layouts/BaseLayout.astro';

const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';
const heroBg = `${imgBase}minimalist%20zen%20meditation%20room%20natural%20light%20neutral%20tones%20japanese%20style%20peaceful&image_size=landscape_16_9`;
---

<BaseLayout title="Contact Us | Oriental Vibe" description="Get in touch with Oriental Vibe. We're here to help with any questions about space energy, feng shui consultations, or our products.">
  <style is:global>
    .contact-hero {
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: calc(var(--navbar-height) + 4rem) 2rem 4rem;
      background: linear-gradient(180deg, rgba(245,241,235,0.9) 0%, rgba(248,246,242,0.95) 100%), url('${heroBg}');
      background-size: cover;
      background-position: center;
      position: relative;
    }

    .contact-hero-content {
      max-width: 700px;
      position: relative;
      z-index: 1;
    }

    .contact-hero-subtitle {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-accent-dark);
      margin-bottom: 1.5rem;
      font-weight: 400;
    }

    .contact-hero-title {
      margin-bottom: 1.5rem;
    }

    .contact-hero-description {
      font-size: 1.1rem;
      color: var(--color-text-secondary);
      line-height: 1.8;
    }

    .contact-info-section {
      background-color: var(--color-bg-secondary);
    }

    .contact-info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      max-width: 560px;
      margin: 0 auto;
    }

    .contact-info-card {
      background-color: var(--color-bg-tertiary);
      border-radius: var(--radius-lg);
      padding: 2rem 1.5rem;
      text-align: center;
      border: 1px solid var(--color-border-light);
      transition: var(--transition-base);
    }

    .contact-info-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--color-accent-light);
    }

    .contact-info-icon {
      width: 60px;
      height: 60px;
      margin: 0 auto 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: var(--color-bg-primary);
      transition: var(--transition-base);
    }

    .contact-info-card:hover .contact-info-icon {
      background-color: var(--color-accent);
    }

    .contact-info-icon svg {
      width: 24px;
      height: 24px;
      color: var(--color-accent-dark);
      transition: var(--transition-base);
    }

    .contact-info-card:hover .contact-info-icon svg {
      color: var(--color-text-primary);
    }

    .contact-info-card h4 {
      margin-bottom: 0.5rem;
      font-size: 1rem;
    }

    .contact-info-card p {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      margin-bottom: 0;
      line-height: 1.6;
    }

    .contact-form-section {
      background-color: var(--color-bg-primary);
    }

    .contact-form-wrapper {
      max-width: 700px;
      margin: 0 auto;
    }

    .contact-form {
      background-color: var(--color-bg-tertiary);
      border-radius: var(--radius-xl);
      padding: 3rem;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--color-border-light);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group:last-child {
      margin-bottom: 0;
    }

    .form-label {
      display: block;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--color-text-primary);
      margin-bottom: 0.5rem;
      letter-spacing: 0.02em;
    }

    .form-input,
    .form-textarea {
      width: 100%;
      padding: 0.875rem 1.125rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background-color: var(--color-bg-secondary);
      color: var(--color-text-primary);
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 300;
      transition: var(--transition-base);
    }

    .form-input:focus,
    .form-textarea:focus {
      outline: none;
      border-color: var(--color-accent);
      background-color: var(--color-bg-tertiary);
      box-shadow: 0 0 0 3px rgba(191, 175, 150, 0.1);
    }

    .form-input::placeholder,
    .form-textarea::placeholder {
      color: var(--color-text-tertiary);
    }

    .form-textarea {
      min-height: 150px;
      resize: vertical;
    }

    .form-submit {
      width: 100%;
      margin-top: 0.5rem;
    }

    .form-success {
      text-align: center;
      padding: 2rem;
      display: none;
    }

    .form-success.show {
      display: block;
    }

    .form-success-icon {
      width: 72px;
      height: 72px;
      margin: 0 auto 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: rgba(107, 155, 107, 0.1);
      color: var(--state-success);
    }

    .form-success-icon svg {
      width: 36px;
      height: 36px;
    }

    .form-success h3 {
      margin-bottom: 0.75rem;
    }

    .form-success p {
      color: var(--color-text-secondary);
      margin-bottom: 0;
    }

    .faq-quick-links {
      margin-top: 3rem;
      padding-top: 3rem;
      border-top: 1px solid var(--color-border);
    }

    .faq-quick-links h3 {
      text-align: center;
      margin-bottom: 2rem;
    }

    .faq-quick-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      max-width: 800px;
      margin: 0 auto 2rem;
    }

    .faq-quick-item {
      background-color: var(--color-bg-secondary);
      border-radius: var(--radius-md);
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      transition: var(--transition-base);
      cursor: pointer;
    }

    .faq-quick-item:hover {
      background-color: var(--color-bg-tertiary);
      border-color: var(--color-accent-light);
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    .faq-quick-icon {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: var(--color-bg-tertiary);
      color: var(--color-accent-dark);
      transition: var(--transition-base);
    }

    .faq-quick-item:hover .faq-quick-icon {
      background-color: var(--color-accent);
      color: var(--color-text-primary);
    }

    .faq-quick-icon svg {
      width: 16px;
      height: 16px;
    }

    .faq-quick-text {
      font-size: 0.9rem;
      color: var(--color-text-primary);
      font-weight: 400;
    }

    .faq-cta {
      text-align: center;
    }

    .faq-cta p {
      margin-bottom: 1.5rem;
      color: var(--color-text-tertiary);
      font-size: 0.95rem;
    }

    @media (max-width: 1024px) {
      .faq-quick-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .contact-hero {
        min-height: auto;
        padding-top: calc(var(--navbar-height) + 3rem);
        padding-bottom: 3rem;
      }

      .contact-form {
        padding: 2rem 1.5rem;
      }

      .form-row {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .faq-quick-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .contact-info-grid {
        grid-template-columns: 1fr;
      }

      .contact-info-card {
        padding: 1.75rem 1.25rem;
      }
    }
  </style>

  {/* ===== Hero Section ===== */}
  <section class="contact-hero fade-in">
    <div class="contact-hero-content">
      <p class="contact-hero-subtitle" data-i18n="contact.hero_subtitle">Get In Touch</p>
      <h1 class="contact-hero-title" data-i18n="contact.hero_title">Contact Us</h1>
      <p class="contact-hero-description" data-i18n="contact.hero_description">Have questions about space energy, our products, or consultations? We're here to help guide you on your journey to balance and harmony.</p>
    </div>
  </section>

  {/* ===== Contact Info Cards ===== */}
  <section class="section contact-info-section fade-in">
    <div class="container">
      <div class="contact-info-grid">
        <div class="contact-info-card">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h4 data-i18n="contact.email_label">Email</h4>
          <p data-i18n="contact.email_value">support@orientalvibe.com</p>
        </div>

        <div class="contact-info-card">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12,6 12,12 16,14"></polyline>
            </svg>
          </div>
          <h4 data-i18n="contact.hours_label">Working Hours</h4>
          <p data-i18n="contact.hours_value">Mon - Fri: 9AM - 6PM PST<br/>Weekend: By Appointment</p>
        </div>
      </div>
    </div>
  </section>

  {/* ===== Contact Form ===== */}
  <section class="section contact-form-section fade-in">
    <div class="container">
      <div class="contact-form-wrapper">
        <div class="section-title">
          <h2 data-i18n="contact.form_title">Send Us a Message</h2>
          <p data-i18n="contact.form_subtitle">Fill out the form below and we'll get back to you within 24 hours.</p>
        </div>

        <div class="contact-form">
          <form id="contactForm" onsubmit="handleContactSubmit(event)">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="contact.name_label">Name</label>
                <input type="text" class="form-input" name="name" required data-i18n-placeholder="contact.name_placeholder" placeholder="Your full name" />
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="contact.email_form_label">Email</label>
                <input type="email" class="form-input" name="email" required data-i18n-placeholder="contact.email_placeholder" placeholder="your@email.com" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" data-i18n="contact.subject_label">Subject</label>
              <input type="text" class="form-input" name="subject" required data-i18n-placeholder="contact.subject_placeholder" placeholder="How can we help you?" />
            </div>

            <div class="form-group">
              <label class="form-label" data-i18n="contact.message_label">Message</label>
              <textarea class="form-textarea" name="message" required data-i18n-placeholder="contact.message_placeholder" placeholder="Tell us more about your inquiry..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg form-submit" data-i18n="contact.submit_button">Send Message</button>
          </form>

          <div class="form-success" id="formSuccess">
            <div class="form-success-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20,6 9,17 4,12"></polyline>
              </svg>
            </div>
            <h3 data-i18n="contact.success_title">Message Sent!</h3>
            <p data-i18n="contact.success_message">Thank you for reaching out. We'll get back to you within 24 hours.</p>
          </div>
        </div>

        {/* ===== FAQ Quick Links ===== */}
        <div class="faq-quick-links">
          <h3 data-i18n="contact.faq_quick_title">Frequently Asked Questions</h3>
          <div class="faq-quick-grid">
            <a href="/faq" class="faq-quick-item">
              <div class="faq-quick-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16,8 20,8 23,11 23,16 16,16 16,8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              </div>
              <span class="faq-quick-text" data-i18n="contact.faq_shipping">Shipping & Delivery</span>
            </a>
            <a href="/faq" class="faq-quick-item">
              <div class="faq-quick-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14,2 14,8 20,8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
              <span class="faq-quick-text" data-i18n="contact.faq_returns">Returns & Exchanges</span>
            </a>
            <a href="/faq" class="faq-quick-item">
              <div class="faq-quick-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <span class="faq-quick-text" data-i18n="contact.faq_products">Product Care</span>
            </a>
            <a href="/faq" class="faq-quick-item">
              <div class="faq-quick-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="faq-quick-text" data-i18n="contact.faq_membership">Membership</span>
            </a>
            <a href="/faq" class="faq-quick-item">
              <div class="faq-quick-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
              </div>
              <span class="faq-quick-text" data-i18n="contact.faq_services">Consultations</span>
            </a>
            <a href="/faq" class="faq-quick-item">
              <div class="faq-quick-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </div>
              <span class="faq-quick-text" data-i18n="contact.faq_payment">Payment Methods</span>
            </a>
          </div>
          <div class="faq-cta">
            <p data-i18n="contact.faq_more_text">Can't find what you're looking for? Check out our full FAQ page.</p>
            <a href="/faq" class="btn btn-secondary" data-i18n="contact.faq_view_all">View All FAQs</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function handleContactSubmit(event) {
      event.preventDefault();
      const form = document.getElementById('contactForm');
      const success = document.getElementById('formSuccess');
      form.style.display = 'none';
      success.classList.add('show');
    }
  </script>
</BaseLayout>
