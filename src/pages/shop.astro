---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, bundles } from '../data/products.js';

const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';

const categoryFilters = [
  { key: 'all', labelKey: 'shop.filter_all', label: 'All Categories' },
  { key: 'crystals', labelKey: 'shop.filter_crystals', label: 'Crystals' },
  { key: 'decor', labelKey: 'shop.filter_decor', label: 'Decor' },
  { key: 'clearing', labelKey: 'shop.filter_clearing', label: 'Space Clearing' },
];

const categoryLabelKeyMap = {
  crystals: 'shop.filter_crystals',
  decor: 'shop.filter_decor',
  clearing: 'shop.filter_clearing',
};

const categoryLabels = {
  crystals: 'Crystals',
  decor: 'Decor',
  clearing: 'Space Clearing',
};

const bundleImages = [
  `${imgBase}minimalist%20sage%20and%20palo%20santo%20space%20clearing%20kit%20nordic%20decor&image_size=square`,
  `${imgBase}minimalist%20meditation%20crystals%20set%20amethyst%20citrine%20nordic%20decor&image_size=square`,
];

const faqs = [
  { qKey: 'shop.faq_q_1', aKey: 'shop.faq_a_1', q: 'Are the crystals genuine?', a: 'Yes, all our crystals are ethically sourced and genuine. Each piece is hand-selected for quality and energy.' },
  { qKey: 'shop.faq_q_2', aKey: 'shop.faq_a_2', q: 'How long does shipping take?', a: 'Orders ship within 2-3 business days. Delivery typically takes 5-10 business days depending on your location.' },
  { qKey: 'shop.faq_q_3', aKey: 'shop.faq_a_3', q: 'What is your return policy?', a: 'We offer 30-day hassle-free returns. If you are not fully satisfied, return any product within 30 days for a complete refund.' },
];

const stars = (rating) => '★'.repeat(rating) + '☆'.repeat(5 - rating);
---

<BaseLayout>
  {/* ===== Hero ===== */}
  <section class="hero fade-in">
    <div class="hero-content">
      <p class="hero-subtitle" data-i18n="shop.hero_subtitle">Energy-Enhanced Collection</p>
      <h1 class="hero-title" data-i18n="shop.hero_title">Crystals, Decor & Jewelry for Harmonious Living</h1>
      <p class="hero-description" data-i18n="shop.hero_desc">Hand-selected items to balance and harmonize your living space</p>
    </div>
  </section>

  {/* ===== Category Filter + Product Grid ===== */}
  <section class="section fade-in">
    <div class="container">
      <div class="filter-bar">
        {categoryFilters.map((cat) => (
          <button class={`btn btn-secondary filter-btn${cat.key === 'all' ? ' active' : ''}`} data-filter={cat.key} data-i18n={cat.labelKey}>{cat.label}</button>
        ))}
      </div>

      <div class="grid grid-3 product-grid">
        {products.map((product) => (
          <div class="card product-card" data-category={product.category} data-product-id={product.id} data-product-name={product.nameKey} data-product-price={product.price} data-product-image={product.image}>
            <div class="product-image">
              <img src={product.image} alt="" loading="lazy" data-i18n-alt={product.nameKey} />
              <span class="product-category" data-i18n={categoryLabelKeyMap[product.category]}>{categoryLabels[product.category]}</span>
            </div>
            <div class="product-body">
              <h3 data-i18n={product.nameKey}>{product.nameEn}</h3>
              <div class="star-rating" aria-label={`Rating ${product.rating} of 5`}>
                <span class="star">{stars(product.rating)}</span>
              </div>
              <p data-i18n={product.descKey}>{product.descEn}</p>
              <div class="product-footer">
                <div class="price-wrapper">
                  <span class="price" data-price-usd={product.price}>${product.price}</span>
                  <span class="member-price" data-i18n="auth.discount_label" style="display:none;">Member Discount</span>
                </div>
                <button class="btn btn-primary add-cart-btn" data-i18n="common.add_cart">Add to Cart</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== Bundle Recommendations ===== */}
  <section class="section bundle-section fade-in">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="shop.bundle_title">Bundle Recommendations</h2>
        <p data-i18n="shop.bundle_desc">Save up to 30% with curated combinations</p>
      </div>
      <div class="grid grid-2">
        {bundles.map((bundle, i) => (
          <div class="card bundle-recommend-card">
            <div class="bundle-recommend-image">
              <img src={bundleImages[i] ?? bundleImages[0]} alt="" loading="lazy" data-i18n-alt={bundle.nameKey} />
            </div>
            <div class="bundle-recommend-body">
              <span class="badge badge-popular" data-i18n={bundle.tagKey}>{bundle.tagEn}</span>
              <h3 data-i18n={bundle.nameKey}>{bundle.nameEn}</h3>
              <div class="bundle-price">
                <span class="original" data-price-usd={bundle.original}>${bundle.original}</span>
                <span class="sale" data-price-usd={bundle.price}>${bundle.price}</span>
              </div>
              <span class="bundle-items">{bundle.items} items</span>
              <button class="btn btn-primary" data-i18n="common.add_cart">Add to Cart</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== FAQ ===== */}
  <section class="section fade-in">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="shop.faq_title">Frequently Asked Questions</h2>
        <p data-i18n="shop.faq_desc">Common questions about our products</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary data-i18n={faq.qKey}>{faq.q}</summary>
            <p data-i18n={faq.aKey}>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ===== Floating Cart Button ===== */}
  <button class="floating-cart-btn" aria-label="Cart" data-i18n-title="shop.cart_title">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <span class="cart-count">0</span>
  </button>
</BaseLayout>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3rem;
  }
  .filter-btn.active {
    background: var(--color-text-primary);
    color: #fff;
    border-color: var(--color-text-primary);
  }

  .product-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .product-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  .product-card:hover .product-image img {
    transform: scale(1.05);
  }
  .product-category {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-text-primary);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
  }
  .product-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .product-body h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .product-body .star-rating {
    margin-bottom: 0.75rem;
  }
  .product-body p {
    margin-bottom: 1.25rem;
  }
  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }
  .price {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-text-primary);
  }
  .price-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .price.original {
    font-size: 1rem;
    text-decoration: line-through;
    color: var(--color-text-tertiary);
  }
  .member-price {
    font-size: 0.72rem;
    font-weight: 600;
    color: #8A948C;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .member-price::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8A948C;
  }

  .bundle-recommend-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .bundle-recommend-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .bundle-recommend-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bundle-recommend-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .bundle-recommend-body h3 {
    margin: 0.75rem 0;
    font-size: 1.4rem;
  }
  .bundle-recommend-body .bundle-price {
    margin: 0.5rem 0;
  }
  .bundle-items {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    margin-bottom: 1.25rem;
  }

  .faq-list {
    max-width: 800px;
    margin: 0 auto;
  }
  .faq-item {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    overflow: hidden;
  }
  .faq-item summary {
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    font-weight: 500;
    color: var(--color-text-primary);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .faq-item[open] summary::after {
    content: '−';
  }
  .faq-item p {
    padding: 0 1.5rem 1.25rem;
    margin: 0;
  }

  .floating-cart-btn {
    position: fixed;
    right: 1.5rem;
    bottom: 5.5rem;
    z-index: var(--z-sticky);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    border: none;
    cursor: pointer;
    transition: transform var(--transition-base);
  }
  .floating-cart-btn:hover {
    transform: scale(1.1);
  }
  .floating-cart-btn svg {
    width: 26px;
    height: 26px;
    stroke: #fff;
  }
  .cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--color-accent);
    color: var(--color-text-primary);
    font-size: 0.75rem;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    border-radius: 10px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0 5px;
  }
</style>

<script>
  // Category filter
  const filterBtns = document.querySelectorAll('.filter-btn');
  const productCards = document.querySelectorAll('.product-card');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      productCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        card.style.display = filter === 'all' || cat === filter ? '' : 'none';
      });
    });
  });

  // Add to cart
  document.querySelectorAll('.add-cart-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const card = e.target.closest('.product-card');
      if (!card || !window.__cart) return;
      const id = card.dataset.productId;
      const name = card.querySelector('h3')?.textContent || 'Product';
      const price = parseFloat(card.dataset.productPrice) || 0;
      const image = card.dataset.productImage || '';
      window.__cart.addToCart({ id, name, price, image });
    });
  });

  // Bundle add to cart
  document.querySelectorAll('.bundle-recommend-card .btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const card = e.target.closest('.bundle-recommend-card');
      if (!card || !window.__cart) return;
      const name = card.querySelector('h3')?.textContent || 'Bundle';
      const priceEl = card.querySelector('.sale');
      const price = priceEl ? parseFloat(priceEl.getAttribute('data-price-usd')) || 0 : 0;
      const image = card.querySelector('img')?.src || '';
      window.__cart.addToCart({ id: 'bundle-' + name, name, price, image });
    });
  });

  /* ========== Member Discount ========== */
  function applyMemberDiscounts() {
    if (!window.ovAuth) return;
    const isMember = window.ovAuth.isMember();
    const discount = window.ovAuth.getDiscount();
    const tier = window.ovAuth.getTier();

    document.querySelectorAll('.product-card').forEach(card => {
      const priceEl = card.querySelector('.price');
      const memberLabel = card.querySelector('.member-price');
      if (!priceEl || !memberLabel) return;

      if (isMember && discount > 0) {
        const usdPrice = parseFloat(priceEl.getAttribute('data-price-usd'));
        const discountedPrice = (usdPrice * (1 - discount)).toFixed(0);
        const discountPct = Math.round(discount * 100);

        // Add original price (strikethrough)
        if (!card.querySelector('.price.original')) {
          const originalSpan = document.createElement('span');
          originalSpan.className = 'price original';
          originalSpan.setAttribute('data-price-usd', usdPrice.toString());
          originalSpan.textContent = '$' + usdPrice;
          priceEl.parentNode.insertBefore(originalSpan, priceEl);
        }

        // Update current price
        priceEl.setAttribute('data-price-usd', discountedPrice);
        priceEl.textContent = '$' + discountedPrice;

        // Show member discount label
        const tierNames = { starter: 'Starter', harmony: 'Harmony', premium: 'Premium' };
        memberLabel.textContent = (tierNames[tier] || 'Member') + ' ' + discountPct + '% off';
        memberLabel.style.display = 'flex';
      } else {
        memberLabel.style.display = 'none';
      }
    });
  }

  // Apply on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyMemberDiscounts);
  } else {
    applyMemberDiscounts();
  }

  // Apply on auth change
  document.addEventListener('ov-auth-change', applyMemberDiscounts);

  /* ========== Admin Data Sync ========== */
  (function syncAdminProducts() {
    let adminProducts;
    try {
      adminProducts = JSON.parse(localStorage.getItem('ov-admin-products'));
    } catch { adminProducts = null; }
    if (!adminProducts || adminProducts.length === 0) return;

    const activeProducts = adminProducts.filter(p => p.status !== 'inactive');
    if (activeProducts.length === 0) return;

    const grid = document.querySelector('.product-grid');
    if (!grid) return;

    const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';

    grid.innerHTML = activeProducts.map(p => {
      const imgSrc = p.image || imgBase + encodeURIComponent(p.name + ' minimalist product photo') + '&image_size=square';
      const catLabel = p.category || 'Other';
      const price = parseFloat(p.price) || 0;
      const rating = p.rating || 4;
      const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      return `
        <div class="card product-card" data-category="${catLabel}" data-product-id="${p.id}" data-product-name="${p.name}" data-product-price="${price}" data-product-image="${imgSrc}">
          <div class="product-image">
            <img src="${imgSrc}" alt="${p.name}" loading="lazy" />
            <span class="product-category">${catLabel}</span>
          </div>
          <div class="product-body">
            <h3>${p.name}</h3>
            <div class="star-rating"><span class="star">${stars}</span></div>
            <p>${p.description || ''}</p>
            <div class="product-footer">
              <div class="price-wrapper">
                <span class="price" data-price-usd="${price}">$${price}</span>
                <span class="member-price" data-i18n="auth.discount_label" style="display:none;">Member Discount</span>
              </div>
              <button class="btn btn-primary add-cart-btn" data-i18n="common.add_cart">Add to Cart</button>
            </div>
          </div>
        </div>`;
    }).join('');

    // Re-bind add-to-cart
    document.querySelectorAll('.add-cart-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const card = e.target.closest('.product-card');
        if (!card || !window.__cart) return;
        const id = card.dataset.productId;
        const name = card.dataset.productName || card.querySelector('h3')?.textContent || 'Product';
        const price = parseFloat(card.dataset.productPrice) || 0;
        const image = card.dataset.productImage || '';
        window.__cart.addToCart({ id, name, price, image });
      });
    });

    // Re-bind filters
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.product-card').forEach(card => {
          const cat = card.getAttribute('data-category');
          card.style.display = filter === 'all' || cat === filter ? '' : 'none';
        });
      });
    });

    applyMemberDiscounts();
  })();
</script>
