---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services.js';

const expertImg = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=professional%20asian%20male%20consultant%20in%20minimalist%20nordic%20office%20portrait&image_size=portrait_4_3';
const beforeImg = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cluttered%20messy%20living%20room%20dark%20unpleasant&image_size=landscape_4_3';
const afterImg = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=clean%20minimalist%20living%20room%20scandinavian%20design%20bright%20natural%20light%20crystals&image_size=landscape_4_3';

const expertCreds = [
  { key: 'services.expert_cred_1', text: '20+ Years Experience' },
  { key: 'services.expert_cred_2', text: 'Certified Energy Consultant' },
  { key: 'services.expert_cred_3', text: '10,000+ Clients Served' },
  { key: 'services.expert_cred_4', text: 'International Practice' },
];

const guarantees = [
  { titleKey: 'services.guarantee_1_title', descKey: 'services.guarantee_1_desc', icon: 'shield' },
  { titleKey: 'services.guarantee_2_title', descKey: 'services.guarantee_2_desc', icon: 'clock' },
  { titleKey: 'services.guarantee_3_title', descKey: 'services.guarantee_3_desc', icon: 'heart' },
];

const testimonials = [
  {
    name: "Sarah M.",
    location: "Los Angeles, CA",
    rating: 5,
    textKey: "services.testimonial_1",
    text: "Dr. Li's home consultation completely transformed our living space. The energy shift was immediate and lasting.",
    avatar: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=professional%20woman%20portrait%20minimalist%20neutral%20background&image_size=square",
  },
  {
    name: "Michael R.",
    location: "New York, NY",
    rating: 5,
    textKey: "services.testimonial_2",
    text: "The BaZi reading gave me clarity about my career path I had been searching for years.",
    avatar: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=professional%20man%20portrait%20minimalist%20neutral%20background%20warm&image_size=square",
  },
  {
    name: "Emma & James",
    location: "London, UK",
    rating: 5,
    textKey: "services.testimonial_3",
    text: "The comprehensive package was worth every penny. Our relationship has never been better.",
    avatar: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=professional%20couple%20portrait%20minimalist%20neutral%20background&image_size=square",
  },
];

const howItWorks = [
  { step: 1, titleKey: "services.how_step_1_title", descKey: "services.how_step_1_desc", title: "Choose Your Service", desc: "Select the consultation that matches your needs and goals.", icon: "search" },
  { step: 2, titleKey: "services.how_step_2_title", descKey: "services.how_step_2_desc", title: "Book Your Session", desc: "Pick a convenient date and time, share your details, and confirm.", icon: "calendar" },
  { step: 3, titleKey: "services.how_step_3_title", descKey: "services.how_step_3_desc", title: "Get Your Consultation", desc: "Meet with our expert consultant and receive personalized guidance.", icon: "star" },
  { step: 4, titleKey: "services.how_step_4_title", descKey: "services.how_step_4_desc", title: "Transform Your Space", desc: "Apply the insights and watch your space and life transform.", icon: "home" },
];
---

<BaseLayout>
  <!-- ===== Hero ===== -->
  <section class="hero fade-in">
    <div class="hero-content">
      <p class="hero-subtitle" data-i18n="services.hero_subtitle">Professional Consultancy</p>
      <h1 class="hero-title" data-i18n="services.hero_title">Space Energy Services</h1>
      <p class="hero-description" data-i18n="services.hero_desc">Personalized guidance to harmonize your space and understand your life energy</p>
      <a href="#booking" class="btn btn-primary btn-lg" style="margin-top: 2rem;" data-i18n="services.hero_cta">Book a Consultation</a>
    </div>
  </section>

  <!-- ===== How It Works ===== -->
  <section class="section fade-in">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="services.how_title">How It Works</h2>
        <p data-i18n="services.how_desc">Your journey to a harmonious space in four simple steps</p>
      </div>
      <div class="how-grid">
        {howItWorks.map((item) => (
          <div class="how-card">
            <div class="how-step-num">{item.step}</div>
            <div class="how-icon">
              {item.icon === 'search' && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>}
              {item.icon === 'calendar' && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>}
              {item.icon === 'star' && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
              {item.icon === 'home' && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>}
            </div>
            <h3 data-i18n={item.titleKey}>{item.title}</h3>
            <p data-i18n={item.descKey}>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Expert Introduction ===== -->
  <section class="section fade-in">
    <div class="container">
      <div class="expert-grid">
        <div class="expert-image">
          <img src={expertImg} alt="Dr. Ming Li" loading="lazy" />
        </div>
        <div class="expert-info">
          <span class="expert-role" data-i18n="services.expert_title">Oriental Space Energy Architect</span>
          <h2 data-i18n="services.expert_name">Dr. Ming Li</h2>
          <p data-i18n="services.expert_bio">With over 20 years of experience bridging traditional Chinese energy principles with modern Western lifestyles, Dr. Li has helped thousands of clients transform their living and working spaces.</p>
          <div class="expert-creds">
            {expertCreds.map((cred) => (
              <span class="expert-cred" data-i18n={cred.key}>{cred.text}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Services Pricing ===== -->
  <section class="section bundle-section fade-in" id="pricing">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="services.services_title">Consultation Services</h2>
        <p data-i18n="services.services_desc">Choose the service that matches your journey</p>
      </div>
      <div class="grid grid-3">
        {services.map((service) => (
          <div class={`card service-card${service.popular ? ' service-card-popular' : ''}${service.vip ? ' service-card-vip' : ''}`}>
            {service.popular && <span class="badge badge-popular service-badge" data-i18n="common.most_popular">Most Popular</span>}
            {service.vip && <span class="badge badge-vip service-badge" data-i18n="services.vip_badge">VIP</span>}
            <h3 data-i18n={service.titleKey}>Service Title</h3>
            <p data-i18n={service.descKey}>Service description.</p>
            <div class="service-price" data-price-usd={service.priceUsd}>${service.priceUsd}</div>
            <ul class="service-features">
              {Array.from({ length: service.features }, (_, idx) => idx + 1).map((featIdx) => (
                <li data-i18n={`services.service_${service.id}_feat_${featIdx}`}>Feature {featIdx}</li>
              ))}
            </ul>
            <a href="#booking" class="btn btn-primary service-book-btn" data-i18n="common.book_now">Book Now</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Client Testimonials ===== -->
  <section class="section fade-in">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="services.testimonials_title">What Our Clients Say</h2>
        <p data-i18n="services.testimonials_desc">Real stories from people who transformed their spaces and lives</p>
      </div>
      <div class="grid grid-3">
        {testimonials.map((t) => (
          <div class="card testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <img src={t.avatar} alt={t.name} loading="lazy" />
              </div>
              <div>
                <div class="testimonial-name">{t.name}</div>
                <div class="testimonial-location">{t.location}</div>
              </div>
            </div>
            <div class="testimonial-stars">{Array.from({ length: t.rating }, () => '★').join('')}</div>
            <p class="testimonial-text" data-i18n={t.textKey}>"{t.text}"</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Before / After ===== -->
  <section class="section fade-in">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="services.case_title">Client Transformations</h2>
        <p data-i18n="services.case_desc">Real before & after stories from our clients</p>
      </div>
      <div class="case-grid">
        <div class="case-column case-before">
          <span class="case-label" data-i18n="services.case_before">Before</span>
          <img src={beforeImg} alt="Before consultation" loading="lazy" />
          <p data-i18n="services.case_before_text">"Our living room felt chaotic and draining. The energy felt stuck and we argued constantly in that space."</p>
        </div>
        <div class="case-column case-after">
          <span class="case-label" data-i18n="services.case_after">After</span>
          <img src={afterImg} alt="After consultation" loading="lazy" />
          <p data-i18n="services.case_after_text">"After the consultation, we rearranged the furniture and added crystals. The space now feels calm and welcoming."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Client Success Stories ===== -->
  <section class="section fade-in" style="background: var(--color-bg-secondary);">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="services.stories_title">Client Success Stories</h2>
        <p data-i18n="services.stories_desc">Real people. Real spaces. Real shifts.</p>
      </div>
      <div class="grid grid-2" style="gap: 2rem;">
        {[
          { titleKey: 'services.story_1_title', textKey: 'services.story_1_text', icon: 'heart' },
          { titleKey: 'services.story_2_title', textKey: 'services.story_2_text', icon: 'briefcase' },
          { titleKey: 'services.story_3_title', textKey: 'services.story_3_text', icon: 'home' },
          { titleKey: 'services.story_4_title', textKey: 'services.story_4_text', icon: 'compass' },
        ].map((story) => (
          <div class="card why-us-card" style="padding: 2rem;">
            <div class="why-us-icon">
              {story.icon === 'heart' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent-dark);">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              )}
              {story.icon === 'briefcase' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent-dark);">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              )}
              {story.icon === 'home' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent-dark);">
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              )}
              {story.icon === 'compass' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent-dark);">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
              )}
            </div>
            <h3 data-i18n={story.titleKey} style="font-size: 1.1rem; margin-bottom: 0.75rem; color: var(--color-text-primary);">Story Title</h3>
            <p data-i18n={story.textKey} style="color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.7; margin-bottom: 0;">Story text</p>
          </div>
        ))}
      </div>
      <p style="text-align: center; margin-top: 2rem; font-size: 0.8rem; color: var(--color-text-tertiary);" data-i18n="services.stories_disclaimer">* Individual experiences. Results vary. For spiritual wellness and personal reflection only.</p>
    </div>
  </section>

  <!-- ===== Booking Form (Simplified) ===== -->
  <section class="section bundle-section fade-in" id="booking">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="services.booking_title">Book Your Consultation</h2>
        <p data-i18n="services.booking_desc">Fill out the form below and we'll get back to you within 24 hours</p>
      </div>
      <div class="booking-form-wrap">
        <form id="bookingForm" class="booking-form" onsubmit="return false;">
          <div class="form-row">
            <div class="form-group">
              <label for="bookService" data-i18n="services.booking_form_service">Service *</label>
              <select id="bookService" required>
                <option value="" disabled selected data-i18n="services.booking_form_service_placeholder">Select a service</option>
                {services.map((s) => (
                  <option value={s.id} data-price-usd={s.priceUsd} data-i18n={s.titleKey}>Service Title</option>
                ))}
              </select>
            </div>
            <div class="form-group">
              <label for="bookDate" data-i18n="services.booking_form_date">Preferred Date</label>
              <input type="date" id="bookDate" min={new Date().toISOString().split('T')[0]} />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="bookName" data-i18n="services.booking_form_name">Full Name *</label>
              <input type="text" id="bookName" required placeholder="Your full name" data-i18n-placeholder="services.booking_form_name_placeholder" autocomplete="name" />
            </div>
            <div class="form-group">
              <label for="bookEmail" data-i18n="services.booking_form_email">Email *</label>
              <input type="email" id="bookEmail" required placeholder="you@example.com" data-i18n-placeholder="services.booking_form_email_placeholder" autocomplete="email" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="bookPhone" data-i18n="services.booking_form_phone">Phone</label>
              <input type="tel" id="bookPhone" placeholder="+1 (555) 123-4567" data-i18n-placeholder="services.booking_form_phone_placeholder" autocomplete="tel" />
            </div>
            <div class="form-group">
              <label for="bookType" data-i18n="services.booking_form_type">Consultation Type</label>
              <select id="bookType">
                <option value="virtual" data-i18n="services.booking_type_virtual">Virtual (Zoom)</option>
                <option value="inperson" data-i18n="services.booking_type_inperson">In-Person</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="bookNotes" data-i18n="services.booking_form_notes">What would you like to discuss?</label>
            <textarea id="bookNotes" rows="4" placeholder="Tell us about your space, concerns, or goals..." data-i18n-placeholder="services.booking_form_notes_placeholder"></textarea>
          </div>
          <div class="form-group form-agreement">
            <label class="checkbox-label">
              <input type="checkbox" id="bookAgree" required />
              <span data-i18n="services.booking_form_agree">I agree to the terms and privacy policy</span>
            </label>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block" id="bookSubmit" data-i18n="services.booking_form_submit">Submit Booking</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ===== Success Modal ===== -->
  <div class="modal-overlay" id="successModal">
    <div class="modal-content">
      <button class="modal-close" id="modalClose" aria-label="Close">&times;</button>
      <div class="modal-body">
        <div class="modal-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <h3 data-i18n="services.booking_success_title">Booking Confirmed!</h3>
        <p data-i18n="services.booking_success_msg">Thank you for booking your consultation. A confirmation email has been sent with all the details.</p>
        <div class="modal-booking-id" id="modalBookingId"></div>
        <div class="modal-next-steps">
          <h4 data-i18n="services.booking_success_next">What's Next</h4>
          <ul>
            <li data-i18n="services.booking_success_step1">Check your email for the confirmation and calendar invite</li>
            <li data-i18n="services.booking_success_step2">Prepare any questions or photos of your space</li>
            <li data-i18n="services.booking_success_step3">We'll send a reminder 24 hours before your session</li>
          </ul>
        </div>
        <button class="btn btn-primary btn-lg" id="modalDone" data-i18n="common.close">Done</button>
      </div>
    </div>
  </div>

  <!-- ===== Service Guarantee ===== -->
  <section class="section fade-in">
    <div class="container">
      <div class="section-title">
        <h2 data-i18n="services.guarantee_title">Service Guarantee & Policy</h2>
      </div>
      <div class="grid grid-3">
        {guarantees.map((g) => (
          <div class="card guarantee-card">
            <div class="guarantee-icon">
              {g.icon === 'shield' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              {g.icon === 'clock' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
              {g.icon === 'heart' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
            </div>
            <h3 data-i18n={g.titleKey}>Guarantee Title</h3>
            <p data-i18n={g.descKey}>Guarantee description.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container" style="text-align:center; padding: 1rem 0 2rem;">
    <p style="font-size: 0.75rem; color: var(--color-text-tertiary); margin: 0; line-height: 1.5;" data-i18n="services.disclaimer">* Oriental Vibe services are for spiritual wellness, personal reflection, and environmental energy reference only. They are not a substitute for professional medical, psychological, legal, or financial advice. Individual experiences vary. No specific outcomes are guaranteed.</p>
  </div>
</BaseLayout>

<style>
  /* ===== How It Works ===== */
  .how-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .how-card {
    text-align: center;
    padding: 2rem 1.5rem;
    position: relative;
  }
  .how-step-num {
    position: absolute;
    top: 0;
    right: 1rem;
    font-size: 3rem;
    font-family: var(--font-serif);
    color: var(--color-border);
    font-weight: 700;
    line-height: 1;
  }
  .how-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-accent-light);
    color: var(--color-accent-dark);
  }
  .how-card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .how-card p { font-size: 0.9rem; color: var(--color-text-secondary); margin: 0; line-height: 1.5; }

  /* ===== Expert ===== */
  .expert-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: center;
  }
  .expert-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-md);
  }
  .expert-image img { width: 100%; height: 100%; object-fit: cover; }
  .expert-info .expert-role {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
  .expert-info h2 { margin-bottom: 1.25rem; }
  .expert-info p { margin-bottom: 1.75rem; }
  .expert-creds { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .expert-cred {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* ===== Service Cards ===== */
  .service-card { position: relative; display: flex; flex-direction: column; }
  .service-card-popular { border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .service-card-vip { border-color: var(--color-text-primary); box-shadow: var(--shadow-md); }
  .service-badge { position: absolute; top: 1rem; right: 1rem; }
  .service-card h3 { font-size: 1.4rem; margin-bottom: 0.75rem; padding-right: 6rem; }
  .service-card p { margin-bottom: 1.25rem; }
  .service-price {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
