<script is:inline>
  (function() {
    var form = document.getElementById('bookingForm');
    var submitBtn = document.getElementById('bookSubmit');
    var modal = document.getElementById('successModal');
    var modalClose = document.getElementById('modalClose');
    var modalDone = document.getElementById('modalDone');
    var modalId = document.getElementById('modalBookingId');

    if (form && submitBtn) {
      submitBtn.addEventListener('click', function() {
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        var serviceEl = document.getElementById('bookService');
        var serviceName = serviceEl ? serviceEl.options[serviceEl.selectedIndex].text : 'Consultation';
        var dateEl = document.getElementById('bookDate');
        var dateVal = dateEl ? dateEl.value : '—';
        var bookingId = 'OV-' + new Date().getFullYear() + '-' + Math.floor(10000 + Math.random() * 90000);

        // Save to localStorage
        try {
          var bookings = JSON.parse(localStorage.getItem('ov-consultations') || '[]');
          bookings.push({
            id: bookingId,
            service: serviceEl ? serviceEl.value : '',
            serviceName: serviceName,
            date: dateVal,
            name: document.getElementById('bookName') ? document.getElementById('bookName').value : '',
            email: document.getElementById('bookEmail') ? document.getElementById('bookEmail').value : '',
            phone: document.getElementById('bookPhone') ? document.getElementById('bookPhone').value : '',
            type: document.getElementById('bookType') ? document.getElementById('bookType').value : 'virtual',
            notes: document.getElementById('bookNotes') ? document.getElementById('bookNotes').value : '',
            createdAt: new Date().toISOString(),
          });
          localStorage.setItem('ov-consultations', JSON.stringify(bookings));
        } catch(e) {}

        // Show modal
        if (modal && modalId) {
          modalId.textContent = 'Booking ID: ' + bookingId;
        }
        if (modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      });
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
      if (form) form.reset();
    }

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modalDone) modalDone.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });
    }

    // Sync admin services to frontend
    (function syncAdminServices() {
      let adminServices;
      try { adminServices = JSON.parse(localStorage.getItem('ov-admin-services')); } catch(e) { adminServices = null; }
      if (!adminServices || adminServices.length === 0) return;
      const active = adminServices.filter(s => s.status !== 'inactive');
      if (active.length === 0) return;
      const grid = document.querySelector('#pricing .grid-3');
      if (!grid) return;
      grid.innerHTML = active.map(s => {
        const popularClass = s.popular ? ' service-card-popular' : '';
        const vipClass = s.vip ? ' service-card-vip' : '';
        const popularBadge = s.popular ? '<span class="badge badge-popular service-badge">Most Popular</span>' : '';
        const vipBadge = s.vip ? '<span class="badge badge-vip service-badge">VIP</span>' : '';
        const originalPrice = s.originalPrice ? `<span style="text-decoration:line-through;color:#8A948C;font-size:0.8em;margin-right:8px;">$${s.originalPrice}</span>` : '';
        return `<div class="card service-card${popularClass}${vipClass}">
          ${popularBadge}${vipBadge}
          <h3>${s.name}</h3>
          <p>${s.description || ''}</p>
          <div class="service-price" data-price-usd="${s.price}">${originalPrice}$${s.price}</div>
          <a href="#booking" class="btn btn-primary service-book-btn">Book Now</a>
        </div>`;
      }).join('');
    })();
  })();
</script>