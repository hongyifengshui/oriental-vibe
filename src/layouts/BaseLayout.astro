---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Analytics from '../components/Analytics.astro';
import AIChatWidget from '../components/AIChatWidget.astro';

const { title = 'Oriental Vibe | Space Energy & Life Balance', description = 'Ancient Eastern Energy for Modern Western Living. Balance Your Home, Calm Your Mind, Upgrade Your Life Vibe.' } = Astro.props;

// SSR locale routing (Plan A: only EN / Traditional Chinese).
// Prefix-matched pages (e.g. /zh/about) lock the whole response to that language;
// legacy unprefixed top-level pages act as redirects (see pages/*.astro wrappers).
const pathSegs = Astro.url.pathname.split('/').filter(Boolean);
const rawPrefix = pathSegs[0];
const ssrLocale = rawPrefix === 'zh' ? 'zh' : 'en';
const htmlLang = ssrLocale === 'zh' ? 'zh-Hant' : 'en';
const ogLocale = ssrLocale === 'zh' ? 'zh_HANT' : 'en_US';
// Page path without the language prefix, always starting with '/'.
const pagePath = (() => {
  if (rawPrefix === 'en' || rawPrefix === 'zh') {
    const rest = '/' + pathSegs.slice(1).join('/');
    return rest === '/' ? '/' : rest;
  }
  return Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '') || '/';
})();
// Ensure canonical points at locale-absolute URL (keeps SEO clean).
const canonicalOrigin = Astro.site ? String(Astro.site).replace(/\/$/, '') : '';
const canonical = canonicalOrigin ? `${canonicalOrigin}/${ssrLocale}${pagePath === '/' ? '/' : pagePath}` : Astro.url.href;
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={ssrLocale === 'zh' ? 'en_US' : 'zh_HANT'} />

  <!-- Hreflang alternates (en / zh-Hant / x-default) -->
  <link rel="alternate" hreflang="en" href={`/en${pagePath}`} />
  <link rel="alternate" hreflang="zh-Hant" href={`/zh${pagePath}`} />
  <link rel="alternate" hreflang="x-default" href={`/en${pagePath}`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Canonical -->
  <link rel="canonical" href={canonical} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Analytics (Google Analytics + Meta Pixel) -->
  <Analytics />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <CookieBanner />
  <WhatsAppButton />
  <CartDrawer />
  <AIChatWidget />

  <!-- ===== Auth Modal ===== -->
  <div class="ov-auth-overlay" id="authOverlay">
    <div class="ov-auth-modal">
      <button class="ov-auth-close" id="authClose">&times;</button>
      <div class="ov-auth-tabs">
        <button class="ov-auth-tab active" data-auth-tab="login" data-i18n="auth.tab_login">Sign In</button>
        <button class="ov-auth-tab" data-auth-tab="register" data-i18n="auth.tab_register">Sign Up</button>
      </div>
      <div class="ov-auth-panel active" id="authLoginPanel">
        <h3 data-i18n="auth.login_title">Welcome Back</h3>
        <p data-i18n="auth.login_subtitle">Sign in to access your member benefits</p>
        <form id="authLoginForm" onsubmit="return false;">
          <div class="ov-auth-field">
            <label for="authLoginEmail" data-i18n="auth.email">Email Address</label>
            <input type="email" id="authLoginEmail" required data-i18n-placeholder="auth.email_placeholder" placeholder="Enter your email" autocomplete="email" />
          </div>
          <div class="ov-auth-field">
            <label for="authLoginPassword" data-i18n="auth.password">Password</label>
            <input type="password" id="authLoginPassword" required data-i18n-placeholder="auth.password_placeholder" placeholder="Enter your password" autocomplete="current-password" />
          </div>
          <div class="ov-auth-row">
            <label class="ov-auth-remember">
              <input type="checkbox" id="authRemember" />
              <span data-i18n="auth.remember_me">Remember me</span>
            </label>
            <a href="#" class="ov-auth-forgot" data-i18n="auth.forgot_password">Forgot password?</a>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block" id="authLoginBtn" data-i18n="auth.login_btn">Sign In</button>
        </form>
        <p class="ov-auth-switch">
          <span data-i18n="auth.no_account">Don't have an account?</span>
          <button class="ov-auth-switch-btn" data-auth-switch="register" data-i18n="auth.tab_register">Sign Up</button>
        </p>
      </div>
      <div class="ov-auth-panel" id="authRegisterPanel">
        <h3 data-i18n="auth.register_title">Create Account</h3>
        <p data-i18n="auth.register_subtitle">Join and unlock free Five Elements Test</p>
        <form id="authRegisterForm" onsubmit="return false;">
          <div class="ov-auth-field">
            <label for="authRegName" data-i18n="auth.name">Full Name</label>
            <input type="text" id="authRegName" required data-i18n-placeholder="auth.name_placeholder" placeholder="Enter your name" autocomplete="name" />
          </div>
          <div class="ov-auth-field">
            <label for="authRegEmail" data-i18n="auth.email">Email Address</label>
            <input type="email" id="authRegEmail" required data-i18n-placeholder="auth.email_placeholder" placeholder="Enter your email" autocomplete="email" />
          </div>
          <div class="ov-auth-field">
            <label for="authRegPassword" data-i18n="auth.password">Password</label>
            <input type="password" id="authRegPassword" required data-i18n-placeholder="auth.password_placeholder" placeholder="Enter your password" autocomplete="new-password" />
          </div>
          <div class="ov-auth-field">
            <label for="authRegConfirm" data-i18n="auth.confirm_password">Confirm Password</label>
            <input type="password" id="authRegConfirm" required data-i18n-placeholder="auth.confirm_password_placeholder" placeholder="Re-enter your password" autocomplete="new-password" />
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block" id="authRegBtn" data-i18n="auth.register_btn">Create Account</button>
        </form>
        <p class="ov-auth-social-proof" data-i18n="auth.social_proof">Join 10,000+ members on their energy journey</p>
        <p class="ov-auth-switch">
          <span data-i18n="auth.has_account">Already have an account?</span>
          <button class="ov-auth-switch-btn" data-auth-switch="login" data-i18n="auth.tab_login">Sign In</button>
        </p>
      </div>
    </div>
  </div>

  <!-- i18n Client Script -->
  <script is:inline>
    (async function() {
      const translations = {};
      // Plan A: Strictly 2 languages. DE/FR/ES sources still exist on disk but
      // are never registered nor mirrored → accessing /i18n/de.json returns 404.
      const supportedLangs = ['en', 'zh'];

      async function loadTranslations(lang) {
        if (translations[lang]) return translations[lang];
        if (supportedLangs.indexOf(lang) === -1) return {};
        try {
          const res = await fetch(`/i18n/${lang}.json`);
          translations[lang] = await res.json();
          return translations[lang];
        } catch (e) {
          console.warn('Failed to load translations for', lang, e);
          return {};
        }
      }

      function getNested(obj, path) {
        return path.split('.').reduce((acc, key) => acc?.[key], obj);
      }

      // Plan A · Language isolation: NO cross-language fallbacks.
      // Missing keys are left at their SSR default for the locale and reported
      // loudly to the console so content owners fix them before deploy.
      // (Whitelist: brand English loanwords & proper nouns tolerated on 繁體 pages.)
      const WHITELIST_EN_LOANWORDS_ZH = new Set([
        'Oriental Vibe','WhatsApp','Five Elements Test','Master Xu Wei',
        'Santa Monica','CTA','SEO','SVG','URL','HTML','CSS','D1','AI','DEEPSEEK-CHAT',
        'USD','PDF','Stripe','PayPal','BaZi','Qi Men Dun Jia','Feng Shui','BaGua',
      ]);
      function looksLikeEnglish(text) {
        if (typeof text !== 'string') return false;
        // Any run of 10+ ASCII letters = suspicious loan-sentence on 繁體 page.
        return /[A-Za-z]{10,}/.test(text);
      }

      function applyTranslations(lang) {
        if (supportedLangs.indexOf(lang) === -1) lang = 'en';
        const t = translations[lang] || {};

        function write(key, setter) {
          const value = getNested(t, key);
          if (value === undefined || value === null) {
            // Silence expected: SSR rendered this locale already. Missing a
            // client-side override is fine. Do NOT fall back to the other locale
            // (that's the #1 source of "cross-language mixing" bugs).
            if (window.__OV_I18N_VERBOSE__) {
              console.error('[i18n] missing translation key (fallback disabled):', key);
            }
            return;
          }
          if (lang === 'zh' && looksLikeEnglish(value) && !WHITELIST_EN_LOANWORDS_ZH.has(String(value).trim())) {
            console.error('[lang-isolation] likely EN leak into zh-Hant page. key=', key, ' sample=', String(value).slice(0,80));
          }
          setter(value);
        }

        document.querySelectorAll('[data-i18n]').forEach(el => {
          write(el.getAttribute('data-i18n'), (v) => { el.textContent = v; });
        });
        document.querySelectorAll('[data-i18n-title]').forEach(el => {
          write(el.getAttribute('data-i18n-title'), (v) => { el.setAttribute('title', v); });
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
          write(el.getAttribute('data-i18n-placeholder'), (v) => { el.setAttribute('placeholder', v); });
        });
        document.querySelectorAll('[data-i18n-alt]').forEach(el => {
          write(el.getAttribute('data-i18n-alt'), (v) => { el.setAttribute('alt', v); });
        });
        document.querySelectorAll('[data-i18n-value]').forEach(el => {
          write(el.getAttribute('data-i18n-value'), (v) => { el.setAttribute('value', v); });
        });

        document.documentElement.lang = lang === 'zh' ? 'zh-Hant' : 'en';

        const pathToTitleMap = {
          '/': 'home.hero_title',
          '/shop': 'shop.hero_title',
          '/services': 'services.hero_title',
          '/courses': 'courses.hero_title',
          '/blog': 'blog.hero_title',
          '/element-test': 'test.hero_title',
          '/membership': 'membership.hero_title',
          '/privacy': 'privacy.title',
          '/terms': 'terms.title',
          '/shipping': 'shipping.title',
          '/contact': 'contact.hero_title',
          '/faq': 'faq.hero_title',
          '/about': 'about.hero_title',
        };
        const path = window.location.pathname.replace(/\/$/, '') || '/';
        const titleKey = pathToTitleMap[path];
        if (titleKey) {
          const pageTitle = getNested(t, titleKey);
          const brandName = getNested(t, 'brand.name') || 'Oriental Vibe';
          if (pageTitle) {
            document.title = `${pageTitle} | ${brandName}`;
          }
        }
      }

      // FIX (Financial BUG): All transactions in USD per user requirement ("所有付款方式统一用美金结算").
      // Display must match settlement currency 1:1 to prevent displayed-total vs actual-payment mismatch.
      // Rate hardcoded to 1, symbol always $ regardless of language.
      const currencyRates = {
        USD: { symbol: '$', rate: 1 },
      };

      const langToCurrency = {
        en: 'USD',
        zh: 'USD',
      };

      function applyCurrency(currency) {
        // Always display USD $ value. data-price-usd stores the authoritative USD amount.
        const { symbol, rate } = currencyRates.USD;
        document.querySelectorAll('[data-price-usd]').forEach(el => {
          const usd = parseFloat(el.getAttribute('data-price-usd'));
          if (isNaN(usd)) return;
          const raw = usd * rate;
          // FIX: Show decimals only if fractional part exists (e.g. $9.99 → $9.99, $49 → $49)
          // Prevents $9.99 being truncated to $10 which mismatch with button/payment i18n text.
          const formatted = (Math.round(raw * 100) / 100) % 1 === 0
            ? raw.toFixed(0)
            : raw.toFixed(2);
          el.textContent = `${symbol}${formatted}`;
        });
      }

      // A 子项目 D1 bootstrap：前台页面加载时，异步把云端 D1 数据同步到 localStorage（乐观缓存 60s）。
      // - SSR 渲染 DOM 时使用 Astro build-time 静态数据（保证首屏不白屏）。
      // - D1 返回后，本地缓存更新并派发一次合成的 ov-admin-saved 事件，让各页面的同步脚本重渲染。
      // - 无论 D1 成功 / 失败 / 超时（3s），都不阻塞 i18n + auth 初始化。
      async function bootstrapD1Once() {
        if (typeof fetch !== 'function') return false;
        try {
          const ctrl = new AbortController();
          const t = setTimeout(() => ctrl.abort(), 3000);
          const resp = await fetch('/api/data/all', {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'default',
            signal: ctrl.signal,
          }).catch(() => null);
          clearTimeout(t);
          if (!resp || !resp.ok) return false;
          const snap = await resp.json().catch(() => null);
          if (!snap || !snap.ok) return false;
          const PFX = 'ov-admin-';
          const broadcasted = [];
          function writeAndBroadcast(key, value) {
            if (value == null) return;
            const raw = typeof value === 'string' ? value : JSON.stringify(value);
            try { localStorage.setItem(PFX + key, raw); } catch (e) { /* quota ignore */ }
            broadcasted.push(key);
          }
          if (Array.isArray(snap.products)) writeAndBroadcast('products', snap.products);
          if (Array.isArray(snap.categories)) writeAndBroadcast('categories', snap.categories);
          if (snap.membershipLevels) writeAndBroadcast('membershipLevels', snap.membershipLevels);
          if (snap.benefits) writeAndBroadcast('benefits', snap.benefits);
          // Content KVs stored under settings in D1
          if (snap.settings) {
            if (snap.settings.whatsappNumber != null) writeAndBroadcast('whatsappNumber', snap.settings.whatsappNumber);
            if (snap.settings.paymentInfo != null) writeAndBroadcast('paymentInfo', snap.settings.paymentInfo);
            if (snap.settings.contactInfo != null) writeAndBroadcast('contactInfo', snap.settings.contactInfo);
            if (snap.settings.aiConfig != null) writeAndBroadcast('aiConfig', snap.settings.aiConfig);
          }
          // Admin content/editor KVs mirrored as JSON arrays — match ov-admin-blog/services/courses
          if (Array.isArray(snap.blog)) writeAndBroadcast('blog', snap.blog);
          if (Array.isArray(snap.services)) writeAndBroadcast('services', snap.services);
          if (Array.isArray(snap.courses)) writeAndBroadcast('courses', snap.courses);
          // Backwards-compat: snap.orders/users are optional on public snapshot; ignore missing
          // 合并一个 settings 对象（兼容 admin page 直接 lsGet('settings') 的用法）
          if (snap.settings) {
            try {
              const prev = JSON.parse(localStorage.getItem(PFX + 'settings') || '{}');
              const merged = Object.assign({}, prev || {}, {
                whatsappNumber: snap.settings.whatsappNumber,
                paymentInfo: snap.settings.paymentInfo,
                paymentEnabled: snap.settings.paymentInfo && (snap.settings.paymentInfo.stripe || snap.settings.paymentInfo.paypal),
                aiConfig: snap.settings.aiConfig,
              });
              localStorage.setItem(PFX + 'settings', JSON.stringify(merged));
              broadcasted.push('settings');
            } catch (e) {}
          }
          if (snap.content && typeof snap.content === 'object') {
            var content = {};
            Object.keys(snap.content).forEach(function (pageKey) {
              writeAndBroadcast(pageKey, snap.content[pageKey]);
              content[pageKey] = snap.content[pageKey];
            });
            writeAndBroadcast('content', content);
          }
          // 派发一次合成事件：各页面用 broadcastSave 的 listener 会重渲染。
          try {
            const synthetic = new CustomEvent('ov-admin-saved', {
              detail: { key: '__all__', keys: broadcasted, snapshot: snap, at: Date.now() },
            });
            window.dispatchEvent(synthetic);
            document.dispatchEvent(synthetic);
          } catch (e) {}
          return true;
        } catch (e) {
          // 静默降级：D1 不可用时不阻塞任何功能。
          if (window.console) console.info('[d1-bootstrap] skipped:', (e && e.message) || e);
          return false;
        }
      }

      // Resolve start language: SSR path beats localStorage for strict isolation.
      function resolveStartLang() {
        const segs = window.location.pathname.split('/').filter(Boolean);
        if (segs[0] === 'zh') return 'zh';
        if (segs[0] === 'en') return 'en';
        const saved = localStorage.getItem('ov-lang');
        if (saved === 'zh' || saved === 'en') return saved;
        return 'en';
      }

      async function init() {
        const currentLang = resolveStartLang();
        const hasManualCurrency = localStorage.getItem('ov-currency-manual') === 'true';
        let currentCurrency = localStorage.getItem('ov-currency');
        
        if (!currentCurrency || !hasManualCurrency) {
          currentCurrency = langToCurrency[currentLang] || 'USD';
          localStorage.setItem('ov-currency', currentCurrency);
        }

        // Plan A · No fallback preload. Only the target locale ever touches the DOM.
        await loadTranslations(currentLang);
        applyTranslations(currentLang);
        applyCurrency(currentCurrency);

        window.ovI18n = {
          t: function(key, fb) {
            var parts = key.split('.');
            var lang = localStorage.getItem('ov-lang') || 'en';
            var v = translations[lang];
            if (!v) return fb || key;
            for (var i = 0; i < parts.length; i++) v = v && v[parts[i]];
            return v || fb || key;
          },
          getLang: function() { return localStorage.getItem('ov-lang') || 'en'; },
          translations: translations
        };
        document.dispatchEvent(new CustomEvent('ov-i18n-ready', { detail: { lang: currentLang, translations: translations } }));

        // D1 云端数据后台加载（非阻塞）。失败静默，成功则覆盖 localStorage 并派发统一同步事件。
        // 与 init() 并发执行，不等待。
        if (typeof window.__ovD1Bootstrapped === 'undefined') {
          window.__ovD1Bootstrapped = true;
          setTimeout(bootstrapD1Once, 150);
        }
      }

      window.addEventListener('lang-change', async (e) => {
        const lang = e.detail;
        await loadTranslations(lang);
        applyTranslations(lang);
        // FIX: Always USD (no longer switch currency on language change — matches settlement 1:1)
        localStorage.setItem('ov-currency', 'USD');
        localStorage.removeItem('ov-currency-manual');
        applyCurrency('USD');
        document.dispatchEvent(new CustomEvent('ov-i18n-ready', { detail: { lang: lang, translations: translations } }));
      });

      window.addEventListener('currency-change', (e) => {
        applyCurrency(e.detail);
      });

      /* ========== Auth System ========== */
      const AUTH_KEY = 'ov-user';
      const MEMBERSHIP_KEY = 'ov-membership';

      const tierDiscounts = {
        free: 0,
        starter: 0.05,
        harmony: 0.12,
        premium: 0.25,
      };

      function getAuthState() {
        try {
          const raw = localStorage.getItem(AUTH_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch(e) { return null; }
      }

      function setAuthState(user) {
        localStorage.setItem(AUTH_KEY, JSON.stringify(user));
        // Sync membership data
        if (user.tier && user.tier !== 'free') {
          const membership = {
            name: user.name,
            email: user.email,
            tier: user.tier,
            tierName: user.tier === 'starter' ? 'Starter Circle' : user.tier === 'harmony' ? 'Harmony Circle' : 'Premium Circle',
            memberId: 'OV-' + new Date().getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000),
            registeredAt: user.registeredAt || new Date().toISOString(),
          };
          localStorage.setItem(MEMBERSHIP_KEY, JSON.stringify(membership));
          localStorage.setItem('ov-is-member', 'true');
        } else {
          localStorage.setItem('ov-is-member', 'true');
        }
        updateAuthUI();
        document.dispatchEvent(new CustomEvent('ov-auth-change', { detail: user }));
      }

      function clearAuthState() {
        localStorage.removeItem(AUTH_KEY);
        localStorage.removeItem(MEMBERSHIP_KEY);
        localStorage.removeItem('ov-is-member');
        localStorage.removeItem('ov-test-paid');
        updateAuthUI();
        document.dispatchEvent(new CustomEvent('ov-auth-change', { detail: null }));
      }

      function getUserTier() {
        const user = getAuthState();
        // Check membership first (takes priority)
        try {
          const mem = JSON.parse(localStorage.getItem(MEMBERSHIP_KEY) || 'null');
          if (mem && mem.tier && mem.tier !== 'free') return mem.tier;
        } catch(e) {}
        return user ? (user.tier || 'free') : null;
      }

      function getUserDiscount() {
        const tier = getUserTier();
        if (!tier) return 0;
        return tierDiscounts[tier] || 0;
      }

      window.ovAuth = {
        getUser: getAuthState,
        setUser: setAuthState,
        logout: clearAuthState,
        getTier: getUserTier,
        getDiscount: getUserDiscount,
        isLoggedIn: function() { return !!getAuthState(); },
        isMember: function() {
          const tier = getUserTier();
          return tier && tier !== 'free';
        },
      };

      /* ========== Auth Modal Logic ========== */
      function initAuthModal() {
        const overlay = document.getElementById('authOverlay');
        const closeBtn = document.getElementById('authClose');
        const tabs = document.querySelectorAll('.ov-auth-tab');
        const panels = document.querySelectorAll('.ov-auth-panel');
        const switchBtns = document.querySelectorAll('.ov-auth-switch-btn');
        const loginForm = document.getElementById('authLoginForm');
        const regForm = document.getElementById('authRegisterForm');

        function openModal(tab) {
          if (!overlay) return;
          overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
          switchTab(tab || 'login');
        }

        function closeModal() {
          if (!overlay) return;
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }

        function switchTab(tab) {
          tabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-auth-tab') === tab));
          panels.forEach(p => p.classList.toggle('active', p.id === (tab === 'login' ? 'authLoginPanel' : 'authRegisterPanel')));
        }

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (overlay) overlay.addEventListener('click', function(e) { if (e.target === overlay) closeModal(); });

        tabs.forEach(tab => tab.addEventListener('click', function() {
          switchTab(this.getAttribute('data-auth-tab'));
        }));

        switchBtns.forEach(btn => btn.addEventListener('click', function(e) {
          e.preventDefault();
          switchTab(this.getAttribute('data-auth-switch'));
        }));

        // Login submit
        if (loginForm) {
          loginForm.addEventListener('submit', function() {
            const email = document.getElementById('authLoginEmail')?.value.trim();
            const password = document.getElementById('authLoginPassword')?.value.trim();
            if (!email || !password) return;
            if (!email.includes('@')) { alert('Please enter a valid email.'); return; }

            const user = {
              name: email.split('@')[0],
              email: email,
              tier: 'free',
              registeredAt: new Date().toISOString(),
            };
            setAuthState(user);
            closeModal();
          });
        }

        // Register submit
        if (regForm) {
          regForm.addEventListener('submit', function() {
            const name = document.getElementById('authRegName')?.value.trim();
            const email = document.getElementById('authRegEmail')?.value.trim();
            const password = document.getElementById('authRegPassword')?.value.trim();
            const confirm = document.getElementById('authRegConfirm')?.value.trim();
            if (!name || !email || !password || !confirm) return;
            if (!email.includes('@')) { alert('Please enter a valid email.'); return; }
            if (password !== confirm) {
              const t = window.ovI18n;
              alert(t ? t.t('auth.passwords_not_match', 'Passwords do not match') : 'Passwords do not match');
              return;
            }
            if (password.length < 6) { alert('Password must be at least 6 characters.'); return; }

            const user = {
              name: name,
              email: email,
              tier: 'free',
              registeredAt: new Date().toISOString(),
            };
            setAuthState(user);
            closeModal();
          });
        }

        window.ovAuth.openModal = openModal;
        window.ovAuth.closeModal = closeModal;
      }

      /* ========== Auth UI Update ========== */
      function updateAuthUI() {
        const user = getAuthState();
        const tier = getUserTier();
        const userAreaEl = document.getElementById('ovUserArea');
        const loginCtaEl = document.getElementById('ovLoginCta');

        if (userAreaEl) {
          if (user) {
            userAreaEl.style.display = 'flex';
            const avatar = userAreaEl.querySelector('.ov-user-avatar');
            const userName = userAreaEl.querySelector('.ov-user-name');
            const tierBadge = userAreaEl.querySelector('.ov-user-tier-badge');
            if (avatar) avatar.textContent = (user.name || user.email || 'U').charAt(0).toUpperCase();
            if (userName) userName.textContent = user.name || user.email.split('@')[0];
            if (tierBadge) {
              tierBadge.className = 'ov-user-tier-badge ' + (tier || 'free');
              const tierLabels = { free: 'Free', starter: 'Starter', harmony: 'Harmony', premium: 'Premium' };
              tierBadge.textContent = tierLabels[tier] || 'Free';
              tierBadge.style.display = (tier && tier !== 'free') ? 'inline-block' : 'none';
            }
          } else {
            userAreaEl.style.display = 'none';
          }
        }
        if (loginCtaEl) {
          loginCtaEl.style.display = user ? 'none' : 'flex';
        }
      }

      // Initialize auth modal and UI when DOM is ready
      function initAuth() {
        initAuthModal();
        updateAuthUI();

        // Login CTA button
        const loginCta = document.getElementById('ovLoginCta');
        if (loginCta) {
          loginCta.addEventListener('click', function() {
            if (window.ovAuth && window.ovAuth.openModal) {
              window.ovAuth.openModal('login');
            }
          });
        }

        // User dropdown toggle
        const userBtn = document.getElementById('ovUserBtn');
        const userDropdown = document.getElementById('ovUserDropdown');
        if (userBtn && userDropdown) {
          userBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            userDropdown.classList.toggle('open');
          });
          document.addEventListener('click', function() {
            userDropdown.classList.remove('open');
          });
        }

        // Logout button
        const logoutBtn = document.getElementById('ovLogoutBtn');
        if (logoutBtn) {
          logoutBtn.addEventListener('click', function() {
            clearAuthState();
            if (userDropdown) userDropdown.classList.remove('open');
          });
        }

        // Listen for membership changes (from membership page)
        document.addEventListener('ov-membership-updated', function(e) {
          if (e.detail && e.detail.tier) {
            const user = getAuthState();
            if (user) {
              user.tier = e.detail.tier;
              setAuthState(user);
            }
          }
        });
      }

      initAuth();

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });

      function afterInit() {
        document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          init().then(afterInit);
        });
      } else {
        init().then(afterInit);
      }
    })();
  </script>
</body>
</html>
