---
import '../styles/global.css';
---
<div class="cart-overlay" id="cartOverlay" aria-hidden="true"></div>
<aside class="cart-drawer" id="cartDrawer" role="dialog" aria-label="Shopping Cart" aria-hidden="true">
  <div class="cart-header">
    <h3 data-i18n="common.cart">Shopping Cart</h3>
    <button class="cart-close" id="cartClose" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <div class="cart-body" id="cartBody">
    <div class="cart-empty" id="cartEmpty">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-text-tertiary); margin-bottom: 1rem;">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <p style="color: var(--color-text-secondary);" data-i18n="cart.empty">Your cart is empty</p>
    </div>
    <div class="cart-items" id="cartItems"></div>
  </div>
  <div class="cart-footer" id="cartFooter" style="display: none;">
    <div class="cart-subtotal">
      <span data-i18n="cart.subtotal">Subtotal</span>
      <span class="cart-total-price" id="cartTotal">$0</span>
    </div>
    <p class="cart-note" data-i18n="cart.note">Shipping & taxes calculated at checkout</p>
    <button class="btn btn-primary btn-lg" style="width: 100%;" id="checkoutBtn" data-i18n="common.checkout">Checkout</button>
    <button class="btn btn-secondary" style="width: 100%;" id="cartContinue" data-i18n="cart.continue">Continue Shopping</button>
  </div>
</aside>

<!-- Checkout Modal -->
<div class="checkout-overlay" id="checkoutOverlay"></div>
<div class="checkout-modal" id="checkoutModal">
  <div class="checkout-modal-header">
    <h3 data-i18n="common.checkout">Checkout</h3>
    <button class="checkout-modal-close" id="checkoutModalClose">&times;</button>
  </div>
  <div class="checkout-modal-body">
    <div class="checkout-order-summary" id="checkoutOrderSummary"></div>
    <div class="checkout-payment-section">
      <h4 data-i18n="cart.payment_method">Payment Method</h4>
      <div class="checkout-payment-info" id="checkoutPaymentInfo">
        <p>Loading payment information...</p>
      </div>
    </div>
  </div>
</div>

<style>
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(58, 64, 61, 0.5);
    backdrop-filter: blur(2px);
    z-index: var(--z-modal);
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-base);
  }
  .cart-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100vh;
    background: var(--color-bg-tertiary);
    z-index: calc(var(--z-modal) + 1);
    transform: translateX(100%);
    transition: var(--transition-base);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xl);
  }
  .cart-drawer.open {
    transform: translateX(0);
  }
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border-light);
  }
  .cart-header h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
  }
  .cart-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-primary);
    padding: 0.25rem;
    line-height: 0;
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }
  .cart-close:hover {
    background: var(--color-bg-secondary);
  }
  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }
  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
  }
  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cart-item {
    display: flex;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-light);
  }
  .cart-item-img {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex-shrink: 0;
  }
  .cart-item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .cart-item-name {
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .cart-item-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .cart-item-qty button {
    background: none;
    border: none;
    width: 28px;
    height: 28px;
    cursor: pointer;
    font-size: 1rem;
    color: var(--color-text-primary);
    transition: var(--transition-fast);
  }
  .cart-item-qty button:hover {
    background: var(--color-bg-secondary);
  }
  .cart-item-qty span {
    min-width: 24px;
    text-align: center;
    font-size: 0.9rem;
  }
  .cart-item-price {
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .cart-item-remove {
    background: none;
    border: none;
    color: var(--color-text-tertiary);
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0;
    transition: var(--transition-fast);
  }
  .cart-item-remove:hover {
    color: var(--state-error);
  }
  .cart-footer {
    padding: 1.5rem;
    border-top: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.1rem;
  }
  .cart-total-price {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
  }
  .cart-note {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    text-align: center;
  }

  /* Checkout Modal */
  .checkout-overlay {
    position: fixed;
    inset: 0;
    background: rgba(58, 64, 61, 0.5);
    backdrop-filter: blur(2px);
    z-index: calc(var(--z-modal) + 2);
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-base);
  }
  .checkout-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .checkout-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    background: var(--color-bg-tertiary);
    border-radius: 16px;
    width: 90%;
    max-width: 500px;
    max-height: 80vh;
    overflow-y: auto;
    z-index: calc(var(--z-modal) + 3);
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-xl);
  }
  .checkout-modal.open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }
  .checkout-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border-light);
  }
  .checkout-modal-header h3 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
  }
  .checkout-modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--color-text-secondary);
    padding: 0;
    line-height: 1;
  }
  .checkout-modal-close:hover {
    color: var(--color-text-primary);
  }
  .checkout-modal-body {
    padding: 1.5rem;
  }
  .checkout-order-summary {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-light);
  }
  .checkout-order-item {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }
  .checkout-order-total {
    display: flex;
    justify-content: space-between;
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-border-light);
    font-weight: 600;
    font-size: 1.1rem;
  }
  .checkout-payment-section h4 {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }
  .checkout-payment-info {
    background: var(--color-bg-secondary);
    border-radius: 10px;
    padding: 1rem;
    font-size: 0.9rem;
    line-height: 1.6;
    white-space: pre-wrap;
    color: var(--color-text-secondary);
  }
  .checkout-payment-info a {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }
  .checkout-payment-info .no-payment {
    text-align: center;
    color: var(--color-text-tertiary);
    padding: 1rem 0;
  }
</style>

<script is:inline>
  (function() {
    const CART_KEY = 'ov-cart';
    const drawer = document.getElementById('cartDrawer');
    const overlay = document.getElementById('cartOverlay');
    const closeBtn = document.getElementById('cartClose');
    const continueBtn = document.getElementById('cartContinue');
    const cartItemsEl = document.getElementById('cartItems');
    const cartEmptyEl = document.getElementById('cartEmpty');
    const cartFooterEl = document.getElementById('cartFooter');
    const cartTotalEl = document.getElementById('cartTotal');
    const cartCountEls = document.querySelectorAll('.cart-count');

    function getCart() {
      try {
        return JSON.parse(localStorage.getItem(CART_KEY)) || [];
      } catch (e) {
        return [];
      }
    }

    function saveCart(cart) {
      localStorage.setItem(CART_KEY, JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart-update'));
    }

    function getCurrency() {
      // FIX: USD only — display must match settlement currency to avoid price mismatch
      return 'USD';
    }

    // FIX (Financial BUG): All display and settlement in USD per user requirement.
    // Rate locked to 1, symbol always $ regardless of user language selection.
    // Structure retained for future extensibility; values pinned to USD.
    const currencyRates = {
      USD: { symbol: '$', rate: 1 },
      EUR: { symbol: '$', rate: 1 },
      GBP: { symbol: '$', rate: 1 },
      CNY: { symbol: '$', rate: 1 }
    };

    function formatPrice(usd) {
      // Always display in USD ($) — no FX conversion.
      // Cart stores price in USD; checkout totals must exactly match displayed totals.
      const { symbol, rate } = currencyRates.USD;
      const raw = usd * rate;
      // FIX: Show decimals only if fractional part exists (e.g. $9.99 → $9.99, $49 → $49)
      const formatted = (Math.round(raw * 100) / 100) % 1 === 0
        ? raw.toFixed(0)
        : raw.toFixed(2);
      return `${symbol}${formatted}`;
    }

    function updateCartCount() {
      const cart = getCart();
      const count = cart.reduce((sum, item) => sum + item.quantity, 0);
      cartCountEls.forEach(el => {
        el.textContent = count;
        el.style.display = count > 0 ? 'flex' : 'none';
      });
    }

    function renderCart() {
      const cart = getCart();
      if (cart.length === 0) {
        cartEmptyEl.style.display = 'flex';
        cartItemsEl.style.display = 'none';
        cartFooterEl.style.display = 'none';
        return;
      }
      cartEmptyEl.style.display = 'none';
      cartItemsEl.style.display = 'flex';
      cartFooterEl.style.display = 'flex';

      cartItemsEl.innerHTML = cart.map((item, index) => `
        <div class="cart-item">
          <img src="${item.image}" alt="${item.name}" class="cart-item-img" />
          <div class="cart-item-info">
            <div>
              <div class="cart-item-name">${item.name}</div>
              <button class="cart-item-remove" data-index="${index}" data-i18n="cart.remove">Remove</button>
            </div>
            <div class="cart-item-bottom">
              <div class="cart-item-qty">
                <button data-action="decrease" data-index="${index}">−</button>
                <span>${item.quantity}</span>
                <button data-action="increase" data-index="${index}">+</button>
              </div>
              <span class="cart-item-price" data-price-usd="${item.price * item.quantity}">${formatPrice(item.price * item.quantity)}</span>
            </div>
          </div>
        </div>
      `).join('');

      const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
      cartTotalEl.setAttribute('data-price-usd', total);
      cartTotalEl.textContent = formatPrice(total);

      applyCartTranslations();
    }

    function handleCartClick(e) {
      const actionBtn = e.target.closest('button[data-action]');
      const removeBtn = e.target.closest('.cart-item-remove');

      if (actionBtn) {
        const index = parseInt(actionBtn.dataset.index);
        const action = actionBtn.dataset.action;
        const cart = getCart();
        if (!cart[index]) return;
        if (action === 'increase') {
          cart[index].quantity += 1;
        } else if (action === 'decrease') {
          cart[index].quantity -= 1;
          if (cart[index].quantity <= 0) {
            cart.splice(index, 1);
          }
        }
        saveCart(cart);
        renderCart();
      }

      if (removeBtn) {
        const index = parseInt(removeBtn.dataset.index);
        const cart = getCart();
        if (!cart[index]) return;
        cart.splice(index, 1);
        saveCart(cart);
        renderCart();
      }
    }

    cartItemsEl.addEventListener('click', handleCartClick);

    function openCart() {
      drawer.classList.add('open');
      overlay.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      renderCart();
    }

    function closeCart() {
      drawer.classList.remove('open');
      overlay.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function addToCart(product) {
      const cart = getCart();
      const existing = cart.find(item => item.id === product.id);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ ...product, quantity: 1 });
      }
      saveCart(cart);
      updateCartCount();
      openCart();
    }

    function applyCartTranslations() {
      const lang = localStorage.getItem('ov-lang') || 'en';
      fetch(`/i18n/${lang}.json`)
        .then(r => r.json())
        .then(t => {
          if (!t.cart) return;
          document.querySelectorAll('#cartDrawer [data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            const parts = key.split('.');
            let val = t;
            for (let i = 0; i < parts.length; i++) val = val?.[parts[i]];
            if (val) el.textContent = val;
          });
        })
        .catch(() => {});
    }

    closeBtn?.addEventListener('click', closeCart);
    overlay?.addEventListener('click', closeCart);
    continueBtn?.addEventListener('click', closeCart);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (document.getElementById('checkoutModal').classList.contains('open')) {
          closeCheckout();
        } else {
          closeCart();
        }
      }
    });

    // Checkout modal
    const checkoutOverlay = document.getElementById('checkoutOverlay');
    const checkoutModal = document.getElementById('checkoutModal');
    const checkoutModalClose = document.getElementById('checkoutModalClose');
    const checkoutBtn = document.getElementById('checkoutBtn');
    const checkoutOrderSummary = document.getElementById('checkoutOrderSummary');
    const checkoutPaymentInfo = document.getElementById('checkoutPaymentInfo');

    function getPaymentSettings() {
      try {
        const settings = JSON.parse(localStorage.getItem('ov-admin-settings'));
        return settings || {};
      } catch { return {}; }
    }

    function openCheckout() {
      const cart = getCart();
      if (cart.length === 0) return;

      const settings = getPaymentSettings();
      if (settings.paymentEnabled === false) {
        alert('Payment is currently unavailable. Please contact us for assistance.');
        return;
      }

      // Render order summary
      let itemsHtml = cart.map(item => `
        <div class="checkout-order-item">
          <span>${item.name} x${item.quantity}</span>
          <span>${formatPrice(item.price * item.quantity)}</span>
        </div>
      `).join('');

      const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
      itemsHtml += `
        <div class="checkout-order-total">
          <span>Total</span>
          <span>${formatPrice(total)}</span>
        </div>
      `;
      checkoutOrderSummary.innerHTML = itemsHtml;

      // Render payment info
      const paymentInfo = settings.paymentInfo || '';
      if (paymentInfo.trim()) {
        // Convert URLs to clickable links
        const linked = paymentInfo.replace(
          /(https?:\/\/[^\s]+)/g,
          '<a href="$1" target="_blank" rel="noopener">$1</a>'
        );
        checkoutPaymentInfo.innerHTML = linked;
      } else {
        checkoutPaymentInfo.innerHTML = '<p class="no-payment">Please contact us to complete your order.</p>';
      }

      checkoutOverlay.classList.add('open');
      checkoutModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeCheckout() {
      checkoutOverlay.classList.remove('open');
      checkoutModal.classList.remove('open');
      if (!drawer.classList.contains('open')) {
        document.body.style.overflow = '';
      }
    }

    checkoutBtn?.addEventListener('click', openCheckout);
    checkoutModalClose?.addEventListener('click', closeCheckout);
    checkoutOverlay?.addEventListener('click', closeCheckout);

    document.querySelectorAll('.floating-cart-btn, [data-cart-toggle]').forEach(btn => {
      btn.addEventListener('click', openCart);
    });

    window.addEventListener('cart-update', updateCartCount);
    window.addEventListener('currency-change', () => {
      renderCart();
      updateCartCount();
    });
    window.addEventListener('lang-change', () => {
      applyCartTranslations();
      if (drawer.classList.contains('open')) {
        renderCart();
      }
    });

    updateCartCount();
    window.__cart = { addToCart, openCart, closeCart, getCart };

    // Live refresh: settings changed in admin → if checkout modal IS open right now, re-render it
    function settingsKeyChanged(k) {
      return k == null || k === 'settings' ||
        (typeof k === 'string' && k.indexOf('ov-admin-settings') === 0);
    }
    function rerenderCheckoutIfOpen() {
      if (checkoutModal && checkoutModal.classList.contains('open')) openCheckout();
    }
    window.addEventListener('ov-admin-saved', function(e) {
      if (settingsKeyChanged(e && e.detail && e.detail.key)) {
        // If drawer is open, re-render cart so member discounts reflect latest membership levels too
        if (drawer && drawer.classList.contains('open')) renderCart();
        rerenderCheckoutIfOpen();
      }
    });
    window.addEventListener('storage', function(e) {
      if (settingsKeyChanged(e ? e.key : null)) {
        if (drawer && drawer.classList.contains('open')) renderCart();
        rerenderCheckoutIfOpen();
      }
    });
  })();
</script>
