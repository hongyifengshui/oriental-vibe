---
import '../styles/global.css';
import { translations } from '../i18n/index.js';
const __segs = Astro.url.pathname.split('/').filter(Boolean);
const __L = __segs[0] === 'zh' ? 'zh' : 'en';
const T = translations[__L] || translations.en;
const t = (k, fb = '') => {
  let v = T;
  for (const p of k.split('.')) { v = v?.[p]; if (v === undefined || v === null) return fb || k; }
  return typeof v === 'string' ? v : (fb || k);
};
---
<div class="cookie-banner" id="cookieBanner" role="dialog" aria-label={__L === 'zh' ? 'Cookie 同意' : 'Cookie consent'}>
  <p class="cookie-text" data-i18n="cookie.text">{t('cookie.text')}</p>
  <div class="cookie-buttons">
    <button class="btn cookie-decline" id="cookieDecline" data-i18n="cookie.decline">{t('cookie.decline', 'Decline')}</button>
    <button class="btn cookie-accept" id="cookieAccept" data-i18n="cookie.accept">{t('cookie.accept', 'Accept')}</button>
  </div>
</div>
<script is:inline>
  (function () {
    const banner = document.getElementById('cookieBanner');
    if (!banner) return;
    const choice = localStorage.getItem('ov-cookie-consent');
    if (choice) {
      banner.style.display = 'none';
      return;
    }
    banner.style.display = 'flex';
    const accept = document.getElementById('cookieAccept');
    const decline = document.getElementById('cookieDecline');
    const close = (value) => {
      localStorage.setItem('ov-cookie-consent', value);
      banner.style.display = 'none';
      window.dispatchEvent(new CustomEvent('cookie-consent', { detail: value }));
    };
    accept?.addEventListener('click', () => close('accepted'));
    decline?.addEventListener('click', () => close('declined'));
  })();
</script>
