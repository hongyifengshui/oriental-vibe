---
import '../styles/global.css';
const DEFAULT_NUM = '1234567890';
---
<a href={`https://wa.me/${DEFAULT_NUM}`} class="whatsapp-btn" id="ovWhatsAppBtn" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M16.001 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.255.589 4.459 1.706 6.402L3.2 28.8l6.55-1.717a12.724 12.724 0 0 0 6.251 1.634h.005c7.06 0 12.8-5.74 12.8-12.8 0-3.421-1.332-6.635-3.751-9.054A12.708 12.708 0 0 0 16.001 3.2zm0 23.04h-.004a10.6 10.6 0 0 1-5.4-1.481l-.387-.23-4.014 1.052 1.071-3.912-.252-.401a10.58 10.58 0 0 1-1.623-5.668c0-5.865 4.775-10.64 10.641-10.64 2.842 0 5.514 1.108 7.523 3.118a10.58 10.58 0 0 1 3.116 7.524c0 5.865-4.775 10.64-10.64 10.64zm5.834-7.965c-.319-.16-1.887-.93-2.178-1.036-.292-.106-.504-.159-.716.16-.213.319-.823 1.036-1.009 1.248-.186.213-.371.239-.69.08-.319-.16-1.346-.496-2.563-1.582-.948-.846-1.587-1.89-1.773-2.209-.186-.319-.02-.491.14-.65.144-.143.319-.371.478-.557.16-.186.213-.319.319-.531.106-.213.053-.398-.027-.557-.08-.16-.716-1.725-.981-2.362-.258-.62-.52-.536-.716-.546l-.61-.011c-.213 0-.557.08-.849.398-.292.319-1.113 1.088-1.113 2.653 0 1.565 1.14 3.076 1.299 3.289.16.213 2.243 3.423 5.431 4.8.758.327 1.35.522 1.812.669.761.242 1.453.208 2.001.126.611-.091 1.887-.771 2.152-1.516.265-.745.265-1.383.186-1.516-.08-.133-.292-.213-.611-.372z"/>
  </svg>
  <span class="whatsapp-tooltip" data-i18n="common.whatsapp">WhatsApp</span>
</a>
<script is:inline>
  // Sync WhatsApp number from admin → settings → whatsapp (live refresh)
  // Number may be "+1 555-123-4567", "8613888888888", "+852 9123 4567" etc. Strip all non-digit and trim leading 00/+.
  (function() {
    function apply() {
      try {
        var raw = localStorage.getItem('ov-admin-settings');
        var settings = raw ? JSON.parse(raw) : null;
        var btn = document.getElementById('ovWhatsAppBtn');
        if (!btn) return;
        var num = settings && settings.whatsapp ? String(settings.whatsapp) : '';
        if (!num) return;
        var cleaned = num.replace(/[^\d]/g, '').replace(/^00/, '');
        if (!cleaned) return;
        btn.setAttribute('href', 'https://wa.me/' + cleaned);
      } catch(e) {}
    }
    function runWhenReady(fn) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, { once: true }); else fn(); }
    runWhenReady(apply);
    window.addEventListener('ov-admin-saved', function(e) { var k = e && e.detail && e.detail.key; if (k == null || k === 'settings') apply(); });
    window.addEventListener('storage', function(e) { if (e.key === 'ov-admin-settings') apply(); });
  })();
</script>
