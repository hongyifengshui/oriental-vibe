---
import '../styles/global.css';
import { translations } from '../i18n/index.js';
const year = new Date().getFullYear();

// SSR locale: derive from current path so the static HTML ships already in the
// correct language — no runtime-translation "placeholder flicker".  This is the
// structural counterpart to the build-time language-isolation hard-guard.
const __segs = Astro.url.pathname.split('/').filter(Boolean);
const __L = __segs[0] === 'zh' ? 'zh' : 'en';
const T = translations[__L] || translations.en;
const t = (k, fb = '') => {
  let v = T;
  for (const p of k.split('.')) { v = v?.[p]; if (v === undefined || v === null) return fb || k; }
  return typeof v === 'string' ? v : (fb || k);
};

const socialLinks = [
  { href: 'https://instagram.com', aria: __L === 'zh' ? 'Instagram' : 'Instagram', label: 'IG' },
  { href: 'https://facebook.com', aria: __L === 'zh' ? 'Facebook（臉書）' : 'Facebook', label: 'FB' },
  { href: 'https://youtube.com', aria: __L === 'zh' ? 'YouTube（優兔）' : 'YouTube', label: 'YT' },
  { href: 'https://pinterest.com', aria: __L === 'zh' ? 'Pinterest' : 'Pinterest', label: 'PIN' },
];

const paymentIcons = [
  { aria: __L === 'zh' ? 'Visa' : 'Visa', label: 'VISA' },
  { aria: __L === 'zh' ? 'Mastercard（萬事達）' : 'Mastercard', label: 'MC' },
  { aria: 'PayPal', label: 'PayPal' },
  { aria: __L === 'zh' ? 'Apple Pay' : 'Apple Pay', label: 'Apple Pay' },
  { aria: __L === 'zh' ? 'Google Pay' : 'Google Pay', label: 'G Pay' },
  { aria: 'Stripe', label: 'Stripe' },
];
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h3 class="footer-brand" data-i18n="brand.name">{t('brand.name', 'Oriental Vibe')}</h3>
        <p class="footer-description" data-i18n="footer.desc">{t('footer.desc')}</p>
        <div class="footer-social">
          {socialLinks.map(s => (
            <a href={s.href} aria-label={s.aria} target="_blank" rel="noopener">{s.label}</a>
          ))}
        </div>
      </div>

      <div class="footer-col">
        <h4 data-i18n="footer.shop">{t('footer.shop', 'Shop')}</h4>
        <ul>
          <li><a href={__L === 'zh' ? '/zh/shop' : '/en/shop'} data-i18n="footer.shop_all">{t('footer.shop_all')}</a></li>
          <li><a href={(__L === 'zh' ? '/zh' : '/en') + '/shop?category=crystals'} data-i18n="footer.crystals">{t('footer.crystals')}</a></li>
          <li><a href={(__L === 'zh' ? '/zh' : '/en') + '/shop?category=decor'} data-i18n="footer.decor">{t('footer.decor')}</a></li>
          <li><a href={(__L === 'zh' ? '/zh' : '/en') + '/shop?category=clearing'} data-i18n="footer.clearing">{t('footer.clearing')}</a></li>
          <li><a href={(__L === 'zh' ? '/zh' : '/en') + '/shop#bundles'} data-i18n="footer.bundles">{t('footer.bundles')}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 data-i18n="footer.services">{t('footer.services')}</h4>
        <ul>
          <li><a href={__L === 'zh' ? '/zh/services' : '/en/services'} data-i18n="footer.consultation">{t('footer.consultation')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/services' : '/en/services'} data-i18n="footer.bazi">{t('footer.bazi')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/services' : '/en/services'} data-i18n="footer.energy_audit">{t('footer.energy_audit')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/courses' : '/en/courses'} data-i18n="footer.courses">{t('footer.courses')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/element-test' : '/en/element-test'} data-i18n="footer.element_test">{t('footer.element_test')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/membership' : '/en/membership'} data-i18n="nav.membership">{t('nav.membership')}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 data-i18n="footer.support">{t('footer.support')}</h4>
        <ul>
          <li><a href={__L === 'zh' ? '/zh/about' : '/en/about'} data-i18n="footer.about">{t('footer.about')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/contact' : '/en/contact'} data-i18n="footer.contact">{t('footer.contact')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/faq' : '/en/faq'} data-i18n="footer.faq">{t('footer.faq')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/shipping' : '/en/shipping'} data-i18n="footer.shipping">{t('footer.shipping')}</a></li>
          <li><a href={__L === 'zh' ? '/zh/privacy' : '/en/privacy'} data-i18n="footer.privacy">{t('footer.privacy')}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-payments">
      <span data-i18n="footer.we_accept">{t('footer.we_accept', 'We Accept')}:</span>
      <div class="footer-payments-icons">
        {paymentIcons.map(p => (<span aria-label={p.aria}>{p.label}</span>))}
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-disclaimer" data-i18n="footer.disclaimer">{t('footer.disclaimer')}</p>
    </div>
  </div>
</footer>

<script is:inline>
  // Sync admin settings to footer (live refresh)
  function syncFooterSettings() {
    try {
      const settings = JSON.parse(localStorage.getItem('ov-admin-settings'));
      if (!settings) return;
      if (settings.siteName) {
        const brand = document.querySelector('.footer-brand');
        if (brand) brand.textContent = settings.siteName;
      }
      if (settings.siteDesc) {
        const desc = document.querySelector('.footer-description');
        if (desc) desc.textContent = settings.siteDesc;
      }
      if (settings.whatsapp) {
        const whatsappLink = document.querySelector('a.footer-whatsapp-link, a.footer-social-whatsapp, a.footer-contact-whatsapp');
        if (whatsappLink) {
          const num = String(settings.whatsapp).replace(/[^\d]/g, '');
          whatsappLink.setAttribute('href', 'https://wa.me/' + num);
        }
      }
      if (settings.email) {
        document.querySelectorAll('a.footer-email-link, a.footer-contact-email').forEach(a => {
          a.setAttribute('href', 'mailto:' + settings.email);
          if (!a.textContent.trim() || a.textContent.indexOf('@') < 0) a.textContent = settings.email;
        });
      }
    } catch(e) {}
  }
  function runWhenReady(fn) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, { once: true }); else fn(); }
  runWhenReady(syncFooterSettings);
  window.addEventListener('ov-admin-saved', e => { const k = e && e.detail && e.detail.key; if (k == null || k === 'settings') syncFooterSettings(); });
  window.addEventListener('storage', e => { if (e.key === 'ov-admin-settings') syncFooterSettings(); });
</script>
