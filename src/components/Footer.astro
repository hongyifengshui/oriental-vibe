---
import '../styles/global.css';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h3 class="footer-brand" data-i18n="brand.name">Oriental Vibe</h3>
        <p class="footer-description" data-i18n="footer.desc">
          Bridging ancient Eastern wisdom with modern Western living. We help you harmonize your space, balance your energy, and elevate your everyday life.
        </p>
        <div class="footer-social">
          <a href="https://instagram.com" aria-label="Instagram" target="_blank" rel="noopener">IG</a>
          <a href="https://facebook.com" aria-label="Facebook" target="_blank" rel="noopener">FB</a>
          <a href="https://youtube.com" aria-label="YouTube" target="_blank" rel="noopener">YT</a>
          <a href="https://pinterest.com" aria-label="Pinterest" target="_blank" rel="noopener">PIN</a>
        </div>
      </div>

      <div class="footer-col">
        <h4 data-i18n="footer.shop">Shop</h4>
        <ul>
          <li><a href="/shop" data-i18n="footer.shop_all">All Products</a></li>
          <li><a href="/shop?category=crystals" data-i18n="footer.crystals">Crystals</a></li>
          <li><a href="/shop?category=decor" data-i18n="footer.decor">Decor</a></li>
          <li><a href="/shop?category=clearing" data-i18n="footer.clearing">Space Clearing</a></li>
          <li><a href="/shop#bundles" data-i18n="footer.bundles">Bundles</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 data-i18n="footer.services">Services</h4>
        <ul>
          <li><a href="/services" data-i18n="footer.consultation">Space Consultation</a></li>
          <li><a href="/services" data-i18n="footer.bazi">BaZi Reading</a></li>
          <li><a href="/services" data-i18n="footer.energy_audit">Energy Audit</a></li>
          <li><a href="/courses" data-i18n="footer.courses">Courses</a></li>
          <li><a href="/element-test" data-i18n="footer.element_test">Five Elements Test</a></li>
          <li><a href="/membership" data-i18n="nav.membership">Membership</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 data-i18n="footer.support">Support</h4>
        <ul>
          <li><a href="/about" data-i18n="footer.about">About Us</a></li>
          <li><a href="/contact" data-i18n="footer.contact">Contact</a></li>
          <li><a href="/faq" data-i18n="footer.faq">FAQ</a></li>
          <li><a href="/shipping" data-i18n="footer.shipping">Shipping & Returns</a></li>
          <li><a href="/privacy" data-i18n="footer.privacy">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-payments">
      <span data-i18n="footer.we_accept">We Accept:</span>
      <div class="footer-payments-icons">
        <span aria-label="Visa">VISA</span>
        <span aria-label="Mastercard">MC</span>
        <span aria-label="PayPal">PayPal</span>
        <span aria-label="Apple Pay">Apple Pay</span>
        <span aria-label="Google Pay">G Pay</span>
        <span aria-label="Stripe">Stripe</span>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-disclaimer" data-i18n="footer.disclaimer">
        All content is spiritual wellness & interior energy reference only. Not medical, legal or financial advice. No guaranteed results.
      </p>
    </div>
  </div>
</footer>
