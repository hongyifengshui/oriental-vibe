---
/**
 * PageContact.astro — Contact page
 *
 * Layout: Hero → 2-col (form + info card) → WhatsApp CTA
 * Design tokens match BrandFunnel.astro earthy palette.
 * All copy via i18n `contact.*` keys. Locale from Astro.props.locale.
 */
import { translations } from '../../i18n/index.js';

const props = Astro.props || {};
let locale = (typeof props.locale === 'string') ? props.locale : 'en';
if (locale !== 'zh' && locale !== 'en') locale = 'en';
const L = locale;
const T = translations[L] || translations.en;
const pick = (k, fb) => k.split('.').reduce((acc, p) => acc?.[p], T) ?? fb ?? k;

const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';
const heroBg = `${imgBase}warm%20minimalist%20workspace%20with%20scrolls%20crystals%20tea%20zen%20aesthetic&image_size=landscape_16_9`;

const prefix = '/' + L;
const href = (p) => prefix + p;
---
<main class="funnel funnel--contact">
  {/* 1 HERO */}
  <section class="funnel-hero">
    <div class="funnel-hero__bg" style={`background-image: url(${heroBg});`}></div>
    <div class="funnel-wrap funnel-hero__inner" style="grid-template-columns:1fr;text-align:center;">
      <div class="funnel-hero__copy" style="max-width:700px;margin-inline:auto;">
        <p class="funnel-overline center" data-i18n="contact.hero_subtitle">{pick('contact.hero_subtitle', 'Get in Touch')}</p>
        <h1 class="funnel-h1" data-i18n="contact.title">{pick('contact.title', 'Contact Us')}</h1>
        <p class="funnel-sub" data-i18n="contact.subtitle">{pick('contact.subtitle', 'Have questions? We would love to hear from you.')}</p>
      </div>
    </div>
  </section>

  {/* 2 FORM + INFO (2-col) */}
  <section class="funnel-section">
    <div class="funnel-wrap" style="display:grid;grid-template-columns:1.2fr 0.8fr;gap:40px;align-items:start;">
      {/* Form */}
      <div class="contact-form-wrap">
        <form class="contact-form" onsubmit="event.preventDefault();alert('{pick('contact.success_msg', 'Thank you for your message! We will get back to you within 24 hours.')}')">
          <div class="contact-field">
            <label data-i18n="contact.form_name">{pick('contact.form_name', 'Your Name')}</label>
            <input type="text" name="name" placeholder={pick('contact.name_placeholder', 'John Doe')} required />
          </div>
          <div class="contact-field">
            <label data-i18n="contact.form_email">{pick('contact.form_email', 'Your Email')}</label>
            <input type="email" name="email" placeholder={pick('contact.email_placeholder', 'you@example.com')} required />
          </div>
          <div class="contact-field">
            <label data-i18n="contact.form_message">{pick('contact.form_message', 'Your Message')}</label>
            <textarea name="message" rows="5" placeholder={pick('contact.message_placeholder', 'Tell us more about your inquiry...')} required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%;" data-i18n="contact.form_submit">{pick('contact.form_submit', 'Send Message')}</button>
        </form>
      </div>

      {/* Info Card */}
      <div class="contact-info-card">
        <h3 data-i18n="contact.info_title">{pick('contact.info_title', 'Contact Information')}</h3>
        <div class="contact-info-item">
          <span class="contact-info-icon">📧</span>
          <div>
            <div class="contact-info-label" data-i18n="contact.email_label">{pick('contact.email_label', 'Email')}</div>
            <a href="mailto:hello@orientalvibe.com" data-i18n="contact.email_value">{pick('contact.email_value', 'hello@orientalvibe.com')}</a>
          </div>
        </div>
        <div class="contact-info-item">
          <span class="contact-info-icon">📱</span>
          <div>
            <div class="contact-info-label" data-i18n="contact.phone_label">{pick('contact.phone_label', 'Phone')}</div>
            <a href="tel:+15551234567" data-i18n="contact.phone_value">{pick('contact.phone_value', '+1 (555) 123-4567')}</a>
          </div>
        </div>
        <div class="contact-info-item">
          <span class="contact-info-icon">📍</span>
          <div>
            <div class="contact-info-label" data-i18n="contact.address_label">{pick('contact.address_label', 'Address')}</div>
            <span data-i18n="contact.address_value">{pick('contact.address_value', '123 Harmony Street, San Francisco, CA 94102')}</span>
          </div>
        </div>
        <div class="contact-info-item">
          <span class="contact-info-icon">🕐</span>
          <div>
            <div class="contact-info-label" data-i18n="contact.hours_label">{pick('contact.hours_label', 'Business Hours')}</div>
            <span data-i18n="contact.hours_value">{pick('contact.hours_value', 'Monday – Friday, 9:00 AM – 6:00 PM (PST)')}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3 WHATSAPP CTA */}
  <section class="funnel-section funnel-section--paper" style="text-align:center;">
    <div class="funnel-wrap">
      <h2 class="funnel-h2 center" data-i18n="contact.whatsapp_cta">{pick('contact.whatsapp_cta', 'Prefer WhatsApp?')}</h2>
      <p class="funnel-p center" data-i18n="contact.whatsapp_text" style="max-width:600px;margin-inline:auto;">{pick('contact.whatsapp_text', 'Chat with us on WhatsApp for quick answers and consultation bookings.')}</p>
      <a href="https://wa.me/15551234567" class="btn btn-primary btn-lg" style="margin-top:12px;background:#25D366;border-color:#25D366;color:#fff;" target="_blank" rel="noopener">
        💬 WhatsApp
      </a>
    </div>
  </section>

  {/* Disclaimer */}
  <p style="text-align:center;font-size:12px;color:#9A7B4D;padding:24px 16px 40px;max-width:700px;margin:0 auto;line-height:1.7;" data-i18n="contact.disclaimer">{pick('contact.disclaimer', 'This form is for general inquiries only.')}</p>
</main>

<style is:global>
.contact-form-wrap{background:#fff;border:1px solid #EFE6D2;border-radius:16px;padding:32px;}
.contact-form{display:flex;flex-direction:column;gap:18px;}
.contact-field{display:flex;flex-direction:column;gap:6px;}
.contact-field label{font-size:14px;font-weight:600;color:#1A1715;}
.contact-field input,.contact-field textarea{padding:12px 14px;border:1px solid #EFE6D2;border-radius:8px;font-size:14px;font-family:inherit;background:#FFFBF2;color:#1A1715;transition:border-color .2s;}
.contact-field input:focus,.contact-field textarea:focus{outline:none;border-color:#C79F60;box-shadow:0 0 0 3px rgba(199,159,96,.12);}
.contact-field textarea{resize:vertical;min-height:120px;}
.contact-info-card{background:#FFFBF2;border:1px solid #EFE6D2;border-radius:16px;padding:28px;}
.contact-info-card h3{font-family:'Playfair Display','STKaiti',Georgia,serif;font-size:20px;color:#1A1715;margin:0 0 20px;}
.contact-info-item{display:flex;gap:14px;align-items:flex-start;padding:12px 0;border-bottom:1px solid #EFE6D2;}
.contact-info-item:last-child{border-bottom:none;}
.contact-info-icon{font-size:20px;flex-shrink:0;width:28px;text-align:center;}
.contact-info-label{font-size:12px;color:#9A7B4D;text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:2px;}
.contact-info-item span,.contact-info-item a{font-size:14px;color:#56514B;text-decoration:none;}
.contact-info-item a:hover{color:#8C5A2B;}
@media (max-width:780px){
  .funnel--contact .funnel-wrap[style*="grid-template-columns"]{grid-template-columns:1fr !important;}
  .contact-form-wrap{padding:22px;}
}
</style>