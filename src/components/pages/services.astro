---
/**
 * PageServices.astro — Services
 *
 * 6-section funnel: Hero → Expert Card → Category Tabs → Service Cards → FAQ → CTA
 * Reads from i18n `services.*` keys + data/services.js for service cards.
 */
import { translations } from '../../i18n/index.js';
import { services, serviceCategories } from '../../data/services.js';

const props = Astro.props || {};
let locale = (typeof props.locale === 'string') ? props.locale : 'en';
if (locale !== 'zh' && locale !== 'en') locale = 'en';
const L = locale;
const T = translations[L] || translations.en;
const pick = (k, fb) => k.split('.').reduce((acc, p) => acc?.[p], T) ?? fb ?? k;

const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';
const heroBg = `${imgBase}professional%20feng%20shui%20consultation%20desk%20with%20compass%20crystals%20scrolls%20warm%20light%20japandi&image_size=landscape_16_9`;
const masterImg = `${imgBase}professional%20portrait%20middle%20aged%20chinese%20master%20xu%20wei%20burgundy%20polo%20shirt%20wooden%20beads%20bracelet%20black%20studio%20warm%20light&image_size=square_hd`;

const prefix = '/' + L;
const href = (p) => prefix + p;

const cats = Object.values(serviceCategories);
const catIcons = { personal: '📜', home: '🏠', business: '🏢', premium: '👑' };
---
<main class="funnel funnel--services">
  {/* 1 HERO */}
  <section class="funnel-hero">
    <div class="funnel-hero__bg" style={`background-image: url(${heroBg});`}></div>
    <div class="funnel-wrap funnel-hero__inner">
      <div class="funnel-hero__copy">
        <p class="funnel-overline" data-i18n="services.hero_subtitle">{pick('services.hero_subtitle')}</p>
        <h1 class="funnel-h1" data-i18n="services.hero_title">{pick('services.hero_title')}</h1>
        <p class="funnel-sub" data-i18n="services.hero_desc">{pick('services.hero_desc')}</p>
        <a class="btn btn-primary btn-lg" href="#services-section" data-i18n="services.services_title">{pick('services.services_title')}</a>
      </div>
    </div>
  </section>

  {/* 2 EXPERT CARD */}
  <section class="funnel-section">
    <div class="funnel-wrap" style="display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:start;background:#fff;border:1px solid #EFE6D2;border-radius:14px;padding:28px;">
      <div style="width:140px;height:140px;border-radius:14px;overflow:hidden;flex-shrink:0;background:#F3EBDB;">
        <img src={masterImg} alt={pick('services.expert_name')} width="140" height="140" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;" />
      </div>
      <div>
        <div style="font-family:'Playfair Display','STKaiti',Georgia,serif;font-size:22px;color:#1A1715;margin-bottom:4px;" data-i18n="services.expert_name">{pick('services.expert_name')}</div>
        <div style="font-size:13px;color:#8C5A2B;font-weight:600;margin-bottom:10px;" data-i18n="services.expert_title">{pick('services.expert_title')}</div>
        <p style="font-size:14px;color:#56514B;line-height:1.7;margin:0 0 12px;" data-i18n="services.expert_bio">{pick('services.expert_bio')}</p>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {[1,2,3,4,5,6,7,8].map(i=>(
            <span style="font-size:11px;background:#FFFBF2;border:1px solid #EFE6D2;padding:3px 10px;border-radius:999px;color:#625B51;white-space:nowrap;" data-i18n={`services.expert_cred_${i}`}>{pick(`services.expert_cred_${i}`)}</span>
          ))}
        </div>
        <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;">
          <a class="btn btn-sm btn-primary" href={href('/master')} data-i18n="services.expert_cta_about">{pick('services.expert_cta_about')}</a>
          <a class="btn btn-sm btn-ghost" href={href('/contact')} data-i18n="services.expert_cta_book">{pick('services.expert_cta_book')}</a>
        </div>
        <p style="font-size:11px;color:#9A7B4D;margin:8px 0 0;" data-i18n="services.expert_compliance">{pick('services.expert_compliance')}</p>
      </div>
    </div>
  </section>

  {/* 3 CATEGORY TABS */}
  <nav class="courses-nav" id="services-section">
    <div class="funnel-wrap courses-nav__inner">
      <span class="courses-nav__label">{pick('services.services_desc','Filter')}</span>
      <div class="courses-nav__pills">
        <button class="courses-pill is-active" data-svc="all">{pick('services.services_title','All')}</button>
        {cats.map(c=>(
          <button class="courses-pill" data-svc={c.id}>
            <span class="courses-pill__icon">{catIcons[c.id]}</span>
            <span data-i18n={c.titleKey}>{pick(c.titleKey, c.titleText)}</span>
          </button>
        ))}
      </div>
    </div>
  </nav>

  {/* 4 SERVICE CARDS */}
  <section class="funnel-section">
    <div class="funnel-wrap">
      <p class="funnel-overline center" data-i18n="services.services_desc">{pick('services.services_desc')}</p>
      <h2 class="funnel-h2 center" data-i18n="services.services_title">{pick('services.services_title')}</h2>
      <div class="services-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px;">
        {services.map(s=>(
          <article class="course-card course-card--svc" data-svc={s.category} style={s.popular ? 'border-color:#C79F60;' : (s.vip ? 'border-color:#8C5A2B;background:linear-gradient(180deg,#FFFBF2,#FFF5E0);' : '')}>
            {s.popular ? <span style="position:absolute;top:12px;right:12px;background:#C79F60;color:#FFF6DD;font-size:11px;padding:4px 10px;border-radius:999px;font-weight:600;z-index:2;">{L==='zh'?'最受欢迎':'POPULAR'}</span> : ''}
            {s.vip ? <span style="position:absolute;top:12px;right:12px;background:linear-gradient(135deg,#8C5A2B,#C79F60);color:#FFF6DD;font-size:11px;padding:4px 10px;border-radius:999px;font-weight:600;z-index:2;">VIP</span> : ''}
            <div class="course-card__body">
              <h4 class="course-card__t" data-i18n={s.titleKey}>{pick(s.titleKey)}</h4>
              <p class="course-card__d" data-i18n={s.descKey}>{pick(s.descKey)}</p>
              <div style="margin-top:auto;">
                {Array.from({length:s.features},(_,j)=>(
                  <div style="font-size:12px;color:#625B51;display:flex;align-items:center;gap:6px;padding:2px 0;" data-i18n={`services.service_${s.id}_feat_${j+1}`}>
                    <span style="color:#5B7B69;">✓</span> {pick(`services.service_${s.id}_feat_${j+1}`)}
                  </div>
                ))}
              </div>
            </div>
            <footer class="course-card__foot">
              <span class="course-card__price">{s.price}</span>
              <a class="btn btn-sm btn-primary" href={href('/contact')}>{pick('contact.title','Book Now')}</a>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 5 FAQ */}
  {[1,2,3].length>0 ? (
  <section class="funnel-section funnel-section--paper">
    <div class="funnel-wrap">
      <h2 class="funnel-h2 center">FAQ</h2>
      <div class="funnel-faq" style="margin-top:28px;">
        {[1,2,3].map(i=>(
          <details class="funnel-faq__item" open={i===1}>
            <summary data-i18n={`shop.faq_q_${i}`}>{pick(`shop.faq_q_${i}`)}</summary>
            <p data-i18n={`shop.faq_a_${i}`}>{pick(`shop.faq_a_${i}`)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  ) : ''}

  {/* 6 CTA */}
  <section class="funnel-cta">
    <div class="funnel-wrap funnel-cta__inner">
      <div class="funnel-cta__copy">
        <h2 class="funnel-h2">{pick('services.hero_title')}</h2>
        <p class="funnel-sub">{pick('services.hero_desc')}</p>
      </div>
      <div class="funnel-cta-row">
        <a class="btn btn-primary btn-lg" href={href('/contact')}>{pick('contact.title','Book a Consultation')}</a>
        <a class="btn btn-ghost btn-lg" href={href('/element-test')}>{pick('home.hero_cta','Free Test')}</a>
      </div>
    </div>
  </section>

  <p style="text-align:center;font-size:12px;color:#9A7B4D;padding:24px 16px 40px;max-width:860px;margin:0 auto;line-height:1.7;font-style:italic;" data-i18n="services.disclaimer">{pick('services.disclaimer')}</p>
</main>

<script is:inline>
  (function(){
    var pills = document.querySelectorAll('.courses-pill[data-svc]');
    var cards = document.querySelectorAll('.course-card--svc[data-svc]');
    if (!pills.length || !cards.length) return;
    pills.forEach(function(p){
      p.addEventListener('click',function(){
        pills.forEach(function(pp){pp.classList.remove('is-active');});
        p.classList.add('is-active');
        var f = p.getAttribute('data-svc');
        cards.forEach(function(c){
          c.style.display = (f==='all'||c.getAttribute('data-svc')===f) ? '' : 'none';
        });
      });
    });
    pills.forEach(function(p,i){if(i>0)p.classList.remove('is-active');});
  })();
</script>

<style is:global>
.course-card--svc{position:relative;overflow:visible;}
@media(max-width:980px){.services-grid{grid-template-columns:repeat(2,1fr)!important;}}
@media(max-width:640px){.services-grid{grid-template-columns:1fr!important;}}
</style>