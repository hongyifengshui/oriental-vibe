---
/**
 * PageElementTest.astro — Five Elements Test placeholder page
 *
 * Layout: Hero with CTA → placeholder card explaining the test is coming soon
 * Design tokens match BrandFunnel.astro earthy palette.
 * All copy via i18n `test.*` keys with inline fallbacks. Locale from Astro.props.locale.
 */
import { translations } from '../../i18n/index.js';

const props = Astro.props || {};
let locale = (typeof props.locale === 'string') ? props.locale : 'en';
if (locale !== 'zh' && locale !== 'en') locale = 'en';
const L = locale;
const T = translations[L] || translations.en;
const pick = (k, fb) => k.split('.').reduce((acc, p) => acc?.[p], T) ?? fb ?? k;

const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';
const heroBg = `${imgBase}minimalist%20five%20elements%20illustration%20wood%20fire%20earth%20metal%20water%20nordic%20watercolor&image_size=landscape_16_9`;

const prefix = '/' + L;
const href = (p) => prefix + p;
---
<main class="funnel funnel--test">
  {/* 1 HERO */}
  <section class="funnel-hero">
    <div class="funnel-hero__bg" style={`background-image: url(${heroBg});`}></div>
    <div class="funnel-wrap funnel-hero__inner" style="grid-template-columns:1fr;text-align:center;">
      <div class="funnel-hero__copy" style="max-width:700px;margin-inline:auto;">
        <p class="funnel-overline center" data-i18n="test.subtitle">{pick('test.subtitle', 'Discover your personal energy profile')}</p>
        <h1 class="funnel-h1" data-i18n="test.title">{pick('test.title', 'Five Elements Test')}</h1>
        <p class="funnel-sub" data-i18n="test.description">{pick('test.description', 'Coming soon. This interactive test will help you identify your dominant element and receive personalized recommendations.')}</p>
        <div class="funnel-cta-row" style="justify-content:center;">
          <a class="btn btn-primary btn-lg" href={href('/contact')} data-i18n="test.hero_subtitle">{pick('test.hero_subtitle', 'Book a Consultation')}</a>
          <a class="btn btn-ghost btn-lg" href={href('/services')} data-i18n="nav.services">{pick('nav.services', 'Services')}</a>
        </div>
      </div>
    </div>
  </section>

  {/* 2 PLACEHOLDER CARD */}
  <section class="funnel-section">
    <div class="funnel-wrap" style="max-width:700px;margin-inline:auto;">
      <div class="test-placeholder" style="background:#FFFBF2;border:1px solid #EFE6D2;border-radius:20px;padding:48px 32px;text-align:center;">
        <div style="font-size:48px;margin-bottom:16px;">🧘</div>
        <h2 class="funnel-h2" data-i18n="test.title">{pick('test.title', 'Five Elements Test')}</h2>
        <p class="funnel-p" data-i18n="test.description" style="max-width:520px;margin-inline:auto;">{pick('test.description', 'Coming soon. This interactive test will help you identify your dominant element and receive personalized recommendations.')}</p>
        <p class="funnel-p" style="color:#8C5A2B;font-weight:600;margin-top:8px;" data-i18n="test.hero_subtitle">{pick('test.hero_subtitle', 'Stay tuned — the Five Elements Test is on its way.')}</p>
        <a href={href('/contact')} class="btn btn-primary btn-lg" style="margin-top:16px;">{pick('contact.hero_subtitle', 'Get in Touch')}</a>
      </div>
    </div>
  </section>
</main>