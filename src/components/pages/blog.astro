---
/**
 * PageBlog.astro — Blog listing page
 *
 * Layout: Hero → Category pills → Grid of blog cards (3 cols) → Newsletter CTA
 * Design tokens match BrandFunnel.astro earthy palette.
 * All copy via i18n `blog.*` keys. Locale from Astro.props.locale.
 */
import { translations } from '../../i18n/index.js';
import { posts } from '../../data/blog.js';

const props = Astro.props || {};
let locale = (typeof props.locale === 'string') ? props.locale : 'en';
if (locale !== 'zh' && locale !== 'en') locale = 'en';
const L = locale;
const T = translations[L] || translations.en;
const pick = (k, fb) => k.split('.').reduce((acc, p) => acc?.[p], T) ?? fb ?? k;

const imgBase = 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=';
const heroBg = `${imgBase}minimalist%20reading%20nook%20with%20scrolls%20crystals%20warm%20lamp&image_size=landscape_16_9`;

const prefix = '/' + L;
const href = (p) => prefix + p;

const categories = [
  { key: 'blog.cat_home', slug: 'home', fb: 'Home Energy' },
  { key: 'blog.cat_office', slug: 'office', fb: 'Office' },
  { key: 'blog.cat_bazi', slug: 'bazi', fb: 'BaZi' },
  { key: 'blog.cat_space', slug: 'space', fb: 'Space Energy' },
  { key: 'blog.cat_wellness', slug: 'wellness', fb: 'Wellness' },
  { key: 'blog.cat_decor', slug: 'decor', fb: 'Decor' },
  { key: 'blog.cat_crystals', slug: 'crystals', fb: 'Crystal Healing' },
];
---
<main class="funnel funnel--blog">
  {/* 1 HERO */}
  <section class="funnel-hero">
    <div class="funnel-hero__bg" style={`background-image: url(${heroBg});`}></div>
    <div class="funnel-wrap funnel-hero__inner" style="grid-template-columns:1fr;text-align:center;">
      <div class="funnel-hero__copy" style="max-width:740px;margin-inline:auto;">
        <p class="funnel-overline center" data-i18n="blog.hero_subtitle">{pick('blog.hero_subtitle', 'Insights & Wisdom')}</p>
        <h1 class="funnel-h1" data-i18n="blog.hero_title">{pick('blog.hero_title', 'Blog & Articles')}</h1>
        <p class="funnel-sub" data-i18n="blog.hero_desc">{pick('blog.hero_desc', 'Explore space energy principles, wellness tips, and client stories')}</p>
      </div>
    </div>
  </section>

  {/* 2 CATEGORY PILLS */}
  <section class="funnel-stats" style="padding:28px 0;">
    <div class="funnel-wrap" style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;">
      {categories.map(cat => (
        <a href={href(`/blog?cat=${cat.slug}`)} class="blog-cat-pill" data-i18n={cat.key}>{pick(cat.key, cat.fb)}</a>
      ))}
    </div>
  </section>

  {/* 3 BLOG GRID */}
  <section class="funnel-section">
    <div class="funnel-wrap">
      <p class="funnel-overline center">{pick('blog.hero_subtitle', 'Insights & Wisdom')}</p>
      <h2 class="funnel-h2 center" data-i18n="blog.latest_title">{pick('blog.latest_title', 'Latest Articles')}</h2>
      <p class="funnel-p center" style="margin-bottom:36px;" data-i18n="blog.latest_desc">{pick('blog.latest_desc', 'Insights on space energy, elemental living, and modern wellness')}</p>
      <div class="blog-grid">
        {posts.map(post => {
          const catKey = post.categoryKey || 'blog.cat_home';
          const catFb = post.categoryEn || 'Home Energy';
          const titleKey = post.titleKey || '';
          const titleFb = post.titleEn || '';
          const excerptKey = post.excerptKey || '';
          const excerptFb = post.excerptEn || '';
          return (
            <article class="blog-card">
              <a href={href(`/blog/${post.id}`)} class="blog-card__img">
                <img src={post.image} alt={pick(post.titleKey, post.titleEn)} loading="lazy" decoding="async" width="400" height="225" />
              </a>
              <div class="blog-card__body">
                <div class="blog-card__meta">
                  <span class="blog-card__date">{post.date}</span>
                  <span class="blog-card__cat" data-i18n={catKey}>{pick(catKey, catFb)}</span>
                </div>
                <h3 class="blog-card__title">
                  <a href={href(`/blog/${post.id}`)} data-i18n={titleKey}>{pick(titleKey, titleFb)}</a>
                </h3>
                <p class="blog-card__excerpt" data-i18n={excerptKey}>{pick(excerptKey, excerptFb)}</p>
                <a href={href(`/blog/${post.id}`)} class="blog-card__link" data-i18n="blog.read_more">{pick('blog.read_more', 'Read More')} →</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  {/* 4 NEWSLETTER CTA */}
  <section class="funnel-cta">
    <div class="funnel-wrap funnel-cta__inner">
      <div class="funnel-cta__copy">
        <h2 class="funnel-h2">{pick('blog.hero_subtitle', 'Stay Inspired')}</h2>
        <p class="funnel-sub">{pick('blog.hero_desc', 'Get weekly energy wisdom delivered to your inbox.')}</p>
      </div>
      <form style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;" onsubmit="event.preventDefault();alert('Subscribed!')">
        <input type="email" placeholder={pick('home.newsletter_placeholder', 'Your email address')} style="padding:12px 16px;border:1px solid #EFE6D2;border-radius:8px;font-size:14px;min-width:260px;flex:1;background:#fff;font-family:inherit;" />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>
</main>

<style is:global>
.blog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;}
.blog-card{background:#fff;border:1px solid #EFE6D2;border-radius:14px;overflow:hidden;transition:transform .3s,box-shadow .3s;display:flex;flex-direction:column;}
.blog-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(110,80,40,.12);border-color:#D6C9A8;}
.blog-card__img{display:block;aspect-ratio:16/9;overflow:hidden;background:#F3EBDB;}
.blog-card__img img{width:100%;height:100%;object-fit:cover;transition:transform .5s;}
.blog-card:hover .blog-card__img img{transform:scale(1.05);}
.blog-card__body{padding:18px;display:flex;flex-direction:column;flex:1;}
.blog-card__meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-size:12px;}
.blog-card__date{color:#9A7B4D;}
.blog-card__cat{background:#F3EBDB;color:#8C5A2B;padding:3px 10px;border-radius:999px;font-weight:600;font-size:11px;letter-spacing:.04em;text-transform:uppercase;}
.blog-card__title{font-family:'Playfair Display','STKaiti',Georgia,serif;font-size:17px;line-height:1.3;margin:0 0 8px;color:#1A1715;}
.blog-card__title a{color:inherit;text-decoration:none;}
.blog-card__title a:hover{color:#8C5A2B;}
.blog-card__excerpt{font-size:14px;color:#56514B;line-height:1.6;margin:0 0 14px;flex:1;}
.blog-card__link{font-size:13px;font-weight:600;color:#8C5A2B;text-decoration:none;}
.blog-card__link:hover{text-decoration:underline;}
.blog-cat-pill{display:inline-block;padding:8px 18px;border-radius:999px;font-size:13px;font-weight:600;color:#56514B;background:#FFFBF2;border:1px solid #EFE6D2;text-decoration:none;transition:all .2s;letter-spacing:.03em;}
.blog-cat-pill:hover{background:#8C5A2B;color:#fff;border-color:#8C5A2B;}
@media (max-width:980px){.blog-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:640px){.blog-grid{grid-template-columns:1fr;}}
</style>