---
import { translations } from '../../i18n/index.js';
const { locale = 'en' } = Astro.props;
const L = locale === 'zh' ? 'zh' : 'en';
const T = translations[L] || translations.en;
const pick = (k, fb) => k.split('.').reduce((acc, p) => acc?.[p], T) ?? fb ?? k;

const sections = Array.from({ length: 7 }, (_, i) => ({
  tKey: `privacy.section_${i + 1}_title`,
  dKey: `privacy.section_${i + 1}_text`,
}));
---
<main class="funnel funnel--privacy">
  <!-- HERO -->
  <section class="funnel-hero">
    <div class="funnel-wrap funnel-hero__inner" style="grid-template-columns:1fr;">
      <div class="funnel-hero__copy">
        <h1 class="funnel-h1" data-i18n="privacy.title">{pick('privacy.title')}</h1>
        <p class="funnel-sub" data-i18n="privacy.section_0_text">{pick('privacy.section_0_text')}</p>
      </div>
    </div>
  </section>

  {sections.map((s, i) => (
    <section class={`funnel-section${i % 2 === 0 ? ' funnel-section--paper' : ''}`}>
      <div class="funnel-wrap">
        <h2 class="funnel-h2" data-i18n={s.tKey}>{pick(s.tKey)}</h2>
        <p class="funnel-p" data-i18n={s.dKey}>{pick(s.dKey)}</p>
      </div>
    </section>
  ))}
</main>