---
import '../styles/global.css';
// 环境变量控制是否启用分析追踪
const enableAnalytics = import.meta.env.PUBLIC_ENABLE_ANALYTICS === 'true';
// 占位符 ID — 部署时通过环境变量或直接替换配置
const gaId = import.meta.env.PUBLIC_GA_ID || 'G-XXXXXXXXXX';
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID || 'YOUR_PIXEL_ID';
---
{enableAnalytics && (
  <>
    {/* Google Analytics */}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
    </script>

    {/* Meta Pixel */}
    <script is:inline define:vars={{ pixelId }}>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixelId);
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`} alt="" />
    </noscript>
  </>
)}
