<script is:inline>
  (function() {
    // Read GA ID from admin settings (localStorage)
    let gaId = '';
    try {
      const settings = JSON.parse(localStorage.getItem('ov-admin-settings'));
      gaId = settings?.gaId || '';
    } catch { /* ignore */ }

    if (gaId) {
      // Google Analytics
      const gaScript = document.createElement('script');
      gaScript.async = true;
      gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(gaScript);

      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
      window.gtag = gtag;
    }
  })();
</script>