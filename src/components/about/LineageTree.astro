---
// 师承族谱树 SVG：Guiguzi → (79 gen) → Sun Bin → ... → Master Xu Wei (80/79)
const p = Astro.props || {};
let lang = (typeof p.lang === 'string') ? p.lang : 'en';
if (!['zh','en','es','fr','de'].includes(lang)) lang = 'en';
const t = {
  zh: {
    title: '師承族譜 · 兩千年一脈相傳',
    ggui: '鬼谷子（西元前四世紀）',
    gguiSub: '縱橫家鼻祖 · 兵法 · 陰陽',
    sunbin: '孫臏（西元前 369–316）',
    sunbinSub: '《孫臏兵法》作者 · 軍事天才',
    middle: '族譜 Zi Pu 有載 · 79 代傳承不絕',
    xuwei: '徐 偉（當代）',
    xuweiSub: '鬼谷子第 80 代 · 孫臏第 79 代 · 非遺傳承',
    zhuyou: '祝由十三科 古法今用',
    jinkou: '孫臏金口訣 唯一嫡系',
  },
  en: {
    title: 'Direct Lineage — 2,400 Years Unbroken',
    ggui: 'Guiguzi (4th c. BCE)',
    gguiSub: 'Founder · Political Strategist School',
    sunbin: 'Sun Bin (369–316 BCE)',
    sunbinSub: 'Author of Sun Bin\'s Art of War',
    middle: '79 generations recorded in Zi Pu (Clan Genealogy)',
    xuwei: 'Master Xu Wei (Present Day)',
    xuweiSub: '80th-Gen Guiguzi · 79th-Gen Sun Bin · ICH Inheritor',
    zhuyou: 'Zhuyou Thirteen Sections preserved',
    jinkou: 'Sun Bin Golden Formulas sole lineage-holder',
  }
};
const L = (lang === 'zh') ? t.zh : t.en;
---

<style>
.lineage-root { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 32px; align-items: center; }
@media (max-width: 860px) { .lineage-root { grid-template-columns: 1fr; } }
.lineage-caption { font-size: 13px; color: #6B726F; line-height: 1.7; }
.lineage-caption h3 { color: #3A403D; font-size: 16px; margin-bottom: 10px; font-weight: 600; }
.lineage-caption .pill { display: inline-block; padding: 4px 12px; border-radius: 999px; background: #F5F0E8; color: #8a7a5a; font-size: 11px; margin: 4px 6px 0 0; }
</style>

<div class="lineage-root" id="about-lineage-tree">
  <div>
    <svg viewBox="0 0 460 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={L.title}>
      <defs>
        <linearGradient id="lineage-vine" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#BFAF96" />
          <stop offset="100%" stop-color="#8A948C" />
        </linearGradient>
        <linearGradient id="card-f" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#FFFDF9" />
          <stop offset="100%" stop-color="#F5F1EB" />
        </linearGradient>
      </defs>

      <!-- 背景装饰：中国家谱竖格 -->
      <g stroke="#E8E0D4" stroke-width="1" fill="none" opacity=".6">
        <rect x="14" y="14" width="432" height="492" rx="14" />
        <line x1="230" y1="10" x2="230" y2="510" stroke-dasharray="3 5" />
      </g>

      <!-- 节点 1 — 鬼谷子 -->
      <g>
        <rect x="70" y="34" width="320" height="84" rx="14" fill="url(#card-f)" stroke="#BFAF96" stroke-width="1.3" />
        <text x="230" y="70" text-anchor="middle" font-family="'Cinzel','STKaiti',serif" font-size="18" font-weight="700" fill="#3A403D">{L.ggui}</text>
        <text x="230" y="96" text-anchor="middle" font-size="12" fill="#8A948C">{L.gguiSub}</text>
        <g transform="translate(26, 58)" fill="#BFAF96" opacity=".9">
          <circle cx="0" cy="0" r="14" fill="#F5F1EB" stroke="#BFAF96" stroke-width="1.5" />
          <text x="0" y="4" text-anchor="middle" font-size="14">❖</text>
        </g>
      </g>

      <!-- 管道 1 → 中间 -->
      <g stroke="url(#lineage-vine)" stroke-width="2" fill="none" stroke-linecap="round">
        <line x1="230" y1="118" x2="230" y2="190" />
        <polygon points="230,194 222,184 238,184" fill="#8A948C" stroke="none" />
      </g>

      <!-- 中间节点 — 79 代桥接 -->
      <g>
        <rect x="86" y="204" width="288" height="58" rx="12" fill="#FFF9F1" stroke="#D4C6A8" stroke-width="1" stroke-dasharray="4 4" />
        <text x="230" y="230" text-anchor="middle" font-size="13" fill="#8a7a5a" font-style="italic">{L.middle}</text>
      </g>

      <!-- 管道 中间 → 孙膑 -->
      <g stroke="url(#lineage-vine)" stroke-width="2" fill="none" stroke-linecap="round">
        <line x1="230" y1="262" x2="230" y2="300" />
        <polygon points="230,304 222,294 238,294" fill="#8A948C" stroke="none" />
      </g>

      <!-- 节点 2 — 孙膑 -->
      <g>
        <rect x="80" y="312" width="300" height="78" rx="14" fill="url(#card-f)" stroke="#BFAF96" stroke-width="1.3" />
        <text x="230" y="344" text-anchor="middle" font-family="'Cinzel','STKaiti',serif" font-size="17" font-weight="700" fill="#3A403D">{L.sunbin}</text>
        <text x="230" y="366" text-anchor="middle" font-size="12" fill="#8A948C">{L.sunbinSub}</text>
      </g>

      <!-- 管道 孙膑 → 徐伟（79 代）-->
      <g stroke="url(#lineage-vine)" stroke-width="2.2" fill="none" stroke-linecap="round">
        <path d="M230 390 L230 416 L86 416 L86 456" />
        <text x="210" y="410" font-size="10" fill="#8A948C">79 generations</text>
        <text x="156" y="450" font-size="10" fill="#8A948C">80th Gen · direct</text>
      </g>

      <!-- 节点 3 — Xu Wei -->
      <g>
        <rect x="30" y="438" width="196" height="68" rx="14" fill="linear-gradient(135deg,#BFAF96,#A6977C)" stroke="#8A7A60" stroke-width="1.5" />
        <text x="128" y="466" text-anchor="middle" font-family="'Cinzel','STKaiti',serif" font-size="16" font-weight="700" fill="#FFFFFF">{L.xuwei}</text>
        <text x="128" y="486" text-anchor="middle" font-size="10.5" fill="#F5F1EB">{L.xuweiSub}</text>
      </g>

      <!-- 右侧两个小徽章：ICH badges -->
      <g transform="translate(264, 430)">
        <rect x="0" y="0" width="170" height="30" rx="8" fill="#FFF5E6" stroke="#D4A574" />
        <text x="85" y="19" text-anchor="middle" font-size="11" fill="#8A5A10" font-weight="600">{L.jinkou}</text>
      </g>
      <g transform="translate(264, 468)">
        <rect x="0" y="0" width="170" height="30" rx="8" fill="#E8F5E8" stroke="#6B9B7A" />
        <text x="85" y="19" text-anchor="middle" font-size="11" fill="#2A5A38" font-weight="600">{L.zhuyou}</text>
      </g>
    </svg>
  </div>

  <div class="lineage-caption">
    <h3>{L.title}</h3>
    <p>{lang === 'zh'
      ? '兩千四百年來，鬼谷子 一脈相傳的學問從未中斷。每一代都在族譜（Zi Pu）上記載姓名、生卒、傳承者姓名，形成了今天我們能夠回溯的完整師承鏈。徐偉老師是族譜上明確記載的鬼谷子第八十代、孫臏第七十九代嫡傳弟子，掌握此兩脈全部法門，包括《金口訣》與《祝由十三科》—— 兩項皆已列入中國國家級與省級非物質文化遺產名錄。'
      : 'For 2,400 years the lineage of Guiguzi has been preserved in hand-copied clan genealogy books (Zi Pu), recording every generation\'s name, lifespan, and the disciple who transmitted it. Master Xu Wei is the explicitly documented 80th-generation direct holder of the Guiguzi lineage and 79th-generation of Sun Bin\'s school, entrusted with its complete canon — including the Sun Bin Golden Formulas and Zhuyou Thirteen Sections, both inscribed on national/provincial Intangible Cultural Heritage rosters.'}</p>
    <div style="margin-top:14px;">
      <span class="pill">{lang === 'zh' ? '族譜有載' : 'Documented in Zi Pu'}</span>
      <span class="pill">{lang === 'zh' ? '嫡傳弟子' : 'Direct Disciple'}</span>
      <span class="pill">ICH · UNESCO</span>
      <span class="pill">80 / 79 <span style="margin-left:4px;display:inline;">{lang === 'zh' ? '代' : 'Gen'}</span></span>
    </div>
  </div>
</div>
