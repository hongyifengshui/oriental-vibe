# ============================================================
# Oriental Vibe · Cloudflare Pages 环境变量配置模板
# 部署目标：Cloudflare Pages + D1 数据库
# 用法：
#   1) 复制本文件，在 Cloudflare Dashboard → Pages → 你的项目 → Settings → Environment Variables
#      里把每一行（去掉 # 注释、去掉引号、去掉 = 后面的示例前缀）逐个粘贴为 Production / Preview 环境变量。
#   2) 如果你本地想跑 npx astro preview 并复用 Functions 的 env：不要把本文件 .env 暴露到仓库，
#      Local 用 `npx wrangler pages dev` 配合 --binding、.dev.vars 来模拟。
#
# 必填 / 选填速览：
#   🔴 必填（缺一个，对应功能会在运行时直接报 4xx/5xx 或降级到 localStorage 兜底）
#   🟡 强烈推荐（不填也能跑，但是"真正能用"的关键能力缺失）
#   🟢 可选 / 多租户需要
# ============================================================

# ============================================================
# ① Cloudflare D1 数据库绑定（🔴 必填）
# ------------------------------------------------------------
# 这个不是 Environment Variables，是"Bindings"，在同一个页面：
#   Pages → 项目 → Settings → Functions → D1 database bindings → Add binding
#     Variable name (左侧，代码读 env.DB)  :  DB
#     D1 database (右侧，选择你的 D1 库)    :  oriental-vibe-db (你在 D1 创建的库名)
#
# 如果没绑：所有 /api/* 接口会自动降级为"只读静态 + localStorage 兜底模式"
# （不会白屏，但数据不会持久化）
# ============================================================
# [D1 BINDING] DB → 绑定到你的 D1 数据库实例，Variable name 必须是 "DB"

# ============================================================
# ② AI 客服智能体 / GPT-4o-mini（🟡 强烈推荐）
# ============================================================
# 位置：OpenAI Dashboard → API Keys → Create new secret key
# 权限范围：至少要有 chat.completions.create 权限（GPT-4o-mini 可用的常规 key 即可）
# 如果不填：/api/chat 返回 500 → 前端自动降级到本地规则引擎（话术机械、不可调）
OPENAI_API_KEY=sk-xxxx-example-DoNotCommitRealKey
# 如果你用的是 Azure OpenAI / 第三方兼容代理，改这个：
OPENAI_BASE_URL=https://api.openai.com/v1
# 默认已经是 gpt-4o-mini，一般不用改；想省钱可换成 gpt-4o-mini（一样）、想更准换 gpt-4o
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# ③ Admin 登录 / 鉴权（🔴 超级管理员 必填）
# ============================================================
# 用于给 ov_session Cookie 做 HMAC-SHA256 签名。丢了这个 key = 所有管理员全部被强制登出。
# 🔒 最少 32 个字符，推荐：openssl rand -hex 32   （或去 https://1password.com/password-generator 生成 32+）
AUTH_SECRET=replace-me-with-at-least-32-chars-long-random-string-xxxxxxxxxxxxx

# 首次部署 / 迁移后用来创建第一个超级管理员账户。
# 步骤：填好 EMAIL + PASSWORD → 部署成功 → 浏览器访问一次 https://你的域名 /api/auth/init
#  → 返回 { ok:true } 后就可以删这两个 env（为了安全建议删掉；不删也能用，但被人知道=能反复调 /init）
SUPER_ADMIN_EMAIL=admin@orientalvibe1314.com
SUPER_ADMIN_INIT_PASSWORD=ChangeMeAfterFirstInit_strongPassword123!

# 开发阶段标记：dev 时忘记密码接口会返回可直接点击的重置链接（方便测试）；
# 生产环境改成 "prod"，只发邮件给管理员。
STAGE=prod

# ============================================================
# ④ 支付（🟡 要真收钱必填；测试期可跳过，走礼宾手动兜底）
# ============================================================
# 位置：Stripe Dashboard → API keys → Secret key（以 sk_ 开头）
# ⚠️ 测试环境用 sk_test_...；生产切 sk_live_...
# 如果不填：选 Stripe → 自动提示"24 小时内客服发 Stripe 付款链接"（不会报错）
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (可选) 如果以后要接 PayPal，放这里；目前代码是占位提示。
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================================
# ⑤ 通知 & 外呼（🟡 强烈推荐——否则所有"提交成功后通知你"都是静默）
# ============================================================
# 网站收到 Contact / Booking / 新订单 时，这个邮箱会收到一份 BCC，你可以用它做客户 CRM 入口
ADMIN_NOTIFY_EMAIL=hello@orientalvibe1314.com

# --- 5a. 邮件（🟢 可选，B 子项目"通知"上线前是占位，不填不会报错）
# 以下以 Resend / Mailgun / Sendgrid 任一家 REST API 为设计；选一家填即可。
# 发信地址：必须在平台那边校验过域名的发件人（比如 noreply@orientalvibe1314.com）
MAIL_FROM=Oriental Vibe <noreply@orientalvibe1314.com>
# 如果你用 Resend（推荐，最便宜），填 Resend API key：
MAIL_API_TOKEN=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 如果用 Mailgun / Sendgrid，MAIL_API_TOKEN 填对应 key，MAIL_API_ENDPOINT 填对应的 base url。
#MAIL_API_ENDPOINT=https://api.mailgun.net/v3/yourdomain.com/messages

# --- 5b. WhatsApp（🟢 可选，通知 2.0 上线前占位）
# 位置：Meta Business Suite → WhatsApp → 你绑定的号码的 Phone Number ID（不是号码本身）
WA_PHONE_ID=1234567890123456789
# Meta App Dashboard → System Users → Generate Token（永久 token，有 whatsapp_business_messaging 权限）
WA_TOKEN=EAACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx...

# ============================================================
# ⑥ Cloudflare 部署配套（GitHub Actions 使用，不是 Pages 环境变量）
# ============================================================
# 以下 2 个是在 GitHub → 仓库 hongyifengshui/oriental-vibe → Settings → Secrets and variables → Actions → New repository secret：
#
# CLOUDFLARE_API_TOKEN   = 以 Cloudflare Dashboard → My Profile → API Tokens → Create Token
#                          "Edit Cloudflare Pages Projects" 模板 → 选你的 Account + Zone 即可。
# CLOUDFLARE_ACCOUNT_ID   = Cloudflare Dashboard → 任何页面右下角"Account ID"，32 字符十六进制。
#
# 这两个是写在 GitHub Secrets 里的，不要加到 Pages 的 Environment Variables 页面。

# ============================================================
# ⑦ 其它可选（本地调试、限流微调）
# ============================================================
# 每个公共接口每 IP 每分钟请求数上限（默认各接口代码里都硬了 3/5/8/10，一般不用配）
#RATE_LIMIT_OVERRIDE=10
# 域名 / CSP 白名单（以后加 CSP header 时用，占位）
#ALLOWED_ORIGINS=https://orientalvibe1314.com
